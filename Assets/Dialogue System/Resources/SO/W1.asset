    season: 3
    sound: ptbr_ep24_bbt_0c
    id: 2
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Voc\xEA tem raz\xE3o! Precisamos deter esse rob\xF4 antes que ele chegue
