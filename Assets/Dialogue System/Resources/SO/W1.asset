    sound: ptbr_ep24_bbt_5d
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Tente copiar a sequ\xEAncia de placas que j\xE1 est\xE3o no painel at\xE9
