    sound: ptbr_ep24_bbt_0g
    id: 6
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ser\xE1 que alguma coisa por aqui mostra para onde o rob\xF4 est\xE1 indo?"
    world: 1
    season: 3
    sound: ptbr_ep24_bbt_0h
    id: 7
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O rob\xF4 gigante afundou! Conseguimos!"
