    season: 1
    sound: ptbr_ep8_bbt_0h
    id: 7
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "\xC9 um c\xE3o de guarda rob\xF4! Precisamos tir\xE1-lo do caminho!"
