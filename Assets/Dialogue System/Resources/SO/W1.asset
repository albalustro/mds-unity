    season: 3
    sound: ptbr_ep24_bbt_0e
    id: 4
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "O que voc\xEA est\xE1 olhando, Guardi\xE3o? Teve uma ideia?"
