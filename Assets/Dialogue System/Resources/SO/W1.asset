    world: 1
    season: 1
    sound: ptbr_ep7_bbt_1c
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "As c\xE2meras mostram os objetos perto de cada porta, mas em posi\xE7\xF5es
