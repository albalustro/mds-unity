    season: 1
    sound: ptbr_ep6_bbt_5g
    id: 6
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Oba! Funcionou! O peso da televis\xE3o est\xE1 fazendo a porta abrir!"
