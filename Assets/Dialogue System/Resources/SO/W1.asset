    sound: ptbr_ep8_bbt_5g
    id: 6
    episode: 7
    emotion: regular
    slug: error3
    minigame: 5
  - text: "\xC9 isso! O Senhor Sombrio foi para seu laborat\xF3rio no sexto andar!"
