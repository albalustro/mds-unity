    season: 1
    sound: ptbr_ep8_bbt_3a
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "O que \xE9 essa coisa na cabe\xE7a dele? J\xE1 entendi!"
