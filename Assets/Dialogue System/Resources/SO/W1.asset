    season: 3
    sound: ptbr_ep24_bbt_1d
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Pronto! Acho que isso j\xE1 \xE9 o suficiente! Vamos em frente!"
