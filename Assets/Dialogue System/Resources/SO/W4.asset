%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: W4
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "N\xE3o sei como posso te agradecer por ter nos ajudado, nobre Guardi\xE3o.
      Sem tua ajuda jamais conseguiria salvar a vila!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_43
    id: 0
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "Mas olhe a destrui\xE7\xE3o provocada pela m\xE1quina-drag\xE3o!  Vejo
      muito trabalho pela frente!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_44
    id: 1
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "Alto l\xE1, estranho! Quem \xE9s tu para adentrar a vila secreta das fadas!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_01
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Pelas l\xE1grimas da Rainha, \xE9s um Guardi\xE3o dos Sonhos! Ent\xE3o
      h\xE1 esperan\xE7a!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_02
    id: 3
    episode: 1
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Sou Florin, o bravo cavaleiro deste reino e encarregado de defender esta
      vila do terr\xEDvel perigo que a assola!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_03
    id: 4
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Uma fera gigantesca est\xE1 destruindo tudo pelo caminho. Venha! Vejamos
      o que podemos fazer pelos nobres cidad\xE3os deste sonho."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_04
    id: 5
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Por que me olhas deste jeito, Guardi\xE3o? Alguma coisa errada comigo?
      Mostarda no bigode? N\xE3o... Eu n\xE3o tenho bigode!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_11
    id: 6
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ou\xE7a! \xC9 o som de duendes preparando-se para a batalha! AVANTE!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_12
    id: 7
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "O que h\xE1 de errado com a forma que falo? Todos os cavaleiros falam desse
      jeito! ... N\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_19
    id: 8
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ora, n\xE3o importa! Temos um monstro a derrotar e uma vila a salvar! Soldados!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_20
    id: 9
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Como assim aquilo n\xE3o \xE9 um drag\xE3o? Ora, n\xE3o importa! Ainda
      temos trabalho a fazer!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_27
    id: 10
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "O drag\xE3o... certo, a m\xE1quina foi derrotada! Vencemos!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_34
    id: 11
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: Mas os perigos que podem surgir! Precisamos fazer algo para proteger a vila!
    world: 4
    season: 1
    sound: ptbr_ep73_frn_35
    id: 12
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Parece que o terr\xEDvel drag\xE3o passou por aqui e espalhou os pertences
      deste pobre alde\xE3o."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_05
    id: 0
    episode: 1
    emotion: sad
    slug: intro
    minigame: 1
  - text: "Podes ajudar-me na \xE1rdua tarefa de organizar tudo nestas cestas?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Creio que h\xE1 algo fora do lugar, nobre Guardi\xE3o. Talvez devamos organiz\xE1-los
      por cor? Ou tipo de coisa?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_07
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Compreendo tua inten\xE7\xE3o, mas creio que possamos organizar a primeira
      caixa utilizando apenas objetos vermelhos."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_08
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Poder\xEDamos, talvez, colocar os pertences vermelhos em uma caixa e os
      verdes em outra?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_09
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: "N\xE3o precisa agradecer, gentil alde\xE3o. \xC9 nosso dever como protetores
      deste sonho ajud\xE1-lo!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_10
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Sim. Guerreiros destemidos aguardando o comando! Mas, onde est\xE1 o capit\xE3o
      de voc\xEAs?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_13
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ora, se o capit\xE3o desapareceu, faremos n\xF3s o trabalho dele! Guardi\xE3o,
      vamos mostrar a estes soldados como cavalgar como verdadeiros cavaleiros!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_14
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o creio que seja bem assim..."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_15
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "N\xE3o seria ao contr\xE1rio?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_16
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Talvez eu deva demonstrar com minha vasta experi\xEAncia na montaria de
      insetos de todos os tipos e tamanhos."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_17
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: Excelente trabalho! Pela Rainha das Fadas!
    world: 4
    season: 1
    sound: ptbr_ep73_frn_18
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 2
  - text: "O que s\xE3o aqueles potes? Ah, melado! Tive uma ideia!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_21
    id: 0
    episode: 1
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, ajude-me a distribuir os potes de melado. Nenhum soldado deve
      ter mais do que os demais!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_22
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Creio que sobrar\xE3o potes de melado, mas n\xE3o h\xE1 problema!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_23
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: Cada soldado deve ter apenas um pote de melado!
    world: 4
    season: 1
    sound: ptbr_ep73_frn_24
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Aten\xE7\xE3o, soldados! Apresentar armas! Atacar!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_25
    id: 4
    episode: 1
    emotion: scared
    slug: error3
    minigame: 3
  - text: "O drag\xE3o est\xE1 aprisionado no melado!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_26
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 3
  - text: "J\xE1 ouvistes falar de Cascudos? S\xE3o terr\xEDveis abelhas imposs\xEDveis
      de se domesticar!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_28
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Temos v\xE1rios cascudos aqui, para caso de ataque de drag\xF5es. Ajude-me
      a liber\xE1-los. Est\xE3o na porta do meio da parte de cima e na porta da esquerda
      da parte de baixo."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_29
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Creio que me entendeste mal. Em cima \xE9 a porta do meio, e embaixo \xE9
      a porta da esquerda."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_30
    id: 2
    episode: 1
    emotion: regular
    slug: error0
    minigame: 4
  - text: "Precisamos de todos os cascudos ao mesmo tempo! Abra a porta do meio que
      fica da parte de cima tamb\xE9m."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_31
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Isso n\xE3o ser\xE1 o suficiente. Tu tamb\xE9m precisas abrir a porta de
      baixo, do lado esquerdo."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_32
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Agora, afasta-te, pois os cascudos atacar\xE3o o que estiver entre eles
      e o melado!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_33
    id: 5
    episode: 1
    emotion: scared
    slug: victory
    minigame: 4
  - text: "O que planejas fazer, Guardi\xE3o? Posso ajudar-te?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_36
    id: 0
    episode: 1
    emotion: scared
    slug: intro
    minigame: 5
  - text: "Uma barreira m\xE1gica! \xC9s muito s\xE1bio!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_37
    id: 1
    episode: 1
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Vejo que come\xE7aste a colocar as pilastras. Podes completar a sequ\xEAncia,
      por favor?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_38
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "A magia far\xE1 com que o fogo e a \xE1gua se tornem vapor, criando uma
      ilus\xE3o de que a vila n\xE3o est\xE1 aqui."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_42
    id: 3
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "H\xE1 algo de errado, n\xE3o? Precisamos seguir a sequ\xEAncia de pilastras
      m\xE1gicas."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_39
    id: 4
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "S\xE3o duas pilastras de cada tipo, ou a magia n\xE3o funcionar\xE1."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_40
    id: 5
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "A fada completar\xE1 o encantamento!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_41
    id: 6
    episode: 1
    emotion: happy
    slug: error3
    minigame: 5
  - text: "Muito obrigado por tua oferta em nos ajudar a reconstruir a vila, nobre
      Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_01
    id: 0
    episode: 2
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "A m\xE1quina-drag\xE3o destruiu muitas casas e derrubou diversas \xE1rvores!
      Precisaremos reorganizar tudo!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_02
    id: 1
    episode: 2
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Por que aquela m\xE1quina faria tamanho estrago? E em uma floresta t\xE3o
      pac\xEDfica!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_03
    id: 2
    episode: 2
    emotion: sad
    slug: minigame1
    minigame: 
  - text: Bom, perguntas ficam para depois. Temos muito trabalho pela frente. Avante!
    world: 4
    season: 1
    sound: ptbr_ep74_frn_04
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Muitos alde\xF5es est\xE3o reclamando de que suas planta\xE7\xF5es est\xE3o
      sendo devoradas por uma praga."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_08
    id: 4
    episode: 2
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Ajuda-me a descobrir o que est\xE1 acontecendo?"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_09
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "As coisas n\xE3o eram assim t\xE3o perigosas quando nossa majestade, a
      Rainha das Fadas, protegia-nos. Se n\xE3o fossem pelos gigantes..."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_13
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos, Guardi\xE3o. Est\xE3o a nos chamar no Lago Arco \xCDris."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_14
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Olhai! \xC9 meu tio, Darin! Talvez ele precise de ajuda!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_19
    id: 8
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "A vila est\xE1 como nova! Em pouco tempo ningu\xE9m mais se lembrar\xE1
      do perigo que passamos."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_23
    id: 9
    episode: 2
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Se houvesse uma forma de lembrar duendes e fadas sobre a import\xE2ncia
      de proteger nossa floresta!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_24
    id: 10
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Que h\xE1 de errado, Guardi\xE3o? Tu pareces preocupado? Deixo-te ser cavaleiro
      tamb\xE9m!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_30
    id: 11
    episode: 2
    emotion: scared
    slug: final
    minigame: 
  - text: "Este cartaz do vilanesco Senhor Sombrio? Cr\xEA que ele seja o respons\xE1vel
      pela m\xE1quina-drag\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_31
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Ent\xE3o est\xE1 decidido: partiremos imediatamente. Se algu\xE9m neste
      sonho sabe a verdade certamente que \xE9 a \xC1rvore Mais Velha! Avante!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_32
    id: 13
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Drag\xE3o infernal! Cuspiu fogo por toda a parte!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_05
    id: 0
    episode: 2
    emotion: sad
    slug: intro
    minigame: 1
  - text: "Guardi\xE3o, ajude-me a apagar o inc\xEAndio com a \xE1gua deste tonel!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "\xC9s mesmo muito destemido, Guardi\xE3o! Enfrentaste o fogo sem medo!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_07
    id: 2
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Pelo ronco do gigante! S\xE3o pulgas-rob\xF4s, de certo soltas pela m\xE1quina-drag\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_10
    id: 0
    episode: 2
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Vamos captur\xE1-las, Guardi\xE3o, antes que devorem tudo!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_11
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Creio que capturamos todas essas odiosas m\xE1quinas!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_12
    id: 2
    episode: 2
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Que estrago terr\xEDvel! Pobres sapulhas, cobertos de \xF3leo at\xE9 debaixo
      das unhas!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_15
    id: 0
    episode: 2
    emotion: sad
    slug: intro
    minigame: 3
  - text: "A terr\xEDvel m\xE1quina-drag\xE3o espalhou \xF3leo por todo o lago. Precisamos
      fazer algo a respeito!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_16
    id: 1
    episode: 2
    emotion: scared
    slug: intro
    minigame: 3
  - text: "As fadas nos deram um p\xF3 m\xE1gico que limpar\xE1 os sapulhas, mas s\xF3
      se todos eles ficarem do lado de fora ao mesmo tempo! Ajuda-me, Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_17
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Bom trabalho, caro amigo! Agora deixemos o p\xF3 m\xE1gico fazer seu trabalho!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_18
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Guardi\xE3o, meu tio Darin est\xE1 juntando madeira usada para consertar
      o que foi destru\xEDdo."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_20
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Podes ajudar-me a juntar madeira? Mas sem retir\xE1-la da natureza! A floresta
      j\xE1 sofreu muito com o ataque."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_21
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Devemos sempre que poss\xEDvel reutilizar materiais que j\xE1 temos. Se
      n\xE3o um dia n\xE3o restar\xE3o mais \xE1rvores na Floresta Encantada!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_22
    id: 2
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Tu \xE9s mesmo s\xE1bio, Guardi\xE3o! Podemos colocar cartazes explicando
      o que deve ser feito!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_25
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Assim os habitantes da vila sempre se lembrar\xE3o de cuidar do meio ambiente."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_26
    id: 1
    episode: 2
    emotion: happy
    slug: intro
    minigame: 5
  - text: Encontrei alguns cartazes que podemos usar. Quais seriam os melhores cartazes
      para usarmos nesta campanha?
    world: 4
    season: 1
    sound: ptbr_ep74_frn_27
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Tens certeza, Guardi\xE3o? Creio que estes cartazes aqui seriam de melhor
      valia."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_28
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 5
  - text: "\xD3tima escolha! Fazemos uma \xF3tima dupla! Eu, o cavaleiro. Tu, meu
      escudeiro!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_29
    id: 4
    episode: 2
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Devemos seguir em frente. O mapa que tu nos deste nos ajudar\xE1 deveras
      em nosso caminho. Obrigado, amigo Gronco!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_46
    id: 0
    episode: 3
    emotion: happy
    slug: final
    minigame: 
  - text: "E quanto a n\xF3s, Guardi\xE3o, vamos em frente! A sabedoria da \xC1rvore
      Mais Velha nos aguarda!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_47
    id: 1
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: "N\xE3o temas, Guardi\xE3o. Conhe\xE7o esta floresta como a palma da minha
      m\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_01
    id: 2
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Que \xE1rvore \xE9 esta? Ela n\xE3o deveria estar aqui? Que esp\xE9cie
      de bruxaria \xE9 essa?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_02
    id: 3
    episode: 3
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Talvez a \xC1rvore Mais Velha tenha mudado a floresta para se proteger...
      ou talvez eu..."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_03
    id: 4
    episode: 3
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Bom, deve haver uma pista de como reencontrar nosso caminho... creio.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_04
    id: 5
    episode: 3
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Gronco, tu dizes ser este o teu nome? Mmmm... Sou Florin e este \xE9 um
      Guardi\xE3o dos sonhos. Buscamos o caminho at\xE9 a \xC1rvore Mais Velha."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_11
    id: 6
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Podes nos ajudar? Ora, que oportuno! Vamos segui-lo at\xE9 a casa dele,
      Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_12
    id: 7
    episode: 3
    emotion: happy
    slug: minigame2
    minigame: 
  - text: "Ent\xE3o tens ouvido o som de m\xE1quinas na floresta? Tu cr\xEAs que foram
      eles que roubaram teu urso e mexeram em teu tapete?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_19
    id: 8
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Estou a pensar se a m\xE1quina-drag\xE3o n\xE3o foi apenas o come\xE7o
      de algo... o que \xE9 isso adiante?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_20
    id: 9
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Que lugar \xE9 este? N\xE3o parece algo do Sonho das \xC1rvores Encantadas.
      E de onde vem todo esse barulho?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_28
    id: 10
    episode: 3
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "Gronco poder\xE1 agora... onde est\xE1 o Gronco?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_35
    id: 11
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Pelas ra\xEDzes da \xC1rvore Mais Velha! Quando foi que Gronco derrotou
      todos aqueles cavaleiros rob\xF3ticos?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_36
    id: 12
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Cuidado, Guardi\xE3o! \xC9 um terr\xEDvel ogro da floresta! Deixes que
      eu enfrentarei essa fera!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_05
    id: 0
    episode: 3
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Tu achas que ele s\xF3 est\xE1 procurando algum objeto? Quem sabe este
      bilhete possa nos ajudar... vamos ler: N\xE3o \xE9 de comer, n\xE3o \xE9 de
      metal, \xE9 marrom e \xE9 macio."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_06
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Um urso de pel\xFAcia? Que tipo de monstro tem um urso de pel\xFAcia?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_10
    id: 2
    episode: 3
    emotion: happy
    slug: victory
    minigame: 1
  - text: "N\xE3o creio que isso se encaixe em todas as caracter\xEDsticas escritas
      no bilhete. Primeira caracter\xEDstica: n\xE3o \xE9 de comer."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_07_A
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Ent\xE3o, j\xE1 sabemos que ele n\xE3o procura esta ma\xE7\xE3, nem a coxinha
      de galinha e nem o coco... Falta ver as outras caracter\xEDsticas: n\xE3o \xE9
      de metal, \xE9 marron e \xE9 macio."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_07_B
    id: 4
    episode: 3
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O objeto \xE9 marrom e macio. Tira o que n\xE3o for desta forma para facilitar
      encontr\xE1-lo."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_08_A
    id: 5
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "A segunda caracter\xEDstica, nobre Guardi\xE3o, \xE9 que n\xE3o \xE9 de
      metal. Assim, chave inglesa, porca, engrenagem e parafuso s\xE3o tamb\xE9m eliminados
      daqui. Falta-nos eleger aquilo que seja marrom e macio!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_08_B
    id: 6
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Creio que o objeto \xE9 este."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_09
    id: 7
    episode: 3
    emotion: regular
    slug: error3
    minigame: 1
  - text: O que foi, Gronco? Qual o motivo de tanto pranto?
    world: 4
    season: 1
    sound: ptbr_ep75_frn_13
    id: 0
    episode: 3
    emotion: sad
    slug: intro
    minigame: 2
  - text: "Algu\xE9m colocou n\xFAmeros entre as letras do seu tapete! Ora, quem pregaria
      tal pe\xE7a? Devemos ajud\xE1-lo, Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_14
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Devemos tirar todos os n\xFAmeros e deixar apenas as letras no tapete."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_15
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 2
  - text: Deixes o que for letra. Tira o resto.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_16
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Usarei minha coragem para eliminar apenas os n\xFAmeros intrusos!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_17
    id: 4
    episode: 3
    emotion: happy
    slug: error3
    minigame: 2
  - text: "Teu tapete est\xE1 salvo, Gronco! Pode levar-nos at\xE9 nosso objetivo
      agora?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_18
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Dizes que tal muro n\xE3o existia aqui antes, Gronco? \xC9 certo que algu\xE9m
      tenta nos impedir de alcan\xE7ar nosso objetivo!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_21
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Devemos atravessar este muro e descobrir que mist\xE9rio \xE9 esse que
      cerca nosso sonho!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_22
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Gronco, tu \xE9s forte! Segures o port\xE3o. Guardi\xE3o, vamos procurar
      um tronco grande o suficiente para prender e manter o port\xE3o aberto."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_23
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o creio que este tronco se encaixe no espa\xE7o da porta."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_24
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: "S\xF3 de olhar j\xE1 percebemos que os de tamanho mais curto n\xE3o nos
      servem! Qual deles deve se encaixar perfeitamente, nobre Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_25
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 3
  - text: Acredito que este tronco tem o tamanho apropriado.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_26
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Vamos passar r\xE1pido antes que o tronco se parta!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_27
    id: 6
    episode: 3
    emotion: scared
    slug: victory
    minigame: 3
  - text: "Mais uma vil m\xE1quina-monstro! Vou destru\xED-la sem demora! Prepare-se
      monstro!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_29
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O que queres dizer com senha? Ent\xE3o tu cr\xEAs que pode vencer a m\xE1quina
      colocando os n\xFAmeros certos no painel? Mas quais s\xE3o esses n\xFAmeros?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_30
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "H\xE1 duas ferramentas no desenho. Seria o primeiro n\xFAmero 2?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_32
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 4
  - text: "N\xE3o seriam esses desenhos uma pista desta tal senha?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_31
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ent\xE3o, seguindo teu pensamento, os n\xFAmeros seriam estes..."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_33
    id: 4
    episode: 3
    emotion: regular
    slug: error3
    minigame: 4
  - text: "A m\xE1quina-monstro dorme! Essa m\xE1gica \xE9 realmente poderosa, Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_34
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Gronco, tu \xE9s um grande guerreiro! Em todos os sentidos!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_37
    id: 0
    episode: 3
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Se houvesse me chamado emprestaria minhas armas para derrotar estes rob\xF4s
      maldosos!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_38
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Quantos rob\xF4s tu derrotaste sozinho? Guardi\xE3o, ajuda-me a contar."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_39
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "10 rob\xF4s, e sozinho! Gronco, tu \xE9s realmente impressionante!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_45
    id: 3
    episode: 3
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Gronco \xE9 bravo, mas o ex\xE9rcito do Senhor Sombrio n\xE3o \xE9 t\xE3o
      grande assim."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_42
    id: 4
    episode: 3
    emotion: regular
    slug: error_more
    minigame: 5
  - text: "D\xEA uma olhada no alto da \xE1rvore, Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_41
    id: 5
    episode: 3
    emotion: happy
    slug: hint1
    minigame: 5
  - text: Acho que foram mais inimigos derrubados por Gronco.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_40
    id: 6
    episode: 3
    emotion: regular
    slug: error_less
    minigame: 5
  - text: "H\xE1 7 rob\xF4s aqui e mais 3 sobre a empilhadeira. Quantos o Gronco derrotou?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_43
    id: 7
    episode: 3
    emotion: regular
    slug: hint2
    minigame: 5
  - text: Se foram 7 mais 3...
    world: 4
    season: 1
    sound: ptbr_ep75_frn_44
    id: 8
    episode: 3
    emotion: regular
    slug: lasterror
    minigame: 5
  - text: "Guardi\xE3o... s\xF3 h\xE1 um lugar onde descobriremos a localiza\xE7\xE3o
      da Rainha das Fadas... No Castelo dos Gigantes!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_49
    id: 0
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "O fruto do conhecimento! Se o comermos saberemos o que precisamos sobre
      o que est\xE1 acontecendo!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_47
    id: 1
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "\xC9 um fruto delicioso...  N\xE3o! O Senhor Sombrio est\xE1 atr\xE1s da
      Rainha das Fadas! Mas... onde ela est\xE1?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_48
    id: 2
    episode: 4
    emotion: scared
    slug: final
    minigame: 
  - text: "\xC1rvore Mais Velha, pode nos ajudar a compreender o perigo que amea\xE7a
      o Sonho das \xC1rvores Encantadas?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_46
    id: 3
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "A \xC1rvore Mais Velha fica logo adiante, Guardi\xE3o."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_01
    id: 4
    episode: 4
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Ela \xE9 muito s\xE1bia! Foi ela quem ensinou a Rainha das Fadas como colocar
      todos os gigantes para dormir, salvando, assim, o Sonho."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_02
    id: 5
    episode: 4
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "\xC9 uma pena que a Rainha tenha desaparecido na mesma \xE9poca... Ela
      jamais deixaria invadirem o Sonho das \xC1rvores Encantadas!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_03
    id: 6
    episode: 4
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Tu cr\xEAs mesmo que o Senhor Sombrio est\xE1 por tr\xE1s desta invas\xE3o?
      A \xC1rvore certamente saber\xE1 nos dizer a verdade!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_04
    id: 7
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Se foi mesmo o Senhor Sombrio o respons\xE1vel por tudo isso, ele devia
      estar tentando ferir a \xC1rvore Mais Velha."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_11
    id: 8
    episode: 4
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Olhe, mais uma m\xE1quina-monstro! Creio que tu precisar\xE1s usar tua
      magia novamente!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_12
    id: 9
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Os duendes da Vila Secreta constru\xEDram um sistema de irriga\xE7\xE3o
      para ajudar a floresta a crescer."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_19
    id: 10
    episode: 4
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Se colocarmos o orvalho m\xE1gico da \xE1rvore no tanque, poderemos salvar
      este bosque."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_20
    id: 11
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Tu consegues ouvir esta m\xFAsica tristonha? De onde vem?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_28
    id: 12
    episode: 4
    emotion: sad
    slug: minigame4
    minigame: 
  - text: "Est\xE1 tudo resolvido! Podemos agora retornar \xE0 \xC1rvore Mais Velha
      para descobrirmos sobre..."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_37
    id: 13
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Que algazarra \xE9 esta? N\xE3o consigo nem ouvir minha pr\xF3pria voz!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_38
    id: 14
    episode: 4
    emotion: scared
    slug: minigame5
    minigame: 
  - text: "S\xE1bia \xC1rvore Mais Velha... que cheiro \xE9 esse? Algu\xE9m andou
      despejando lixo por aqui?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_05
    id: 0
    episode: 4
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Isso \xE9 terr\xEDvel! Polu\xEDram tudo a tua volta! D\xEA-nos teu orvalho
      m\xE1gico e n\xF3s limparemos tudo! Meu cantil tem espa\xE7o para 10 unidades
      de orvalho. Ajuda-me, Guardi\xE3o."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_06
    id: 1
    episode: 4
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Cada gota \xE9 uma unidade de orvalho. Precisamos de exatamente 10 gotas."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_07
    id: 2
    episode: 4
    emotion: regular
    slug: error_1
    minigame: 1
  - text: "Acho que se contarmos as gotas que guardamos no cantil at\xE9 chegar a
      10 ser\xE1 o suficiente."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_08
    id: 3
    episode: 4
    emotion: regular
    slug: error_2
    minigame: 1
  - text: Se colhermos estas gotas aqui teremos o suficiente.
    world: 4
    season: 1
    sound: ptbr_ep76_frn_09
    id: 4
    episode: 4
    emotion: regular
    slug: error_3
    minigame: 1
  - text: "Obrigado, \xC1rvore Mais Velha! Limparemos o bosque antes de pedirmos tua
      ajuda!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_10
    id: 5
    episode: 4
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Faz teu truque e coloque a m\xE1quina-monstro para dormir. Eu a distrairei
      enquanto tu a domina!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_13
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Que \xE9 este aparelho? Ser\xE1 que ele tem uma pista de como derrotar
      a m\xE1quina-monstro?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_14
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o funcionou! Tente o gravador novamente! Ele parece dizer uma senha!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_15
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Pelo menos as duas letras j\xE1 identifiquei como sendo \"B\" e \"A\"...
      E os \xFAltimos n\xFAmeros entendi 3 e 5... N\xE3o achas melhor ouvirmos de
      novo?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_16
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Muito bem, Guardi\xE3o. Tu \xE9s um verdadeiro her\xF3i!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_18
    id: 4
    episode: 4
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Malditos sejam esses rob\xF4s! Destru\xEDram os canos!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_21
    id: 0
    episode: 4
    emotion: sad
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, precisamos consertar tudo, ou o bosque n\xE3o se recuperar\xE1!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_22
    id: 1
    episode: 4
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Tu deves colocar os canos faltando em suas posi\xE7\xF5es corretas. Ajuda-me
      com isso?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_23
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Os canos devem ficar na sequ\xEAncia correta. Veja os n\xFAmeros que faltam."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_24
    id: 3
    episode: 4
    emotion: regular
    slug: error_1
    minigame: 3
  - text: "\xC9 uma sequ\xEAncia decrescente! \xC9 s\xF3 seguir os n\xFAmeros e colocar
      aqueles que faltam."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_25
    id: 4
    episode: 4
    emotion: regular
    slug: error_2
    minigame: 3
  - text: "Coloquei o orvalho no tanque. Permita-me ajud\xE1-lo a terminar com os
      canos."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_26
    id: 5
    episode: 4
    emotion: regular
    slug: error_3
    minigame: 3
  - text: "Isso parece ser o suficiente. A \xE1gua misturada ao orvalho m\xE1gico
      limpar\xE1 o solo."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_27
    id: 6
    episode: 4
    emotion: happy
    slug: victory
    minigame: 3
  - text: "S\xE3o as flores cantantes! Parece que querem cantar alguma coisa para
      um de n\xF3s!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_29
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\"Uni, duni, t\xEA. Salam\xEA mingu\xEA. O sorvete color\xEA. O escolhido
      foi voc\xEA!\""
    world: 4
    season: 1
    sound: ptbr_ep76_frn_30
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O qu\xEA? O escolhido fui eu? Puxa, que bacana!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_32
    id: 2
    episode: 4
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Elas me escolheram! Que legal! Mas precisam saber qual desses nomes \xE9
      o meu..."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_31
    id: 3
    episode: 4
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Tens certeza? Desta lista, quase todos os nomes s\xE3o enormes... E meu
      nome \xE9 curtinho, n\xE3o \xE9?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_33
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Proponho que a gente elimine os nomes bem compridos: Bar\xE3o Bom Trapo...
      Ele nem \xE9 deste Sonho! Senhor Sombrio... Nunca as flores iriam querer cantar
      para ele, n\xE3o achas? O que mais temos a\xED na lista?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_34
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ser\xE1 que n\xE3o \xE9 este? FLO-RIN... Eu mesmo!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_35
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: "\xC9 uma honra ter sido escolhido por elas! Obrigado, belas damas!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_36
    id: 7
    episode: 4
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Quem diria! O ataque das m\xE1quinas-monstro desorganizou as nozes dos
      nossos companheiros esquilos!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_39
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acalmem-se, pequenos amigos! Decerto o Guardi\xE3o dos Sonhos poder\xE1
      ajud\xE1-los!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_40
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O que me dizes, Guardi\xE3o? Podes arrumar as nozes, em cada bandeja, de
      10 em 10?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_41
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: Todos parecem satisfeitos! Bom! Podemos seguir adiante agora!
    world: 4
    season: 1
    sound: ptbr_ep76_frn_45
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Temos que somar com muito cuidado, pois cada bandeja deve ter 10 nozes
      \u2013 nem mais, nem menos, ou estes esquilos continuar\xE3o a brigar."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_42
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: "S\xE3o 30 nozes, n\xE3o \xE9? Para te ajudar, uma das bandejas j\xE1 est\xE1
      com 10. As outras 20 nozes, arrumas 10 em cada uma das duas outras bandejas."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_43
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: 'Acho que assim fica bom: 10 na primeira bandeja, 10 na segunda e 10 na
      terceira. Somando 30 nozes!'
    world: 4
    season: 1
    sound: ptbr_ep76_frn_44
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 5
  - text: "A Rainha das Fadas est\xE1... no Cora\xE7\xE3o do Sonho, em uma caverna
      no fundo da Terra!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_52
    id: 0
    episode: 5
    emotion: scared
    slug: final
    minigame: 
  - text: "Se a rainha est\xE1 assim t\xE3o fundo s\xF3 h\xE1 uma forma de chegarmos
      at\xE9 ela: com a ajuda dos an\xF5es ferr\xF5es!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_53
    id: 1
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: Estamos quase chegando ao Castelo dos Gigantes!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_01
    id: 2
    episode: 5
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "H\xE1 muitos e muitos anos os Gigantes tentaram conquistar todo o Sonho,
      mas a Rainha das Fadas usou um feiti\xE7o para coloc\xE1-los para dormir."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_02
    id: 3
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ningu\xE9m sabe o que aconteceu com a Rainha, mas parece que o Senhor Sombrio
      descobriu!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_03
    id: 4
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Espere. Estou ouvindo um zumbido estranho vindo de algum lugar. Pode ser
      um monstro!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_04
    id: 5
    episode: 5
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Trafa diz que soube de um mapa escondido no castelo. O mapa revela o esconderijo
      da Rainha das Fadas!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_11
    id: 6
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Precisamos chegar at\xE9 o ba\xFA que guarda o mapa... Mas precisaremos
      passar primeiro pelos gigantes!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_12
    id: 7
    episode: 5
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Estamos a salvo! \xC9 aquele o ba\xFA, Trafa?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_27
    id: 8
    episode: 5
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Agora s\xF3 nos resta abrir o ba\xFA e pegar o mapa!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_28
    id: 9
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Um enxame de tra\xE7as gigantes! Precisamos salvar o mapa!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_36
    id: 10
    episode: 5
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "A m\xFAsica p\xF4s as tra\xE7as gigantes para dormir! Conseguimos!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_43
    id: 11
    episode: 5
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Agora \xE9 seguro pegar o mapa."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_44
    id: 12
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "\xC9 a joaninha viajadeira Trafa! E est\xE1 presa em papel pega-mosca!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_05
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Guardi\xE3o, podes ajudar-me a fazer um solvente para libertar Trafa? Precisamos
      juntar os ingredientes, mas s\xF3 aqueles que t\xEAm o nome dentro do outro
      ingrediente."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_06
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "A palavra \"lago\" est\xE1 em \"lagoa\", ent\xE3o esses dois ficam juntos.
      O que mais?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_07
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "N\xE3o vamos usar todos os ingredientes. S\xF3 4."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_08
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Creio que isso \xE9 tudo. Agora \xE9 s\xF3 misturar e colocar no papel
      pega-mosca."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_09
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Est\xE1s a salva, Trafa! Agora, diga-nos: o que fazes aqui?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_10
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Estes gigantes se mexem muito dormindo! Trafa n\xE3o conseguir\xE1 voar
      por cima deles carregando n\xF3s dois."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_13
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: Eu montarei em Trafa e guio-te do ar. Primeiro, para frente!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_14
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Agora vire \xE0 esquerda."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_16
    id: 2
    episode: 5
    emotion: regular
    slug: request_1
    minigame: 2
  - text: Novamente para frente. Avante!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_18
    id: 3
    episode: 5
    emotion: regular
    slug: request_2
    minigame: 2
  - text: "Vire \xE0 direita."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_20
    id: 4
    episode: 5
    emotion: regular
    slug: request_3
    minigame: 2
  - text: "Volte para tr\xE1s!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_22
    id: 5
    episode: 5
    emotion: regular
    slug: request_4
    minigame: 2
  - text: "Para terminar, v\xE1 para a direita."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_24
    id: 6
    episode: 5
    emotion: regular
    slug: request_5
    minigame: 2
  - text: "Cuidado! \xC9 para frente!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_15
    id: 7
    episode: 5
    emotion: scared
    slug: error0
    minigame: 2
  - text: "Por a\xED, n\xE3o! Esquerda!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_17
    id: 8
    episode: 5
    emotion: scared
    slug: error1
    minigame: 2
  - text: "Guardi\xE3o! Quase! \xC9 para frente!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_19
    id: 9
    episode: 5
    emotion: scared
    slug: error2
    minigame: 2
  - text: "Nossa! Que perigo... Eu disse \xE0 direita!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_21
    id: 10
    episode: 5
    emotion: scared
    slug: error3
    minigame: 2
  - text: "Olha o bra\xE7o do gigante! Volte para tr\xE1s!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_23
    id: 11
    episode: 5
    emotion: scared
    slug: error4
    minigame: 2
  - text: "Cuidado! Estamos quase l\xE1! Direita!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_25
    id: 12
    episode: 5
    emotion: scared
    slug: error5
    minigame: 2
  - text: "Tu conseguiste, Guardi\xE3o! Somos uma \xF3tima equipe!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_26
    id: 13
    episode: 5
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Esses gigantes terr\xEDveis! Protegeram o ba\xFA com um cadeado m\xE1gico!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_29
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Que tipo de bruxaria \xE9 essa que n\xE3o usa chave? O que s\xE3o essas
      palavras?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_30
    id: 1
    episode: 5
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Tu, Guardi\xE3o, t\xE3o s\xE1bio nas palavras: como abriremos este ba\xFA?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_31
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Creio que conhecemos estas palavras... Se colocarmos um I em FLOR N, temos
      FLORIN! Esse \xE9 mesmo o meu nome!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_32
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Vamos ver... esta aqui parece ser Ogro e aquela ali uva... quais ser\xE3o
      as outras?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_33
    id: 4
    episode: 5
    emotion: happy
    slug: error2
    minigame: 3
  - text: Posso tentar? Eu sei algumas palavras... deixe-me tentar, por favor.
    world: 4
    season: 1
    sound: ptbr_ep77_frn_34
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "O ba\xFA est\xE1 aberto! Mas... que barulho \xE9 este?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_35
    id: 6
    episode: 5
    emotion: regular
    slug: victory
    minigame: 3
  - text: "S\xE3o muitas tra\xE7as gigantes! \xC9 imposs\xEDvel venc\xEA-las sozinho!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_37
    id: 0
    episode: 5
    emotion: scared
    slug: intro
    minigame: 4
  - text: "No ba\xFA! A harpa m\xE1gica! Guardi\xE3o, ajude-me a descobrir a sequ\xEAncia
      certa para nos proteger das tra\xE7as gigantes!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_38
    id: 1
    episode: 5
    emotion: scared
    slug: intro
    minigame: 4
  - text: "N\xE3o creio que seja assim. Devemos repetir a sequ\xEAncia."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_39
    id: 2
    episode: 5
    emotion: regular
    slug: error_1
    minigame: 4
  - text: "S\xE3o as vogais em ordem alfab\xE9tica, n\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_40
    id: 3
    episode: 5
    emotion: regular
    slug: error_2
    minigame: 4
  - text: "Dai-me a honra de completar esta sequ\xEAncia, ao menos desta vez!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_41
    id: 4
    episode: 5
    emotion: happy
    slug: error_3
    minigame: 4
  - text: "Adoro o som da harpa... Extraordin\xE1rio!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_42
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Oh, n\xE3o! As tra\xE7as destru\xEDram o mapa! Como descobriremos onde
      est\xE1 a Rainha?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_45
    id: 0
    episode: 5
    emotion: sad
    slug: intro
    minigame: 5
  - text: "Tu achas que \xE9 poss\xEDvel reconstruir o mapa, Guardi\xE3o? Mas como?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_46
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Claro, tu podes ler as palavras faltantes e ver onde se encaixam! Boa ideia,
      Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_47
    id: 2
    episode: 5
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Cada palavra corresponde a um desenho do mapa, como a Lagoa Arco-\xCDris."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_48
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: Que outras palavras se encaixam com os desenhos do mapa?
    world: 4
    season: 1
    sound: ptbr_ep77_frn_49
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: "N\xE3o estariam estes aqui trocados? Vejamos..."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_50
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 5
  - text: "O mapa est\xE1 completo!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_51
    id: 6
    episode: 5
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Hidra, poderia nos mostrar o caminho da mina dos an\xF5es ferr\xF5es?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_46_cut
    id: 0
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Vamos, Guardi\xE3o. Antes que este monstro decida mudar de ideia sobre
      nossa amizade!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_47
    id: 1
    episode: 6
    emotion: scared
    slug: final
    minigame: 
  - text: "O caminho at\xE9 a mina dos an\xF5es ferr\xF5es passa pelo terr\xEDvel
      Vale das Hidras!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_01
    id: 2
    episode: 6
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Como assim o que h\xE1 de t\xE3o terr\xEDvel em uma hidra? Elas s\xE3o
      cobras gigantes! Com v\xE1rias cabe\xE7as!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_02
    id: 3
    episode: 6
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Acho eu... Nunca... nunca vi uma hidra!
    world: 4
    season: 1
    sound: ptbr_ep78_frn_03
    id: 4
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei! Tem uma cabe\xE7a que parece concentrada... aquela, com um l\xE1pis
      na boca!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_05
    id: 5
    episode: 6
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Tu ouves este silvo? O que poderia...
    world: 4
    season: 1
    sound: ptbr_ep78_frn_11
    id: 6
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "\xC9 a outra cabe\xE7a da hidra! O que ser\xE1 que ela quer?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_12
    id: 7
    episode: 6
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Sinto cheiro de cozido... Espero que n\xE3o seja uma das cabe\xE7as se
      preparando para nos cozinhar!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_19
    id: 8
    episode: 6
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "L\xE1 est\xE1 ela, a terceira cabe\xE7a! Ela parece faminta!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_20
    id: 9
    episode: 6
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "A quarta cabe\xE7a est\xE1 adiante. Parece estar ouvindo r\xE1dio."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_28
    id: 10
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Isso \xE9 tudo, certo? N\xE3o precisamos mais ajudar nenhuma cabe\xE7a
      de hidra, n\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_37
    id: 11
    episode: 6
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Espere... aquela quinta cabe\xE7a quer alguma coisa..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_38
    id: 12
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ela est\xE1 fazendo palavras cruzadas! Se dermos uma ajuda, ela pode nos
      indicar o caminho da mina. Qual palavra est\xE1 faltando?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_06
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Nobre Guardi\xE3o, achas que as outras palavras aqui presentes nos auxiliam
      a escrever esta que est\xE1 faltando? Vamos observ\xE1-las letra por letra?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_07
    id: 1
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Penso j\xE1 termos descoberto ao menos duas letras: \"B\" e \"O\", que
      est\xE3o na palavra LOBO... Bom come\xE7o, n\xE3o achas, meu amigo?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_08
    id: 2
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Falta-nos bem pouco neste desafio! A palavra VELA parece tamb\xE9m conter
      uma parte importante do que precisamos: as letras \"L\" e \"A\" completam nossa
      palavra BOLA!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_09
    id: 3
    episode: 6
    emotion: happy
    slug: error3
    minigame: 1
  - text: "Ainda bem que ficou tudo resolvido. N\xE3o queria ter que enfrentar essa
      hidra..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_10
    id: 4
    episode: 6
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Ela... ela tamb\xE9m quer nossa ajuda! Ela viu que auxiliamos a outra cabe\xE7a
      e... Quem diria!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_13
    id: 0
    episode: 6
    emotion: happy
    slug: intro
    minigame: 2
  - text: "Ela quer que a ajudemos a descobrir qual destes objetos \xE9 o mais leve
      entre eles."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_14
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Talvez seja boa ideia pesar os objetos. O mais pesado ficar\xE1 mais baixo
      na balan\xE7a."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_15
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Com certeza n\xE3o \xE9 nem a bigorna, nem o vaso de planta! Estes dois
      s\xE3o os mais pesados!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_16
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Ainda n\xE3o me parece ser este, Guardi\xE3o. Quem sabe tentas este aqui?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_17
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 2
  - text: "\xC9 certo! \xC9 o urso de pel\xFAcia. Podes contar a teus amigos... irm\xE3os...
      cabe\xE7as... n\xE3o sei!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_18
    id: 5
    episode: 6
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Fique longe de n\xF3s, monstro terr\xEDvel! Olha como ela saliva de fome!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_21
    id: 0
    episode: 6
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Espere... ela... ela s\xF3 quer ajuda para fazer uma torta de frutas? Que
      tipo de cobra gigante \xE9 esta?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_22
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, podes ajud\xE1-la? Creio que \xE9 s\xF3 colocarmos cada um
      dos ingredientes nas quantidades corretas."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_23
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que a ordem \xE9 outra. Vamos contar cada coisa e ver qual destes
      \xE9 o n\xFAmero correto... Podes tentar de novo?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_24
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "O n\xFAmero deve representar a quantidade de cada ingrediente. Como, por
      exemplo, este 8 deve ser das 8 flores! Quais ser\xE3o os outros?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_25
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Creio que \xE9 s\xF3 trocarmos estes aqui de lugar e est\xE1 terminado:
      3 ma\xE7\xE3s, 8 flores, 12 uvas e 15 sementes! Que torta estranha!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_26
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Devo concordar que o cheiro est\xE1 \xF3timo. Melhor ainda que n\xE3o somos
      o prato principal!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_27
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Se alguma cabe\xE7a n\xE3o estiver usando gravata na festa, vai ficar triste..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_33
    id: 0
    episode: 6
    emotion: regular
    slug: hint1
    minigame: 4
  - text: "N\xE3o sei, mas diria que esta cabe\xE7a da hidra est\xE1 confusa. Parece
      que n\xE3o sabe se decidir sobre algo."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_29
    id: 1
    episode: 6
    emotion: sad
    slug: intro
    minigame: 4
  - text: "Pobre hidra! Guardi\xE3o, ela precisa saber quantas gravatas ainda lhe
      sobrar\xE3o se ela usar uma em cada cabe\xE7a."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_31
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Sobrar\xE3o 5 gravatas, ent\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_36
    id: 3
    episode: 6
    emotion: happy
    slug: victory
    minigame: 4
  - text: "O que foi dito no r\xE1dio sobre o n\xFAmero de gravatas por cabe\xE7a?
      Uma por cabe\xE7a! \xD3timo! Assim sabemos quantas gravatas ela usou e depois
      fica mais f\xE1cil descobrirmos quantas v\xE3o sobrar, concordas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_32
    id: 4
    episode: 6
    emotion: regular
    slug: error_more
    minigame: 4
  - text: "O que foi dito no r\xE1dio sobre o n\xFAmero de gravatas por cabe\xE7a?
      Uma por cabe\xE7a! \xD3timo! Assim sabemos quantas gravatas ela usou e depois
      fica mais f\xE1cil descobrirmos quantas v\xE3o sobrar, concordas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_32
    id: 5
    episode: 6
    emotion: regular
    slug: error_less
    minigame: 4
  - text: "Se n\xE3o estou enganado, era exatamente uma gravata por cabe\xE7a... Como
      ela tem 5 cabe\xE7as usar\xE1 5 gravatas. E das 10 do arm\xE1rio, quantas v\xE3o
      sobrar, ent\xE3o, s\xE1bio amigo?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_34
    id: 6
    episode: 6
    emotion: regular
    slug: hint2
    minigame: 4
  - text: "Se alguma cabe\xE7a n\xE3o estiver usando gravata na festa, vai ficar triste..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_33
    id: 7
    episode: 6
    emotion: regular
    slug: hint3
    minigame: 4
  - text: "Bom, se s\xE3o 10 gravatas no arm\xE1rio... E ela usar\xE1 5 no Baile..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_35
    id: 8
    episode: 6
    emotion: regular
    slug: lasterror
    minigame: 4
  - text: "Pois bem... o que tu precisas, quinta cabe\xE7a da hidra?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_39
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O que \xE9 isto? Um \xE1lbum de figurinhas? Hidras de gravata eu j\xE1
      vi, mas colecionando figurinhas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_40
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Bom, podemos ajud\xE1-la a colar as figuras que faltam no \xE1lbum, n\xE3o
      \xE9, Guardi\xE3o? A flor j\xE1 est\xE1 colada e as outras?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_41_fix
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "J\xE1 achei duas palavras que n\xE3o s\xE3o deste \xE1lbum, pois n\xE3o
      temos a palavra COELHO, nem a palavra \xC1RVORE escritas aqui. Estas figurinhas
      devem ser de outro \xE1lbum..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_42_A
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "O que achas de ler os demais nomes em voz alta para saber quais s\xE3o
      as figurinhas certas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_42_B
    id: 4
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Lobo mau? Esse se encaixa, n\xE3o \xE9, Guardi\xE3o? Parece com as hist\xF3rias
      que meu tio me contava!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_43
    id: 5
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: "E tamb\xE9m se descobrimos a FADA... Tudo se completa com o DUENDE!."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_44
    id: 6
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: Terminamos? Terminamos!
    world: 4
    season: 1
    sound: ptbr_ep78_frn_45
    id: 7
    episode: 6
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Guardi\xE3o, segundo os an\xF5es, o Senhor Sombrio veio at\xE9 aqui roubar
      seus mapas do subterr\xE2neo, pois os an\xF5es sabem onde est\xE1 a Rainha das
      Fadas!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_44
    id: 0
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "E lembra o rubi especial que eles procuravam? \xC9 este o mist\xE9rio!
      A Rainha das Fadas est\xE1 aprisionada dentro do Rubi de Fogo!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_45
    id: 1
    episode: 7
    emotion: scared
    slug: final
    minigame: 
  - text: "N\xE3o podemos perder tempo: precisamos regat\xE1-la antes que seja tarde
      demais!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_46
    id: 2
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Chegamos! Esta \xE9 a mina dos an\xF5es ferr\xF5es! N\xE3o h\xE1 melhor
      minerador em todo o Mundo dos Sonhos!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_01
    id: 3
    episode: 7
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Eles nos ajudar\xE3o a chegar at\xE9 onde a Rainha das Fadas est\xE1 escondida.
      N\xE3o duvidaria que soubessem de tudo desde o princ\xEDpio."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_02
    id: 4
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Estranho... Este lugar parece t\xE3o vazio e silencioso. Geralmente pode-se
      ouvir os an\xF5es cantando e resmungando de longe."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_03
    id: 5
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O que \xE9 aquele objeto piscando ali sobre a mesa?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_04
    id: 6
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ser\xE1 que chegamos tarde demais? Poderia o Senhor Sombrio e seus rob\xF4s
      j\xE1 terem passado por aqui?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_11
    id: 7
    episode: 7
    emotion: sad
    slug: minigame2
    minigame: 
  - text: "Vamos ver se encontramos alguma pista \xE0 frente."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_12
    id: 8
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Os an\xF5es costumam ser muito cuidadosos com suas coisas... N\xE3o deixariam
      as etiquetas soltas de prop\xF3sito."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_18
    id: 9
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Aquele quadro parece ter o relat\xF3rio do dia. Deve haver uma pista ali."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_19
    id: 10
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos avan\xE7ar. Pressinto que estamos prestes a descobrir este mist\xE9rio."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_28
    id: 11
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Espere! Est\xE1s ouvindo este som? H\xE1 algu\xE9m adiante."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_35
    id: 12
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Prepare-se para o combate! Podem ser rob\xF4s do mal!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_36
    id: 13
    episode: 7
    emotion: scared
    slug: minigame5
    minigame: 
  - text: O que queres dizer com "uma bomba"? Uma bomba de fedor ainda por cima? O
      que faz uma bomba aqui?
    world: 4
    season: 1
    sound: ptbr_ep79_frn_05
    id: 0
    episode: 7
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Precisamos deslig\xE1-la antes que exploda! Guardi\xE3o, fazes tua m\xE1gica!
      Parece uma frase, mas toda fora de ordem! Desvendas o segredo da bomba!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_06
    id: 1
    episode: 7
    emotion: scared
    slug: intro
    minigame: 1
  - text: "O segredo come\xE7a com essa figura de SOLDADO! Ah, nobre Guardi\xE3o...
      Qual \xE9 aquela m\xFAsica na qual o soldado vai preso para o quartel?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_07
    id: 2
    episode: 7
    emotion: scared
    slug: error1
    minigame: 1
  - text: "Acho que \xE9 MARCHA SOLDADO... O que vem depois?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_08
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Claro! Ouvia esta m\xFAsica quando treinava para ser cavaleiro!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_09
    id: 4
    episode: 7
    emotion: happy
    slug: error3
    minigame: 1
  - text: "\"Marcha soldado, cabe\xE7a de papel.\" Veja, o rel\xF3gio parou! Estamos
      salvo! E cheirosos!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_10
    id: 5
    episode: 7
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Isto parece uma cole\xE7\xE3o de algum tipo. Mas n\xE3o vejo etiquetas
      em lugar algum."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_13
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ah, algu\xE9m as jogou no ch\xE3o! Vamos recolocar a etiqueta correta no
      vaso."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_14
    id: 1
    episode: 7
    emotion: happy
    slug: intro
    minigame: 2
  - text: Pronto, colado novamente.
    world: 4
    season: 1
    sound: ptbr_ep79_frn_17
    id: 2
    episode: 7
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Acabei por descobrir o segredo! Basta acharmos a etiqueta que tem a mesma
      palavra VASO, mas escrita em letra min\xFAscula. Podes tentar, Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_15
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 2
  - text: "\xC9 esta aqui!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_16
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 2
  - text: 
    world: 4
    season: 1
    sound: ptbr_ep79_frn_23
    id: 0
    episode: 7
    emotion: regular
    slug: radio
    minigame: 3
  - text: "Algu\xE9m bagun\xE7ou tudo, como se estivesse procurando algo."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_20
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o h\xE1 d\xFAvida de que os rob\xF4s do Senhor Sombrio passaram por
      aqui!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_21
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Veja, os an\xF5es fizeram uma grava\xE7\xE3o do relat\xF3rio. Eu toco a
      grava\xE7\xE3o e tu completas o quadro."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_22
    id: 3
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: 
    world: 4
    season: 1
    sound: ptbr_ep79_frn_23
    id: 4
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Terminado? estranho. H\xE1 algo aqui sobre um rubi especial, mas n\xE3o
      consigo ler o resto do que est\xE1 escrito."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_27
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 3
  - text: Tenho certeza que ouvi 3 pedras quadradas. Mas e as outras? Vamos ouvir
      novamente, para termos certeza?
    world: 4
    season: 1
    sound: ptbr_ep79_frn_24
    id: 6
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Com certeza s\xE3o 2 pedras circulares. E as demais?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_25_fix
    id: 7
    episode: 7
    emotion: regular
    slug: error2
    minigame: 3
  - text: "3 quadradas, 2 c\xEDrculares e zero tri\xE2ngulares!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_26
    id: 8
    episode: 7
    emotion: happy
    slug: error3
    minigame: 3
  - text: "Isto parece ser o quarto dos an\xF5es, mas, novamente, tudo est\xE1 fora
      de ordem."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_29
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "J\xE1 que estamos aqui, vamos recolocar os nomes nos seus devidos lugares,
      em ordem alfab\xE9tica."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_30
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: A pessoa precisa ser muito vil para trocar os nomes das camas de lugar!
    world: 4
    season: 1
    sound: ptbr_ep79_frn_34
    id: 2
    episode: 7
    emotion: sad
    slug: victory
    minigame: 4
  - text: "Precisamos organizar de acordo com a primeira letra de cada nome. J\xE1
      tem um que come\xE7a com a letra \"A\". Abeto! Este \xE9 o primeiro!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_31
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Lembra-se da ordem do alfabeto? Come\xE7a com A, B, C, D... Achamos o segundo!
      Donfo! Quais ainda faltam?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_32
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 4
  - text: Abeto, Donfo, Fufos e... Tupli?
    world: 4
    season: 1
    sound: ptbr_ep79_frn_33
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Os an\xF5es ferr\xF5es! Tem\xEDamos que o Senhor Sombrio houvesse feito
      algo com voc\xEAs!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_37
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos ajud\xE1-los a organizar tudo e, depois, expliquem-nos o que o Senhor
      Sombrio fazia aqui."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_38
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, vamos ajud\xE1-los a colocar tudo nos seus devidos ba\xFAs?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_39
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Tudo terminado! Pois bem, an\xF5es. O que houve aqui?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_43
    id: 3
    episode: 7
    emotion: regular
    slug: victory
    minigame: 5
  - text: "O desenho no ba\xFA indica o tipo de objeto a ser ali guardado. Devemos
      ter muita aten\xE7\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_40
    id: 4
    episode: 7
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Alguma coisa est\xE1 no lugar errado. Vamos tentar novamente."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_41_A
    id: 5
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Acho que neste primeiro ba\xFA v\xE3o os dois ret\xE2ngulos verdes, pois
      o desenho do ba\xFA \xE9 igual aos ret\xE2ngulos! O que mais fica faltando?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_41_B
    id: 6
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ah, sim. Estes aqui est\xE3o trocados de lugar!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_42
    id: 7
    episode: 7
    emotion: happy
    slug: error3
    minigame: 5
  - text: "Bom, majestade, creio que ser\xE1 minha \xFAnica oportunidade de v\xEA-la.
      Espero poder servi-la novamente no futuro."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_42
    id: 0
    episode: 8
    emotion: sad
    slug: final
    minigame: 
  - text: "Guardi\xE3o, assim que tu estiveres pronto, podemos ir."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_43
    id: 1
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "Segundo as lendas, o Rubi de Fogo \xE9 uma joia muito poderosa."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_01
    id: 2
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Quando a Rainha das Fadas p\xF4s os gigantes para dormir, ela se escondeu
      dentro da joia, pois se ela fosse derrotada, os gigantes despertariam!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_02
    id: 3
    episode: 8
    emotion: sad
    slug: minigame1
    minigame: 
  - text: Deve ser por isso que o Senhor Sombrio quer o rubi. Ele quer despertar os
      gigantes!
    world: 4
    season: 1
    sound: ptbr_ep80_frn_03
    id: 4
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Veja! Outra m\xE1quina-drag\xE3o. E ela est\xE1 comendo a terra atr\xE1s
      do Rubi de Fogo! Precisamos det\xEA-la."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_04
    id: 5
    episode: 8
    emotion: scared
    slug: minigame1
    minigame: 
  - text: O Senhor Sombrio parece furioso. Precisamos agir antes que ele nos veja.
    world: 4
    season: 1
    sound: ptbr_ep80_frn_11
    id: 6
    episode: 8
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Olhe! Caixas de rubis m\xE1gicos! Vamos us\xE1-los contra o vil\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_12
    id: 7
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Funcionou! O Senhor Sombrio n\xE3o p\xF4de resistir \xE0 luz dos rubis
      e fugiu!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_19
    id: 8
    episode: 8
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Ser\xE1 que o Rubi de Fogo ainda est\xE1 l\xE1 dentro?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_20
    id: 9
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "N\xE3o \xE9 que eu esteja com medo, mas tu \xE9s mais experiente na arte
      da magia. Ent\xE3o..."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_28
    id: 10
    episode: 8
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "Estamos no interior do Rubi de Fogo! Isso \xE9... Pelas costeletas do Gronco!
      \xC9 a Rainha das Fadas!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_33
    id: 11
    episode: 8
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Vossa alteza fe\xE9rica! Viemos proteg\xEA-la do maldoso Senhor Sombrio!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_34
    id: 12
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "O Senhor Sombrio est\xE1 com a m\xE1quina-drag\xE3o! Tu sabes como derrot\xE1-lo,
      Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_05
    id: 0
    episode: 8
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Isso parece um encantamento! Ou uma senha! Quais letras faltam nestas palavras?
      S\xF3 assim conseguiremos ler a frase toda!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_06
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Vamos ler tudo em voz alta para tentar entender: Pela ... O que ser\xE1?
      Parece TELA... Isso mesmo! Basta completar... Pela tela do radar, a Rainha...
      Como continua?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_07
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O nome dela \xE9 Rainha Fada! Pronto, Guardi\xE3o! Colocamos as letras
      \"D\" e \"A\" que faltavam nesta palavra. Continuemos: Pela tela do radar, a
      Rainha Fada est\xE1 escondida dentro da joia..."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_08
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Tela... fada... joia... e m\xE1gica!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_09
    id: 4
    episode: 8
    emotion: happy
    slug: error3
    minigame: 1
  - text: "Muito bem, Guardi\xE3o! A m\xE1quina-drag\xE3o parou!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_10
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Todos os rubis deste lugar s\xE3o m\xE1gicos. Podemos usar essa magia para
      derrotar o Senhor Sombrio!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_13
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Guardi\xE3o, pegue a caixa com o maior n\xFAmero poss\xEDvel de rubis!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_14
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Isso n\xE3o \xE9 o suficiente. Precisamos de mais rubis!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_15
    id: 2
    episode: 8
    emotion: scared
    slug: error1
    minigame: 2
  - text: "Para derrotar o Senhor Sombrio, o importante \xE9 a quantidade. Esta caixa,
      por exemplo, embora bem cheia, s\xF3 tem 2 rubis... N\xE3o nos serve."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_16
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Aquela ali me parece que tem a maior quantidade de rubis. Nem d\xE1 para
      a gente contar direito! S\xE3o pequenos, mas s\xE3o muitos."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_17
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 2
  - text: "N\xF3s o expulsamos do Sonho das \xC1rvores Encantadas com o poder dos
      rubis!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_18
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Quantos rubis m\xE1gicos! Como vamos descobrir qual deles \xE9 o Rubi de
      Fogo?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_21
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Claro! Os an\xF5es ferr\xF5es me deram essas fotos do rubi que guarda nossa
      rainha!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_22
    id: 1
    episode: 8
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Usando estas fotos tu podes descobrir qual dos rubis \xE9 aquele que procuramos?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_23
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "\xC9 ele! Veja as fotos! Ele parece t\xE3o quente quanto o fogo!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_27
    id: 3
    episode: 8
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Olhando a primeira foto, conseguimos eliminar os rubis que t\xEAm mais
      do que 3 faces viradas para n\xF3s! Mas qual deles \xE9 o certo?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_24
    id: 4
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Vamos observar a segunda foto, com certeza os rubis de ponta achatada est\xE3o
      fora! Mas qual ser\xE1 o Rubi de Fogo, nobre Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_25
    id: 5
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: Aquele ali parece ser o que procuramos.
    world: 4
    season: 1
    sound: ptbr_ep80_frn_26
    id: 6
    episode: 8
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Claro! A p\xE1 m\xE1gica dos an\xF5es! Ela nos permitir\xE1 entrar no rubi
      e falar com a Rainha. Ela saber\xE1 como proteger a joia!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_29
    id: 0
    episode: 8
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Veja aqui as instru\xE7\xF5es. A p\xE1 m\xE1gica possui 9 cargas m\xE1gicas.
      Para entrarmos no Rubi, temos que gastar 5 cargas, e para sairmos, vamos gastar
      2 cargas."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_30_A
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ser\xE1 que a p\xE1 m\xE1gica tem carga de magia o suficiente para entrarmos
      e sairmos do Rubi de Fogo?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_30_B
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Estamos com sorte! Tem carga suficiente, e ainda restar\xE3o duas cargas.
      Vamos entrar! Preparado?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_32
    id: 3
    episode: 8
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Deixe-me ver com calma... S\xE3o 9 cargas no total e para entrarmos vamos
      remover 5 destas cargas! Desse total vamos ter que remover mais 2 cargas para
      sairmos de l\xE1! Ser\xE1 que isso poss\xEDvel?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_31
    id: 4
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: "A Rainha est\xE1 muito contente com nosso sucesso, Guardi\xE3o, mas teme
      que precisemos fazer alguma coisa a mais."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_35
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Estas s\xE3o instru\xE7\xF5es de um feiti\xE7o que tornar\xE1 o rubi invis\xEDvel
      a todos, menos para um Guardi\xE3o dos Sonhos. Isso proteger\xE1 nosso Sonho."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_36
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "S\xF3 precisamos descobrir qual destes pap\xE9is tem o poema m\xE1gico."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_37
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Melhor \xE9 examinarmos um a um. Este aqui, por exemplo, \xE9 uma lista
      de compras, veja s\xF3:"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_38_A
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: "2 caixas de folha de parreira, 6 cascas de nozes, 1 d\xFAzia de caixas
      de orvalho... Muitos itens a serem adquiridos, n\xE3o te parece? Qual ser\xE1
      o poema m\xE1gico?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_38_B
    id: 4
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Veja bem, Guardi\xE3o! Temos aqui tamb\xE9m 2 receitas:"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_39_A
    id: 5
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Uma bem deliciosa, com mam\xE3o, leite e pozinhos m\xE1gicos. E outra que
      vai ao forno por 30 minutos, depois de misturar 6 cascas de figueira, 1 ovo
      de avestruz e 3 litros de orvalho. Mas qual ser\xE1 o poema m\xE1gico?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_39_B
    id: 6
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ser\xE1 que n\xE3o \xE9 este outro aqui? \"Pozinho m\xE1gico, fa\xE7a sumir.
      O rubi de fogo que tenho aqui\". Isso mesmo! Os demais textos s\xE3o importantes,
      mas s\xE3o not\xEDcias e n\xE3o poemas, concordas, nobre Guardi\xE3o?\""
    world: 4
    season: 1
    sound: ptbr_ep80_frn_40
    id: 7
    episode: 8
    emotion: regular
    slug: error3
    minigame: 5
  - text: Encontramos!
    world: 4
    season: 1
    sound: ptbr_ep80_frn_41
    id: 8
    episode: 8
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Olhe, as lib\xE9lulas est\xE3o chegando!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_45
    id: 0
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "Tu j\xE1 voaste em uma lib\xE9lula? N\xE3o? Ent\xE3o te prepara, pois \xE9
      muito divertido!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_46
    id: 1
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "Guardi\xE3o! Que bom que tu chegaste! Ouviste nosso pedido de ajuda?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_01
    id: 2
    episode: 1
    emotion: happy
    slug: minigame1
    minigame: 
  - text: O dia do Festival da Primavera se aproxima, e acreditas que as fadas da
      Floresta Sempreverde desapareceram?
    world: 4
    season: 2
    sound: ptbr_ep81_frn_02
    id: 3
    episode: 1
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Sem elas, as flores jamais crescer\xE3o e, talvez, toda a floresta murche!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_03
    id: 4
    episode: 1
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Venha comigo. Explicarei nosso plano no caminho.
    world: 4
    season: 2
    sound: ptbr_ep81_frn_04
    id: 5
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "A Rainha das Formigas teme que, se as fadas se atrasarem, a Floresta Sempreverde
      n\xE3o dar\xE1 frutos, e todos os bichos da floresta ficar\xE3o sem ter o que
      comer!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_12
    id: 6
    episode: 1
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Acho que sei um jeito de cham\xE1-las de volta. V\xEA aquela placa adiante.
      Deve nos indicar o caminho correto."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_13
    id: 7
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Pois ent\xE3o, como eu estava a dizer, h\xE1 uma forma de garantir que
      as fadas retornem a tempo: a Harpa M\xE1gica. Lembra-te dela? Que fica escondida
      no Castelo dos Gigantes?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_20
    id: 8
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Esse t\xFAnel nos levar\xE1 at\xE9 perto do Castelo. Ali, mais placas.
      Alguma delas deve nos indicar o caminho."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_21
    id: 9
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Sei que o Castelo dos Gigantes \xE9 perigoso, mas... o que \xE9 aquilo
      no ch\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_29
    id: 10
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Veja, Guardi\xE3o! O Castelo dos Gigantes Adormecidos! Estamos quase l\xE1!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_36
    id: 11
    episode: 1
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "E, olhe, uma lib\xE9lula! Ela pode nos levar at\xE9 o Castelo."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_37
    id: 12
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Esta \xE9 a entrada do antigo ninho das Formigas Comilonas. A Rainha me
      falou pessoalmente deste lugar."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_05
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "As formigas costumavam abrir esta porta usando o peso certo de comidas
      coletadas da floresta. \xC9 s\xF3 colocar o peso certo no saco."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Se lembro bem, cada uva pesa 1, cada ma\xE7\xE3 pesa 5 e cada mam\xE3o
      pesa 10."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_07
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O desenho na parede \xE9 a pista. 8 uvas pesando 1 cada, d\xE1 8. E o resto?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_08
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: "\"Se cada ma\xE7\xE3 pesa 5 e temos 6 ma\xE7\xE3s, isso d\xE1... 5 mais
      5 s\xE3o 10, mais 5 s\xE3o 15... Temos que somar de 5 em 5... 6 vezes! E isso
      d\xE1 30. T\xEDnhamos 8 de uva e agora 30 de ma\xE7\xE3s... Qual vai ser o peso
      total disso e mais os 2 mam\xF5es?\""
    world: 4
    season: 2
    sound: ptbr_ep81_frn_09
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: "N\xE3o seria este? Somamos o peso 1 da uva 8 vezes. Depois o peso 5 da
      ma\xE7\xE3, 6 vezes. E mais 2 vezes o peso 10 do mam\xE3o. Assim, 8 mais 30
      mais 20 deu peso 58, concordas?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_10
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Funcionou! A porta est\xE1 se abrindo! Vamos."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_11
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 1
  - text: "A Rainha alertou-me que este t\xFAnel tem muitos perigos e, por isso, as
      formigas n\xE3o o usam mais."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_14
    id: 0
    episode: 1
    emotion: scared
    slug: intro
    minigame: 2
  - text: "H\xE1 algo de errado nesta mensagem, n\xE3o? Palavras juntas? Podes corrigi-la
      para que eu entenda?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_15
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Creio que ainda faltam espa\xE7os entre algumas palavras. Quais palavras?
      Que confus\xE3o! Vamos separar isso: \"Bem-vindos \xE0 Caverna dos Contr\xE1rios!\"...
      Mas ainda temos mais a separar, Guardi\xE3o!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_16
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Vamos ler a segunda frase em voz alta. Isso deve nos ajudar: Quem... entrar...
      aqui... Viste como funciona, Guardi\xE3o? O que ainda falta separar?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_17
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Acredito que estes s\xE3o todos os espa\xE7os que faltavam."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_18
    id: 4
    episode: 1
    emotion: happy
    slug: error3
    minigame: 2
  - text: "Que mensagem intrigante! Temos que tomar cuidado daqui para frente, pois
      temos que fazer tudo ao contr\xE1rio!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_19
    id: 5
    episode: 1
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Ora, mas... ser\xE1 que estas instru\xE7\xF5es est\xE3o corretas?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_22
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o! Lembra-te da placa anterior? Estas placas est\xE3o aqui para nos
      enganar! Quem poderia ter feito tamanha armadilha?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_23
    id: 1
    episode: 1
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Precisamos mudar o sentido das frases para entender o recado. Quais s\xE3o
      as palavras que invertem o sentido do que est\xE1 escrito?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_24
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "\xC9 tudo ao contr\xE1rio... A primeira placa diz: \"Pise nas pedras claras
      no ch\xE3o.\" Como sabemos que devemos inverter o sentido, pisaremos nas pedras
      escuras, n\xE3o \xE9 mesmo, Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_25
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Viste a pegadinha da segunda placa? Ela diz: \"Ande de forma veloz no t\xFAnel\".
      Imaginas isso? \xC9 claro que para ser o contr\xE1rio vamos escolher a palavra:
      LENTA - e n\xE3o a palavra feliz ou engra\xE7ada, n\xE3o \xE9?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_26
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: Agora falta apenas trocar esta aqui... vejamos.
    world: 4
    season: 2
    sound: ptbr_ep81_frn_27
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Muito bom, Guardi\xE3o! Salvaste-nos de uma bela armadilha!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_28
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Algu\xE9m deixou cair este envelope! Parece um alerta de um antigo aventureiro!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_30
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Monte as fotografias enquanto leio o que diz aqui. \"Aviso aos aventureiros:
      Fique atento \xE0s armadilhas, ou\xE7a antes de abrir uma porta, e cuidado com
      os monstros!\""
    world: 4
    season: 2
    sound: ptbr_ep81_frn_31
    id: 1
    episode: 1
    emotion: scared
    slug: intro
    minigame: 4
  - text: "Deixe-me reler a carta. \"Aviso aos aventureiros: Fique atento \xE0s armadilhas,
      ou\xE7a antes de abrir uma porta, e cuidado com os monstros!\""
    world: 4
    season: 2
    sound: ptbr_ep81_frn_32
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Jamais caia em uma armadilha, nunca abra uma porta sem ouvir o que tem
      do outro lado e, \xE9 claro, fique longe dos monstros."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_33
    id: 3
    episode: 1
    emotion: scared
    slug: error2
    minigame: 4
  - text: E se descartarmos estas outras? Seria isto?
    world: 4
    season: 2
    sound: ptbr_ep81_frn_34
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 4
  - text: "\xD3timo trabalho! Gostaria de poder agradecer ao aventureiro que nos deixou
      este alerta!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_35
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Enquanto nossa amiguinha chama companheiras para nos levar, poder\xEDamos
      fazer algo pela floresta, n\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_38
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Mas o que ter\xEDamos tempo de fazer antes da chegada das lib\xE9lulas?"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_39
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos colocar na ordem do que \xE9 mais r\xE1pido at\xE9 o mais demorado
      de fazer entre regar uma planta, colher muitas frutas para a viagem, ou esperar
      uma \xE1rvore crescer."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_40
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Tu tens certeza de que esta \xE9 a ordem certa? Creio que regar uma planta
      \xE9 a mais r\xE1pida dessas a\xE7\xF5es."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_41
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Se regar as plantas \xE9 a mais r\xE1pida, qual \xE9 a mais demorada? \xC9
      s\xF3 coloc\xE1-las na ordem crescente de demora."
    world: 4
    season: 2
    sound: ptbr_ep81_frn_42
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Regar \xE9 r\xE1pido, colher frutas \xE9 mais ou menos, mas plantar e esperar
      uma \xE1rvore crescer... Isso sim leva tempo!"
    world: 4
    season: 2
    sound: ptbr_ep81_frn_43
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 5
  - text: Pelo menos temos tempo de regar esta plantinha e colher algumas frutas para
      a viagem!
    world: 4
    season: 2
    sound: ptbr_ep81_frn_44
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Chegamos \xE0 janela! Consegue ouvir este barulho? \xC9 o ronco dos gigantes!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_38
    id: 0
    episode: 2
    emotion: scared
    slug: final
    minigame: 
  - text: "Agora \xE9 apenas uma quest\xE3o de pegar a Harpa M\xE1gica emprestada
      e salvar a Floresta Sempreverde! Vamos?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_39
    id: 1
    episode: 2
    emotion: happy
    slug: final
    minigame: 
  - text: "O que achas de voar em lib\xE9lulas, Guardi\xE3o? N\xE3o \xE9 emocionante?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_01
    id: 2
    episode: 2
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "\xC9 um dos motivos pelo qual me tornei cavaleiro! ... Depois de proteger
      os inocentes, \xE9 claro!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_02
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Logo estaremos no castelo e, ent\xE3o, pegaremos a Harpa M\xE1gica."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_03
    id: 4
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Aproxima-te. Vamos planejar como chegar at\xE9 o castelo."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_04
    id: 5
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Daqui do alto podemos ver perfeitamente todo o Sonho. V\xEAs no mapa os
      rios e as estradas? S\xE3o iguais \xE0s vistas daqui de cima!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_10
    id: 6
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Parece-me que o caminho \xE9 cheio de grandes \xE1rvores e pedras. Precisaremos
      manobrar para n\xE3o nos chocarmos com elas."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_11
    id: 7
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Chegamos! Precisamos deixar as lib\xE9lulas descansarem. Foi uma aventura
      e tanto para elas tamb\xE9m!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_15
    id: 8
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Agora, como alcan\xE7ar a janela do castelo? Ora, claro! Usando uma semente
      m\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_16
    id: 9
    episode: 2
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "A planta cresceu r\xE1pido mesmo! Nem tive tempo de beber \xE1gua!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_26
    id: 10
    episode: 2
    emotion: happy
    slug: minigame4
    minigame: 
  - text: "Pronto? Acho que n\xE3o encontraremos problemas dentro do castelo, mas
      \xE9 bom estarmos preparados!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_32
    id: 11
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Podemos subir agora. Guardi\xF5es primeiro."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_33
    id: 12
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vejamos o que eu tenho em minha bolsa. Deve haver algo de \xFAtil."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_05
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O que podemos usar aqui para encontrarmos nosso caminho at\xE9 o Castelo
      dos Gigantes?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Creio que \xE9 de um mapa que precisamos."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_07
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Creio que \xE9 de um mapa que precisamos."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_07
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 1
  - text: Seria este o mapa?
    world: 4
    season: 2
    sound: ptbr_ep82_frn_08
    id: 4
    episode: 2
    emotion: regular
    slug: error3
    minigame: 1
  - text: Pois bem. Segundo este mapa, estamos no caminho certo!
    world: 4
    season: 2
    sound: ptbr_ep82_frn_09
    id: 5
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Segue a estrada. \xC9 a linha marrom que vemos l\xE1 embaixo. E cuidado
      com os obst\xE1culos!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_12
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: Cuidado!
    world: 4
    season: 2
    sound: ptbr_ep82_frn_13
    id: 1
    episode: 2
    emotion: scared
    slug: error1
    minigame: 2
  - text: Conseguimos! Tu podias ser um cavaleiro voador como eu!
    world: 4
    season: 2
    sound: ptbr_ep82_frn_14
    id: 2
    episode: 2
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Esta semente me foi dada pela Rainha das Formigas e devemos us\xE1-la para
      alcan\xE7ar lugares distantes."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_17
    id: 0
    episode: 2
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Vou plant\xE1-la aqui, sob a janela do castelo. \xC9 certo que ela nos
      levar\xE1 at\xE9 o topo!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_18
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Mas precisamos de \xE1gua para reg\xE1-la. Ser\xE1 que podemos usar o encanamento
      do banheiro dos gigantes? O que me dizes?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_19
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Os canos t\xEAm que estar interligados para que a \xE1gua possa chegar
      ao chuveiro."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_20
    id: 3
    episode: 2
    emotion: regular
    slug: pipeMinigameError1
    minigame: 3
  - text: "Acho que ainda tem uma conex\xE3o faltando... vamos dar uma revisada?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_21
    id: 4
    episode: 2
    emotion: regular
    slug: pipeMinigameError2
    minigame: 3
  - text: "N\xE3o queremos dar um banho completo na semente... ela precisa apenas
      de \xE1gua!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_23
    id: 5
    episode: 2
    emotion: regular
    slug: faucetMinigameError1
    minigame: 3
  - text: Vamos tentar outro registro?
    world: 4
    season: 2
    sound: ptbr_ep82_frn_24
    id: 6
    episode: 2
    emotion: regular
    slug: faucetMinigameError2
    minigame: 3
  - text: "Com esta \xE1gua, a semente m\xE1gica crescer\xE1 num instante!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_25
    id: 7
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: Excelente! Agora precisamos abrir o registro correto!
    world: 4
    season: 2
    sound: ptbr_ep82_frn_22
    id: 8
    episode: 2
    emotion: happy
    slug: pipeMinigameCompleted
    minigame: 3
  - text: "A subida ser\xE1 cansativa. Vamos beber alguma coisa antes de subir?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_27
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Precisamos encontrar uma boa fonte de \xE1gua pot\xE1vel. N\xE3o podemos
      beber qualquer \xE1gua, certo?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_28
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Esta \xE1gua n\xE3o me parece muito saud\xE1vel. Ela pode nos deixar doentes."
    world: 4
    season: 2
    sound: ptbr_ep82_frn_29
    id: 2
    episode: 2
    emotion: scared
    slug: error1
    minigame: 4
  - text: "Em uma floresta ou bosque, a melhor op\xE7\xE3o \xE9 sempre \xE1gua corrente,
      sem poluentes!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_30
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ah, esta \xE1gua \xE9 excelente! Fresca e sem gosto ruim!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_31
    id: 4
    episode: 2
    emotion: happy
    slug: victory
    minigame: 4
  - text: "\xC9 impress\xE3o minha ou aquela folha se mexeu?"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_34
    id: 0
    episode: 2
    emotion: scared
    slug: intro
    minigame: 5
  - text: "\xC9, mexeu-se, sim! Olhe, \xE9 um inseto escondido na planta! Impressionante!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_35
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ser\xE1 que h\xE1 mais animais escondidos na planta? Acho melhor encontrarmos
      para n\xE3o pisar neles acidentalmente!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_36
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: Olha o sapo ali!
    world: 4
    season: 2
    sound: ptbr_extep82_frn_01
    id: 3
    episode: 2
    emotion: scared
    slug: error1
    minigame: 5
  - text: "Dizem que grilos verdes trazem sorte! Cuidado para n\xE3o esmagar o coitado."
    world: 4
    season: 2
    sound: ptbr_extep82_frn_02
    id: 4
    episode: 2
    emotion: scared
    slug: error2
    minigame: 5
  - text: Olha o besouro no caminho!
    world: 4
    season: 2
    sound: ptbr_extep82_frn_03
    id: 5
    episode: 2
    emotion: scared
    slug: error3
    minigame: 5
  - text: "Estamos quase chegando, mas n\xE3o tire os olhos dos bichos estranhos!"
    world: 4
    season: 2
    sound: ptbr_extep82_frn_04
    id: 6
    episode: 2
    emotion: scared
    slug: error4
    minigame: 5
  - text: "Isso a\xED parece, mas n\xE3o \xE9 um galho..."
    world: 4
    season: 2
    sound: ptbr_extep82_frn_05
    id: 7
    episode: 2
    emotion: regular
    slug: error5
    minigame: 5
  - text: Puxa... ainda bem tu conseguiste ver o sapo! Deve ter mais no caminho...
    world: 4
    season: 2
    sound: ptbr_extep82_frn_06
    id: 8
    episode: 2
    emotion: scared
    slug: bug1
    minigame: 5
  - text: "Esta subida est\xE1 movimentada, n\xE3o? Um sapo, um grilo... o que vai
      aparecer depois?"
    world: 4
    season: 2
    sound: ptbr_extep82_frn_07
    id: 9
    episode: 2
    emotion: regular
    slug: bug2
    minigame: 5
  - text: Esse besouro estava bem escondido, hein?
    world: 4
    season: 2
    sound: ptbr_extep82_frn_08
    id: 10
    episode: 2
    emotion: happy
    slug: bug3
    minigame: 5
  - text: "Esse a\xED \xE9 esquisito, n\xE3o \xE9? Ainda bem que \xE9 inofensivo..."
    world: 4
    season: 2
    sound: ptbr_extep82_frn_09
    id: 11
    episode: 2
    emotion: regular
    slug: bug4
    minigame: 5
  - text: "Esse louva-a-deus engana a gente direitinho se passando por um galho, n\xE3o
      \xE9?"
    world: 4
    season: 2
    sound: ptbr_extep82_frn_10
    id: 12
    episode: 2
    emotion: regular
    slug: bug5
    minigame: 5
  - text: "Muito legal, n\xE3o? Estes animais copiam o ambiente para se camuflar.
      Assim ningu\xE9m os encontra mesmo!"
    world: 4
    season: 2
    sound: ptbr_ep82_frn_37
    id: 13
    episode: 2
    emotion: happy
    slug: victory
    minigame: 5
  - text: Precisamos retornar o quanto antes para a Floresta Sempreverde para usar
      a harpa e chamar as fadas de volta!
    world: 4
    season: 2
    sound: ptbr_ep83_frn_57
    id: 0
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: Ih, o gigante rolou para o meio do caminho! Acho que teremos que procurar
      outro caminho para sair do castelo.
    world: 4
    season: 2
    sound: ptbr_ep83_frn_58
    id: 1
    episode: 3
    emotion: scared
    slug: final
    minigame: 
  - text: "Vamos, Guardi\xE3o, n\xE3o podemos perder tempo. As fadas nos aguardam!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_59
    id: 2
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: "Consegues ver a Harpa M\xE1gica daqui? N\xE3o falta muito para salvarmos
      a floresta!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_01
    id: 3
    episode: 3
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Antes de tua chegada juntei alguns objetos que podem ser \xFAteis para
      n\xF3s."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_02
    id: 4
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "At\xE9 aprendi a usar esta sua m\xE1gica que chamas de tecnologia para
      montar um plano."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_03
    id: 5
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Aqui. V\xEA o plano que criei neste papel m\xE1gico que n\xE3o usa borracha."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_04
    id: 6
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Muito bem. Precisamos de muitas pe\xE7as para meu plano dar certo."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_11
    id: 7
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Acho que aquela estante tem os itens que necessito, mas preciso de sua
      ajuda para alcan\xE7\xE1-los."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_12
    id: 8
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Acho que encontramos coisas o suficiente para que meu plano funcione.
    world: 4
    season: 2
    sound: ptbr_ep83_frn_23
    id: 9
    episode: 3
    emotion: happy
    slug: minigame3
    minigame: 
  - text: Disse que estou aprendendo a usar sua "tecnologia." Sabe como? Encontrei
      isso!
    world: 4
    season: 2
    sound: ptbr_ep83_frn_24
    id: 10
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Agora \xE9 s\xF3 seguir o manual e montar o bra\xE7o rob\xF4!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_32
    id: 11
    episode: 3
    emotion: happy
    slug: minigame4
    minigame: 
  - text: "Pensemos nisso depois! Com o bra\xE7o rob\xF4 no lugar, \xE9 s\xF3 pegarmos
      a Harpa M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_47
    id: 12
    episode: 3
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Devo concordar que tua magia n\xE3o \xE9 de todo terr\xEDvel. At\xE9 diverti-me
      deveras com um destes jogos de plantar em uma fazenda!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_05
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: Podes encontrar o arquivo com o plano para mim? Enquanto isso, pegarei a
      corda para descermos.
    world: 4
    season: 2
    sound: ptbr_ep83_frn_06
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Os arquivos est\xE3o em ordem alfab\xE9tica. Procure pelo plano, com 'P'."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_07
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 1
  - text: O plano deve estar entre o L e o R.
    world: 4
    season: 2
    sound: ptbr_ep83_frn_08
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "N\xE3o est\xE1 a\xED? Deixe-me ver."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_09
    id: 4
    episode: 3
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Aqui est\xE1! Tua magia \xE9 confusa, mas maravilhosa."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_10
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 1
  - text: Esta corda parece firme o suficiente para suportar meu peso.
    world: 4
    season: 2
    sound: ptbr_ep83_frn_13
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Preciso que tu coloques estas pedras aqui para fazer peso e me levantar,
      uma prateleira por vez. Vamos come\xE7ar com 18 pedras."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_14
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "S\xE3o 18 pedras no total. Podes misturar pedras soltas ou juntas em saquinhos."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_15
    id: 2
    episode: 3
    emotion: regular
    slug: error_1_1
    minigame: 2
  - text: "Creio que estas aqui s\xE3o suficientes: tr\xEAs saquinhos com 5 pedras
      cada um e mais 3 pedras soltas."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_16
    id: 3
    episode: 3
    emotion: happy
    slug: error_1_2
    minigame: 2
  - text: "S\xE3o 24 pedras no total. Tu podes peg\xE1-las uma a uma, ou combinando
      a quantidade dos saquinhos com as separadas, at\xE9 chegar a 24 pedras."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_17
    id: 4
    episode: 3
    emotion: regular
    slug: error_2_1
    minigame: 2
  - text: "V\xEA se n\xE3o \xE9 a quantidade certa: 2 sacos de 10, e quatro pedrinhas
      soltas! Isso d\xE1 um total de 24!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_18
    id: 5
    episode: 3
    emotion: regular
    slug: error_2_2
    minigame: 2
  - text: "Acho que com esta quantidade de pedras eu n\xE3o chego \xE0 prateleira
      certa... lembra-te que s\xE3o 39 pedras."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_20
    id: 6
    episode: 3
    emotion: regular
    slug: error_3_1
    minigame: 2
  - text: Tente aquelas pedras ali.
    world: 4
    season: 2
    sound: ptbr_ep83_frn_21
    id: 7
    episode: 3
    emotion: regular
    slug: error_3_2
    minigame: 2
  - text: "Muito bom, Guardi\xE3o! Acho que j\xE1 temos o necess\xE1rio!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_22
    id: 8
    episode: 3
    emotion: happy
    slug: victory
    minigame: 2
  - text: "H\xE1 alguns objetos \xFAteis aqui! Podemos us\xE1-los depois. Guardi\xE3o,
      agora \xE9 preciso ter no total 24 pedras para que eu alcance a outra prateleira."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_17a
    id: 9
    episode: 3
    emotion: happy
    slug: intro2
    minigame: 2
  - text: "Mais coisas \xFAteis! Agora para a terceira prateleira ser\xE3o 39 pedras
      no total."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_19
    id: 10
    episode: 3
    emotion: happy
    slug: intro3
    minigame: 2
  - text: "\xC9 um manual para construir um rob\xF4! O Senhor Sombrio, aquele vil\xE3o,
      deve t\xEA-lo perdido aqui na \xFAltima vez que assolou nosso sonho!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_25
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ele nos ajudar\xE1 a montar um bra\xE7o rob\xF4 para alcan\xE7ar a harpa.
      Olhe aqui."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_26
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Oh, n\xE3o! As p\xE1ginas do livro est\xE3o rasgadas! Por favor, Guardi\xE3o,
      ajuda-me a juntar as partes certas do manual!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_27
    id: 2
    episode: 3
    emotion: sad
    slug: intro
    minigame: 3
  - text: "Isso n\xE3o parece trecho do manual. Vamos examinar cada peda\xE7o... \"E
      ent\xE3o eu salvei a princesa...\" Epa! Isso \xE9 outra hist\xF3ria. Sinto muito
      por confundi-lo, Guardi\xE3o. H\xE1 outros peda\xE7os misturados aqui."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_28
    id: 3
    episode: 3
    emotion: scared
    slug: error1
    minigame: 3
  - text: "Ainda est\xE1 confuso. O trecho \"... e a baleia n\xE3o quis voar\" tamb\xE9m
      parece n\xE3o fazer parte do manual. Ser\xE1 que conseguiremos mont\xE1-lo?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_29
    id: 4
    episode: 3
    emotion: sad
    slug: error2
    minigame: 3
  - text: "Ah, creio que compreendi agora! S\xE3o estes os peda\xE7os! Uma lista de
      materiais necess\xE1rios e uma ilustra\xE7\xE3o de como junt\xE1-los."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_30
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Perfeito! O manual est\xE1 pronto! Imagine se n\xE3o consegu\xEDssemos..."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_31
    id: 6
    episode: 3
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Por favor, l\xEA o manual e passe-me as pe\xE7as na ordem que est\xE1 ali,
      pode ser?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_33
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Isso n\xE3o se parece muito com uma engrenagem, Guardi\xE3o. Aqui est\xE1,
      uma engrenagem. Esse ch\xE3o cheio de obejtos nos confunde, n\xE3o \xE9 mesmo?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_35a
    id: 1
    episode: 3
    emotion: regular
    slug: porcas_mismatch
    minigame: 4
  - text: Excelente!
    world: 4
    season: 2
    sound: ptbr_ep83_frn_34
    id: 2
    episode: 3
    emotion: regular
    slug: porcas_success
    minigame: 4
  - text: "Por favor, tenha a gentileza de me alcan\xE7ar o pr\xF3ximo item do manual.
      O que vem logo abaixo de \"Engrenagem\"."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_35b
    id: 3
    episode: 3
    emotion: regular
    slug: request_parafusos
    minigame: 4
  - text: "Ali est\xE3o os parafusos! Vamos prosseguir, porque a Harpa est\xE1 \xE0
      nossa espera, Guardi\xE3o!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_37
    id: 4
    episode: 3
    emotion: happy
    slug: parafusos_mismatch
    minigame: 4
  - text: "Muito bom! Nosso plano come\xE7a a tomar forma!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_36a
    id: 5
    episode: 3
    emotion: happy
    slug: parafusos_success
    minigame: 4
  - text: "O manual est\xE1 a\xED contigo... Poderias pegar para mim o item logo abaixo
      dos \"Parafusos\"?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_36b
    id: 6
    episode: 3
    emotion: regular
    slug: request_hastes
    minigame: 4
  - text: "Hastes s\xE3o estas coisas compridas, v\xEA? Come\xE7amos com engrenagem,
      passamos pelos parafusos e encontramos as hastes."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_39
    id: 7
    episode: 3
    emotion: regular
    slug: hastes_mismatch
    minigame: 4
  - text: "Essas maravilhosas hastes de metal s\xE3o perfeitas! Grande trabalho, Guardi\xE3o,
      mas ainda temos coisas a encontrar..."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_38a
    id: 8
    episode: 3
    emotion: happy
    slug: hastes_success
    minigame: 4
  - text: "Vamos ver o que pegamos at\xE9 agora: engrenagem, parafusos e hastes de
      metal. O que vem a seguir?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_38b
    id: 9
    episode: 3
    emotion: regular
    slug: request_garra
    minigame: 4
  - text: "Isso n\xE3o \xE9 uma garra. Ela est\xE1 ali. Com esta garra podemos pegar
      a Harpa sem sustos!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_41a
    id: 10
    episode: 3
    emotion: regular
    slug: garra_mismatch
    minigame: 4
  - text: "Fant\xE1stico! Com esta garra, poderemos pegar qualquer coisa com firmeza."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_40
    id: 11
    episode: 3
    emotion: happy
    slug: garra_success
    minigame: 4
  - text: "Estamos quase l\xE1. O que vem logo abaixo da garra?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_41b
    id: 12
    episode: 3
    emotion: regular
    slug: request_mola
    minigame: 4
  - text: "Precisamos dar um impulso na garra, Guardi\xE3o. A mola est\xE1 logo ali.
      Estamos indo muito bem, e s\xF3 falta mais um item do manual."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_43a
    id: 13
    episode: 3
    emotion: regular
    slug: mola_mismatch
    minigame: 4
  - text: "Ora, molas! Adoro o barulho que elas fazem! \xC9 engra\xE7ado. Mas vamos
      voltar ao manual, porque precisamos apenas de mais um item, o \xFAltimo!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_42
    id: 14
    episode: 3
    emotion: happy
    slug: mola_success
    minigame: 4
  - text: "O \xFAltimo da lista! Por favor, alcance-o para que eu possa montar o bra\xE7o
      mec\xE2nico."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_43b
    id: 15
    episode: 3
    emotion: regular
    slug: request_controle
    minigame: 4
  - text: "E o que faltava... um controle remoto! Agora, sim, Guardi\xE3o. Vamos pegar
      a Harpa M\xE1gica e lev\xE1-la de volta ao seu lugar? Conto com tua ajuda, como
      sempre!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_45
    id: 16
    episode: 3
    emotion: happy
    slug: controle_mismatch
    minigame: 4
  - text: "Como tu sabes das coisas, Guardi\xE3o! N\xE3o ter\xEDamos como controlar
      o bra\xE7o mec\xE2nico sem um controle remoto!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_44
    id: 17
    episode: 3
    emotion: happy
    slug: controle_success
    minigame: 4
  - text: "Harpa m\xE1gica, a\xED vamos n\xF3s!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_46
    id: 18
    episode: 3
    emotion: happy
    slug: victory
    minigame: 4
  - text: "N\xE3o consigo enxergar a Harpa M\xE1gica daqui! Como poderei peg\xE1-la
      com o bra\xE7o?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_48
    id: 0
    episode: 3
    emotion: sad
    slug: intro
    minigame: 5
  - text: "Tenho uma ideia! Tu olhas de longe e me passas os comandos do bra\xE7o
      rob\xF4. O que achas?"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_49
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Est\xE1 vendo este controle? Use-o para me dizer o que devo fazer com o
      bra\xE7o para alcan\xE7ar a Harpa M\xE1gica. E cuidado para n\xE3o esbarrar
      em nada! Primeiro, v\xE1 para a frente."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_50
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Cuidado! Se esbarrarmos em alguma coisa, os gigantes poder\xE3o acordar!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_51
    id: 3
    episode: 3
    emotion: scared
    slug: error0
    minigame: 5
  - text: Excelente! Agora, novamente, siga em frente.
    world: 4
    season: 2
    sound: ptbr_ep83_frn_52
    id: 4
    episode: 3
    emotion: regular
    slug: request1
    minigame: 5
  - text: "Opa! Um movimento em falso e o bra\xE7o pode quebrar!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_53
    id: 5
    episode: 3
    emotion: scared
    slug: error1
    minigame: 5
  - text: "Estamos quase l\xE1! \xC9 s\xF3 virar \xE0 direita e..."
    world: 4
    season: 2
    sound: ptbr_ep83_frn_54
    id: 6
    episode: 3
    emotion: regular
    slug: request2
    minigame: 5
  - text: "Cuidado! Eu disse direita! N\xE3o podemos, em vez da harpa, pegar o nariz
      de um gigante e acord\xE1-lo!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_55
    id: 7
    episode: 3
    emotion: scared
    slug: error2
    minigame: 5
  - text: "Conseguimos! Pegamos a Harpa M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep83_frn_56
    id: 8
    episode: 3
    emotion: happy
    slug: victory
    minigame: 5
  - text: Ele foi embora? Ele foi embora!
    world: 4
    season: 2
    sound: ptbr_ep84_frn_42
    id: 0
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "Espero que ele n\xE3o pense mal de mim... me assustei! N\xE3o sabia que
      gigantes eram t\xE3o... gigantes!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_43
    id: 1
    episode: 4
    emotion: scared
    slug: final
    minigame: 
  - text: "Se n\xE3o te importas, acho que devemos seguir viagem. Estamos quase de
      volta e n\xE3o quero correr o risco de atrair mais gigantes!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_44
    id: 2
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "Pena que n\xE3o poderemos pedir ajuda \xE0s lib\xE9lulas, seja l\xE1 onde
      elas estiverem!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_02
    id: 3
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas, tudo bem, a jornada de volta ser\xE1 prazerosa e divertida!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_03
    id: 4
    episode: 4
    emotion: happy
    slug: minigame1
    minigame: 
  - text: Opa! Que desastrado! Deixei cair minhas coisas!
    world: 4
    season: 2
    sound: ptbr_ep84_frn_04
    id: 5
    episode: 4
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Sabes que o caminho n\xE3o parece t\xE3o f\xE1cil daqui debaixo? Acho que
      precisaremos de ajuda."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_11
    id: 6
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ah, e se montarmos uma fogueira? Posso enviar um sinal de fuma\xE7a!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_12
    id: 7
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "At\xE9 que este caminho de volta pelas montanhas \xE9 bem tranquilo, n\xE3o?
      Pena que \xE9 t\xE3o longo e cansativo!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_18
    id: 8
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Vamos parar para descansar as pernas. Ali parece um bom lugar.
    world: 4
    season: 2
    sound: ptbr_ep84_frn_19
    id: 9
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Que som foi este? Ouviste algo?
    world: 4
    season: 2
    sound: ptbr_ep84_frn_26
    id: 10
    episode: 4
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "Ent\xE3o estamos seguindo viagem, concordas?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_33
    id: 11
    episode: 4
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "N\xE3o? O que ser\xE1 que o gigante ainda quer conosco?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_34
    id: 12
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Meu calend\xE1rio caiu e se desmontou todo! Preciso dele para meu treinamento
      com os cavaleiros voadores da Floresta!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_05
    id: 0
    episode: 4
    emotion: sad
    slug: intro
    minigame: 1
  - text: Podes ajudar-me a colocar as folhas em ordem?
    world: 4
    season: 2
    sound: ptbr_ep84_frn_06
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ufa! Tudo resolvido. Muito obrigado, Guardi\xE3o."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_10
    id: 2
    episode: 4
    emotion: happy
    slug: victory
    minigame: 1
  - text: "H\xE1 algo fora de ordem a\xED. Primeiro \xE9 janeiro, depois fevereiro,
      mar\xE7o..."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_07
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Depois de mar\xE7o, vem abril, maio e junho. O que mais?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_08
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Deixe-me colocar a Harpa M\xE1gica aqui no canto e ajud\xE1-lo."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_09
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Alguns duendes vivem nestas montanhas. Costumamos nos comunicar com eles
      por meio de sinais de fuma\xE7a."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_13
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Olhe! Eles est\xE3o responde... N\xE3o! O vento embaralhou a mensagem deles!
      Qual \xE9 a ordem certa?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_14
    id: 1
    episode: 4
    emotion: sad
    slug: intro
    minigame: 2
  - text: "Estes duendes montanheses s\xE3o t\xE3o amig\xE1veis! Obrigado!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_17
    id: 2
    episode: 4
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Tem algo estranho nesta mensagem. N\xE3o estou entendendo direito... Ao
      menos sabemos que aqui est\xE1 o in\xEDcio, porque eles me cumprimentam: \"Ol\xE1,
      Florin. Como tem passado?\""
    world: 4
    season: 2
    sound: ptbr_ep84_frn_15
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: "De repente, se tentarmos assim... A despedida tamb\xE9m est\xE1 clara:
      \"Abra\xE7os para voc\xEA e sua fam\xEDlia.\" Logo, o meio da mensagem s\xF3
      pode ser \"Para chegar \xE0s \xC1rvores do Sonho, contorne a montanha pela esquerda\"."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_16
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: "J\xE1 que vamos descansar, por que n\xE3o praticamos o uso da Harpa M\xE1gica?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_20
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Imagine se, na hora do Festival da Primavera, n\xF3s tocarmos a m\xFAsica
      errada e colocarmos todo mundo para dormir!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_21
    id: 1
    episode: 4
    emotion: sad
    slug: intro
    minigame: 3
  - text: "Esta \xE9 a letra da m\xFAsica, mas temos que escolher uma palavra para
      substituir a palavra SEMEADO na letra original... Qual delas se encaixa perfeitamente
      sem sobrar ou faltar som na m\xFAsica?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_22
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "\xC9 isso mesmo! At\xE9 que para um Guardi\xE3o tu n\xE3o \xE9s um mau
      cantor."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_25
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 3
  - text: "A palavra certa deve ter o mesmo n\xFAmero de s\xEDlabas que a palavra
      SEMEADO, que tem na m\xFAsica."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_23a
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Embora PERTURBADO, LAVADO e INCOMODADO terminem rimando, cada uma delas
      tem um n\xFAmero de s\xEDlabas diferente. Percebes, Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_23b
    id: 5
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Vejamos... Lendo por partes, percebemos que LA-VA-DO tem 3 s\xEDlabas.
      IN-CO-MO-DA-DO tem 5. Agora, SE-ME-A-DO e PER-TUR-BA-DO t\xEAm 4! \xC9 este
      o segredo!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_24
    id: 6
    episode: 4
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Um gigante! E acordado! E eu acho que n\xF3s acabamos por acord\xE1-lo!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_27
    id: 0
    episode: 4
    emotion: scared
    slug: intro
    minigame: 4
  - text: "Senhor gigante! Eu, tu, ele, n\xF3s... Estamos com a harpa porque... Guardi\xE3o,
      ajuda-me a falar com ele! Nunca vi um gigante desperto antes!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_28
    id: 1
    episode: 4
    emotion: scared
    slug: intro
    minigame: 4
  - text: "Isso! Isso que ele disse. Vamos salvar as \xE1rvores do sonho! Certo?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_32
    id: 2
    episode: 4
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Acho que ele quer que justifiquemos o fato de a harpa estar conosco! Olhe
      as bobagens que eu disse! Nunca estaria com ela porque meu t\xEAnis est\xE1
      desamarrado! Jamais! Ajude-me a esclarecer isto, amigo."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_29
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Ent\xE3o, nobre senhor gigante... n\xF3s estamos com a harpa... e... Claro
      que n\xE3o \xE9 porque gostamos de brincar. A harpa \xE9 para tocar e cantar,
      sabemos disso. Perdoe-nos a confus\xE3o, Senhor Gigant\xEDssimo!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_30
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 4
  - text: "O que eu falo, Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_31
    id: 5
    episode: 4
    emotion: scared
    slug: error3
    minigame: 4
  - text: "Ele est\xE1 desconfiado de nossa miss\xE3o! Que ultraje!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_35
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "V\xEAs, Guardi\xE3o, ele tem uma lista de quem vive na Floresta Sempreverde,
      dada pela Rainha Fada e pelo Rei Gigante antes de adormecerem."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_36
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ele quer saber exatamente quantos seres a Harpa M\xE1gica salvar\xE1. Sabemos
      que ser\xE3o apenas as Fadas e as \xC1rvores dos Sonhos, lembra-te?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_37
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "58 seres da floresta! Sem falar em todos os outros seres que n\xE3o teriam
      onde morar, \xE9 claro!"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_41
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Creio que ele se refere ao total de fadas e \xE1rvores na floresta. N\xE3o
      podemos deix\xE1-los de fora, mas tamb\xE9m n\xE3o podemos somar as centopeias,
      nem as formigas, nem o falc\xE3o..."
    world: 4
    season: 2
    sound: ptbr_ep84_frn_38
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: "S\xE3o 25 \xE1rvores mais 33 fadas. Quanto d\xE1 no total?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_39
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: "25 mais 33 d\xE1 quanto?"
    world: 4
    season: 2
    sound: ptbr_ep84_frn_40
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Olha, Guardi\xE3o! As fadas est\xE3o retornando! Elas devem ter ouvido
      nossa m\xFAsica."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_47
    id: 0
    episode: 5
    emotion: happy
    slug: final
    minigame: 
  - text: "E at\xE9 mesmo as \xE1rvores e as flores est\xE3o ficando mais fortes.
      Incr\xEDvel! E eu achando que nossa aventura ainda n\xE3o tinha terminado..."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_48
    id: 1
    episode: 5
    emotion: happy
    slug: final
    minigame: 
  - text: "Estamos de volta, Guardi\xE3o! Retornamos \xE0 Floresta Sempreverde! E
      com a Harpa M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_01
    id: 2
    episode: 5
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Precisamos preparar tudo para o Festival da Primavera, e ele n\xE3o pode
      acontecer sem um bom lugar de destaque para a Harpa."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_02
    id: 3
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Assim que tivermos tudo pronto, poderemos tocar a Harpa M\xE1gica e chamar
      as fadas de volta."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_03
    id: 4
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Olhe ali. Aquele parece um \xF3timo lugar para come\xE7armos."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_04
    id: 5
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Estou terminando um bilhete explicando que escrevemos atr\xE1s uma lista
      com tudo o que precisaremos para montar o pedestal adequadamente."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_11
    id: 6
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Vamos at\xE9 o senhor Zimmo, o mercador, para comprar com ele os materiais."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_12
    id: 7
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Assim que o senhor Zimmo separar tudo, vamos falar com meu tio Darin. Ele
      \xE9 o melhor marceneiro de toda esta floresta!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_19
    id: 8
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Acho que o mercador j\xE1 tem tudo separado. Vamos ver?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_20
    id: 9
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos at\xE9 meu tio Darin entregar-lhe o material."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_26
    id: 10
    episode: 5
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Est\xE1 pronto! Meu tio n\xE3o s\xF3 \xE9 muito bom, mas tamb\xE9m \xE9
      muito r\xE1pido!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_37
    id: 11
    episode: 5
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Vamos l\xE1 ver de perto!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_38
    id: 12
    episode: 5
    emotion: happy
    slug: minigame5
    minigame: 
  - text: O que tu achas de colocarmos um pedestal bem bonito e colorido aqui?
    world: 4
    season: 2
    sound: ptbr_ep85_frn_05
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "V\xEA o que podemos usar para deixar o pedestal colorido."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_06
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Perfeito! Este pedestal ficar\xE1 digno da Harpa M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_10
    id: 2
    episode: 5
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Acho que isso n\xE3o serve. Leia a descri\xE7\xE3o dos itens. Come\xE7ando
      l\xE1 de cima: MARTELO - serve para martelar os pregos. E o que estamos procurando
      deve servir para colorir, concordas?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_07
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O que precisamos \xE9 algo para pintar o pedestal, certo? Continuemos na
      listagem: PARAFUSO e PREGO tamb\xE9m t\xEAm fun\xE7\xF5es diferentes de pintura,
      confere? N\xE3o servem, ent\xE3o."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_08
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: "N\xE3o h\xE1 nenhuma tinta por a\xED? Ah, achei! Bem l\xE1 embaixo, no
      finalzinho!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_09
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Ol\xE1, senhor Zimmo. Precisamos destes materiais para produzir um bel\xEDssimo
      pedestal para o Festival!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_13
    id: 0
    episode: 5
    emotion: happy
    slug: intro
    minigame: 2
  - text: "Ora, o que h\xE1 de errado com o meu bilhete? Guardi\xE3o, acho que escrevi
      algo errado. Podes corrigir para mim? O senhor Zimmo \xE9 muito exigente e se
      recusa a ler os bilhetes se n\xE3o estiverem com a escrita toda certinha!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_14
    id: 1
    episode: 5
    emotion: sad
    slug: intro
    minigame: 2
  - text: Melhor agora, senhor Zimmo? Perfeito!
    world: 4
    season: 2
    sound: ptbr_ep85_frn_18
    id: 2
    episode: 5
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Examinaste bem, Guardi\xE3o? Ser\xE1 que n\xE3o faltam letras mai\xFAsculas?
      Lembrei agora que devia t\xEA-las usado para iniciar cada frase... Podes fazer
      isso, por favor?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_15
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Se n\xE3o me engano, os nomes tamb\xE9m s\xE3o escritos com iniciais mai\xFAsculas.
      Talvez por isso o senhor Zimmo tenha se ofendido - ser\xE1? Ajude-me, meu amigo
      Guardi\xE3o."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_16
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Ah, compreendi! Ent\xE3o o que faltam s\xE3o estes aqui?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_17
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Tudo pronto, senhor Zimmo? \xD3timo! Agora basta pagar pelos itens."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_21
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Precisamos passar tr\xEAs cheques para os ajudantes do Zimmo. Eu preencho
      o primeiro, de 17 folhas. Pode preencher os outros dois para mim? Um \xE9 de
      71 folhas e o outro \xE9 de 710 folhas."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_22
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Aqui est\xE3o, senhor Zimmo! Agrade\xE7a seus ajudantes pelo \xF3timo trabalho."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_25
    id: 2
    episode: 5
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Opa, ficou algo esquisito a\xED. Precisa do n\xFAmero em cima e do valor
      escrito embaixo. No \xFAltimo o valor era 710 e tu deverias preencher com \"setecentas
      e dez folhas\", certo?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_23
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Cuidado para n\xE3o se confundir com os n\xFAmeros! O outro era com o n\xFAmero
      71 e basta preencher com \"setenta e uma folhas\"... Prontinho!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_24
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Cuidado para n\xE3o se confundir com os n\xFAmeros! O outro era com o n\xFAmero
      71 e basta preencher com \"setenta e uma folhas\"... Prontinho!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_24
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Ol\xE1, tio! Pelo jeito o senhor j\xE1 se preparou para construir o pedestal!
      Temos algo para medir o tamanho das coisas?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_27
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Excelente! Temos um bel\xEDssimo pedestal para a Harpa M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_36
    id: 1
    episode: 5
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Opa, acho que isso n\xE3o serve."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_28
    id: 2
    episode: 5
    emotion: regular
    slug: error0_1
    minigame: 4
  - text: "Esta r\xE9gua parece perfeita para o servi\xE7o."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_29
    id: 3
    episode: 5
    emotion: regular
    slug: error0_2
    minigame: 4
  - text: E quanto ao peso? Precisamos ter certeza de que o pedestal aguenta a Harpa!
    world: 4
    season: 2
    sound: ptbr_ep85_frn_30
    id: 4
    episode: 5
    emotion: regular
    slug: nextItem1
    minigame: 4
  - text: "Acho que n\xE3o d\xE1 pra ver o peso com isso..."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_31
    id: 5
    episode: 5
    emotion: regular
    slug: error1_1
    minigame: 4
  - text: "O que precisamos, agora, \xE9 de uma balan\xE7a, como esta aqui."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_32
    id: 6
    episode: 5
    emotion: regular
    slug: error1_2
    minigame: 4
  - text: "Meu tio \xE9 meticuloso, e gosta de saber quanto tempo leva para fazer
      cada passo..."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_33
    id: 7
    episode: 5
    emotion: regular
    slug: nextItem2
    minigame: 4
  - text: O que precisamos para medir o tempo?
    world: 4
    season: 2
    sound: ptbr_ep85_frn_34
    id: 8
    episode: 5
    emotion: regular
    slug: error2_1
    minigame: 4
  - text: "Um cron\xF4metro como este vem bem a calhar."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_35
    id: 9
    episode: 5
    emotion: regular
    slug: error2_2
    minigame: 4
  - text: "Ficou lindo mesmo. Agora sim a Harpa M\xE1gica tem o lugar que merece para
      o Festival da Primavera!"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_39
    id: 0
    episode: 5
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Sabe o que falta agora? Tocar e cantar! Lembra-te da m\xFAsica que ensaiamos?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_40
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: Bom... eu acho que sei. Vamos tentar! Se eu errar, me avise, hein?
    world: 4
    season: 2
    sound: ptbr_ep85_frn_41
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Agora est\xE1 tudo certinho. Estou muito agradecido, meu nobre amigo."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_46
    id: 3
    episode: 5
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Soa-me muito estranho... Onde j\xE1 se viu alecrim assado! \xC9 dourado!
      Obrigado, Guardi\xE3o. Imagina se eu canto isso errado! Se quiser, canto de
      novo."
    world: 4
    season: 2
    sound: ptbr_ep85_frn_43
    id: 4
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Observas, Guardi\xE3o! Estou mesmo distra\xEDdo no canto! Cantei que o
      alecrim CRESCEU no mato - mas na letra da m\xFAsica est\xE1 escrito que ele
      NASCEU no mato... Que troca... Canto de novo?"
    world: 4
    season: 2
    sound: ptbr_ep85_frn_44
    id: 5
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: Entendi meu erro!
    world: 4
    season: 2
    sound: ptbr_ep85_frn_45
    id: 6
    episode: 5
    emotion: regular
    slug: error3
    minigame: 5
  - text: 
    world: 4
    season: 2
    sound: ptbr_ep85_frn_42
    id: 7
    episode: 5
    emotion: regular
    slug: song
    minigame: 5
  - text: "Uma passagem secreta! E certamente \xE9 para mais um esconderijo do Senhor
      Sombrio!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_40
    id: 0
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "N\xE3o nos resta alternativa se n\xE3o adentrarmos este covil e recuperarmos
      a Harpa M\xE1gica n\xF3s mesmos. Preparado? Ent\xE3o vamos l\xE1!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_41
    id: 1
    episode: 6
    emotion: scared
    slug: final
    minigame: 
  - text: "\xC9 t\xE3o bom saber que cumprimos nossa miss\xE3o, n\xE3o \xE9, Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_01
    id: 2
    episode: 6
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "As fadas retornaram, a floresta est\xE1 bem novamente... E falando nisso,
      por que ser\xE1 que as fadas desapareceram?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_02
    id: 3
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Bom, n\xE3o importa agora! O que importa \xE9 que o Festival da Primavera
      n\xE3o pode esperar!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_03
    id: 4
    episode: 6
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Pediram-nos que pendur\xE1ssemos alguns folhetos naquele mural. Podes ajudar-me?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_04
    id: 5
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Assim que o festival terminar precisamos retornar a Harpa M\xE1gica ao
      Castelo dos Gigantes. Pelo menos l\xE1 ela estar\xE1 segura!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_10
    id: 6
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Imaginas se... espere. Onde est\xE1 a Harpa M\xE1gica? Roubaram a Harpa
      M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_11
    id: 7
    episode: 6
    emotion: scared
    slug: minigame2
    minigame: 
  - text: Devemos convocar todos os habitantes da Floresta Sempreverde e avisar o
      que aconteceu.
    world: 4
    season: 2
    sound: ptbr_ep86_frn_17
    id: 8
    episode: 6
    emotion: scared
    slug: minigame3
    minigame: 
  - text: Vamos falar com as fadas.
    world: 4
    season: 2
    sound: ptbr_ep86_frn_18
    id: 9
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Uma \xE1guia avistou o Senhor Sombrio seguindo naquela dire\xE7\xE3o. Vamos
      at\xE9 l\xE1."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_26
    id: 10
    episode: 6
    emotion: happy
    slug: minigame4
    minigame: 
  - text: "Este \xE9 um lugar muito perigoso, cheio de predadores ferozes. Precisamos
      ficar alertas."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_31
    id: 11
    episode: 6
    emotion: scared
    slug: minigame5
    minigame: 
  - text: Fica atento para qualquer pista sobre o paradeiro do Senhor Sombrio.
    world: 4
    season: 2
    sound: ptbr_ep86_frn_32
    id: 12
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Durante o festival costumam-se colocar todos os tipos de textos no mural
      para quem quiser ler. S\xE3o poemas, receitas, not\xEDcias..."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_05
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Aqui est\xE3o os textos. Podes preg\xE1-los no lugar certo para mim?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_06
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Pronto! Agora vamos voltar para a festa. Meu est\xF4mago est\xE1 roncando
      de fome!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_09
    id: 2
    episode: 6
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Est\xE1 tudo no lugar certo? Acho melhor dares uma conferida... Not\xEDcias,
      normalmente, t\xEAm um t\xEDtulo e contam uma hist\xF3ria..."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_07
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Ser\xE1 que n\xE3o \xE9 assim que devem ficar? A receita, com seus ingredientes
      e suas quantidades; o convite, com data, hor\xE1rio e informa\xE7\xF5es sobre
      o evento; e a not\xEDcia, com seu t\xEDtulo e sua hist\xF3ria!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_08
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Oh, n\xE3o! Um bilhete do Senhor Sombrio! Diz que devemos entregar o Rubi
      de Fogo, o cora\xE7\xE3o do Sonho, ou ele destruir\xE1 a Harpa M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_12
    id: 0
    episode: 6
    emotion: sad
    slug: intro
    minigame: 2
  - text: "Ele diz no bilhete que temos at\xE9 s\xE1bado. Se hoje \xE9 ter\xE7a-feira,
      quantos dias temos at\xE9 s\xE1bado?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_13
    id: 1
    episode: 6
    emotion: scared
    slug: intro
    minigame: 2
  - text: Quatro dias! Precisamos fazer algo, e depressa!
    world: 4
    season: 2
    sound: ptbr_ep86_frn_16
    id: 2
    episode: 6
    emotion: scared
    slug: victory
    minigame: 2
  - text: "Espera! Vamos fazer esta conta com calma. Hoje, sendo 3\xAA-feira, falta
      1 dia para 4\xAA-feira, faltam 2 dias para 5\xAA-feira... Quantos dias faltam
      at\xE9 o s\xE1bado?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_14
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Sempre acho isso confuso... Vamos l\xE1: para 4\xAA-feira falta 1 dia;
      para 5\xAA-feira faltam 2 dias; para 6\xAA-feira ser\xE3o 3 dias e, por fim,
      at\xE9 s\xE1bado temos o prazo de 4 dias! T\xE3o pouco, n\xE3o \xE9 Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_15
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Guardi\xE3o, as fadas chamaram os animais da floresta para nos ajudar."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_19
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Elas acreditam que as aves poder\xE3o nos ajudar a encontrar o Senhor Sombrio."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_20
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Aqui est\xE1 uma lista de todos os animais que se ofereceram para ajudar.
      Vejamos quantas aves temos no total."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_21
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "163 aves! Certamente com todas essas aves ser\xE1 imposs\xEDvel o Senhor
      Sombrio se esconder."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_25
    id: 3
    episode: 6
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Tu n\xE3o contaste nenhum bicho que n\xE3o fosse ave e n\xE3o se esqueceu
      de nenhuma, n\xE3o \xE9?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_22
    id: 4
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Se vamos aceitar ajuda s\xF3 das aves, temos que somar apenas as 58 corujas,
      com os 101 can\xE1rios e as 4 \xE1guias, concordas, Guardi\xE3o? Fazes isso?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_23
    id: 5
    episode: 6
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Temos 58 corujas, 101 can\xE1rios e 4 \xE1guias..."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_24
    id: 6
    episode: 6
    emotion: regular
    slug: error3
    minigame: 3
  - text: Estes sujeitos podem ter visto alguma coisa. Viram o Senhor Sombrio em algum
      lugar?
    world: 4
    season: 2
    sound: ptbr_ep86_frn_27
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Um diz que o Senhor Sombrio n\xE3o foi para o Bosque Buc\xF3lico e outro
      diz que ele foi pelo caminho da esquerda. Opa, l\xEA naquele jornal ali! Qual
      dos dois est\xE1 certo?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_28
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O Senhor Sombrio foi na dire\xE7\xE3o da Selva Selvagem!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_30
    id: 2
    episode: 6
    emotion: regular
    slug: victory
    minigame: 4
  - text: Sabia que um deles estava nos enganando!
    world: 4
    season: 2
    sound: ptbr_ep86_frn_29
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 4
  - text: "O que tu encontraste a\xED, Guardi\xE3o? Uma fera selvagem?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_33
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Uma mensagem entalhada na \xE1rvore! Ora, s\xF3 algu\xE9m terr\xEDvel como
      o Senhor Sombrio maltrataria uma \xE1rvore deste jeito!"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_34
    id: 1
    episode: 6
    emotion: scared
    slug: intro
    minigame: 5
  - text: "Parece um tipo de charada ou senha... Ser\xE1 que conseguimos descobri-la?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_35
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Que frases estranhas! O guepardo guerreiro guiou Guilherme at\xE9 o guich\xEA
      para ver a guitarrista gulosa... A gata garbosa gostou da galera reunida para
      ver a girafa gulosa... Mas... o que \xE9 este barulho?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_39
    id: 3
    episode: 6
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Notaste uma coisa? Todas as palavras que faltam ser colocadas come\xE7am
      com a letra \"G\"? Mas achas que todas t\xEAm o mesmo som? Isso deve ser uma
      pista, n\xE3o achas, Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_36
    id: 4
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Que curioso! Algumas t\xEAm GU seguido de outra vogal, viste? A\xED o som
      fica bem diferente na hora de ler... Interessant\xEDssimo! Como GUITARRISTA,
      por exemplo, vamos coloc\xE1-la na frase do GUEPARDO GUERREIRO! Que tal?"
    world: 4
    season: 2
    sound: ptbr_ep86_frn_37
    id: 5
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: "N\xE3o funcionou... Vamos tentar assim."
    world: 4
    season: 2
    sound: ptbr_ep86_frn_38
    id: 6
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Terminamos de fechar a sa\xEDda do esconderijo. Duvido o Senhor Sombrio
      sair de l\xE1 t\xE3o cedo!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_41
    id: 0
    episode: 7
    emotion: happy
    slug: final
    minigame: 
  - text: "Precisamos voltar logo para a floresta. A festa n\xE3o pode seguir sem
      a harpa!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_42
    id: 1
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "O Senhor Sombrio vem atormentando o Mundo dos Sonhos h\xE1 muitos e muitos
      anos. Dizem que ele foi um inventor, um g\xEAnio, antes de... sabe-se l\xE1
      o que foi que aconteceu com ele."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_01
    id: 2
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Se ele pegar o Rubi de Fogo, ele ter\xE1 um poder ilimitado! N\xE3o podemos
      deixar o Rubi ou a Harpa M\xE1gica em suas m\xE3os."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_02
    id: 3
    episode: 7
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Precisamos tomar cuidado, pois este vil\xE3o sempre tem uma surpresa escondida
      nas mangas."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_03
    id: 4
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O que \xE9 aquela coisa ali? Um tipo de bola de cristal?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_04
    id: 5
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Tu encontraste algo? Uma imagem? Ser\xE1 uma pista?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_10
    id: 6
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Parece com aqueles quadros na parede, n\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_11
    id: 7
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Devemos sair imediatamente e retornar ao Festival da Primavera. S\xF3 resta..."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_17
    id: 8
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Est\xE1 ouvindo este barulho? Parecem rob\xF4s vindo da entrada! Precisamos
      encontrar outra sa\xEDda."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_18
    id: 9
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ora, mas \xE9 Trafa, a joaninha aventureira! Como ela veio parar aqui?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_26
    id: 10
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "N\xE3o podemos deixar que os rob\xF4s do Senhor Sombrio saiam do esconderijo!
      Precisamos fechar a sa\xEDda de alguma forma!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_33
    id: 11
    episode: 7
    emotion: scared
    slug: minigame5
    minigame: 
  - text: "Olhe, um ogro vendedor de bugigangas! V\xEA se ele tem algo de \xFAtil."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_34
    id: 12
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "C\xE2meras, tu dizes? Ent\xE3o cada uma tem uma imagem de algo que aconteceu?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_05
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O di\xE1rio do Senhor Sombrio! Mas parece dizer algo diferente do que h\xE1
      nos monitores. Qual sequ\xEAncia \xE9 a certa?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_06
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "\xC9 este mesmo. Tu \xE9s mais s\xE1bio na tecnologia do que eu, Guardi\xE3o.
      V\xEA o que descobres."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_09
    id: 2
    episode: 7
    emotion: regular
    slug: victory
    minigame: 1
  - text: "N\xE3o me parece ser este di\xE1rio. Mas certamente um dos monitores est\xE1
      com a sequ\xEAncia certa, descrita no di\xE1rio. Leste o que est\xE1 escrito,
      Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_07
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Creio que n\xE3o \xE9 este tamb\xE9m. Ent\xE3o s\xF3 pode ser este aqui:
      ele pega a harpa, depois segue o caminho da selva e, por fim, se esconde."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_08
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Tu cr\xEAs que esta imagem \xE9 de onde o Senhor Sombrio escondeu a Harpa
      M\xE1gica?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_12
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o sou t\xE3o s\xE1bio, Guardi\xE3o... Atr\xE1s de qual quadro o vil\xE3o
      ocultou a harpa? Observe em detalhes, porque s\xE3o bem parecidos. E cuidado,
      pois os outros dois podem ter armadilhas!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_13
    id: 1
    episode: 7
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Aqui est\xE1! Esse Senhor Sombrio n\xE3o \xE9 muito bom em esconder coisas,
      hein?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_16
    id: 2
    episode: 7
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Cuidado! Ouvi um som estranho. N\xE3o creio que seja este o quadro. Observas
      que este aqui tem uma abelhinha voando perto de um vaso s\xF3 de flores. E o
      que tu escolheste?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_14
    id: 3
    episode: 7
    emotion: scared
    slug: error1
    minigame: 2
  - text: "Opa! Ouvi o barulho de algo se armando. Afaste-se devagar... Vamos ver
      o \xFAltimo."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_15
    id: 4
    episode: 7
    emotion: scared
    slug: error2
    minigame: 2
  - text: "O que \xE9 este lugar? Ser\xE1 que o Senhor Sombrio se acha assim t\xE3o
      lindo?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_19
    id: 0
    episode: 7
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Os espelhos est\xE3o me dando dor de cabe\xE7a... \xC9 um tipo de feiti\xE7o?
      Estou... confuso..."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_20
    id: 1
    episode: 7
    emotion: sad
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, ajude-me! Quem \xE9s tu? Quem somos n\xF3s?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_21
    id: 2
    episode: 7
    emotion: scared
    slug: intro
    minigame: 3
  - text: Conseguimos! Maldito labirinto de espelhos! Vamos sair daqui antes que nos
      percamos novamente!
    world: 4
    season: 2
    sound: ptbr_ep87_frn_25
    id: 3
    episode: 7
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Tu precisas me ajudar a entender quem \xE9 quem aqui. Ela \xE9 a Harpa,
      certo? E ele \xE9 o Senhor Sombrio."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_22
    id: 4
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ser\xE1 que tu tamb\xE9m est\xE1s ficando confuso? Quando tu dizes 'eu'
      queres dizer \"tu\", o Guardi\xE3o, certo? \xC9... n\xF3s somos n\xF3s dois."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_23
    id: 5
    episode: 7
    emotion: scared
    slug: error2
    minigame: 3
  - text: Espere... acho que estou melhorando...
    world: 4
    season: 2
    sound: ptbr_ep87_frn_24
    id: 6
    episode: 7
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Calma, Trafa! N\xE3o fique nervosa! Vamos sair juntos daqui. Tu sabes onde
      est\xE1 a chave deste lugar?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_27
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o compreendo... Guardi\xE3o, entendes o que ela quer dizer?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_28
    id: 1
    episode: 7
    emotion: sad
    slug: intro
    minigame: 4
  - text: "\xC9 isso mesmo! Aqui est\xE1 a chave! Vamos sair daqui r\xE1pido!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_32
    id: 2
    episode: 7
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Vamos com calma: tu dizes que a chave est\xE1 naquela lin... S\xF3 pode
      ser LINDA, porque LINTO n\xE3o existe e as outras partes come\xE7am com P. E
      antes de P, a gente usa M, e n\xE3o N. Recordas deste detalhe, Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_29
    id: 3
    episode: 7
    emotion: sad
    slug: error1
    minigame: 4
  - text: "T\xEDnhamos acabado de lembrar que devemos usar a letra \"M\" antes do
      \"P\" e do \"B\", ent\xE3o, como aqui tem \"N\", s\xF3 pode ser CANTO. Foi moleza!
      O que falta, nobre amigo?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_30
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ser\xE1 que ela n\xE3o se refere \xE0quela arca ali no limpo canto da campana?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_31
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Ol\xE1, senhor Ogro! Precisamos de madeira, pregos e tudo mais para fechar
      uma porta. E r\xE1pido!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_35
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, eu vou at\xE9 l\xE1 com Trafa fechar a sa\xEDda. Podes pagar
      o Ogro? \xC9 s\xF3 somar o valor de tudo nesta lista e entregar a ele. Obrigado!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_36
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "... O custo total \xE9 de 18 folhas! Est\xE1 pago, senhor Ogro?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_40
    id: 2
    episode: 7
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Some tudo com calma. Lembre-se do valor de cada coisa. Por exemplo, cada
      prego pequeno custa 1 folha, ent\xE3o, se s\xE3o dois preguinhos, gastaremos,
      s\xF3 com eles, 2 folhas. E ainda falta todo o resto da lista!"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_37
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Dois pregos pequenos custam 2 folhas. Mais tr\xEAs pregos grandes, ao custo
      de 2 folhas cada um, d\xE3o 6 folhas. O valor j\xE1 est\xE1 em 8 folhas. O que
      mais?"
    world: 4
    season: 2
    sound: ptbr_ep87_frn_38
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "8 folhas \xE9 o valor at\xE9 agora. Mais 6 folhas das t\xE1buas, ao custo
      de 3 folhas por cada uma e 4 do martelo..."
    world: 4
    season: 2
    sound: ptbr_ep87_frn_39
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Acho que conseguimos mesmo, n\xE3o \xE9, Guardi\xE3o? Salvamos a floresta
      e o Sonho das \xC1rvores Encantadas."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_39
    id: 0
    episode: 8
    emotion: happy
    slug: final
    minigame: 
  - text: "E agora? Agora \xE9 s\xF3 festejar! Vamos dan\xE7ar!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_40
    id: 1
    episode: 8
    emotion: happy
    slug: final
    minigame: 
  - text: Estamos de volta! Ufa, esta foi por pouco!
    world: 4
    season: 2
    sound: ptbr_ep88_frn_01
    id: 2
    episode: 8
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "\xC9 por isso que as fadas deixam a Harpa M\xE1gica no Castelo dos Gigantes.
      O Senhor Sombrio n\xE3o teria coragem de ir at\xE9 l\xE1 sozinho!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_02
    id: 3
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "\xC9 isso! Ele deve ter escondido as fadas para que n\xF3s tir\xE1ssemos
      a Harpa M\xE1gica do castelo para que ele a roubasse!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_03
    id: 4
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Melhor continuarmos com nossos planos logo e, ent\xE3o, retornar a harpa!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_04
    id: 5
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Seria bom irmos r\xE1pido com os preparativos."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_11
    id: 6
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Venha, Guardi\xE3o. Precisamos pegar a comida para a festa!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_12
    id: 7
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ser\xE1 que com toda essa confus\xE3o todos sabem que o festival ainda
      vai acontecer?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_19
    id: 8
    episode: 8
    emotion: sad
    slug: minigame3
    minigame: 
  - text: Se tivesse uma forma de avisar a todos...
    world: 4
    season: 2
    sound: ptbr_ep88_frn_20
    id: 9
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Nossa, j\xE1 temos convidados chegando! Vamos receb\xEA-los."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_27
    id: 10
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Acredito que algumas pessoas est\xE3o com medo que o Senhor Sombrio retorne..."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_32
    id: 11
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: E se eu fizer um discurso explicando tudo?
    world: 4
    season: 2
    sound: ptbr_ep88_frn_33
    id: 12
    episode: 8
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Os habitantes da floresta anotaram aqui quando poder\xE3o participar da
      festa."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_05
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Em qual hor\xE1rio h\xE1 mais habitantes dispon\xEDveis?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_06
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: 14 horas parece uma boa escolha.
    world: 4
    season: 2
    sound: ptbr_ep88_frn_10
    id: 2
    episode: 8
    emotion: happy
    slug: victory
    minigame: 1
  - text: "N\xE3o me parece estar certo... V\xEA um hor\xE1rio onde h\xE1 mais convidados.
      \xC0s 13 horas, por exemplo, a festa seria um fiasco! Bem pouca gente compareceria,
      reparaste?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_07
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O tamanho da barra diz quantos convidados h\xE1 em cada hor\xE1rio. Se
      fizermos ao meio-dia, s\xF3 18 comparecer\xE3o. Melhor escolhermos outro..."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_08
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "N\xE3o seria \xE0s 14 horas? \xC9 a barra maior e mostra que 45 habitantes
      poder\xE3o ir."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_09
    id: 5
    episode: 8
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Sempre ajudo a servir a comida durante o Festival da Primavera. Sou \xF3timo
      nisso, sabias?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_13
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Quer ver como eu sirvo t\xE3o bem quanto monto uma lib\xE9lula? V\xEA quanto
      tempo eu levo para servir esta comida."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_14
    id: 1
    episode: 8
    emotion: happy
    slug: intro
    minigame: 2
  - text: "Acho que bati meu recorde do ano passado! 6 segundos \xE9 bem r\xE1pido!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_18
    id: 2
    episode: 8
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Opa, n\xE3o pode ser isso. Quanto tempo eu levei para servir? Tu observaste
      bem no cron\xF4metro? Se quero medir o tempo, n\xE3o posso usar METRO, que serve
      para medir o tamanho das coisas."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_15
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 2
  - text: "De jeito algum... Eu tenho um recorde \xF3timo. \xC9 bem pouco tempo! Ent\xE3o,
      estejas certo de que tamb\xE9m n\xE3o pode ser contagem de HORAS..."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_16
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "N\xE3o s\xE3o seis segundos, s\xE3o? S\xE3o, sim!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_17
    id: 5
    episode: 8
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Um convite? \xC9 uma \xF3tima ideia, Guardi\xE3o! Vou escrev\xEA-lo."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_21
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: Ficou grande demais! Vou reescrever. Espera um pouco.
    world: 4
    season: 2
    sound: ptbr_ep88_frn_22
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Bom, fiz tr\xEAs vers\xF5es do convite. Qual deles tu achas que ficou melhor?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_23
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 que este a\xED n\xE3o est\xE1 confuso? Acho que um dos outros dois
      passa melhor a ideia, n\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_24
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "E este \xFAltimo aqui? N\xE3o \xE9 melhor?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_25
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Tem todas as informa\xE7\xF5es importantes e de forma bem clara. V\xEA:
      \"Tu est\xE1s convidado para a festa na Floresta Sempreverde, \xE0s 14 horas,
      com buf\xEA. Chame teus amigos.\" Vou pedir para os can\xE1rios entregarem tudo
      o mais r\xE1pido poss\xEDvel!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_26
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Ol\xE1, eu... Opa, acho que interrompemos uma conversa!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_28
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O que diziam elas, Guardi\xE3o?"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_29
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\xC9 isso! As fadas est\xE3o felizes com a volta da Harpa M\xE1gica!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_31
    id: 2
    episode: 8
    emotion: regular
    slug: victory
    minigame: 4
  - text: "\xC9 claro que \"tu est\xE1s bonito, Florin\" n\xE3o \xE9 o que elas falam.
      Elas tamb\xE9m n\xE3o querem o Senhor Sombrio aqui."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_30
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: "\xC9 claro que \"tu est\xE1s bonito, Florin\" n\xE3o \xE9 o que elas falam.
      Elas tamb\xE9m n\xE3o querem o Senhor Sombrio aqui."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_30
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Temo que essa confus\xE3o toda estrague a festa."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_34
    id: 0
    episode: 8
    emotion: sad
    slug: intro
    minigame: 5
  - text: Podes me ajudar a rever meu discurso e corrigi-lo?
    world: 4
    season: 2
    sound: ptbr_ep88_frn_35
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Algo ainda n\xE3o est\xE1 legal no texto. Podes ver o que \xE9? Come\xE7o
      esclarecendo que s\xF3 consegui recuperar a harpa porque tu estavas junto comigo..."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_36
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: "E h\xE1 isto aqui tamb\xE9m, certo? Nosso desejo \xE9 mesmo que o Senhor
      Sombrio e sua gangue n\xE3o voltem mais!"
    world: 4
    season: 2
    sound: ptbr_ep88_frn_37
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Bom, l\xE1 vamos n\xF3s."
    world: 4
    season: 2
    sound: ptbr_ep88_frn_38
    id: 4
    episode: 8
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Ei, o que este cachorro louco est\xE1 fazendo! Vai comer a mistura que
      fizemos!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_44
    id: 0
    episode: 1
    emotion: scared
    slug: final
    minigame: 
  - text: "Pelas barbas da \xC1rvore Mais Velha! O c\xE3o est\xE1 se transformando
      no... no... Mago Malaquias!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_45
    id: 1
    episode: 1
    emotion: scared
    slug: final
    minigame: 
  - text: Eu disse que o mago mais poderoso deste sonho fedia muito? Ops...
    world: 4
    season: 3
    sound: ptbr_ep89_frn_46
    id: 2
    episode: 1
    emotion: regular
    slug: final
    minigame: 
  - text: "Bem-vindo, Guardi\xE3o! Vieste juntar-te a mim em minha busca pelo Mago
      Malaquias?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_01
    id: 3
    episode: 1
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "H\xE1 dias que ningu\xE9m o v\xEA, e ele n\xE3o apareceu na \xFAltima reuni\xE3o
      dos feiticeiros da Floresta Sempreverde."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_02
    id: 4
    episode: 1
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Mago Malaquias! Onde est\xE1s tu? Ol\xE1 cachorrinho. Quem \xE9s...?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_03
    id: 5
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Pelos cabelos dourados da Rainha! Como fede este c\xE3o! Ser\xE1 que ele
      pertence ao Malaquias? Vamos at\xE9 sua casa perguntar."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_04
    id: 6
    episode: 1
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Estranho... N\xE3o h\xE1 sinal do mago em parte alguma!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_11
    id: 7
    episode: 1
    emotion: sad
    slug: minigame2
    minigame: 
  - text: "Olhe, aquele cachorro fedorento est\xE1 tentando dizer alguma coisa. O
      que \xE9 aquele livro?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_12
    id: 8
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "N\xE3o gosto muito de magias... N\xE3o acho que s\xE3o muito... seguras."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_18
    id: 9
    episode: 1
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "N\xE3o seria melhor pesquisarmos o que fazem esses ingredientes primeiro?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_19
    id: 10
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Agora \xE9 s\xF3 misturar tudo. Precisamos de uma mesa de trabalho."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_28
    id: 11
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: Opa! Cuidado!
    world: 4
    season: 3
    sound: ptbr_ep89_frn_35
    id: 12
    episode: 1
    emotion: scared
    slug: minigame5
    minigame: 
  - text: "N\xE3o! Deixei cair alguma coisa dentro do moedor! E agora?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_36
    id: 13
    episode: 1
    emotion: sad
    slug: minigame5
    minigame: 
  - text: "Malaquias? Nada... Vamos ter que ir at\xE9 l\xE1."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_05
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Pelo que as fadas me avisaram, o mago costuma trabalhar em seu laborat\xF3rio.
      Fica num andar com uma porta grande, uma estante de livros e tr\xEAs janelas
      pequenas."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Sim. \xC9 este mesmo! Bate com a descri\xE7\xE3o que temos."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_10
    id: 2
    episode: 1
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Este andar n\xE3o bate com a descri\xE7\xE3o. Tenho certeza de que o laborat\xF3rio
      n\xE3o fica nos dois primeiros andares."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_07a
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Veja, o primeiro andar tem uma porta grande, mas apenas uma janela. J\xE1
      o segundo andar tem uma estante, mas apenas duas janelas e nenhuma porta."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_07b
    id: 4
    episode: 1
    emotion: sad
    slug: error1
    minigame: 1
  - text: "O laborat\xF3rio tamb\xE9m n\xE3o fica no \xFAltimo andar, porque ali s\xF3
      vemos duas janelas. E tamb\xE9m ouvi dizer que ele gosta de dormir no alto."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_08
    id: 5
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Pelo que estou vendo aqui, apenas o terceiro andar tem tr\xEAs janelas
      pequenas... ser\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_09
    id: 6
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Parece um livro de receitas, e est\xE1 aberto em uma p\xE1gina espec\xEDfica."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_13
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "O cachorro n\xE3o para de latir! Ent\xE3o deve ser importante. Vamos separar
      os ingredientes da receita e ver no que d\xE1."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_14
    id: 1
    episode: 1
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Perfeito! Flores juntas aqui, plantas que n\xE3o s\xE3o flores ali... Agora
      sabemos fazer... seja l\xE1 o que for isso."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_17
    id: 2
    episode: 1
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Alguma coisa est\xE1 fora do lugar. Existe alguma flor que n\xE3o \xE9
      planta? Acho que n\xE3o!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_15
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Precisamos mudar s\xF3 estes aqui de lugar."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_16
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Precisamos mudar s\xF3 estes aqui de lugar."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_16
    id: 5
    episode: 1
    emotion: scared
    slug: error3
    minigame: 2
  - text: "O que tu encontraste a\xED, Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_20
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Parece algum tipo de enciclop\xE9dia. Ela explica o que cada tipo de ingrediente
      faz!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_21
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos ver o que h\xE1 de comum nos ingredientes da f\xF3rmula, que s\xE3o:
      abacate, agri\xE3o, canela, espinafre e rabanete."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_22
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Esses cinco vegetais s\xE3o ricos em ferro! Essa po\xE7\xE3o deve ser bem
      forte!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_27
    id: 3
    episode: 1
    emotion: happy
    slug: victory
    minigame: 3
  - text: "O que abacate, agri\xE3o, canela, espinafre e rabanete t\xEAm de igual
      na composi\xE7\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_23
    id: 4
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Acho que n\xE3o s\xE3o vitaminas, porque, se o abacate \xE9 rico em vitamina
      A, o espinafre em vitamina B e o rabanete \xE9 rico em vitamina C."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_24
    id: 5
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Vamos ver as caracter\xEDsticas do abacate, do agri\xE3o, canela, do espinafre
      e do rabanete. O que est\xE1 presente em todos eles?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_25a
    id: 6
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "N\xE3o s\xE3o vitaminas, que s\xE3o diferentes, nem pot\xE1ssio, j\xE1
      que ele est\xE1 presente em alimentos como beterraba, morango e r\xFAcula."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_25b
    id: 7
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: Acho que, com sua ajuda, consegui descobrir!
    world: 4
    season: 3
    sound: ptbr_ep89_frn_26
    id: 8
    episode: 1
    emotion: happy
    slug: error3
    minigame: 3
  - text: "Esta mesa parece \xF3tima para trabalharmos!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_29
    id: 0
    episode: 1
    emotion: happy
    slug: intro
    minigame: 4
  - text: Vamos colocar os ingredientes nas quantidades descritas na receita neste
      moedor.
    world: 4
    season: 3
    sound: ptbr_ep89_frn_30
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Devemos colocar exatamente o que \xE9 pedido. Agri\xE3o e espinafre, por
      exemplo, a receita pede a metade das folhas - temos 2 de agri\xE3o, ent\xE3o
      a metade \xE9 1."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_31a
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "E temos 4 de espinafre, cuja metade \xE9 2. Sabe-se l\xE1 o que pode acontecer
      se errarmos as quantidades num feiti\xE7o destes!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_31b
    id: 3
    episode: 1
    emotion: scared
    slug: error1
    minigame: 4
  - text: "Ainda tem algo estranho por aqui. A cada tr\xEAs peda\xE7os de abacate,
      precisamos de um. O mesmo vale para os morangos."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_32
    id: 4
    episode: 1
    emotion: scared
    slug: error2
    minigame: 4
  - text: "Vejamos se faltou alguma coisa. Permita-me ajud\xE1-lo."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_33
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Est\xE1 tudo a\xED? \xD3timo! Agora basta moer tudo e ver o que acontece."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_34
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Eu s\xF3 queria afastar os ingredientes que n\xE3o usamos, mas deixei cair
      alguma coisa a\xED dentro!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_37
    id: 0
    episode: 1
    emotion: sad
    slug: intro
    minigame: 5
  - text: "Agora este c\xE3o fedorento n\xE3o para de latir! Talvez ele saiba que
      isso pode fazer a receita falhar..."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_38
    id: 1
    episode: 1
    emotion: scared
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, me desculpe, mas podes me ajudar a tirar os ingredientes que
      n\xE3o pertencem \xE0 f\xF3rmula?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_39
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Que mal pode haver em ter uma jabuticaba e p\xE9talas de rosa na f\xF3rmula?
      Bom, vamos ver o que acontece."
    world: 4
    season: 3
    sound: ptbr_ep89_frn_43
    id: 3
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "S\xF3 devemos tirar o que n\xE3o est\xE1 na lista. V\xEA o que n\xE3o consta
      nela: para isso, deves l\xEA-la com calma... Abacate, agri\xE3o... estes devem
      ficar. O que mais?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_40
    id: 4
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Pelas minhas contas, creio que sejam apenas dois ingredientes que n\xE3o
      est\xE3o na lista. Quais s\xE3o? Canela, espinafre e rabanete est\xE3o na lista!"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_41
    id: 5
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ora, olhe s\xF3! S\xE3o estes aqui, n\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep89_frn_42
    id: 6
    episode: 1
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Ent\xE3o a Bruxa Zabumba o transformou em cachorro, Mago Malaquias? Que
      terr\xEDvel!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_01
    id: 0
    episode: 2
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Guardi\xE3o, essa bruxa vive aprontando maldades com todo mundo! Ela parece
      n\xE3o conhecer os limites do razo\xE1vel!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_02
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Bom, vamos todos at\xE9 a cabana da Bruxa Zabumba descobrir por que ela
      faz isso, ent\xE3o!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_03
    id: 2
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei, o que acontece logo ali \xE0 frente?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_04
    id: 3
    episode: 2
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Por que tu achas que n\xE3o foi a bruxa, Malaquias? N\xE3o acreditas que
      ela \xE9 m\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_10
    id: 4
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Olhem l\xE1! V\xE1rios animais tristes! Ter\xE1 acontecido algo a eles?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_11
    id: 5
    episode: 2
    emotion: sad
    slug: minigame2
    minigame: 
  - text: De novo defendes a bruxa, Mago Malaquias?
    world: 4
    season: 3
    sound: ptbr_ep90_frn_17
    id: 6
    episode: 2
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "Ent\xE3o, por que n\xE3o perguntamos aos animais? Eles podem dizer o que
      aconteceu aqui!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_18
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Os animais dizem que h\xE1 duendes vivendo nesta floresta. Talvez eles
      saibam alguma coisa sobre o que est\xE1 acontecendo."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_27
    id: 8
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Mas que cheiro horroroso \xE9 este? Malaquias, n\xE3o \xE9s tu, ou \xE9s?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_32
    id: 9
    episode: 2
    emotion: scared
    slug: minigame5
    minigame: 
  - text: "Calma, n\xE3o precisas ficar zangado! Se n\xE3o vem de ti, de quem ser\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_33
    id: 10
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "V\xF3s acreditais naquilo? O Leprech\xE3o dizendo que o Senhor Sombrio
      n\xE3o recicla e nem por isso n\xE3o consegue o que quer!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_40
    id: 11
    episode: 2
    emotion: sad
    slug: final
    minigame: 
  - text: "Bom, vamos terminar nossa viagem. Estamos quase na cabana da Bruxa Zabumba.
      E espero que ela tenha uma \xF3tima explica\xE7\xE3o para o que est\xE1 acontecendo
      por aqui!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_41
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Que terr\xEDvel! Aposto que a Bruxa Zabumba \xE9 a culpada por tudo isso!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_05
    id: 0
    episode: 2
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Precisamos liberar estes rios para que suas \xE1guas apaguem o fogo!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: O rio deu um jeito no fogo! Muito bem!
    world: 4
    season: 3
    sound: ptbr_ep90_frn_07
    id: 2
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "A \xE1gua destruiu aquelas m\xE1quinas que estavam poluindo tudo aqui na
      regi\xE3o! Excelente!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_08
    id: 3
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Conseguimos, Guardi\xE3o! Essa Bruxa vai pagar caro por isso!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_09
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Com o fogo e a polui\xE7\xE3o eles devem ter fugido de casa!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_12
    id: 0
    episode: 2
    emotion: sad
    slug: intro
    minigame: 2
  - text: "Vamos recoloc\xE1-los de volta em seus habitats naturais."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_13
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Todos felizes agora! E n\xE3o gra\xE7as \xE0quela bruxa maligna!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_16
    id: 2
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Opa, algo est\xE1 errado. Cada tipo de animal tem um habitat ideal. Animais
      aqu\xE1ticos vivendo fora da \xE1gua eu s\xF3 vi no Sonho das Nuvens Guerreiras!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_14
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Eles n\xE3o parecem felizes. P\xE1ssaros ficam em \xE1rvores, certo? Peixes
      dentro d'\xE1gua. O que mais? O tatu vive entocado e o sapo coaxa no lago."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_15
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Eles n\xE3o parecem felizes. P\xE1ssaros ficam em \xE1rvores, certo? Peixes
      dentro d'\xE1gua. O que mais? O tatu vive entocado e o sapo coaxa no lago."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_15
    id: 5
    episode: 2
    emotion: sad
    slug: error3
    minigame: 2
  - text: "Animais, concordam que algu\xE9m anda destruindo a floresta atrav\xE9s
      de a\xE7\xF5es predat\xF3rias, correto?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_19
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: Exatamente o que eu disse!
    world: 4
    season: 3
    sound: ptbr_ep90_frn_20
    id: 1
    episode: 2
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Pois eu diria que transformar um mago em cachorro fedorento \xE9 uma a\xE7\xE3o
      bastante predat\xF3ria!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_21
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "V\xF3s fizestes uma lista de reclama\xE7\xF5es? Muito bem! Guardi\xE3o,
      vamos ver aqui quais destas reclama\xE7\xF5es tem a ver com a\xE7\xF5es predat\xF3rias."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_22
    id: 3
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Sim. Essas coisas podem destruir o meio ambiente! Engra\xE7ado que eu esperava
      que uma bruxa usasse m\xE1gica e n\xE3o m\xE1quinas e lixo..."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_26
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Tem certeza? Os animais dizem que h\xE1 3 a\xE7\xF5es predat\xF3rias nesta
      lista. Quais s\xE3o? Logo a primeira da lista \xE9 horr\xEDvel: queimadas."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_23
    id: 5
    episode: 2
    emotion: scared
    slug: error1
    minigame: 3
  - text: "S\xF3 precisamos marcar as a\xE7\xF5es contra a natureza. \xC9 natural
      dos sapos coaxarem muito de noite..."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_24a
    id: 6
    episode: 2
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Compreendemos que perturbe o sono, mas n\xE3o \xE9 a\xE7\xE3o contra a
      natureza, por isso n\xE3o marcaremos, concordas, Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_24b
    id: 7
    episode: 2
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Ser\xE1 que n\xE3o s\xE3o estas aqui? Veja! Desmatamento e polui\xE7\xE3o
      das \xE1guas!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_25
    id: 8
    episode: 2
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Ol\xE1, amigos da floresta! Viemos... pelas antenas da nobil\xEDssima Rainha
      Formiga, quanto lixo!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_28
    id: 0
    episode: 2
    emotion: scared
    slug: intro
    minigame: 4
  - text: "S\xE3o v\xF3s que andais poluindo toda a floresta? N\xE3o? Mas duvido que
      esse lixo n\xE3o perten\xE7a a vossas pessoas."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_29
    id: 1
    episode: 2
    emotion: scared
    slug: intro
    minigame: 4
  - text: Vamos mostrar a eles como deixar o ambiente limpo e, quem sabe, plantar
      algumas pinhas.
    world: 4
    season: 3
    sound: ptbr_ep90_frn_30
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "E ainda explicamos que devemos reduzir o consumo desses materiais, e ainda
      separar o lixo para reaproveit\xE1-lo, n\xE3o \xE9 mesmo?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_31a
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Se n\xE3o evitarmos queimadas e nem replantarmos o que cortamos, a floresta
      corre o risco de acabar!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_31b
    id: 4
    episode: 2
    emotion: sad
    slug: victory
    minigame: 4
  - text: "Ora, \xE9 o Leprech\xE3o, o duende porcalh\xE3o! E olha quanta sujeira
      em toda a parte!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_34
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Leprech\xE3o, tu precisas limpar este lugar! N\xE3o sabe que pode trazer
      doen\xE7as, sem falar que \xE9 um desperd\xEDcio enorme?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_35
    id: 1
    episode: 2
    emotion: sad
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, podes me ajudar? Precisamos separar coisas inteiras em \"Reutilizar\",
      objetos de pl\xE1stico, papel ou vidro amassados ou quebrados em \"Reciclar\"."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_36a
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "E as comidas podres v\xE3o na cesta \"Org\xE2nicos\", para que possamos
      fazer uma compostagem para hortas caseiras. Vamos l\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_36b
    id: 3
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Mas \xE9 muito lixo mesmo! Acho que ajudamos bastante, n\xE3o? Aprendeu,
      Leprech\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_37
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Como assim, n\xE3o? Tu n\xE3o entendeste que \xE9 importante evitar o desperd\xEDcio
      e reutilizar o que pudermos?"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_38
    id: 5
    episode: 2
    emotion: sad
    slug: victory
    minigame: 5
  - text: "Eu n\xE3o vou ficar aqui ouvindo tamanha besteira! Vamos embora! Temos
      uma miss\xE3o a cumprir!"
    world: 4
    season: 3
    sound: ptbr_ep90_frn_39
    id: 6
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Acho que n\xE3o \xE9 isso... De repente se tentarmos assim..."
    world: 4
    season: 3
    sound: ptbr_ep90_frn_error
    id: 7
    episode: 2
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Bom, s\xF3 h\xE1 uma forma de descobrirmos... Entrando!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_60
    id: 0
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: "Mago Malaquias, estarei ao teu lado para o que der e vier. Vou ajud\xE1-lo
      a descobrir quem \xE9 o vil\xE3o desta hist\xF3ria!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_61
    id: 1
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: "Nossa, mas este lugar fede mais do que o c\xE3o Malaquias! Nada pessoal,
      Malaquias..."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_01
    id: 2
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ent\xE3o este lado da floresta n\xE3o era assim antes, Malaquias? O que
      aconteceu?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_02
    id: 3
    episode: 3
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Decerto foi essa bruxa que tu insistes em defender que deixou tudo isso
      aqui t\xE3o sujo!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_03
    id: 4
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos arrumar um jeito de atravessar aquela ponte e chegar at\xE9 a malfadada
      cabana."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_04
    id: 5
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Tu achas que a bruxa ficou zangada contigo, Malaquias? Mas, por qu\xEA?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_11
    id: 6
    episode: 3
    emotion: sad
    slug: minigame2
    minigame: 
  - text: "L\xE1 est\xE1 a Bruxa Zabumba na janela! Vamos perguntar a ela."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_12
    id: 7
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Guardi\xE3o, olha a cara do mago Malaquias! Ele est\xE1 apaixonado por
      ela tamb\xE9m! Quem diria..."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_24
    id: 8
    episode: 3
    emotion: happy
    slug: minigame3
    minigame: 
  - text: Malaquias, esclarece logo a ela e resolve isso de uma vez!
    world: 4
    season: 3
    sound: ptbr_ep91_frn_25
    id: 9
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Nossa, olha que sorriso gigante no rosto dela! E ela... Espera. De que
      carta mal-educada Zabumba est\xE1 falando?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_33
    id: 10
    episode: 3
    emotion: regular
    slug: minigame4
    minigame: 
  - text: Agora vamos descobrir quem se passou por Malaquias e enganou a pobre Zabumba!
    world: 4
    season: 3
    sound: ptbr_ep91_frn_51
    id: 11
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vamos procurar por duas \xE1rvores juntas."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_52
    id: 12
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Quanta modernidade! N\xE3o esperava que a casa de uma bruxa tivesse este
      tipo de... seguran\xE7a eletr\xF4nica!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_05
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "\xC9 algum tipo de senha para nos deixar passar? Seja o que for, acho que
      h\xE1 mais de uma resposta certa."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_06
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: Parece que funcionou! Vamos atravessar antes que se feche novamente!
    world: 4
    season: 3
    sound: ptbr_ep91_frn_10
    id: 2
    episode: 3
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Opa, n\xE3o foi. Pelo que parece precisamos marcar todas as respostas que
      s\xE3o iguais a 136, como a primeira delas: 100 + 30 + 6 d\xE1 136, n\xE3o concordas?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_07
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Nada ainda. Vamos somar um por um os n\xFAmeros e ver quais d\xE3o 136.
      Esse segundo aqui j\xE1 vi que n\xE3o d\xE1: 100 + 3 + 60 d\xE1 163... Que pegadinha,
      hein? Esse n\xE3o faz parte da senha, com certeza!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_08
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Acho que devem ser estes, pois todos mostram maneiras diferentes de compor
      o n\xFAmero 136."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_09
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 1
  - text: Olha aqui, senhora bruxa, eu... Malaquias, o que...
    world: 4
    season: 3
    sound: ptbr_ep91_frn_13
    id: 0
    episode: 3
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Guardi\xE3o, o que est\xE1 ocorrendo ali? Estou confuso! O que est\xE3o
      fazendo um com o outro?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_14
    id: 1
    episode: 3
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Espere um pouco... Ent\xE3o a Bruxa Zabumba gosta do Mago Malaquias? Ora
      essa..."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_23
    id: 2
    episode: 3
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Parece que ela est\xE1 se expressando de uma forma bem enf\xE1tica, n\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_15
    id: 3
    episode: 3
    emotion: regular
    slug: error1_0
    minigame: 2
  - text: "Ela est\xE1 falando bem alto, e com raiva, ao que parece. \xC9, ela est\xE1
      gritando."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_16
    id: 4
    episode: 3
    emotion: regular
    slug: error1_1
    minigame: 2
  - text: "Apesar de nervoso, ele est\xE1 conversando calmamente..."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_17
    id: 5
    episode: 3
    emotion: regular
    slug: error2_0
    minigame: 2
  - text: Veja como Malaquias fala tranquilamente com Zabumba.
    world: 4
    season: 3
    sound: ptbr_ep91_frn_18
    id: 6
    episode: 3
    emotion: regular
    slug: error2_1
    minigame: 2
  - text: Finalmente ela parece um pouco mais calma, agora.
    world: 4
    season: 3
    sound: ptbr_ep91_frn_19
    id: 7
    episode: 3
    emotion: regular
    slug: error3_0
    minigame: 2
  - text: "Zabumba at\xE9 perguntou algo para Malaquias."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_20
    id: 8
    episode: 3
    emotion: regular
    slug: error3_1
    minigame: 2
  - text: "Finalmente parece que temos um di\xE1logo civilizado."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_21
    id: 9
    episode: 3
    emotion: regular
    slug: error4_0
    minigame: 2
  - text: Que bom que Malaquias conseguiu falar com Zabumba!
    world: 4
    season: 3
    sound: ptbr_ep91_frn_22
    id: 10
    episode: 3
    emotion: happy
    slug: error4_1
    minigame: 2
  - text: O que foi esse barulho de papel rasgando?
    world: 4
    season: 3
    sound: ptbr_ep91_frn_26
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Pelo ronco dos gigantes! O Malaquias est\xE1 t\xE3o nervoso que rasgou
      o poema que escreveu para a bruxa... digo, Zabumba!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_27
    id: 1
    episode: 3
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, vamos ajud\xE1-lo a colocar seu poema em ordem. Ele est\xE1
      nervoso demais para faz\xEA-lo sozinho."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_28
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Feito! \xC9 todo teu, Malaquias!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_32
    id: 3
    episode: 3
    emotion: happy
    slug: victory
    minigame: 3
  - text: "N\xE3o \xE9 essa a ordem. A sequ\xEAncia de linhas precisa rimar e fazer
      sentido!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_29
    id: 4
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Eu... n\xE3o acho que seja assim... Olha a cara de desconfiada da bruxa.
      Mas, pelo que li, no primeiro s\xF3 pode ser mesmo \"Que correspondesse meu
      amor...\""
    world: 4
    season: 3
    sound: ptbr_ep91_frn_30
    id: 5
    episode: 3
    emotion: regular
    slug: error2
    minigame: 3
  - text: Ah! Permita-me arrumar o que ficou faltando.
    world: 4
    season: 3
    sound: ptbr_ep91_frn_31
    id: 6
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Que carta mais mal-educada. N\xE3o me surpreende que ela esteja t\xE3o
      zangada contigo, Malaquias!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_34
    id: 0
    episode: 3
    emotion: scared
    slug: intro
    minigame: 4
  - text: "N\xE3o foste tu quem a mandaste? Vamos ver pelo remetente da carta! Isso
      nos dir\xE1 de onde ela veio!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_35
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Aqui. Vamos usar este mapa. Eu te guio at\xE9 o endere\xE7o. Primeiro,
      vai para o Leste."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_36
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "A\xED est\xE1! \xC9 da\xED que veio a carta!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_50
    id: 3
    episode: 3
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Opa, calma! \xC9 para o Leste. Olhando para a Rosa dos Ventos, o Leste
      est\xE1 \xE0 direita. Encontraste?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_37
    id: 4
    episode: 3
    emotion: scared
    slug: error_leste
    minigame: 4
  - text: "O Sul fica em outra dire\xE7\xE3o... Na parte de baixo da Rosa dos Ventos."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_39
    id: 5
    episode: 3
    emotion: scared
    slug: error_sul
    minigame: 4
  - text: "Opa, dire\xE7\xE3o errada!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_41
    id: 6
    episode: 3
    emotion: scared
    slug: error2
    minigame: 4
  - text: "N\xE3o queremos nos perder no caminho, n\xE3o \xE9? O Norte \xE9 em cima,
      se olharmos para a Rosa dos Ventos."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_43
    id: 7
    episode: 3
    emotion: scared
    slug: error_norte
    minigame: 4
  - text: "De acordo com minha b\xFAssola, o Oeste fica \xE0 esquerda da Rosa dos
      Ventos."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_45
    id: 8
    episode: 3
    emotion: scared
    slug: error_oeste
    minigame: 4
  - text: "O Norte \xE9 pra l\xE1..."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_47
    id: 9
    episode: 3
    emotion: regular
    slug: error5
    minigame: 4
  - text: "O Leste \xE9 o lado em que o Sol nasce, sabia?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_49
    id: 10
    episode: 3
    emotion: regular
    slug: error6
    minigame: 4
  - text: "Agora, por obs\xE9quio, vire para o Sul."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_38
    id: 11
    episode: 3
    emotion: regular
    slug: request1
    minigame: 4
  - text: "\xD3timo! Agora, novamente, vai para o Leste."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_40
    id: 12
    episode: 3
    emotion: regular
    slug: request2
    minigame: 4
  - text: O mapa diz que devemos ir para o Norte.
    world: 4
    season: 3
    sound: ptbr_ep91_frn_42
    id: 13
    episode: 3
    emotion: regular
    slug: request3
    minigame: 4
  - text: Uma curva suave para o Oeste...
    world: 4
    season: 3
    sound: ptbr_ep91_frn_44
    id: 14
    episode: 3
    emotion: regular
    slug: request4
    minigame: 4
  - text: Novamente Norte... estamos quase chegando!
    world: 4
    season: 3
    sound: ptbr_ep91_frn_46
    id: 15
    episode: 3
    emotion: happy
    slug: request5
    minigame: 4
  - text: Agora, para finalizar, vamos para o Leste!
    world: 4
    season: 3
    sound: ptbr_ep91_frn_48
    id: 16
    episode: 3
    emotion: regular
    slug: request6
    minigame: 4
  - text: "Quem diria que um dia eu estaria ajudando uma bruxa..., digo, linda donzela!
      N\xE3o me olhas assim, Malaquias!"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_53
    id: 0
    episode: 3
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Parece ser este o lugar... Mas... qual das duas entradas que est\xE3o perto
      das ra\xEDzes das \xE1rvores? Vejamos a carta."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_54
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ora, mas quem escreveu este endere\xE7o errou feio. \xC9 s\xF3 olhar adiante
      que se v\xEA que h\xE1 algo errado na descri\xE7\xE3o! Ajude-me a encontrar
      os erros na carta e risc\xE1-los, Guardi\xE3o."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_55
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: A carta veio desta toca! Teria sido um tatu que mandou aquela carta desaforada?
    world: 4
    season: 3
    sound: ptbr_ep91_frn_59
    id: 3
    episode: 3
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Espere um pouco... a \xE1rvore azul \xE9 furadinha, e a verde tem espinhos.
      Mas tem algo que n\xE3o est\xE1 de acordo, aqui. O que poderia ser, \xF3 s\xE1bio
      Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_56
    id: 4
    episode: 3
    emotion: regular
    slug: error1
    minigame: 5
  - text: "As duas \xE1rvores, tanto a azul como a verde, est\xE3o secas. E a carta
      afirma que a toca fica ao lado de uma \xE1rvore baixa e n\xE3o alta! O que mais
      est\xE1 errado?"
    world: 4
    season: 3
    sound: ptbr_ep91_frn_57
    id: 5
    episode: 3
    emotion: regular
    slug: error2
    minigame: 5
  - text: "\xC9 o tamanho as \xE1rvores que est\xE1 trocado."
    world: 4
    season: 3
    sound: ptbr_ep91_frn_58
    id: 6
    episode: 3
    emotion: regular
    slug: error3
    minigame: 5
  - text: A carta original! A que a Zabumba mandou para o Malaquias! Estava escondida
      aqui mesmo!
    world: 4
    season: 3
    sound: ptbr_ep92_frn_55
    id: 0
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "Malaquias, esta \xE9 a tua prova que o Senhor Sombrio enganou a Zabumba!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_56
    id: 1
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "E agora? Ora, e agora n\xF3s voltamos at\xE9 l\xE1 e mostramos para ela!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_57
    id: 2
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: Nossa, mas que toca mais diferente para um tatu...
    world: 4
    season: 3
    sound: ptbr_ep92_frn_01
    id: 3
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Sabe de uma coisa... acho que n\xE3o \xE9 um tatu que mora por aqui e sim..."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_02
    id: 4
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Algo esquisito sentindo est\xE1s? Leve estar a cabe\xE7a como se estivesse?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_03
    id: 5
    episode: 4
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Aqui acontecendo o que est\xE1? Ajude-nos, Guardi\xE3o!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_04
    id: 6
    episode: 4
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Para nos salvar, o manual de sobreviv\xEAncia eu posso usar."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_11
    id: 7
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Guardi\xE3o, deves tu me ajudar."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_12
    id: 8
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Funcionou? Ufa! Funcionou! Que armadilha mais terr\xEDvel! Estava me deixando
      todo confuso!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_19
    id: 9
    episode: 4
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Que tipo de mente terr\xEDvel faria uma armadilha destas?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_20
    id: 10
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Agora podemos passar sem perigo! O que ser\xE1 que os raios laser protegiam?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_28
    id: 11
    episode: 4
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Ser\xE1 que... ser\xE1 que o Senhor Sombrio escondeu a carta original aqui?
      Dentro do computador?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_46
    id: 12
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ent\xE3o vamos descobrir!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_47
    id: 13
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: Neste bilhete escreverei! Entender tu vais.
    world: 4
    season: 3
    sound: ptbr_ep92_frn_05
    id: 0
    episode: 4
    emotion: scared
    slug: intro
    minigame: 1
  - text: Na ordem certa devemos colocar ou entender nunca vamos.
    world: 4
    season: 3
    sound: ptbr_ep92_frn_06
    id: 1
    episode: 4
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Errado est\xE1. Ordem certa n\xE3o \xE9."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_07
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Estranho ainda est\xE1. Resolver o problema precisamos."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_08
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Ao contr\xE1rio deve ser!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_09
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 1
  - text: O buraco precisamos fechar!
    world: 4
    season: 3
    sound: ptbr_ep92_frn_10
    id: 5
    episode: 4
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Na caverna dos ecos invertidos devemos estar. Fech\xE1-la devemos agora."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_13
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: As figurinhas devemos colar na certa ordem. Por favor, ajuda-me!
    world: 4
    season: 3
    sound: ptbr_ep92_frn_14
    id: 1
    episode: 4
    emotion: scared
    slug: intro
    minigame: 2
  - text: Usar pedras devemos para fechar a caverna e vento parar.
    world: 4
    season: 3
    sound: ptbr_ep92_frn_18
    id: 2
    episode: 4
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Na sequ\xEAncia certa devemos colocar, as frases seguindo."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_15
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: Entrada da caverna a, encontrar precisamos.
    world: 4
    season: 3
    sound: ptbr_ep92_frn_16
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: Encontrar grandes pedras fechar entrada para! Entrada caverna da encaixar
      na pedras as!
    world: 4
    season: 3
    sound: ptbr_ep92_frn_17
    id: 5
    episode: 4
    emotion: scared
    slug: error3
    minigame: 2
  - text: "Uma grade laser! E um rob\xF4! Tu sabes o que isso quer dizer, Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_21
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: Foi o Senhor Sombrio! Foi ele quem roubou a carta do Malaquias e mandou
      a resposta malcriada para a Zabumba!
    world: 4
    season: 3
    sound: ptbr_ep92_frn_22
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Precisamos usar este rob\xF4 para tampar os lasers com estas tampinhas.
      Dos 38 lasers, 24  j\xE1 est\xE3o tampados. Quantos faltam?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_23
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "14! \xC9 isso mesmo! Olha, o rob\xF4 est\xE1 tampando os lasers!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_27
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Parece-me que a solu\xE7\xE3o vai requerer uma conta.. Se s\xE3o 38, com
      24 j\xE1 tapados, para sabermos quantos ainda faltam tapar, creio que devamos
      calcular 38 menos 24, n\xE3o achas?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_24
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Precisamos colocar o valor certo no rob\xF4. Tens certeza que calculaste
      bem 38 menos 24? Vamos refazer a conta..."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_25
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 3
  - text: "38 menos 24... d\xE1 14?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_26
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Estamos indo muito bem at\xE9 aqui! J\xE1 at\xE9 estou sentindo o cheiro
      do sucesso! Mas ainda n\xE3o chegamos l\xE1. Agora deves escolher uma figura
      com a mesma forma da anterior, mas com outra cor. Vamos l\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_42
    id: 0
    episode: 4
    emotion: regular
    slug: nextShape3
    minigame: 4
  - text: Um computador, claro! Aposto que o Senhor Sombrio o utilizava para guardar
      alguma coisa!
    world: 4
    season: 3
    sound: ptbr_ep92_frn_29
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Vamos tentar quebrar a senha e descobrir o que h\xE1 a\xED dentro. \xC9
      s\xF3 seguir a sequ\xEAncia. Primeiro precisamos encontrar o tri\xE2ngulo amarelo
      no teclado..."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_30
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Excelente, Guardi\xE3o! Agora tu deves manter a forma, mas escolher outra
      cor!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_33
    id: 3
    episode: 4
    emotion: regular
    slug: nextShape0
    minigame: 4
  - text: "Muito bem! Tenho certeza que desvendaremos esta senha sem demora! No pr\xF3ximo
      passo, deves escolher outra forma, mas com a mesma cor da \xFAltima imagem na
      tela."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_36
    id: 4
    episode: 4
    emotion: regular
    slug: nextShape1
    minigame: 4
  - text: "Puxa, que senha trabalhosa, n\xE3o? Mas n\xE3o deve faltar muito, ou ningu\xE9m
      conseguiria lembrar dela."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_39a
    id: 5
    episode: 4
    emotion: regular
    slug: nextShape2
    minigame: 4
  - text: "Bom, a seguir deves pressionar no teclado, por favor, uma pe\xE7a com a
      mesma cor da \xFAltima escolhida, mas com uma forma diferente, est\xE1 bem?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_39b
    id: 6
    episode: 4
    emotion: regular
    slug: nextShape2
    minigame: 4
  - text: "Desvendamos a senha! O outro monitor est\xE1 ligando! \xD3timo trabalho,
      Guardi\xE3o!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_45
    id: 7
    episode: 4
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Um tri\xE2ngulo tem 3 lados, Guardi\xE3o, e amarelo \xE9 a cor do ouro!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_31
    id: 8
    episode: 4
    emotion: regular
    slug: error0_1
    minigame: 4
  - text: "Um tri\xE2ngulo amarelo... v\xEA! Ali, na linha de baixo, entre o c\xEDrculo
      vermelho e o trap\xE9zio azul!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_32
    id: 9
    episode: 4
    emotion: regular
    slug: error0_2
    minigame: 4
  - text: "Lembra-te: deves escolher outro tri\xE2ngulo, s\xF3 que com uma cor diferente
      da amarela."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_34
    id: 10
    episode: 4
    emotion: regular
    slug: error1_1
    minigame: 4
  - text: "Temos outros dois tri\xE2ngulos no teclado... pronto, vamos pressionar
      o tri\xE2ngulo vermelho que est\xE1 logo ao lado do c\xEDrculo e do quadrado
      azuis."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_35
    id: 11
    episode: 4
    emotion: regular
    slug: error1_2
    minigame: 4
  - text: "Vamos ver de qual cor \xE9 a segunda forma que est\xE1 na tela? Esta deve
      ser a cor da pr\xF3xima escolha."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_37
    id: 12
    episode: 4
    emotion: regular
    slug: error2_1
    minigame: 4
  - text: "Seguindo as instru\xE7\xF5es, vamos escolher esta pe\xE7a aqui, que tal?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_38
    id: 13
    episode: 4
    emotion: regular
    slug: error2_2
    minigame: 4
  - text: "Bom, temos tr\xEAs pe\xE7as em nossa sequ\xEAncia at\xE9 aqui, certo, Guardi\xE3o?
      E todas as figuras possuem uma caracter\xEDstica em comum com a anterior."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_40a
    id: 14
    episode: 4
    emotion: regular
    slug: error3_1
    minigame: 4
  - text: "Agora, o que deves escolher \xE9 uma tecla com a mesma cor da \xFAltima
      figura escolhida."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_40b
    id: 15
    episode: 4
    emotion: regular
    slug: error3_1
    minigame: 4
  - text: "Entre as op\xE7\xF5es que temos, esta parece que combina de alguma forma..."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_41
    id: 16
    episode: 4
    emotion: regular
    slug: error3_2
    minigame: 4
  - text: "Lembra-te de que n\xE3o \xE9 poss\xEDvel repetir a cor ou mudar a forma,
      Guardi\xE3o..."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_43
    id: 17
    episode: 4
    emotion: regular
    slug: error4_1
    minigame: 4
  - text: "Que tal finalizarmos com esta pe\xE7a aqui, Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_44
    id: 18
    episode: 4
    emotion: regular
    slug: error4_2
    minigame: 4
  - text: "Que mensagem esquisita \xE9 esta? Est\xE1 escrito na l\xEDngua dos rob\xF4s,
      por acaso?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_48
    id: 0
    episode: 4
    emotion: scared
    slug: intro
    minigame: 5
  - text: "Deve ser a forma do Senhor Sombrio nos despitar! S\xF3 pode!"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_49
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, tu podes ajustar as letras para que elas fiquem todas iguais
      e possamos ler melhor?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_50
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "\xC9 isso! Era mais uma senha secreta! E, o que \xE9 isso aqui?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_54
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 5
  - text: Tanto o tipo de letra, quanto o tamanho das letras devem ser os mesmos em
      toda a mensagem.
    world: 4
    season: 3
    sound: ptbr_ep92_frn_51
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Ainda n\xE3o entendo. N\xE3o h\xE1 alguma letra de um tipo diferente por
      a\xED?"
    world: 4
    season: 3
    sound: ptbr_ep92_frn_52
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Estou come\xE7ando a entender melhor! Vamos ver se \xE9 isto aqui."
    world: 4
    season: 3
    sound: ptbr_ep92_frn_53
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 5
  - text: "U\xE9, Malaquias, ainda n\xE3o foi falar com a Zabumba? O que te segura,
      homem?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_48
    id: 0
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "Guardi\xE3o, estou achando que vamos precisar dar uma forcinha para o Mago
      Malaquias criar coragem e se declarar para a bruxa Zabumba."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_49
    id: 1
    episode: 5
    emotion: happy
    slug: final
    minigame: 
  - text: "Eu estava certo! Este outro t\xFAnel nos levou de volta \xE0 floresta!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_01
    id: 2
    episode: 5
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "N\xE3o reconhe\xE7o este lugar. Estamos perdidos?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_02
    id: 3
    episode: 5
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Acalma-te, Mago Malaquias! Logo encontraremos o caminho at\xE9 o lar de
      tua amada!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_03
    id: 4
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Guardi\xE3o, tu sabes para onde devemos ir?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_04
    id: 5
    episode: 5
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "A mata \xE9 t\xE3o fechada por aqui. Ei, o que \xE9 aquilo l\xE1 adiante?
      Uma vila?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_09
    id: 6
    episode: 5
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "\"Vilarejo Tocaio.\" Ora, quem diria! Algu\xE9m vive no meio desta selva!
      Talvez eles saibam o caminho at\xE9 a cabana da Zabumba!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_10
    id: 7
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ent\xE3o o senhor pode nos ajudar, senhor Patr\xEDcio? Precisamos chegar
      \xE0 cabana da bruxa Zabumba?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_21
    id: 8
    episode: 5
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Ora, n\xF3s o acompanharemos at\xE9 tua casa, claro!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_22
    id: 9
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Muito obrigado, senhor Patr\xEDcio! Vamos em frente!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_30
    id: 10
    episode: 5
    emotion: happy
    slug: minigame4
    minigame: 
  - text: "Nossa, andamos tanto! Vou aproveitar para anotar como est\xE1 sendo nossa
      viagem. Posso contar esta hist\xF3ria depois para os outros cavaleiros."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_37
    id: 11
    episode: 5
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "L\xE1 est\xE1 a cabana de Zabumba! Eu termino aqui minhas anota\xE7\xF5es.
      Guardi\xE3o, tu me ajudas?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_38
    id: 12
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Sim, claro! \xC9 aquela encruzilhada, eu me lembro dela. Com certeza precisamos
      virar \xE0 esquerda."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_05
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O qu\xEA? Tu n\xE3o concordas, Malaquias? Bom, s\xF3 h\xE1 um jeito de
      descobrir quem est\xE1 certo: nos dados! Quem tirar o maior n\xFAmero vence.
      Guardi\xE3o, tu ser\xE1s o juiz."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_06
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O cavaleiro estava certo, o mago estava errado! Foi o Guardi\xE3o quem
      disse!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_08
    id: 2
    episode: 5
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Opa, n\xE3o foi ele n\xE3o. Fui eu! Se 5 + 5 \xE9 igual a 10, e 6 + 4 tamb\xE9m
      \xE9 igual a 10, basta ver que 3 \xE9 maior do que 1. Venci!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_07
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Ol\xE1, nobre senhor, somos viajantes e nos perdemos... O senhor parece
      preocupado. Precisa de ajuda?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_11
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Segundo o senhor Jos\xE9 Patr\xEDcio, agora ele est\xE1 corrigindo a lista
      telef\xF4nica do vilarejo. O problema \xE9 que todos os homens se chamam Jos\xE9
      e todas as mulheres se chamam Maria!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_12
    id: 1
    episode: 5
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Quem sabe n\xE3o podemos ajud\xE1-lo a corrigir o que h\xE1 de errado?
      Certamente o senhor Patr\xEDcio nos ajudar\xE1 em seguida!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_13
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: Primeiro, temos que mudar os apelidos para os nomes corretos...
    world: 4
    season: 3
    sound: ptbr_ep93_frn_14
    id: 3
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Esses n\xE3o parecem ser os apelidos... Quem aqui n\xE3o est\xE1 registrado
      como Jos\xE9 ou como Maria?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_15
    id: 4
    episode: 5
    emotion: regular
    slug: error1_1
    minigame: 2
  - text: Estamos sujando tudo com esses carimbos, deixa eu te ajudar.
    world: 4
    season: 3
    sound: ptbr_ep93_frn_16
    id: 5
    episode: 5
    emotion: regular
    slug: error1_2
    minigame: 2
  - text: "Pronto! Agora s\xF3 temos \"Jos\xE9s\" e \"Marias\". Agora precisamos organizar
      todos em ordem alfab\xE9tica!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_17
    id: 6
    episode: 5
    emotion: regular
    slug: order
    minigame: 2
  - text: "Essa ordem parece estar um pouco estranha... Os Jos\xE9s v\xEAm antes das
      Marias, e se todos t\xEAm nomes iguais, temos que olhar para as primeiras letras
      do segundo nome, certo?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_18
    id: 7
    episode: 5
    emotion: sad
    slug: error2_1
    minigame: 2
  - text: "Jos\xE9 Pl\xEDnio vai entrar entre o Jos\xE9 Pedro e o Jos\xE9 Ricardo...
      E a Maria Francisca vai estar entre a Maria Fernanda e a Maria Gabriela. Acho
      que \xE9 isso."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_19
    id: 8
    episode: 5
    emotion: regular
    slug: error2_2
    minigame: 2
  - text: "\xD3timo trabalho, Guardi\xE3o! Os moradores v\xE3o encontrar os n\xFAmeros
      de telefones bem mais f\xE1cil, agora!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_20
    id: 9
    episode: 5
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Sabe como \xE9, senhor Patr\xEDcio, \xE9 que nosso amigo Malaquias aqui
      precisa conversar com a bruxa... digo, linda dama Zabumba."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_23
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Como n\xE3o conhecemos este lado da floresta, pode nos dizer como chegar
      l\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_24
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Uh, calma! Eu vou anotar. Nossa, como ele fala r\xE1pido. Guardi\xE3o me
      ajude! Estou escrevendo tudo errado!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_25
    id: 2
    episode: 5
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Agora eu entendi. De t\xE3o afoito, esqueci de colocar alguns detalhes.
      Caramba! Tu nos salvaste de uma enrascada, Guardi\xE3o!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_29
    id: 3
    episode: 5
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Ainda h\xE1 algo errado a\xED. Letras mai\xFAsculas para os nomes e in\xEDcio
      de frase, claro! O que mais est\xE1 faltando corrigir, Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_26
    id: 4
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Veja s\xF3! Onde j\xE1 se viu escrever pergunta sem ponto de interroga\xE7\xE3o?
      Que cabe\xE7a a minha! Mas ainda n\xE3o est\xE1 tudo certinho, est\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_27
    id: 5
    episode: 5
    emotion: regular
    slug: error2
    minigame: 3
  - text: Opa, espere um pouco. Lembro-me disso!
    world: 4
    season: 3
    sound: ptbr_ep93_frn_28
    id: 6
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "O que \xE9 aquilo ca\xEDdo pelo ch\xE3o? S\xE3o placas?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_31
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Esse lugar \xE9 t\xE3o distante que as estradas at\xE9 aqui nem foram terminadas!
      Vamos organizar estas placas para facilitar a vida dos que vierem depois de
      n\xF3s."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_32
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Tudo perfeitamente organizado! Pelo menos agora ningu\xE9m mais se perder\xE1
      por aqui."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_36
    id: 2
    episode: 5
    emotion: happy
    slug: victory
    minigame: 4
  - text: Precisamos organizar por tipo de placa, um tipo em cada conjunto.
    world: 4
    season: 3
    sound: ptbr_ep93_frn_33
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 4
  - text: Tem alguma placa no lugar errado. Vamos agrupar por tipo.
    world: 4
    season: 3
    sound: ptbr_ep93_frn_34
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 4
  - text: Opa, vamos trocar estas aqui de lugar.
    world: 4
    season: 3
    sound: ptbr_ep93_frn_35
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 4
  - text: Enquanto o Malaquias junta coragem para falar com a Zabumba, ajude-me com
      meu relato de viagem.
    world: 4
    season: 3
    sound: ptbr_ep93_frn_39
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Eu... embelezei um pouco a viagem, inclu\xED umas coisas da minha imagina\xE7\xE3o
      aqui e ali... nada demais!"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_40
    id: 1
    episode: 5
    emotion: happy
    slug: intro
    minigame: 5
  - text: "S\xF3 acho que eu fiz desenhos demais... Me ajude aqui. Qual desenho n\xE3o
      se encaixa no meu texto?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_41
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Primeiro, passamos pelo Vilarejo Tocaio. Depois, fomos ao Bosque Animado.
      Os cactos espinhentos foram dif\xEDceis de passar. E, finalmente, chegamos \xE0
      casa de Zabumba."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_42
    id: 3
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: A Lagoa Molhada! De onde eu tirei isso? Devia estar sonhando com vontade
      de fazer xixi...
    world: 4
    season: 3
    sound: ptbr_ep93_frn_47
    id: 4
    episode: 5
    emotion: happy
    slug: victory
    minigame: 5
  - text: "U\xE9? Eu n\xE3o tinha escrito sobre esse lugar aqui... Vamos reler parte
      por parte do meu escrito: passamos pelo Vilarejo tocaio."
    world: 4
    season: 3
    sound: ptbr_ep93_frn_43
    id: 5
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Isso, ent\xE3o, fez parte de nossa aventura! O que mais est\xE1 escrito
      no relato?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_44
    id: 6
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Opa, este tamb\xE9m tem no meu texto! Continuando a sequ\xEAncia para n\xE3o
      ter mais erros: depois, fomos ao Bosque Animado. Somos n\xF3s aqui com essas
      \xE1rvores cantantes! Qual \xE9, ent\xE3o, a imagem sobrando, Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_45
    id: 7
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Tamb\xE9m n\xE3o \xE9 este. Ser\xE1 que n\xE3o \xE9 esse a\xED?"
    world: 4
    season: 3
    sound: ptbr_ep93_frn_46
    id: 8
    episode: 5
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Olha, Guardi\xE3o. Eu j\xE1 vi muita coisa. Gigantes, rainhas, at\xE9 uma
      hidra de muitas cabe\xE7as, mas esta \xE9 a primeira vez que eu vejo um mago
      perdidamente apaixonado por uma bruxa do p\xE2ntano..."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_43
    id: 0
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Quem poderia imaginar que um mago s\xE1bio e poderoso teria tanto medo
      de declarar o seu amor?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_01
    id: 1
    episode: 6
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Malaquias foi ao bosque escrever um poema sozinho, porque \xE9 envergonhado."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_02
    id: 2
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Pediu para buscarmos algumas coisas para ele, pois quer fazer uma surpresa
      para a Zabumba.
    world: 4
    season: 3
    sound: ptbr_ep94_frn_03
    id: 3
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ele disse que h\xE1 uma confeitaria aqui perto onde podemos fazer um bolo
      bem legal para ela."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_04
    id: 4
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O bolo j\xE1 est\xE1 pronto? Quase! Falta decorar."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_11
    id: 5
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Guardi\xE3o, vamos ajudar o Formig\xE3o a decorar o bolo?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_12
    id: 6
    episode: 6
    emotion: happy
    slug: minigame2
    minigame: 
  - text: "Tamb\xE9m, quem j\xE1 viu uma formiga confeiteira? Como pode doce algum
      sobreviver \xE0 fome dele por doce?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_19
    id: 7
    episode: 6
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Bom, ainda precisamos pegar algumas rosas. Onde ser\xE1 que encontraremos
      algumas?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_20
    id: 8
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Bolo, rosas... est\xE1 tudo aqui! Agora vamos atr\xE1s do Malaquias. Onde
      ele se meteu?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_27
    id: 9
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: Bolo, rosas, poema. O que mais uma bruxa..., dama, poderia querer?
    world: 4
    season: 3
    sound: ptbr_ep94_frn_34
    id: 10
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Preparado? Vamos, ent\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_35
    id: 11
    episode: 6
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Esse \xE9 o lugar. Pelo que o Malaquias disse n\xF3s mesmos podemos fazer
      o bolo aqui, com ajuda do mestre cuca Formig\xE3o, \xE9 claro!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_05
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Vamos por tudo na ordem certa. A primeira coisa a fazer \xE9 colocar os
      ingredientes na tigela. Depois, ligue o forno e coloque a forma no forno. Uma
      hora depois, tire a forma do forno."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_06
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Feito! Colocar a forma no forno e retirar depois de 1 hora. Ser\xE1 que
      o bolo vai ficar bom?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_10
    id: 2
    episode: 6
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Com certeza o mestre cuca Formig\xE3o n\xE3o vai brincar com a comida...
      Lembro que a primeira coisa que ele faz \xE9 colocar os ingredientes na tigela.
      E depois?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_07
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Se n\xE3o seguirmos a receita direitinho, o bolo n\xE3o vai ficar bom...
      \xC9 preciso ligar o forno antes de colocarmos a forma dentro dele. Qual o pr\xF3ximo
      passo?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_08
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Acho que, olhando o mestre cuca Formig\xE3o, acabei aprendendo. Vamos ver..."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_09
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Olha s\xF3, o Formig\xE3o j\xE1 come\xE7ou a decorar e... Ei, isso \xE9
      glac\xEA na sua boca, Formig\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_13
    id: 0
    episode: 6
    emotion: scared
    slug: intro
    minigame: 2
  - text: "D\xE1 para acreditar? O Formig\xE3o comeu parte da decora\xE7\xE3o! Guardi\xE3o,
      vamos n\xF3s mesmos completar a decora\xE7\xE3o seguindo o padr\xE3o que j\xE1
      existe. Por favor, restaure os dois andares que ele estragou!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_14
    id: 1
    episode: 6
    emotion: sad
    slug: intro
    minigame: 2
  - text: "Parece muito bom. Agora s\xF3 precisamos manter o Formig\xE3o bem longe
      do bolo!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_18
    id: 2
    episode: 6
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Precisamos escolher a decora\xE7\xE3o que mantenha os padr\xF5es que n\xE3o
      foram comidos pelo formig\xE3o, para n\xE3o parecer que uma formiga gigante
      comeu parte da decora\xE7\xE3o! Tanto em cima quanto embaixo do bolo."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_15
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Tem certeza que este padr\xE3o se encaixa com o resto do bolo?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_16
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: Deve ser outro. Talvez este aqui.
    world: 4
    season: 3
    sound: ptbr_ep94_frn_17
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Nossa, n\xE3o tinha percebido esta roseira! Tu \xE9s realmente atento,
      Guardi\xE3o!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_21
    id: 0
    episode: 6
    emotion: happy
    slug: intro
    minigame: 3
  - text: Vou colher algumas. O Malaquias escreveu um bilhete sobre as rosas... onde
      eu o coloquei?
    world: 4
    season: 3
    sound: ptbr_ep94_frn_22
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Aqui est\xE1. J\xE1 peguei 19 rosas. Quantas faltam para termos o que ele
      pede?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_23
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Isso, 17 rosas! Vamos peg\xE1-las, ent\xE3o. E tome cuidado com os espinhos!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_26
    id: 3
    episode: 6
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Acho que n\xE3o \xE9 isso... Vamos ver: as 36 que ele quer, menos as 19
      que j\xE1 peguei... Quantas ficam faltando?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_24
    id: 4
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Vamos fazer as contas juntos. S\xE3o 36 menos 19, e isso... 17!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_25
    id: 5
    episode: 6
    emotion: regular
    slug: error2
    minigame: 3
  - text: "A\xED est\xE1s tu, Malaquias! Est\xE1 tudo pronto. Vamos?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_28
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Tu desejas que revisemos teu poema? Est\xE1s t\xE3o nervoso assim, \xE9?
      Vamos ajud\xE1-lo."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_29
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O poema est\xE1 perfeito agora! Com certeza a Zabumba vai adorar."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_33
    id: 2
    episode: 6
    emotion: happy
    slug: victory
    minigame: 4
  - text: "V\xEA, Guardi\xE3o. Quando a pron\xFAncia de palavras \xE9 igual \xE0 TeRRA,
      coRRo, coRRermos, utilizamos RR nestas palavras, entende?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_30
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Outro segredo importante. No in\xEDcio das palavras, sempre utilizamos
      apenas uma letra R, mesmo com o som sendo igual ao do RR."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_31
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Nas demais ocasi\xF5es, usamos apenas um R. Sempre \xE9 importante lermos
      e escrevermos com cautela e aten\xE7\xE3o, pois assim evitamos erros devido
      \xE0 afoba\xE7\xE3o."
    world: 4
    season: 3
    sound: ptbr_ep94_frn_32
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 4
  - text: "O que foi agora, Malaquias? Qual \xE9 o problema, homem?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_36
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, olha s\xF3 esta express\xE3o embasbacada do mago! Ele parece
      estar em outro planeta!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_37
    id: 1
    episode: 6
    emotion: scared
    slug: intro
    minigame: 5
  - text: "Vamos organizar as ideias dele? Isso deve faz\xEA-lo andar, finalmente!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_38
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: Malaquias? Acorde!
    world: 4
    season: 3
    sound: ptbr_ep94_frn_42
    id: 3
    episode: 6
    emotion: scared
    slug: victory
    minigame: 5
  - text: "Os pensamentos precisam bater com as imagens, ou o Malaquias n\xE3o vai
      sair do lugar. De cara ele pensou em ir correndo aos bra\xE7os da amada. Que
      rom\xE2ntico! Que outras ideias ele tem?"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_39
    id: 4
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Cada frase tem uma imagem correspondente. S\xF3 precisamos junt\xE1-las.
      O nobre Malaquias est\xE1 mesmo doido de amor! At\xE9 voando para os bra\xE7os
      de Zabumba ele pensa que pode ir!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_40
    id: 5
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Doido de amor e tamb\xE9m muito corajoso! Ir voando numa ave super Veloz
      \xE9 uma verdadeira loucura de amor!"
    world: 4
    season: 3
    sound: ptbr_ep94_frn_41
    id: 6
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Guardi\xE3o, funcionou! O p\xE2ntano fedorento est\xE1 secando e \xE1rvores
      e grama est\xE3o crescendo!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_41
    id: 0
    episode: 7
    emotion: happy
    slug: final
    minigame: 
  - text: Ah, o cheiro de folhas, de flores... Meu nariz agradece!
    world: 4
    season: 3
    sound: ptbr_ep95_frn_42
    id: 1
    episode: 7
    emotion: happy
    slug: final
    minigame: 
  - text: "Nosso dever est\xE1 cumprido! Basta agora retornarmos para casa. Vamos?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_43
    id: 2
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "\xD4 de casa! Al\xF4? Podemos entrar?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_01
    id: 3
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Que bom que v\xF3s vos entendestes! Uma bruxa malvada a menos no mundo,
      n\xE3o \xE9? E um cachorro fedido a menos tamb\xE9m!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_02
    id: 4
    episode: 7
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "V\xF3s poder\xEDeis aproveitar que Zabumba n\xE3o \xE9 mais m\xE1 e limpar
      este canto da floresta, n\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_03
    id: 5
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "E \xE9 claro que vamos ajudar. Tu precisas do qu\xEA? Um livro de receitas?
      Onde est\xE1?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_04
    id: 6
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "\"Feiti\xE7o de renascimento de floresta.\" Se ela tinha isso aqui esse
      tempo todo porque n\xE3o usou antes? Bem que este lugar precisava disso!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_11
    id: 7
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Vamos pegar os ingredientes para o feiti\xE7o."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_12
    id: 8
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ser\xE1 que este feiti\xE7o vai funcionar mesmo? N\xE3o aguento mais sentir
      este cheiro terr\xEDvel do p\xE2ntano!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_18
    id: 9
    episode: 7
    emotion: sad
    slug: minigame3
    minigame: 
  - text: "Vamos at\xE9 a mesa. Precisamos pegar as quantidades certas de cada ingrediente."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_19
    id: 10
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Zabumba, e esse ingrediente secreto? Onde tem? No quarto?
    world: 4
    season: 3
    sound: ptbr_ep95_frn_27
    id: 11
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Esta miss\xE3o est\xE1 sendo dif\xEDcil para algu\xE9m com um nariz do
      tamanho do meu. Tudo fede neste lugar!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_33
    id: 12
    episode: 7
    emotion: sad
    slug: minigame5
    minigame: 
  - text: "Muito bem, Zabumba. Aqui est\xE3o todos os ingredientes. Podemos mistur\xE1-los?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_34
    id: 13
    episode: 7
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "\xC9 este mesmo, Guardi\xE3o. Opa! Algumas letras ca\xEDram da capa!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_05
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Livros m\xE1gicos... Este livro s\xF3 se abre se colocarmos as letras de
      volta nos lugares certos. Ajuda-me?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_06
    id: 1
    episode: 7
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Pronto! O livro se abriu. Qual \xE9 a p\xE1gina, Zabumba? Quinze?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_10
    id: 2
    episode: 7
    emotion: regular
    slug: victory
    minigame: 1
  - text: "N\xE3o abriu ainda. Eu me confundo porque algumas vezes o \"S\" tem o som
      de \"Z\". Mas com calma a gente consegue. Olha s\xF3: \"Asa de Morcego cura
      coisa ruim\"."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_07
    id: 3
    episode: 7
    emotion: sad
    slug: error1
    minigame: 1
  - text: "Que coisa esquisita. \"Olha essa frase - \xE9 bem coisa de supersticioso:
      Treze \xE9 o n\xFAmero do azar\"."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_08
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: Vou te ajudar com o que falta.
    world: 4
    season: 3
    sound: ptbr_ep95_frn_09
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Mas que ingredientes mais terr\xEDveis! Por que n\xE3o usar coisas mais
      normais como sal, pimenta e pozinho m\xE1gico?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_13
    id: 0
    episode: 7
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Aqui est\xE1 a receita, Guardi\xE3o. D\xEA uma olhada e anote o que precisamos,
      por favor."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_14
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Olhos de sapo e p\xE9s de lagartixa, \xE9 o mesmo que dizer olhos dele
      e p\xE9s dela... Eca!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_17
    id: 2
    episode: 7
    emotion: scared
    slug: victory
    minigame: 2
  - text: "N\xE3o \xE9 bem isso. Olha o que diz a receita e depois marca a resposta:
      diz que devemos pegar dois olhos DELE, ent\xE3o est\xE3o se referindo ao sapo,
      que \xE9 ELE, n\xE3o ELA."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_15
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Esta receita est\xE1 escrita de um jeito confuso mesmo. Posso ajud\xE1-lo?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_16
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Parece que a lista de ingredientes est\xE1 toda fora de ordem! Deve ser
      para caso algu\xE9m roube o livro para n\xE3o saber us\xE1-lo."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_20
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: Vamos organizar tudo primeiro? Vamos colocar cada ingrediente no intervalo
      certo.
    world: 4
    season: 3
    sound: ptbr_ep95_frn_21
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: Vamos ver pela quantidade de cada coisa.
    world: 4
    season: 3
    sound: ptbr_ep95_frn_22
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que agora est\xE1 tudo organizado. Espera... falta alguma coisa, n\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_26
    id: 3
    episode: 7
    emotion: sad
    slug: victory
    minigame: 3
  - text: "Precisamos ver se o n\xFAmero fica no intervalo aqui pedido... Olha aqui:
      ingredientes com menos de 10 unidades temos os 2 olhos de sapo morto e as 3
      patas de lagartixa secas, lembra?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_23
    id: 4
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Entre 10 e 100 temos o qu\xEA? Aqui constam 23 orelhas de morcego surdo
      e 32 espinhos de rosa. E 23 e 32 s\xE3o maiores do que 10 e menores do que 100
      - ent\xE3o ficam aqui mesmo! E o resto?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_24
    id: 5
    episode: 7
    emotion: regular
    slug: error2
    minigame: 3
  - text: "J\xE1 sei! Podemos colocar estes aqui, deste jeito: 232 e 322 ficam entre
      101 e 1000 e os demais ingredientes, que precisamos em quantidade maior do que
      1000, ficam ali, no \xFAltimo peda\xE7o do caderno."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_25
    id: 6
    episode: 7
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Bom, a bruxa disse que guarda o ingrediente secreto aqui neste quarto,
      em um arm\xE1rio."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_28
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "S\xE3o tr\xEAs arm\xE1rios! Eu n\xE3o quero correr o risco de abrir o errado.
      Vai que explode! Vamos usar esta planta baixa que mostra qual \xE9 o arm\xE1rio
      certo."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_29
    id: 1
    episode: 7
    emotion: scared
    slug: intro
    minigame: 4
  - text: "A\xED est\xE1! O ingrediente secreto! O que ser\xE1 isso? Pelo cheiro deve
      ser chul\xE9 de bruxa."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_32
    id: 2
    episode: 7
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Opa, talvez seja outro! O desenho mostra o arm\xE1rio de frente, mas com
      a porta aberta. Vamos procurar detalhes nos outros dois e comparar com a planta..."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_30
    id: 3
    episode: 7
    emotion: scared
    slug: error1
    minigame: 4
  - text: "Cuidado! Acho que vi um tent\xE1culo saindo da\xED de dentro! Ent\xE3o
      s\xF3 pode ser o outro... Na verdade, eu desconfiei por causa dos cantinhos
      parecendo asas de morcego e da cor azul, reparou?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_31
    id: 4
    episode: 7
    emotion: scared
    slug: error2
    minigame: 4
  - text: "Como se j\xE1 n\xE3o bastasse ajudar uma bruxa, agora estou eu, cavaleiro,
      fazendo feiti\xE7os num caldeir\xE3o!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_35
    id: 0
    episode: 7
    emotion: scared
    slug: intro
    minigame: 5
  - text: "Bom, \xE9 por uma boa causa, n\xE3o \xE9 mesmo? E o Guardi\xE3o dos Sonhos
      est\xE1 ao meu lado, ent\xE3o n\xE3o pode ser coisa ruim."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_36
    id: 1
    episode: 7
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Vamos ler a receita com cuidado. Diga-me quando eu devo colocar esses olhos
      de pulga m\xEDope."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_37
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Opa, est\xE1 borbulhando. Isso \xE9 bom ou ruim?"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_40
    id: 3
    episode: 7
    emotion: scared
    slug: victory
    minigame: 5
  - text: "\xC9 melhor ler com calma, ou \xE9 capaz de transformarmos o p\xE2ntano
      em um deserto!"
    world: 4
    season: 3
    sound: ptbr_ep95_frn_38
    id: 4
    episode: 7
    emotion: scared
    slug: error1
    minigame: 5
  - text: "Creio que o certo \xE9 antes das antenas de lesmas lerdas."
    world: 4
    season: 3
    sound: ptbr_ep95_frn_39
    id: 5
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ora, ele fugiu! Ah, mas duvido que ele volte! Especialmente n\xE3o agora
      que Malaquias e Zabumba est\xE3o juntos!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_39
    id: 0
    episode: 8
    emotion: happy
    slug: final
    minigame: 
  - text: "Ei, v\xF3s precisais mesmo se beijar na nossa frente? Eca!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_40
    id: 1
    episode: 8
    emotion: scared
    slug: final
    minigame: 
  - text: Chega, Mago Malaquias! Outro dia tu voltas a encontrar tua namorada Zabumba!
      Agora precisamos ir!
    world: 4
    season: 3
    sound: ptbr_ep96_frn_01
    id: 2
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos! Tua torre o espera logo ali... u\xE9? Cad\xEA a Torre do Mago? Ser\xE1
      que demoramos tanto assim que ela foi embora?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_02
    id: 3
    episode: 8
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "N\xE3o, espera! N\xE3o \xE9 poss\xEDvel! Guardi\xE3o, a torre sumiu! Como?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_03
    id: 4
    episode: 8
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Algu\xE9m deve ter feito isso, mas quem poderia ser t\xE3o cruel?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_04
    id: 5
    episode: 8
    emotion: sad
    slug: minigame1
    minigame: 
  - text: Precisamos descobrir como exatamente isso aconteceu!
    world: 4
    season: 3
    sound: ptbr_ep96_frn_10
    id: 6
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Olhe, uma \xE1rvore falante! Talvez ela tenha visto alguma coisa."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_11
    id: 7
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Sem sua torre, Malaquias n\xE3o poder\xE1 ajudar as fadas a proteger o
      Sonho!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_17
    id: 8
    episode: 8
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "Precisamos ir at\xE9 onde estava a torre. Pode haver alguma pista por l\xE1."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_18
    id: 9
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Nossa! Ele est\xE1 se transformando em... em alguma coisa! O que fazemos
      com isso?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_25
    id: 10
    episode: 8
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "A torre do Malaquias est\xE1 de volta! Mas que magia impressionante!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_32
    id: 11
    episode: 8
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "E, olhe, \xE9 o Senhor Sombrio, aquele bandido! Vamos ver com o Malaquias
      o que fazer."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_33
    id: 12
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vejamos meu relat\xF3rio de maldades. N\xF3s cavaleiros anotamos aqui tudo
      de ruim que acontece no sonho e quem \xE9 o respons\xE1vel."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_05
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Hoje \xE9 quinta-feira. Quem costuma fazer mais maldades nas quintas-feiras?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_06
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "... Senhor Sombrio! Claro! Foi tudo um plano para tirar o Malaquias da
      torre e roub\xE1-la para ele!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_09
    id: 2
    episode: 8
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Precisamos primeiro localizar a quinta-feira na linha debaixo do gr\xE1fico,
      que mostra os dias da semana. Est\xE1 marcada como 5\xAA. O tamanho da barra
      colorida mostra a quantidade de malvadezas. Qual \xE9 a maior barra?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_07
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "A barra roxa \xE9 disparada a maior! Ela diz que algu\xE9m costuma fazer
      8 maldades neste dia... E pela legenda ao lado a barra roxa corresponde ao..."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_08
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Malaquias, fala com a \xE1rvore. V\xEA o que consegues descobrir."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_12
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Guardi\xE3o, o que eles est\xE3o falando? O que foi que aconteceu?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_13
    id: 1
    episode: 8
    emotion: scared
    slug: intro
    minigame: 2
  - text: "O Senhor Sombrio estava perto da torre e deve ter usado alguma m\xE1quina
      para fazer a torre e ele mesmo desaparecerem!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_16
    id: 2
    episode: 8
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Ser\xE1 que \xE9 isso mesmo? Vamos ver novamente o que eles disseram, pois
      com certeza n\xE3o foi que o sujeito com capuz sumiu antes de chegar \xE0 torre
      de Malaquias... Se fosse assim, n\xE3o teria feito a torre desaparecer."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_14
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Espere, n\xE3o foi isso. Ent\xE3o..."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_15
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Olhe! Parece que o Senhor Sombrio deixou cair este tablet. Isso pode ser
      uma instru\xE7\xE3o de como trazer a torre de volta! Mas, claro, tem algo de
      errado."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_19
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Est\xE1 faltando alguma coisa nestas frases. Precisamos complet\xE1-las
      para descobrir como resolver este mist\xE9rio."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_20
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Perfeito! Parece que \xE9 algum tipo de instru\xE7\xE3o."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_24
    id: 2
    episode: 8
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Opa! H\xE1 algo de errado a\xED. Vamos ler cada frase para saber se faz
      sentido: \"Vou fazer a torre, que \xE9 a casa dele, desaparecer! Porque quero
      que Malaquias fique perdido.\" Que crueldade! O que mais diz aqui?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_21
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ainda h\xE1 algo estranho. Olhe esta! \"Tudo funcionou, mas eles n\xE3o
      podem encontrar este tablet.\" Claro, Guardi\xE3o! O tablet deve dizer como
      fazer reaparecer a torre do Malaquias! Continue, por favor..."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_22
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: E se colocarmos estas palavras aqui no lugar?
    world: 4
    season: 3
    sound: ptbr_ep96_frn_23
    id: 5
    episode: 8
    emotion: regular
    slug: error3
    minigame: 3
  - text: "O que \xE9 isso que tu encontraste a\xED, Guardi\xE3o?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_26
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Parece um pedestal. E falta exatamente esta pe\xE7a que encontramos! Acho
      que \xE9 s\xF3 a colocarmos no lugar certo!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_27
    id: 1
    episode: 8
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Encaixou! E... v\xEA! A torre!"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_31
    id: 2
    episode: 8
    emotion: happy
    slug: victory
    minigame: 4
  - text: "A pe\xE7a precisa estar girada na posi\xE7\xE3o certa, seguindo a sequ\xEAncia
      das outras pe\xE7as."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_28
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Esta n\xE3o me parece a posi\xE7\xE3o certa. Vamos tentar outra."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_29
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Bom, s\xF3 resta uma alternativa."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_30
    id: 5
    episode: 8
    emotion: regular
    slug: error3
    minigame: 4
  - text: A sua torre desapareceu porque o Senhor Sombrio criou um campo de invisibilidade!
    world: 4
    season: 3
    sound: ptbr_ep96_frn_34
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O que est\xE1s dizendo, Malaquias?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_35
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, me dizes uma coisa. Estamos ou n\xE3o estamos falando da mesma
      coisa?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_36
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Viu! Eu disse que n\xF3s est\xE1vamos falando a mesma coisa! Espere um
      pouco... o Senhor Sombrio? Onde?"
    world: 4
    season: 3
    sound: ptbr_ep96_frn_38
    id: 3
    episode: 8
    emotion: scared
    slug: victory
    minigame: 5
  - text: "Tens certeza disso? S\xE3o as mesmas informa\xE7\xF5es, s\xF3 que n\xF3s
      dois estamos dizendo-as de maneiras diferentes, Guardi\xE3o."
    world: 4
    season: 3
    sound: ptbr_ep96_frn_37
    id: 4
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
