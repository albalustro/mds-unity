    world: 1
    season: 3
    sound: ptbr_ep24_bbt_6c
    id: 10
    episode: 8
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Vamos, Guardi\xE3o! Temos uma festa para continuar!"
