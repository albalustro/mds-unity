    season: 3
    sound: ptbr_ep24_bbt_0j_1
    id: 9
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "\xC9 o Senhor Sombrio! Ou ser\xE1 que devemos cham\xE1-lo de Ing\xEAnio?"
