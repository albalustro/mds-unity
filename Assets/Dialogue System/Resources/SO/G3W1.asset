%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G3W1
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "O guardi\xE3o chegou!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0a
    id: 0
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Surpresa! Est\xE1vamos esperando por voc\xEA, para agradecer por tudo que
      voc\xEA e os outros Guardi\xF5es sempre fizeram por n\xF3s!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0b
    id: 1
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eu organizei uma superfesta para voc\xEA e... Sim, eu organizei! Sozinho!
      Ou quase..."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0c
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ora, n\xE3o importa quem fez! O que importa \xE9 que voc\xEA chegou! Vamos,
      vamos! Est\xE3o todos lhe esperando para as fotos!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0d
    id: 3
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Acredita que os Colecionadores ficaram pegando as comidas para guardar
      em suas pr\xF3prias cole\xE7\xF5es? Absurdo!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0e
    id: 4
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Venha, Guardi\xE3o. Ajude-me a organizar os comes e bebes!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0f
    id: 5
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "H\xE1 tantas brincadeiras legais! Pique-esconde, futebol, pescaria..."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0g
    id: 6
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos at\xE9 ali para ver o que h\xE1 para fazer!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0h
    id: 7
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O que \xE9 essa coisa? Guardi\xE3o, voc\xEA vai l\xE1 falar com ele! Eu
      espero aqui!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0i
    id: 8
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Voc\xEA n\xE3o pode... sei l\xE1! Dar um chute na canela dele?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0k
    id: 9
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Todos vieram para a festa! Os Colecionadores trouxeram at\xE9 os seus bichos
      de estima\xE7\xE3o!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Vamos tirar algumas fotos para guardar de recorda\xE7\xE3o? Mas precisamos
      organizar tudo isso direitinho... Cada foto com um conjunto diferente, para
      n\xE3o ficar apertado demais."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: Acho melhor separarmos uma foto por conjunto... Alguma coisa que seja igual
      em todos os que estiverem na foto! Para isso temos que escolher alguma coisa...
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1c
    id: 2
    episode: 1
    emotion: regular
    slug: error0_1
    minigame: 1
  - text: "O que acha de escolher apenas Colecionadores... Ou ent\xE3o apenas os bichos
      de estima\xE7\xE3o para uma foto?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1d
    id: 3
    episode: 1
    emotion: regular
    slug: error0_2
    minigame: 1
  - text: "Pronto! Agora, vamos escolher uma categoria para encontrar mais f\xE1cil
      depois!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1e
    id: 4
    episode: 1
    emotion: regular
    slug: request1
    minigame: 1
  - text: "\xC9 essa a categoria mesmo? Talvez haja outra que se encaixe melhor."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1f
    id: 5
    episode: 1
    emotion: regular
    slug: error1_1
    minigame: 1
  - text: Vamos tentar essa outra etiqueta aqui.
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1g
    id: 6
    episode: 1
    emotion: regular
    slug: error1_2
    minigame: 1
  - text: Pronto! Agora outra foto!
    world: 1
    season: 3
    sound: 
    id: 7
    episode: 1
    emotion: regular
    slug: request2
    minigame: 1
  - text: Muito bom! Vamos deixar os outros tirarem mais fotos. Venha comigo!
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_1h
    id: 8
    episode: 1
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Esses s\xE3o os gar\xE7ons. Eles v\xE3o levar a comida at\xE9 os convidados."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_2a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Pode me ajudar a dividir a comida igualmente entre as bandejas e dizer
      quanto de cada coisa cada gar\xE7om deve levar?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_2b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Acho que vai sobrar comida, hein? Assim \xE9 capaz de a comida estragar!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_2c
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Ser\xE1 que temos tudo isso de comida mesmo? Melhor contar de novo!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_2d
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Precisamos dividir cada comida em quantidades iguais, ou parte dos convidados
      ficar\xE1 sem comida!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_2e
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Gar\xE7ons, podem ajudar aqui a dividir tudo?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_2f
    id: 5
    episode: 1
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Perfeito! Vamos l\xE1! N\xE3o h\xE1 nada pior do que um bando de Colecionadores
      famintos!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_2g
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Nossa, quantas op\xE7\xF5es!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_3a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos sortear os nomes de quem come\xE7ar\xE1 em cada brincadeira!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_3b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, voc\xEA pode me ajudar a colocar as brincadeiras em ordem
      alfab\xE9tica?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_3c
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 que \xE9 essa a ordem certa? Algo me parece estranho."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_3d
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: Colocamos alguma brincadeira fora de ordem aqui...
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_3e
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Vamos ver aqui... Esta que come\xE7a com A vai primeiro, depois vem esta
      e esta..."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_3f
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Olha s\xF3! \xC9 o meu nome! Eu vou brincar primeiro! Oba!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_3g
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 3
  - text: Logo agora que eu ia brincar...
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Quem \xE9 ele?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Tem certeza? N\xE3o parece!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4c
    id: 2
    episode: 1
    emotion: regular
    slug: error_0_1
    minigame: 4
  - text: "Ele \xE9... Deixe-me ver?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4d
    id: 3
    episode: 1
    emotion: regular
    slug: error_0_2
    minigame: 4
  - text: "Um rob\xF4 constru\xEDdo pelo Senhor Sombrio! O que ele quer aqui?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4e
    id: 4
    episode: 1
    emotion: regular
    slug: request1
    minigame: 4
  - text: "Qu\xEA? Ele quer isso mesmo?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4f
    id: 5
    episode: 1
    emotion: regular
    slug: error_1_1
    minigame: 4
  - text: "N\xE3o pode ser isso. Espere um pouco..."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4g
    id: 6
    episode: 1
    emotion: regular
    slug: error_1_2
    minigame: 4
  - text: "Um milh\xE3o de bot\xF5es? Mas isso \xE9 uma fortuna!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_4h
    id: 7
    episode: 1
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Guardi\xE3o, voc\xEA precisa fazer alguma coisa! N\xE3o pode deix\xE1-lo
      levar nossos animais! Nem meus bot\xF5es!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0j
    id: 8
    episode: 1
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Talvez um chute n\xE3o seja boa ideia... Ele \xE9 todo feito de metal!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_5a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O que \xE9 isso? Uma porta!"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_5b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos abri-la agora mesmo! Mas sem barulho! Como devemos fazer isto sem
      o rob\xF4 perceber?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_5c
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Gire... o qu\xEA? Tem certeza do que est\xE1 me dizendo?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_5d
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: Acho que precisamos pensar com calma!
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_5e
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Cuidado para n\xE3o fazer barulho! Vamos tentar assim..."
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_5f_1
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Funciona! Olha essa coisa est\xE1 se abrindo!"
    world: 1
    season: 3
    sound: ptbr_ep3_bbt_4t
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Espere um pouco! Por que eu entrei em um rob\xF4 gigante do mal?"
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0l
    id: 7
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: Ai, ai, ai...
    world: 1
    season: 3
    sound: ptbr_ep17_bbt_0m
    id: 8
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Lembre-me o porqu\xEA de estarmos dentro de um rob\xF4 gigante enviado
      pelo Senhor Sombrio."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0a
    id: 0
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Certo, precisamos salvar os animais capturados pelo rob\xF4... Mas eu preciso
      mesmo vir com voc\xEA? N\xE3o \xE9... perigoso?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0b
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Tudo bem... Tudo bem... Eu o ajudarei!
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0c
    id: 2
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Agora... Para onde vamos?
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0d
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Certo! Vamos indo?
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0e
    id: 4
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Acho que os animais pequenos est\xE3o assustados. Vamos ver o que podemos
      fazer pra ajud\xE1-los?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0f
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Est\xE3o todos prontos? Acho melhor sairmos daqui o quanto antes!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0g
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O que \xE9 aquilo ali? Pode ser \xFAtil!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0h
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O rob\xF4 est\xE1 se movendo? Olhe pela janela, Guardi\xE3o. Talvez nos
      d\xEA uma pista de onde estamos!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0i
    id: 8
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Mas que cheiro terr\xEDvel \xE9 esse? Vamos olhar naquele monitor."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0j
    id: 9
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Esse t\xFAnel parece bem apertado! Eu n\xE3o preciso entrar a\xED n\xE3o,
      n\xE3o \xE9?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Tenho uma ideia! Voc\xEA vai pelo t\xFAnel e eu vou guiando voc\xEA daqui
      de fora!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: Primeiro siga para o norte.
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1c
    id: 2
    episode: 2
    emotion: regular
    slug: request_0
    minigame: 1
  - text: Encontramos um dos animaizinhos! Vamos seguir para o leste agora.
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1e
    id: 3
    episode: 2
    emotion: regular
    slug: request_1
    minigame: 1
  - text: "Mais um! Que legal! Agora v\xE1 para o sul."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1g
    id: 4
    episode: 2
    emotion: regular
    slug: request_2
    minigame: 1
  - text: "Eba, voc\xEA encontrou mais um! Certo, agora leste novamente."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1i
    id: 5
    episode: 2
    emotion: regular
    slug: request_3
    minigame: 1
  - text: "Um, dois, tr\xEAs, quatro animais de estima\xE7\xE3o encontrados! Vejamos
      aqui... agora v\xE1 para o norte!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1k
    id: 6
    episode: 2
    emotion: regular
    slug: request_4
    minigame: 1
  - text: "Cinco animais! Nossa, acho que j\xE1 devem ter sido todos! V\xE1 para o
      oeste agora."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1m
    id: 7
    episode: 2
    emotion: regular
    slug: request_5
    minigame: 1
  - text: "N\xE3o, n\xE3o. Esse \xE9 um beco sem sa\xEDda! O norte \xE9 por ali..."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1d
    id: 8
    episode: 2
    emotion: regular
    slug: error0
    minigame: 1
  - text: Opa! Caminho errado! Siga para o leste!
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1f
    id: 9
    episode: 2
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Caramba! N\xE3o \xE9 esse o caminho. O sul \xE9 para c\xE1!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1h
    id: 10
    episode: 2
    emotion: regular
    slug: error2
    minigame: 1
  - text: "O que eu disse mesmo? N\xE3o, \xE9 para o leste! Venha!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1j
    id: 11
    episode: 2
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Ser\xE1 que eu disse errado? Norte! Por aqui!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1l
    id: 12
    episode: 2
    emotion: regular
    slug: error4
    minigame: 1
  - text: "Beco sem sa\xEDda! Vamos voltar e seguir para o oeste!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1o
    id: 13
    episode: 2
    emotion: regular
    slug: error5
    minigame: 1
  - text: Legal! Seis animais! Acho que encontramos todos, certo?
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_1p
    id: 14
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: Cuidado! Os filhotes tentam se proteger... Acho melhor deixar cada filhote
      quietinho e trazer os adultos para perto!
    world: 1
    season: 3
    sound: 
    id: 0
    episode: 2
    emotion: regular
    slug: touchAnimal
    minigame: 2
  - text: "Os pequeninos est\xE3o com medo! Ora, eu os entendo... N\xE3o que eu tenha
      medo, \xE9 claro..."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_2a
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vamos colocar os animais maiores perto dos menores. Assim eles se sentir\xE3o
      protegidos!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_2b
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: Ele ficou com medo! Melhor trazer o adulto do mesmo tipo para proteger o
      filhote!
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_2d
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Que confus\xE3o! Deixe-me ajudar."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_2e
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Pronto! Assim cada bichinho se sente protegido ao lado de um mais velho
      da sua mesma esp\xE9cie! Melhor assim, n\xE3o \xE9 mesmo?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_2f
    id: 5
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Veja! \xC1gua, luz, comida... parece que \xE9 exatamente o que esses bichos
      precisam! Esses bichinhos ficaram muito tempo presos naquelas jaulas terr\xEDveis
      sem comida, \xE1gua e luz!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_3a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Podemos cuidar deles antes de partir, n\xE3o? Voc\xEA me ajuda a dar a
      eles aquilo que pedirem?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_3b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Por enquanto acho que isto \xE9 suficiente. Quando estiverem em suas casas
      eles se alimentar\xE3o melhor."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_3c
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Pronto! Acho que j\xE1 est\xE3o satisfeitos e felizes agora! Por isso \xE9
      importante deixarmos os bichinhos sempre bem alimentados."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_3d
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Esse rob\xF4 pirado est\xE1 indo embora! Olhe para esses lugares! \xC9
      de onde os animais vieram!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_4a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Vamos aproveitar para colocar cada animal no seu habitat natural antes
      que o rob\xF4 v\xE1 embora!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_4b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Mas lembre-se, cada animal vive em um tipo de lugar! Vamos l\xE1?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_4b1
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: Opa! Deixa que eu colocar este aqui em seu habitat e...
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_4c
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Agora sim! Todos os animais est\xE3o de volta aos seus habitats naturais!
      Olhe como est\xE3o felizes!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_4d
    id: 4
    episode: 2
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Nossa! Esse rob\xF4 est\xE1 soltando muita polui\xE7\xE3o l\xE1 fora! Vai
      acabar estragando todo o Sonho das Coisas Perdidas!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_5a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: E os animaizinhos que acabamos de libertar! Coitados!
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_5b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, vamos colocar cada tipo de poluente no lugar certo, assim
      consertamos essa geringon\xE7a! Vamos come\xE7ar?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_5c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Opa! Conseguimos diminuir a polui\xE7\xE3o e isso j\xE1 \xE9 uma grande
      ajuda."
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_5d
    id: 3
    episode: 2
    emotion: regular
    slug: lose
    minigame: 5
  - text: "Pronto! Cuidamos dessa polui\xE7\xE3o horrorosa! Nossos amigos animaizinhos
      est\xE3o seguros agora!"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_5e
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Ent\xE3o? Podemos ir embora agora?"
    world: 1
    season: 3
    sound: ptbr_ep18_bbt_0l
    id: 5
    episode: 2
    emotion: regular
    slug: end
    minigame: 5
  - text: "N\xE3o? Temos que... deter o rob\xF4? Voc\xEA tem certeza? Certeza absoluta?"
