    season: 3
    sound: ptbr_ep24_bbt_5e_1
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ele vai me pegar! Eu o ajudo a colocar essas \xFAltimas placas no lugar!"
