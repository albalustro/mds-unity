    season: 3
    sound: ptbr_ep24_bbt_3b
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 que \xE9 isso mesmo? Acho que \xE9 outra palavra."
