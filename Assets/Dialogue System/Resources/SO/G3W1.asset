    world: 1
    season: 3
    sound: ptbr_ep24_bbt_4b
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ser\xE1 que \xE9 isso mesmo? N\xE3o parece algo que o Mestre dos Sonhos
