%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G1W3
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "Oi! Voc\xEA \xE9 um Guardi\xE3o dos Sonhos? Vamos, me siga!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_01
    id: 0
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "N\xE3o temos tempo para conversar agora! Os Filhos do Trov\xE3o est\xE3o
      atacando a cidade e ningu\xE9m sabe o porqu\xEA!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_02
    id: 1
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Est\xE1 vendo aquela torre l\xE1 em cima? Ela \xE9 o para-raios de Stratus.
      Precisamos lig\xE1-lo antes que toda a cidade seja destru\xEDda!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_03
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Espero que voc\xEA saiba pilotar uma prancha voadora, porque a queda ia
      ser bem desagrad\xE1vel!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_04
    id: 3
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Meu nome \xE9 Nimbus, a mais destemida cidad\xE3 de Stratus, campe\xE3
      mundial de surfe a\xE9reo e, pelo que parece, a \xFAnica maluca o suficiente
      para tentar salvar essa cidade!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_13
    id: 4
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Precisamos arrumar um jeito de entrar na torre. E tem que ser logo!
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_14
    id: 5
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Nunca vi os Filhos do Trov\xE3o t\xE3o irados. Eles s\xE3o barulhentos
      e vivem trovejando, claro, mas n\xE3o assim, desse jeito!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_22
    id: 6
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos logo ligar o para-raios. Talvez depois possamos descobrir o que est\xE1
      acontecendo."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_23
    id: 7
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O para-raios fica aqui. Ou... deveria... Onde est\xE1 o para-raios?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_31
    id: 8
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: Agora, onde ligamos esta coisa?
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_38
    id: 9
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Deve haver algum tipo de bateria ou coisa parecida por a\xED. Consegue
      ver alguma coisa dessas?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_39
    id: 10
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Parece que os Filhos do Trov\xE3o est\xE3o indo embora. Devem ter percebido
      que o para-raios protege a cidade."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_47
    id: 11
    episode: 1
    emotion: regular
    slug: final
    minigame: 
  - text: "Agora a quest\xE3o \xE9: por que os Filhos do Trov\xE3o estavam atacando
      Stratus? Preparado para investigar um mist\xE9rio, Guardi\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_48
    id: 12
    episode: 1
    emotion: regular
    slug: final
    minigame: 
  - text: "N\xE3o d\xE1 para enxergar nada no meio desta neblina, mas n\xE3o se preocupe!
      Eu posso voar por Stratus de olhos fechados. Quer ver?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_05
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "\xC9 s\xF3 voc\xEA seguir minhas instru\xE7\xF5es e chegaremos \xE0 torre
      sem nos esborracharmos nem nada. Vire \xE0 esquerda... agora!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Cuidado! Disse esquerda, Guardi\xE3o. Acho que preciso gritar por cima
      desse vento todo!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_07
    id: 2
    episode: 1
    emotion: regular
    slug: error0_1
    minigame: 1
  - text: "Est\xE1 vendo a sorveteria? Vamos naquela dire\xE7\xE3o agora."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_08
    id: 3
    episode: 1
    emotion: regular
    slug: request1
    minigame: 1
  - text: "Olha o poste! Nossa, voc\xEA gosta de viver perigosamente, n\xE3o \xE9?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_09
    id: 4
    episode: 1
    emotion: regular
    slug: error1_1
    minigame: 1
  - text: "Agora \xE9 s\xF3 encontrar a placa que indica o caminho da torre. Voc\xEA
      consegue v\xEA-la da\xED?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_10
    id: 5
    episode: 1
    emotion: regular
    slug: request2
    minigame: 1
  - text: "Isso n\xE3o \xE9 hora de ir ao Banco de Stratus, Guardi\xE3o! A cidade
      est\xE1 em perigo!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_11
    id: 6
    episode: 1
    emotion: regular
    slug: error2_1
    minigame: 1
  - text: "Estamos quase l\xE1! J\xE1 posso ver a torre daqui!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_12
    id: 7
    episode: 1
    emotion: regular
    slug: victory
    minigame: 1
  - text: "O guarda que cuidava da torre deve ter fugido no ataque, mas deixou umas
      coisas para tr\xE1s."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_15
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Deve haver uma instru\xE7\xE3o em algum lugar. Uma dessas coisas deve abrir
      a porta."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_16
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Aqui est\xE1! A coisa que abre a porta n\xE3o \xE9 de comer, \xE9 de metal
      e \xE9 da cor azul! O que se parece com isso, Guardi\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_17
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Se n\xE3o \xE9 de comer, n\xE3o pode ser o sandu\xEDche e nem a ma\xE7\xE3...
      Mas tem que ser de metal e da cor azul!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_18
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Vejamos, se n\xE3o \xE9 de comer e \xE9 de metal, ent\xE3o pode ser o garfo,
      a chave de ouro ou a chave de ferro. Mas tamb\xE9m tem que ser azul..."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_19
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Aqui, veja! O que n\xE3o \xE9 de comer, \xE9 de metal e \xE9 azul \xE9
      a chave de ferro! Tomara que funcione..."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_20
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: "\xC9 isso mesmo! Excelente, Guardi\xE3o. Bom trabalho!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_21
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Droga! Os raios partiram as escadas! E n\xE3o h\xE1 vento aqui para minha
      prancha nos levar at\xE9 o alto."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_24
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Dev\xEDamos mandar a conta do conserto para o Trov\xE3o. Ele que cuide
      dos estragos dos filhos!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_25
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos precisar remontar essas escadas de algum jeito, ou nunca chegaremos
      l\xE1 em cima."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_26
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Pelo que parece, as escadas seguem um padr\xE3o. \xC9 s\xF3 segui-lo que
      estamos no caminho certo."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_27
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: Estes degraus se encaixam... aqui. Como fica o resto?
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_28
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Precisamos seguir a sequ\xEAncia certa, ou a escada pode desmoronar enquanto
      subimos."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_29
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Bom trabalho! Vamos subir! Estamos quase l\xE1!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_30
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Como assim, ele est\xE1 desmontado? \xC9 muito azar mesmo!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_32
    id: 0
    episode: 1
    emotion: sad
    slug: intro
    minigame: 4
  - text: "Precisamos montar o para-raios n\xF3s mesmos. Ele precisa ter mais de 9
      pe\xE7as, mas n\xE3o mais do que 15, hein!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_33
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Devagar, cientista! Se o para-raios tiver mais de 15 pe\xE7as ele pode
      puxar todos os raios do sonho. E haja nuvem nesse sonho!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_35
    id: 2
    episode: 1
    emotion: scared
    slug: above
    minigame: 4
  - text: "N\xE3o \xE9 o suficiente. Se n\xE3o tiver pelo menos 9 pe\xE7as o para-raios
      n\xE3o aguentar\xE1 a carga e pode derreter!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_34
    id: 3
    episode: 1
    emotion: regular
    slug: bellow
    minigame: 4
  - text: "Vamos tentar colocar estas pe\xE7as aqui. Acho que \xE9 o suficiente."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_36
    id: 4
    episode: 1
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Isso! Duvido que algu\xE9m consiga montar um para-raios mais perfeito do
      que n\xF3s!"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_37
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Voc\xEA encontrou! Muito bom, Guardi\xE3o."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_40
    id: 0
    episode: 1
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Esta bateria armazena os raios. Sem ela o para-raios iria acabar fritando
      a torre e n\xF3s dois juntos! N\xE3o sei quanto a voc\xEA, mas eu n\xE3o quero
      virar vela derretida."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_41
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Precisamos colocar estas pedras dentro da bateria, na ordem da mais clara
      para a mais escura. A\xED a bateria vai funcionar."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_42
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "As pedras mais claras absorvem mais energia, ent\xE3o precisam ficar na
      frente."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_43
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Se n\xE3o colocarmos da pedra mais clara para a mais escura, elas podem
      se partir."
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_44
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Vamos alinh\xE1-las assim. O que acha?"
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_45
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 5
  - text: Legal! Agora vamos sair de perto antes que um raio o atinja!
    world: 3
    season: 1
    sound: ptbr_ep49_nbs_46
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Olhe os estragos que essas nuvens arruaceiras fizeram em Stratus! Vamos
      levar um temp\xE3o para consertar tudo!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_01
    id: 0
    episode: 2
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Minha vontade \xE9 de ir \xE0 casa do Trov\xE3o e ter uma bela conversa
      com essas nuvens, uma por uma! Eu ia falar tanto..."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_02
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas isso vai ter que ficar para depois... Primeiro vamos ver em que podemos
      ajudar por aqui. Voc\xEA me d\xE1 uma m\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_03
    id: 2
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Veja se encontra algum problema que possamos resolver.
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_04
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Parece que al\xE9m dos raios, os ventos dos Filhos do Trov\xE3o causaram
      um belo estrago. Olha quanta coisa espalhada."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_11
    id: 4
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Acho que ali \xE9 o Arquivo Nacional de Stratus. Talvez possamos ajudar
      por l\xE1."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_12
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Voc\xEA est\xE1 ouvindo esse barulho? Parecem animais..."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_19
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vem do Zool\xF3gico de Stratus! Os animais est\xE3o soltos!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_20
    id: 7
    episode: 2
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "Que fila \xE9 essa? \xC9 para dar bronca nos Filhos do Trov\xE3o? Vamos
      l\xE1 ver!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_28
    id: 8
    episode: 2
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "Acho que podemos pegar o navio voador do meu pai e ir atr\xE1s dos Filhos
      do Trov\xE3o."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_33
    id: 9
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "N\xE3o... O que \xE9 agora?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_34
    id: 10
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "J\xE1 deu, n\xE3o \xE9? Podemos ir atr\xE1s dos Filhos do Trov\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_39
    id: 11
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Mas eu vou dizer umas poucas e boas para esse Trov\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_40
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Nossa! Olha esse fogo! Precisamos apag\xE1-lo antes que ponha em risco
      a sa\xFAde dos animais e das plantas do parque!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_05
    id: 0
    episode: 2
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Um dos raios quebrou o cano d'\xE1gua. Vamos remont\xE1-lo e usar a \xE1gua
      para apagar o fogo."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ser\xE1 que essas pe\xE7as est\xE3o encaixadas direito?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_07
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 1
  - text: "E se n\xF3s seguirmos o desenho original?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_08
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Vamos colocar estas \xFAltimas pe\xE7as e apagar este inc\xEAndio."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_09
    id: 4
    episode: 2
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Resolvemos! O ar j\xE1 at\xE9 est\xE1 mais fresco e limpo. \xD3timo para
      surfar!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_10
    id: 5
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Documentos importantes sobre a hist\xF3ria da cidade e deste Sonho ficam
      guardados aqui, mas os ventos jogaram tudo no ch\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_13
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vamos separar os registros hist\xF3ricos do lixo e preservar a mem\xF3ria
      de Stratus!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_14
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "S\xF3 podemos guardar registros como cartas, fotos e calend\xE1rios importantes."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_15
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 2
  - text: "O lixo pode ficar de fora, n\xE3o \xE9?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_16
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Os galhos, cacos e outras coisas que n\xE3o precisam ser guardadas deixamos
      de fora."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_17
    id: 4
    episode: 2
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Pronto! Agora \xE9 proteger esses registros para que ningu\xE9m se esque\xE7a
      do que j\xE1 aconteceu no passado."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_18
    id: 5
    episode: 2
    emotion: happy
    slug: victory
    minigame: 2
  - text: "O alto das nuvens \xE9 um lugar perigoso para muitos animais. \xC9 por
      isso que mantemos aqueles que encontramos perdidos ou feridos aqui no zool\xF3gico."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_21
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "S\xF3 que cada animal precisa ficar em um lugar parecido com o que ele
      nasceu, ou ele pode n\xE3o sobreviver."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_22
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: Precisamos colocar cada animal de volta ao lugar onde deviam estar. Me ajuda?
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_23
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Cada animal tem um lugar ideal para morar. Eles n\xE3o ficar\xE3o felizes
      em outro lugar."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_24
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Parece que algum animal ficou em um lugar diferente. Vamos tentar outra
      combina\xE7\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_25
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Acho que \xE9 assim ... Passarinho na \xE1rvore, tatu na terra e o peixe,
      na \xE1gua."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_26
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Pronto! Animais felizes! Acho que podemos ir agora ter aquela conversinha
      mais s\xE9ria com as nuvens guerreiras, n\xE3o \xE9?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_27
    id: 6
    episode: 2
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Parece que s\xE3o s\xF3 pessoas que perderam coisas importantes. E est\xE3o
      reclamando que n\xE3o sabem mais as horas e datas dos seus compromissos!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_29
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: Acho melhor ajudarmos. Vamos separar tudo que sirva para marcar o tempo,
      e depois distribuir para seus donos.
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_30
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: 
    world: 3
    season: 1
    sound: 
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 4
  - text: 
    world: 3
    season: 1
    sound: 
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 4
  - text: 
    world: 3
    season: 1
    sound: 
    id: 4
    episode: 2
    emotion: regular
    slug: error3
    minigame: 4
  - text: Pronto? Todo mundo satisfeito? Podemos ir embora?
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_31
    id: 5
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Olha, Guardi\xE3o, melhor irmos logo antes que apare\xE7a mais algum problema!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_32
    id: 6
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "N\xE3o acredito! Os papa-nuvens est\xE3o devorando nossas planta\xE7\xF5es!
      Onde est\xE3o os p\xE1ssaros que deviam proteger este lugar?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_35
    id: 0
    episode: 2
    emotion: sad
    slug: intro
    minigame: 5
  - text: "Stratus consome muitas nuvens todos os dias, ent\xE3o plantamos muitas
      mais para repor o que consumimos. \xC9 o \xFAnico jeito de n\xE3o ferir o meio
      ambiente."
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_36
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Precisamos colocar um p\xE1ssaro em cada nuvem, se n\xE3o ela ser\xE1 perdida!
      Preparado?"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_37
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: 
    world: 3
    season: 1
    sound: 
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 5
  - text: 
    world: 3
    season: 1
    sound: 
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 5
  - text: 
    world: 3
    season: 1
    sound: 
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Isso dar\xE1 um jeito nestes bichos de uma figa!"
    world: 3
    season: 1
    sound: ptbr_ep50_nbs_38
    id: 6
    episode: 2
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Sabia que meu pai n\xE3o ia se importar em nos emprestar o navio dele.
      Claro que no caso ele ainda n\xE3o sabe que eu peguei o Gavi\xE3o Secular, n\xE3o
      \xE9?"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_01
    id: 0
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas ele n\xE3o vai se importar, claro. N\xE3o quando souber que eu o peguei
      para ir at\xE9 a Grande Nuvem falar umas poucas e boas para o Trov\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_02
    id: 1
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vou chegar l\xE1 com o p\xE9 na porta e \"Escuta aqui, Trov\xE3o! Sabe
      com quem voc\xEA est\xE1 falando? Eu sou uma Guardi\xE3!\" Bom, voc\xEA \xE9,
      no caso, mas acho que ia soar legal, n\xE3o \xE9? N\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_03
    id: 2
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei, o que \xE9 essa m\xFAsica? Voc\xEA est\xE1 murmurando uma m\xFAsica?"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_04
    id: 3
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ufa! Essa foi por pouco. N\xE3o queria ter de explicar pro meu pai porque
      o Gavi\xE3o Secular virou pat\xEA de barco!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_16
    id: 4
    episode: 3
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "J\xE1 devemos estar chegando ao desfiladeiro das cascatas. \xC9 melhor
      carregar o propulsor de manobras do barco."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_17
    id: 5
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ei, o que foi essa sombra? Eu tive a impress\xE3o que..."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_24
    id: 6
    episode: 3
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "P\xE1ssaros-drag\xE3o! Ei, n\xF3s n\xE3o somos uma baleia voadora, c\xE9rebros
      de minhoca! Guardi\xE3o, precisamos soprar esses bichos para bem longe!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_25
    id: 7
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Olha, Guardi\xE3o! Parece que os p\xE1ssaros-drag\xE3o atacaram outro navio!
      Vamos ajud\xE1-lo!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_33
    id: 8
    episode: 3
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Estranha essa hist\xF3ria de rob\xF4s, n\xE3o? Ser\xE1 algum novo pirata
      que n\xE3o conhecemos?"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_42
    id: 9
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "L\xE1 est\xE1 a Grande Nuvem do Trov\xE3o. Vamos atracar o navio."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_43
    id: 10
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Estou louca para bater um papinho pessoalmente com o Trov\xE3o. Mas ele
      vai se ver comigo!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_52
    id: 11
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: "\xC9 um grupo de baleias voadoras! Ia ser muito maneiro surfar entre elas!
      Mas n\xE3o com o Gavi\xE3o Secular! Ele \xE9 grande demais!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_05
    id: 0
    episode: 3
    emotion: happy
    slug: intro
    minigame: 1
  - text: "Ajude-me a encontrar o repelente de baleias! Tudo que n\xE3o for do jeito
      que eu explicar, voc\xEA tira fora, est\xE1 bem? Lembro que ele n\xE3o tem uma
      caveira desenhada."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_06
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ele n\xE3o tem uma caveira. Vamos tirar tudo o que tem caveira desenhada?"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_07
    id: 2
    episode: 3
    emotion: regular
    slug: error0_1
    minigame: 1
  - text: "Estes aqui t\xEAm caveira, ent\xE3o n\xE3o s\xE3o o repelente de baleias."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_08
    id: 3
    episode: 3
    emotion: regular
    slug: error0_2
    minigame: 1
  - text: "Muito bom. Agora, com certeza, o repelente n\xE3o \xE9 vermelho."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_09
    id: 4
    episode: 3
    emotion: regular
    slug: request1
    minigame: 1
  - text: Temos coisas vermelhas, verdes e azuis... vamos tirar os objetos vermelhos
      para encontrarmos o repelente?
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_10
    id: 5
    episode: 3
    emotion: regular
    slug: error1_1
    minigame: 1
  - text: "Estas coisas s\xE3o vermelhas, ent\xE3o n\xE3o s\xE3o o repelente."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_11
    id: 6
    episode: 3
    emotion: regular
    slug: error1_2
    minigame: 1
  - text: "Lembrei! \xC9 azul! O repelente contra baleias voadoras \xE9 azul! Vamos
      tirar o resto!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_12
    id: 7
    episode: 3
    emotion: regular
    slug: request2
    minigame: 1
  - text: "Precisamos tirar tudo o que n\xE3o \xE9 azul da nossa frente."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_13
    id: 8
    episode: 3
    emotion: regular
    slug: error2_1
    minigame: 1
  - text: Aqui, pronto! Tiramos o que tem caveira e as coisas verdes e vermelhas...
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_14
    id: 9
    episode: 3
    emotion: regular
    slug: error2_2
    minigame: 1
  - text: "A\xED est\xE1 o repelente contra baleias voadoras!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_15
    id: 10
    episode: 3
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Lembra-se das pedras que capturaram os raios dos Filhos do Trov\xE3o? \xC9
      para isso que as usamos."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_18
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: Cada tipo de manobra precisa de um tamanho de pedra. Coloque cada uma no
      seu devido lugar para que possamos passar pelo desfiladeiro sem problemas.
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_19
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Se n\xE3o funcionou, \xE9 porque tem alguma pedra no lugar errado. Vamos
      observar pelo tamanho do encaixe."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_20
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Ainda n\xE3o ligou tudo. Tente colocar as pedras que sobraram em outros
      encaixes."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_21
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 2
  - text: Vamos colocar o que faltou e... pronto.
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_22
    id: 4
    episode: 3
    emotion: regular
    slug: error3
    minigame: 2
  - text: "O Gavi\xE3o Secular est\xE1 preparado para passar pelo desfiladeiro!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_23
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Nossos navios sempre t\xEAm canh\xF5es de sopro. N\xE3o s\xF3 ajudam a
      enxergar em dias nublados como tamb\xE9m afastam esse tipo de predador."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_26
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "P\xE1ssaros-drag\xE3o adoram atacar baleias voadoras, mas n\xE3o t\xEAm
      coragem de atacar um grupo inteiro. Esses a\xED devem achar que n\xF3s somos
      um filhote que se separou do grupo."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_27
    id: 1
    episode: 3
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Enquanto eu piloto, voc\xEA precisa carregar o canh\xE3o com 10 nuvens.
      Quando estiver pronto, \xE9 s\xF3 puxar a alavanca para disparar."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_28
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Opa! Acho que o canh\xE3o est\xE1 com a quantidade de nuvens diferente
      do que precisa para funcionar. Ele n\xE3o pode ter menos ou mais do que 10 nuvens."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_29
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Veja quantas nuvens tem em cada grupo. A soma das nuvens no canh\xE3o deve
      ser 10."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_30
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Vou te dar uma m\xE3o para n\xE3o correr o risco dos p\xE1ssaros-drag\xE3o
      nos atacarem."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_31
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Boa, Guardi\xE3o! Tchauzinho, cabe\xE7as de minhoca! V\xE3o procurar comida
      em outro lugar!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_32
    id: 6
    episode: 3
    emotion: happy
    slug: victory
    minigame: 3
  - text: "O que aconteceu aqui? N\xE3o foram os p\xE1ssaros-drag\xE3o que o atacaram
      e sim rob\xF4s!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_34
    id: 0
    episode: 3
    emotion: scared
    slug: intro
    minigame: 4
  - text: "Bom, vamos ajud\xE1-lo primeiro e depois vemos isso. Acho que 15 nuvens
      de ar ser\xE3o o suficiente."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_35
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Com mais do que 15, o bal\xE3o vai estourar!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_36
    id: 2
    episode: 3
    emotion: regular
    slug: error_more_1
    minigame: 4
  - text: "Temos que contar com calma, 15 \xE9 menos do que esse tanto de nuvens que
      voc\xEA colocou."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_38
    id: 3
    episode: 3
    emotion: regular
    slug: error_more_2
    minigame: 4
  - text: Com menos do que 15, o navio vai cair.
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_37
    id: 4
    episode: 3
    emotion: regular
    slug: error_less_1
    minigame: 4
  - text: "N\xE3o \xE9 melhor recontar? Acho que ainda est\xE1 faltando nuvens a\xED
      para chegar a 15."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_39
    id: 5
    episode: 3
    emotion: regular
    slug: error_less_2
    minigame: 4
  - text: "Vamos checar e ver se a quantidade \xE9 essa."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_40
    id: 6
    episode: 3
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Exatamente! 15 nuvens de ar! Agora me conte essa hist\xF3ria sobre rob\xF4s
      no Sonho das Nuvens Guerreiras..."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_41
    id: 7
    episode: 3
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Espera, Guardi\xE3o. Preciso ligar o alarme do navio antes de irmos. Vai
      que algum pirata a\xE9reo aparece por aqui e tenta roubar o Gavi\xE3o Secular!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_44
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Meu pai fez fama lutando contra esses piratas a\xE9reos que rondam essas
      nuvens, sabia? Um dia serei uma guerreira como ele!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_45
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Pronto, coloquei minha senha. Agora voc\xEA precisa colocar a sua. \xC9
      s\xF3 escrever o que voc\xEA quiser, mas precisa ter letras e n\xFAmeros, hein!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_46
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: Deixa eu completar sua senha colocando uma letra.
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_50
    id: 3
    episode: 3
    emotion: regular
    slug: error1_l
    minigame: 5
  - text: "Deixa eu completar sua senha colocando um n\xFAmero."
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_49
    id: 4
    episode: 3
    emotion: happy
    slug: error1_n
    minigame: 5
  - text: "Agora sim. Uma senha com letras e n\xFAmeros! Podemos ir!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_51
    id: 5
    episode: 3
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Estou louca para bater um papinho pessoalmente com o Trov\xE3o. Mas ele
      vai se ver comigo!"
    world: 3
    season: 1
    sound: ptbr_ep51_nbs_52
    id: 6
    episode: 3
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Finalmente estamos na Grande Nuvem! Agora, se conseguirmos uma audi\xEAncia
      com o Trov\xE3o, podemos descobrir porque seus filhos atacaram Stratus."
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_01
    id: 0
    episode: 4
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Eu devia ter imaginado. O Pr\xEDncipe Tormenta, filho mais velho do Trov\xE3o,
      exige que passemos por uma s\xE9rie de desafios para provar que somos dignos
      de uma audi\xEAncia!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_02
    id: 1
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "N\xE3o tem problema! Eu aposto que podemos ser nuvens guerreiras melhores
      do que os Filhos do Trov\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_03
    id: 2
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos come\xE7ar logo com esses desafios. Qual \xE9 o primeiro?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_04
    id: 3
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Como assim ainda n\xE3o ganhamos? N\xF3s fizemos as nuvens ficarem chuvosas,
      n\xE3o fizemos?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_11
    id: 4
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Bom, nem s\xF3 de chuva vive uma nuvem guerreira, n\xE3o \xE9? Qual \xE9
      o pr\xF3ximo desafio?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_12
    id: 5
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Acho que eles n\xE3o est\xE3o gostando nada disso. Estamos conseguindo!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_19
    id: 6
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Outro desafio? O que h\xE1 nesse cano comprido de t\xE3o desafiador?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_20
    id: 7
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Acho melhor fazermos alguma coisa para distrair os Filhos do Trov\xE3o
      ou eles continuar\xE3o a sabotar nossos desafios!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_28
    id: 8
    episode: 4
    emotion: sad
    slug: minigame4
    minigame: 
  - text: "Acabou, ent\xE3o? Provamos que somos chuvosos e barulhentos, que sabemos
      soprar forte e at\xE9 fazer picol\xE9s! Podemos falar com o Trov\xE3o agora?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_39
    id: 9
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Como assim um \xFAltimo desafio? Que tipo de desafio poderia estar faltando?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_40
    id: 10
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Pronto, Filhos do Trov\xE3o! Provamos que somos dignos de uma audi\xEAncia!
      Onde est\xE1 o Trov\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_48
    id: 11
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "Ei, olhe, \xE9 o Pr\xEDncipe Tormenta! Que cara de preocupado \xE9 essa?
      Ser\xE1 que aconteceu alguma coisa com o Trov\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_49
    id: 12
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "\xC9, Guardi\xE3o... algo me diz que nossa aventura n\xE3o acaba aqui!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_50
    id: 13
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "Ser t\xE3o chuvoso quanto uma nuvem guerreira? Mas que tipo de desafio
      \xE9 esse?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_05
    id: 0
    episode: 4
    emotion: scared
    slug: intro
    minigame: 1
  - text: "T\xE1 certo, ent\xE3o. Vamos dividir estas gotas de chuva igualmente entre
      cada nuvem. Isso deve provar que podemos ser chuvosos!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_06
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: Acho que cada nuvem deve ter a mesma quantidade de gotas. Temos 25 gotas
      no total.
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_07
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 1
  - text: Se temos cinco nuvens e 25 gotas, quantas gotas devemos colocar em cada
      nuvem?
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_08
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Se n\xE3o estou enganada, acho que cada nuvem precisa ter 5 gotas exatamente,
      certo?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_09
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 1
  - text: "A\xED est\xE3o suas nuvens chuvosas! Ganhamos!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_10
    id: 5
    episode: 4
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Barulhento? N\xF3s podemos ser barulhentos. Ouvi dizer que o Guardi\xE3o
      aqui ronca \xE0 be\xE7a!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_13
    id: 0
    episode: 4
    emotion: happy
    slug: intro
    minigame: 2
  - text: "Nuvens guerreiras gritam palavras que rimam. \xC9 isso que provoca os trov\xF5es.
      Vamos separar as palavras que terminam com as mesmas letras e grit\xE1-las bem
      alto!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_14
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Cada duas palavras formam um conjunto com um final parecido. Vamos gritar
      as palavras para ver quais rimam e, ent\xE3o, dividi-las em duplas."
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_15
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: "S\xE3o cinco duplas de palavras. Trov\xE3o e vagalh\xE3o! Que som legal!
      Gostei de falar isso alto!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_16
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Os Filhos do Trov\xE3o est\xE3o olhando esquisito para n\xF3s. Vamos separar
      essas palavras e seguir em frente."
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_17
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 2
  - text: Chuva e luva! Tormenta e pimenta! Eu posso passar o dia inteiro fazendo
      isso!
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_18
    id: 5
    episode: 4
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Soprar como um vendaval! N\xF3s podemos fazer isso! \xC9 s\xF3 puxar o
      f\xF4lego e..."
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_21
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ei, esta trombeta dos ventos foi sabotada! Est\xE1 vendo os n\xFAmeros
      do regulador? Algu\xE9m tirou tudo do lugar! Aposto que foram os Filhos do Trov\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_22
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Precisamos recolocar os n\xFAmeros para podermos calibrar a trombeta."
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_23
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: 1, 2, 3, 4...
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_24
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: 5, 6, 7, 8...
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_25
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 3
  - text: Vamos precisar completar o resto para podermos regular a trombeta. Vejamos...
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_26
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Olha s\xF3 como sopramos forte! Mais do que qualquer uma das nuvens guerreiras!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_27
    id: 6
    episode: 4
    emotion: happy
    slug: victory
    minigame: 3
  - text: "\xD3tima ideia, Guardi\xE3o! Podemos usar essa m\xE1quina de sorvete para
      fazer um monte de picol\xE9s para os Filhos do Trov\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_29
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O manual da m\xE1quina  de sorvete diz que cada sorvete \xE9 feito com
      1 groselha e 1 gota de \xE1gua. Temos 5 groselhas e 5 gotas de \xE1gua. Quantos
      picol\xE9s voc\xEA acha que conseguiremos fazer?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_30
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Tem certeza? Quantos grupos de groselhas com as gotas de \xE1gua temos?
      Com cada grupo se faz 1 picol\xE9."
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_31
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Se colocarmos 1 groselha e 1 gota de \xE1gua na m\xE1quina, fazemos 1 picol\xE9.
      Se colocarmos mais 1 de cada, temos 2 groselhas e 2 gotas de \xE1gua, o que
      faz 2 picol\xE9s. Quantos picol\xE9s fazemos com 5 groselhas e 5 gotas, Guardi\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_32
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ent\xE3o \xE9 1 de cada aqui..."
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_33
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: 2...
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_34
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: 3...
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_35
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: 4...
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_36
    id: 7
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: "E por \xFAltimo 5!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_37
    id: 8
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Pronto! 5 picol\xE9s de groselha para os Filhos do Trov\xE3o. Afinal, nuvens
      guerreiras de verdade fazem at\xE9 granizo!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_38
    id: 9
    episode: 4
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Fofinho? N\xF3s precisamos ser fofinhos como uma nuvem? Mas... mas... voc\xEAs
      s\xE3o nuvens guerreiras e n\xE3o... coisas fofinhas!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_41
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o! Como n\xF3s vamos provar que somos fofinhos? Eu n\xE3o sei
      ser fofinha!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_42
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Uma m\xE1quina de algod\xE3o doce! \xD3tima ideia! Mas ela parece estar
      quebrada. Como consertamos isso?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_43
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acho que \xE9 s\xF3 colocar os bot\xF5es com as letras na ordem certa,
      n\xE9?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_44
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Qual \xE9 mesmo a letra que vem depois do D? Voc\xEA lembra?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_45
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Com sua ajuda estou me lembrando bem dessa ordem alfab\xE9tica, quer ver?"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_46
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Agora a m\xE1quina est\xE1 fazendo algod\xE3o doce bem fofinho e gostoso!"
    world: 3
    season: 1
    sound: ptbr_ep52_nbs_47
    id: 6
    episode: 4
    emotion: happy
    slug: victory
    minigame: 5
  - text: "D\xE1 para acreditar nisso! Algu\xE9m sequestrou o Trov\xE3o e p\xF4s a
      culpa em Stratus! \xC9 por isso que eles atacaram a cidade!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_01
    id: 0
    episode: 5
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Mas perguntar para qu\xEA, n\xE3o \xE9? Podiam ter vindo perguntar sobre
      o pai, mas n\xE3o tinham que sair atacando!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_02
    id: 1
    episode: 5
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Se bem que eu faria o mesmo, n\xE3o \xE9? Sou meio... intempestiva."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_03
    id: 2
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Precisamos ir atr\xE1s do verdadeiro culpado... Ei! O que aquele rob\xF4
      est\xE1 fazendo no meu navio?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_04
    id: 3
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Quem mandou aquele rob\xF4 e como ele conseguiu desativar o alarme do navio?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_10
    id: 4
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "N\xE3o! Mais rob\xF4s! Guardi\xE3o, precisamos fazer alguma coisa!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_11
    id: 5
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Olha essa bagun\xE7a! Meu pai vai me matar!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_18
    id: 6
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Guardi\xE3o, voc\xEA precisa me ajudar a consertar tudo, come\xE7ando pela
      b\xFAssola."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_19
    id: 7
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Est\xE1 sentindo esse cheiro de queimado? Melhor verificarmos o motor."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_27
    id: 8
    episode: 5
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Sabe quando voc\xEA tem uma sensa\xE7\xE3o ruim? De que tem algo errado,
      mas n\xE3o sabe bem o que \xE9?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_34
    id: 9
    episode: 5
    emotion: sad
    slug: minigame5
    minigame: 
  - text: Me ajuda a procurar pelo navio? Estou com um mau pressentimento sobre isso.
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_35
    id: 10
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Tudo novinho em folha! Bom, quase, n\xE9? Por que esse navio j\xE1 \xE9
      mais velho do que eu e voc\xEA juntos!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_43
    id: 11
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "Mas uma coisa \xE9 certa: se esses rob\xF4s nos atacaram \xE9 porque s\xF3
      pode haver uma pessoa respons\xE1vel pelo sequestro do Trov\xE3o... O Senhor
      Sombrio!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_44
    id: 12
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "Topa ir atr\xE1s do Senhor Sombrio? Acho que podemos dar uma li\xE7\xE3o
      nele e ainda assim salvar o Sonho das Nuvens Guerreiras. Vamos?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_45
    id: 13
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "Aquele rob\xF4 est\xE1 tentando serrar a proa do Gavi\xE3o Secular! Precisamos
      impedi-lo!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_05
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Vamos usar um dos canh\xF5es de vento do navio, mas n\xE3o temos tempo
      de mirar. Escolha o canh\xE3o que j\xE1 est\xE1 mirado no lugar certo. Veja
      as setas em cada um."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_06
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "As setas mostram o caminho do canh\xE3o. Qual deles vai at\xE9 o \"x\",
      que marca o tiro certo no rob\xF4?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_07
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "\xC9 o canh\xE3o da direita! Olhe as setas: para frente, esquerda e para
      frente. Bem onde est\xE1 o rob\xF4!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_08
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Tome isso, seu rob\xF4 safado! Isso \xE9 para aprender a n\xE3o machucar
      o Gavi\xE3o Secular!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_09
    id: 4
    episode: 5
    emotion: regular
    slug: victory
    minigame: 1
  - text: "A flauta dos ventos! Meu pai disse que usou este artefato m\xE1gico para
      lutar com os Gigantes de Trov\xE3o! Se eu conseguir toc\xE1-lo, poderemos expulsar
      os rob\xF4s daqui!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_12
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ajude-me aqui, Guardi\xE3o. Acho que os rob\xF4s rabiscaram a partitura
      da m\xFAsica. Lembro que a m\xFAsica \xE9 uma sequ\xEAncia simples: A, B, C,
      D. Pode tirar o que n\xE3o faz parte da sequ\xEAncia?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_13
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "S\xF3 as quatro primeiras letras do alfabeto fazem parte da sequ\xEAncia:
      A, B, C, D."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_14
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Se a m\xFAsica n\xE3o for exatamente igual \xE0 original, n\xE3o funcionar\xE1.
      Estou achando que tem uma letra que n\xE3o \xE9 da sequ\xEAncia musical... Qual
      ser\xE1?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_15
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Agora estou percebendo! Basta tirarmos as letras que n\xE3o s\xE3o A, B,
      C ou D."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_16
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Funcionou! A flauta dos ventos expulsou os rob\xF4s para bem longe!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_17
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 2
  - text: "A b\xFAssola \xE9 o que nos guia pelos c\xE9us do Sonho das Nuvens Guerreiras.
      Ela sempre aponta para o Norte, ent\xE3o assim sabemos para onde ir."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_20
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Mas olhe o que aqueles rob\xF4s fizeram! Quebraram tudo e tiraram as coisas
      do lugar!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_21
    id: 1
    episode: 5
    emotion: sad
    slug: intro
    minigame: 3
  - text: "Est\xE1 faltando um nome da b\xFAssola. Lembro que \xE9 uma palavra que
      tem 4 letras iguais as da palavra Leste, mas n\xE3o estou bem certa de qual
      seja... Voc\xEA me ajuda?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_22
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Bom, uma coisa eu sei. \"Montanhas\" n\xE3o pode ser, porque tem um monte
      de letras e n\xE3o \xE9 uma dire\xE7\xE3o da b\xFAssola."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_23
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: A palavra tem cinco letras e termina com a letra "E".
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_24
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Olha, Guardi\xE3o! Achamos! Oeste! A escrita \xE9 at\xE9 bem parecida com
      Leste, s\xF3 o L de in\xEDcio que \xE9 diferente."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_25
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Muito bem! Acho que aqueles rob\xF4s queriam nos impedir de sair daqui."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_26
    id: 6
    episode: 5
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Droga... misturaram todas as pedras de energia do Gavi\xE3o Secular! Assim
      ele nunca vai voar!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_28
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Guardi\xE3o, precisamos organizar essas pedras em tr\xEAs conjuntos. Pode
      me ajudar?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_29
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Parece que cada conjunto deve ter apenas pedras com uma mesma caracter\xEDstica...
      Ou mesma forma... Ou mesma cor. O que acha?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_30
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 4
  - text: "N\xE3o podemos deixar as pedras bagun\xE7adas, ou n\xE3o funcionar\xE3o.
      E se voc\xEA separ\xE1-las por cor?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_31
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Bem, se voc\xEA n\xE3o quis separar por cor, acho que, para variar, vou
      arrum\xE1-las por forma! Que tal?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_32
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Agora sim! O motor est\xE1 preparado para voar!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_33
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 4
  - text: "N\xE3o! A cole\xE7\xE3o de quadros do meu pai! Isso foi muita crueldade
      desses rob\xF4s!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_36
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Meu pai sempre foi todo orgulhoso dos navios que j\xE1 comandou e mandou
      pintar um quadro para cada um. \xC9 o xod\xF3 dele!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_37
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, me ajuda, por favor! Precisamos recolocar os quadros na ordem
      alfab\xE9tica ou meu pai vai virar uma fera!"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_38
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Temos que colocar em ordem alfab\xE9tica, ou meu pai vai me matar! Qual
      quadro come\xE7a com a letra A? Esse deve ir primeiro."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_39
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: Tem algo estranho aqui... Precisamos organizar na ordem das letras do alfabeto...
      Depois da Brisa vem qual? Minuano?
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_40
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Primeiro vem a letra A. Depois, a B. N\xE3o temos quadro que come\xE7a
      com C. A pr\xF3xima inicial, pela ordem, \xE9 M. Depois vem o S e o V, que fica
      bem perto do fim do alfabeto."
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_41
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Ufa! Olha, se voc\xEA conhecesse meu pai tamb\xE9m ficaria com medo. Ele
      foi o \xFAnico a derrotar sozinho o Trov\xE3o em uma queda de bra\xE7o, acredita?"
    world: 3
    season: 1
    sound: ptbr_ep53_nbs_42
    id: 6
    episode: 5
    emotion: happy
    slug: victory
    minigame: 5
  - text: "O vento est\xE1 \xF3timo, Guardi\xE3o! Logo estaremos no covil do Senhor
      Sombrio."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_01
    id: 0
    episode: 6
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Est\xE1 vendo aquelas montanhas logo \xE0 frente? Aquele \xE9 o Desfiladeiro
      dos Ventos Uivantes. Meu pai costumava me trazer aqui praticar surfe a\xE9reo."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_02
    id: 1
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Podemos pedir ajuda das harpias, as criaturas que vivem no desfiladeiro.
      S\xE3o meio rabugentas, mas devem alguns favores ao meu pai."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_03
    id: 2
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "L\xE1 est\xE1 a entrada! Precisaremos primeiro passar pelas sentinelas
      que protegem a entrada do desfiladeiro."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_04
    id: 3
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Agora estamos dentro do desfiladeiro. A parte dif\xEDcil est\xE1 por vir."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_11
    id: 4
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Vou precisar que voc\xEA me ajude para manter o Gavi\xE3o Secular voando."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_12
    id: 5
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Daqui para frente n\xE3o devemos ter muitos problemas. Fica moleza!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_19
    id: 6
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O ninho das harpias \xE9 logo adiante. Certamente elas sabem para onde
      o Senhor Sombrio foi."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_20
    id: 7
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Segundo as harpias, essa \xE9 a dire\xE7\xE3o para onde foi o Senhor Sombrio.
      Devemos estar perto."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_28
    id: 8
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Olha l\xE1, Guardi\xE3o! Caramba, o Senhor Sombrio construiu um castelo
      voador! Quem diria?"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_35
    id: 9
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Precisamos chegar at\xE9 l\xE1 e entrar antes que os rob\xF4s nos vejam!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_36
    id: 10
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: Adoraria que meu pai estivesse aqui para me ver agora! Nimbus, a destemida,
      invadindo o castelo voador do Senhor Sombrio!
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_44
    id: 11
    episode: 6
    emotion: happy
    slug: final
    minigame: 
  - text: Se bem que era capaz de ele me dar uma bronca por me arriscar tanto...
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_45
    id: 12
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "N\xE3o importa! O que importa \xE9 que estamos prestes a salvar o Trov\xE3o
      das garras do Senhor Sombrio!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_46
    id: 13
    episode: 6
    emotion: happy
    slug: final
    minigame: 
  - text: "Para entrarmos, precisamos declarar a frase correta, ou as sentinelas destruir\xE3o
      nosso navio voador!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_05
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ou\xE7a o vento. Ele dar\xE1 a dica de qual \xE9 a frase que precisamos
      dizer."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_06
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Estranho... Acho que o vento disse outra coisa. Come\xE7a com \"Nada...\""
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_07
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Vamos ouvir com mais aten\xE7\xE3o... \"Nada det\xE9m...\""
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_08
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "N\xE3o \xE9 f\xE1cil mesmo entender o que as nuvens falam. Mas creio que
      \xE9 algo como \"Nada det\xE9m o...\""
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_09
    id: 4
    episode: 6
    emotion: sad
    slug: error3
    minigame: 1
  - text: "\"Nada det\xE9m o vento!\" Claro que \xE9 isso!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_10
    id: 5
    episode: 6
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Os ventos aqui s\xE3o muito fortes e o desfiladeiro, muito estreito. Com
      esse peso todo n\xE3o conseguiremos passar ilesos."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_13
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Preciso que voc\xEA solte alguns dos sacos de areia da lateral do navio
      para ganharmos altitude. Temos 10 sacos e precisamos ficar com apenas 6."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_14
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Cuidado para n\xE3o soltar sacos demais ou de menos. Precisamos de 6 sacos
      de areia."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_15
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Vamos ver...Temos 10 sacos pendurados e precisamos ficar com apenas 6.
      Isso quer dizer que precisamos cortar quantos sacos, Guardi\xE3o?"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_16
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Vamos tentar juntos! S\xE3o 10 sacos. Cortamos 1, 2, 3, 4..."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_17
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Dos 10 sacos, cortamos 4 e ficamos com 6. Estamos passando da \xE1rea do
      perigo!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_18
    id: 5
    episode: 6
    emotion: happy
    slug: victory
    minigame: 2
  - text: "As harpias est\xE3o de p\xE9ssimo humor. E n\xE3o \xE9 para menos! Olha
      como essas nuvens est\xE3o sujas e fedidas!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_21
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Com certeza o Senhor Sombrio andou por aqui com suas m\xE1quinas sujas!
      Precisamos fazer alguma coisa."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_22
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "O navio tem um kit de qu\xEDmica para fazer chover. Eles est\xE3o em duas
      garrafas diferentes, mas com a mesma quantidade de l\xEDquido. Basta encontr\xE1-las
      e misturar."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_23
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Cuidado com o que voc\xEA mistura ou o navio pode acabar explodindo! As
      quantidades de l\xEDquidos s\xE3o iguais. Nem mais, nem menos."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_24
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Acho que o mais prudente \xE9 comparar a quantidade de l\xEDquido dos frascos.
      S\xF3 funciona se a quantidade dos dois for a mesma."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_25
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 3
  - text: "S\xE3o esses dois a\xED."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_26
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Isso! Agora as nuvens v\xE3o chover toda essa polui\xE7\xE3o e o c\xE9u
      voltar\xE1 a ficar limpo."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_27
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Sabe de uma coisa? Acho melhor disfar\xE7armos o Gavi\xE3o Secular antes
      de chegar mais perto do covil do Senhor Sombrio."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_29
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Veja se no kit de qu\xEDmica h\xE1 ess\xEAncia de nuvens em quantidade
      suficiente para nos cobrir. Precisamos de 20."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_30
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Cuidado para n\xE3o errar a m\xE3o nessa contagem! N\xE3o podemos colocar
      a mais, nem a menos... Precisamos passar despercebidos pelos rob\xF4s do Senhor
      Sombrio."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_31
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 4
  - text: "O ideal \xE9 ir colocando e contando devagar: 1, 2, 3... Continue at\xE9
      colocar 20! Tenho certeza que ainda v\xE3o sobrar algumas no kit."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_32
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Juntos podemos fazer isso melhor! Vamos l\xE1! Pronto!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_33
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Olha quantos rob\xF4s do Senhor Sombrio! Ainda bem que eles n\xE3o podem
      nos ver com esse disfarce!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_34
    id: 5
    episode: 6
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Nossa, isso foi mais f\xE1cil do que eu imaginava. E eu aqui esperando
      lutar com rob\xF4s-bal\xF5es voadores..."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_37
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Tinha que ter uma senha para abrir a porta! Como ser\xE1 que isso funciona?"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_38
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Olha s\xF3... temos tr\xEAs palavras aqui, cada uma com duas s\xEDlabas.
      Na-da... ma-la... bo-lo. Aposto que, se combinarmos duas s\xEDlabas para formar
      uma palavra nova, a porta vai abrir."
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_39
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "N\xE3o vale nem escrever uma palavra igual \xE0s que est\xE3o a\xED, nem
      uma palavra que n\xE3o existe, n\xE9? Capricha a\xED!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_40
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Hoje voc\xEA est\xE1 sem ideia de palavras? Vamos ver... Pode juntar o
      LO, do BOLO, com o NA, do NADA, e formar LONA! O que voc\xEA acha dessa ideia?"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_41
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: "N\xE3o quer criar uma palavra nova que existe? Ent\xE3o deixe que eu invento!
      Vou juntar o BO, do BOLO, com o LA, da MALA, e crio uma BOLA!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_42
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: "A porta est\xE1 se abrindo! Vamos entrar r\xE1pido!"
    world: 3
    season: 1
    sound: ptbr_ep54_nbs_43
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Ouvi uma hist\xF3ria de que o Senhor Sombrio era um g\xEAnio das inven\xE7\xF5es.
      \xC9 verdade isso?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_01
    id: 0
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Se for, isso explica porque ele sempre tem v\xE1rios rob\xF4s e m\xE1quinas
      bizarras."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_02
    id: 1
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Est\xE1 vendo esse raio verde? Tenha cuidado, porque aposto que \xE9 algum
      tipo de alarme."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_03
    id: 2
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Antes de qualquer coisa, precisamos desarmar esse alarme.
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_04
    id: 3
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Agora sim, podemos passar sem risco de tocar algum alarme!
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_12
    id: 4
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ei, olha! Tr\xEAs rob\xF4s! Vamos l\xE1 enfrent\xE1-los antes que eles
      pe\xE7am ajuda!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_13
    id: 5
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Parece que nem todo rob\xF4 gosta de ser mal, n\xE9? Esses a\xED s\xF3
      queriam ser piratas a\xE9reos! Vai entender..."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_20
    id: 6
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Pelo menos eles nos contaram onde o Trov\xE3o est\xE1 preso. Vamos l\xE1!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_21
    id: 7
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Voc\xEA parece meio abatido, Trov\xE3o. Onde est\xE1 seu raio?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_29
    id: 8
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "S\xE3o os rob\xF4s do Senhor Sombrio! E eu estava louca para encontrar
      alguns rob\xF4s!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_38
    id: 9
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vamos peg\xE1-los, Guardi\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_39
    id: 10
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Adoraria ficar e discutir contra todo o ex\xE9rcito de rob\xF4s do Senhor
      Sombrio, mas precisamos levar o Trov\xE3o de volta \xE0 Grande Nuvem."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_48
    id: 11
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "E, Trov\xE3o, eu espero que voc\xEA converse seriamente com seus filhos,
      hein? Porque, vou te contar, que zona eles fizeram em Stratus!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_49
    id: 12
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Parece que o alarme est\xE1 ligado neste neg\xF3cio aqui."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_05
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Olha, um gravador! Vamos us\xE1-lo para saber qual \xE9 a senha e, ent\xE3o,
      coloc\xE1-la no computador."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_06
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Parece que \xE9 uma frase de tr\xEAs palavras. Voc\xEA ouviu a primeira
      palavra? Acho que foi PUXE."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_08
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O que a voz diz que devemos puxar? Um peixe \xE9 que n\xE3o foi, porque
      a palavra era maior..."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_09
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Acho que agora eu entendi direitinho: PUXE A TOMADA. Ser\xE1 essa a senha?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_10
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Esse Senhor Sombrio \xE9 um rid\xEDculo! Que senha tosca!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_11
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Em guarda, seus rob\xF4s de meia bateria! Preparem-se para enfrentar Nimbus,
      a audaciosa!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_14
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ei, esses rob\xF4s foram desmontados! Caramba, ser\xE1 que o Senhor Sombrio
      fez isso de prop\xF3sito? Mas, por qu\xEA? Precisamos remontar os tr\xEAs para
      descobrir!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_15
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Cada pe\xE7a tem um formato espec\xEDfico. Devemos prestar aten\xE7\xE3o
      nas formas que o rosto deles t\xEAm. Cada rob\xF4 tem um tipo diferente de pe\xE7a,
      reparou?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_16
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Vamos examinar rob\xF4 por rob\xF4... O primeiro tem antena e rosto com
      forma de ret\xE2ngulo. O segundo, de tri\xE2ngulo... Ser\xE1 que isso n\xE3o
      \xE9 uma dica de que formas devemos usar em cada um deles?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_17
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Acho que estou come\xE7ando a entender... me ajude aqui, Guardi\xE3o. Os
      ret\xE2ngulos devem ligar o primeiro rob\xF4... O que liga os outros?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_18
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Muito bom! Tri\xE2ngulos no segundo e c\xEDrculos para o terceiro! Agora,
      antes de irem embora, rob\xF4s, nos digam: onde o Trov\xE3o est\xE1 preso?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_19
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Esta \xE9 a cela onde est\xE1 preso o Trov\xE3o! Vamos libert\xE1-lo!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_22
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "\xC9 claro que a porta tinha de ter mais uma destas senhas complicadas!
      O que o Sombrio tem contra chaves normais, hein?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_23
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Parece um tipo de sequ\xEAncia. Precisamos ligar as letras na ordem certa
      para abrir a cela."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_24
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "A, B... qual letra ser\xE1 que vem depois?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_25
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Precisamos tomar cuidado para n\xE3o disparar um alarme. A senha \xE9 uma
      sequ\xEAncia... A, B, C..."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_26
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 3
  - text: Vamos relembrar o alfabeto? A, B, C, D, E.
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_27
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Ouviu este barulho? \xC9 a porta se abrindo! Pode sair, Trov\xE3o! N\xF3s
      o salvamos!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_28
    id: 6
    episode: 7
    emotion: happy
    slug: victory
    minigame: 3
  - text: 
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_32
    id: 0
    episode: 7
    emotion: regular
    slug: sound
    minigame: 4
  - text: "Voc\xEA est\xE1 certo, Guardi\xE3o! O raio do Trov\xE3o est\xE1 sendo usado
      para dar energia a essa m\xE1quina! Precisamos deslig\xE1-la."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_30
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Para deslig\xE1-la, precisamos seguir as instru\xE7\xF5es da grava\xE7\xE3o
      na m\xE1quina."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_31
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "A m\xE1quina precisa ficar com as quantidades exatas de cada tipo de energia
      conforme a grava\xE7\xE3o."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_33
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Vamos ouvir a grava\xE7\xE3o de novo. Acho que n\xE3o ouvi direito as quantidades,
      e a m\xE1quina precisa ficar com as quantidades exatas de cada tipo de energia..."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_34
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Temos que colocar 3 blocos de energia no \xC1lcool Vermelho... e no G\xE1s
      Verde e Raio Amarelo, quanto colocamos?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_35
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Ser\xE1 que assim vai funcionar? S\xE3o 3 no \xC1lcool Vermelho, 2 no G\xE1s
      Verde e 4 no Raio Amarelo."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_36
    id: 6
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "A m\xE1quina est\xE1 se desligando! Cada barra representa a quantidade
      certinha! Agora \xE9 s\xF3 pegar seu raio e irmos embora, Trov\xE3o."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_37
    id: 7
    episode: 7
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Guardi\xE3o, enquanto Trov\xE3o e eu distra\xEDmos esse rob\xF4 voc\xEA
      tenta peg\xE1-lo por tr\xE1s."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_40
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Esses rob\xF4s sentinelas s\xE3o muito poderosos, mas t\xEAm um ponto fraco
      nas costas."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_41
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "\xC9 s\xF3 ligar as chaves que t\xEAm as mesmas letras e ele sofrer\xE1
      um curto circuito."
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_42
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Est\xE1 confuso porque eles colocaram a mesma letra escrita de forma diferente:
      mai\xFAscula e min\xFAscula! Veja s\xF3!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_43
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 5
  - text: "O c\xF3digo para desativar os rob\xF4s \xE9 colocar, por exemplo, a letra
      \"L\" mai\xFAscula junto da letra \"L\" min\xFAscula e assim por diante!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_44
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Vamos l\xE1! As letras \"L\" j\xE1 est\xE3o certinhas... O \"A\" mai\xFAsculo
      tamb\xE9m deve se juntar ao \"A\" min\xFAsculo. O que falta?"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_45
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 5
  - text: Acho que assim vai funcionar...
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_46
    id: 6
    episode: 7
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Voc\xEA deu um curto no rob\xF4! Agora ele n\xE3o conseguir\xE1 nos atacar!"
    world: 3
    season: 1
    sound: ptbr_ep55_nbs_47
    id: 7
    episode: 7
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Me d\xE1 uma raiva ir embora e deixar o Senhor Sombrio com esse castelo
      voador... Isto aqui \xE9 uma fortaleza! Ele poderia us\xE1-lo para atacar Stratus!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_01
    id: 0
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "A n\xE3o ser que... A n\xE3o ser que n\xF3s sabotemos todo este lugar.
      O que voc\xEA acha?"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_02
    id: 1
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Precisamos descobrir os pontos fracos deste lugar para impedir que seja
      usado para o mal.
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_03
    id: 2
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Veja se voc\xEA encontra a central de seguran\xE7a. Deve haver c\xE2meras
      por todos os lados."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_04
    id: 3
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "As c\xE2meras mostraram a construtora de rob\xF4s, a sala de planejamento
      e a sala de m\xE1quinas."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_11
    id: 4
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Precisamos ir a cada um desses lugares para sabotar os terr\xEDveis planos
      do Senhor Sombrio!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_12
    id: 5
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Agora vamos at\xE9 a sala de planejamento do Senhor Sombrio. Quem sabe
      que planos ele n\xE3o tem preparados?"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_19
    id: 6
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Veja se encontra algo que se pare\xE7a com planos de uma arma secreta,
      ou coisa do g\xEAnero."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_20
    id: 7
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Agora vamos at\xE9 a sala de m\xE1quinas. Veja se voc\xEA encontra o caminho
      at\xE9 l\xE1."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_28
    id: 8
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: Precisamos desligar esta coisa. Isso deve fazer o castelo cair que nem uma
      pedra!
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_35
    id: 9
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Acho melhor se preparar para correr, ou n\xF3s vamos cair junto!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_36
    id: 10
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Acho melhor sairmos daqui correndo, Guardi\xE3o!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_43
    id: 11
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "Tchau, tchau, Senhor Sombrio! Tenha uma \xF3tima descida!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_44
    id: 12
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "\xD3timo, Guardi\xE3o! Parece que todas as c\xE2meras est\xE3o ligadas
      a este terminal."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_05
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Precisamos descobrir qual c\xE2mera representa qual lugar no castelo. \xC9
      como se us\xE1ssemos lupas!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_06
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Cada c\xE2mera mostra um detalhe de uma das cenas... Temos que observar
      bem cada uma das imagens, n\xE3o \xE9?"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_07
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Veja este aqui: tem um pote marrom com uma pena azul na cena do meio, bem
      abaixo da caveira, viu? Isso significa que este detalhe \xE9 uma parte daquela
      cena... E os outros?"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_08
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: Agora eu entendi! Veja como ficaram...
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_09
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 1
  - text: "\xD3timo! S\xE3o tr\xEAs lugares excelentes para sabotarmos!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_10
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Vamos come\xE7ar pela m\xE1quina construtora de rob\xF4s. Sem ela o Senhor
      Sombrio ficar\xE1 sem seu ex\xE9rcito do mal!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_13
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Veja se descobre um jeito de destruir essa m\xE1quina. Deve haver alguma
      pista por aqui."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_14
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "As porcas, \xE9 claro! Se colocarmos um bloco com 30 porcas, certamente
      a m\xE1quina quebrar\xE1!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_15
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Blocos com menos porcas n\xE3o engui\xE7am a m\xE1quina. Qual desses blocos
      parece ter as 30 porcas?"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_16
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Parece ser esse, n\xE3o acha? Comparei com o que tem 20 e vi que esse aqui
      tem mais do que aquele."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_17
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Que explos\xE3o danada! Gostei disso! Quero ver o Senhor Sombrio sem seus
      preciosos rob\xF4s!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_18
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Nossa, achei planos, ordens e... at\xE9 poemas! Quem diria que o Senhor
      Sombrio tem um cora\xE7\xE3o! Ele s\xF3 n\xE3o sabe escrever direito..."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_21
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho melhor levarmos tudo isso conosco. Talvez a pol\xEDcia de Stratus
      possa usar este material para descobrir os futuros planos do Senhor Sombrio."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_22
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Voc\xEA me ajuda a separar tudo? Precisamos dividir o que \xE9 poema, o
      que \xE9 carta e o que \xE9 not\xEDcia."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_23
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Not\xEDcias, normalmente, t\xEAm um t\xEDtulo. Cartas s\xE3o assinadas...
      E algumas poesias t\xEAm rimas..."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_24
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Veja! Estas duas s\xE3o cartas, porque est\xE3o assinadas: a para m\xE3e
      dele, est\xE1 assinada \"seu filho Sombrio\", e a outra, para o tenente, ele
      assinou \"Senhor Sombrio\"."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_25
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Voc\xEA leu as not\xEDcias? Tem acontecido muita coisa pelo Sonho das Nuvens
      Guerreiras, especialmente em Stratus!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_26
    id: 5
    episode: 8
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Organizando as poesias, acho que j\xE1 ajudamos o suficiente. Acho que
      isso \xE9 o suficiente. A pol\xEDcia de Stratus vai se divertir lendo este material!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_27
    id: 6
    episode: 8
    emotion: happy
    slug: victory
    minigame: 3
  - text: "L\xF3gico que tinha de ter outra porta com senha! J\xE1 estou ficando cansada!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_29
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Guardi\xE3o, voc\xEA \xE9 mais esperto do que eu para estas coisas. Veja
      se descobre quais as duas senhas que abrem a porta."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_30
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Acho que as palavras t\xEAm a ver com os dois desenhos, n\xE3o? De repente
      \xE9 s\xF3 montar essas palavras."
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_31
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Cada desenho \xE9 uma palavra. Essa a\xED \xE9 o que? Doce? Festa? Bolo?"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_32
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Olha s\xF3! Voc\xEA sacou a ideia! \xC9 um bolo e uma vela!"
    world: 3
    season: 1
    sound: ptbr_ep56_nbs_33
    id: 4
    episode: 8
