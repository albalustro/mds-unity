%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G3W2
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "Bem-vindo de volta, Guardi\xE3o! Fiquei sabendo desse outro guardi\xE3o,
      o Ruto, que desapareceu. Que coisa triste!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_01
    id: 0
    episode: 1
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "A\xED eu pensei comigo mesma: \"Clara, voc\xEA pode ajudar a encontrar
      esse sujeito! Vai que ele se assustou com alguma coisa. E quem melhor para lidar
      com sustos do que voc\xEA?\""
    world: 2
    season: 3
    sound: ptbr_ep41_clr_02
    id: 1
    episode: 1
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "\"Voc\xEA\" sou eu, n\xE3o \xE9? N\xE3o voc\xEA. Eu sou a especialista
      em sustos por aqui!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_03
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Falando nisso, o Ruto foi visto pela \xFAltima vez a caminho da casa do
      P\xE9 Grande. Ele deve saber alguma coisa a respeito."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_04
    id: 3
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Por travessura? Tinha que ser! Goblins s\xE3o criaturinhas mal-intencionadas
      que adoram pregar pe\xE7as nos outros!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_11
    id: 4
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Bom, vamos ver com o P\xE9 Grande se ele sabe do Ruto?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_12
    id: 5
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Precisamos ir at\xE9 a casa dos goblins para recuperar essa coisa. Isso
      deve nos dar uma pista sobre para onde foi o Ruto."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_19
    id: 6
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Vamos seguir em frente. Tenho certeza de que esses goblins moram por aqui,
      em algum lugar!
    world: 2
    season: 3
    sound: ptbr_ep41_clr_20
    id: 7
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Eles devem estar morrendo de medo agora! Vamos bater na porta!
    world: 2
    season: 3
    sound: ptbr_ep41_clr_27
    id: 8
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Veja s\xF3... E ainda v\xE3o embora sem nem pegar as coisas do P\xE9 Grande!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_33
    id: 9
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Acho que vamos precisar ir n\xF3s mesmos atr\xE1s das coisas roubadas..."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_34
    id: 10
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Parece que os goblins j\xE1 tiraram o que estava aqui dentro... E eu aposto
      que sei o porqu\xEA!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_42
    id: 11
    episode: 1
    emotion: regular
    slug: final
    minigame: 
  - text: "Guardi\xE3o, espero que tenha trazido sua coragem, porque precisaremos
      ir at\xE9 o covil do Rei Goblin! Vamos l\xE1!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_43
    id: 12
    episode: 1
    emotion: regular
    slug: final
    minigame: 
  - text: "O P\xE9 Grande disse que goblins estiveram aqui soltando seus animais."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_05
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Vamos ajud\xE1-lo primeiro, Guardi\xE3o? Acho que \xE9 s\xF3 separar e
      organizar todos os animais em dois grupos e pronto! Depois conversamos melhor
      com o P\xE9 Grande."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: Precisamos separar os animais em cada grupo por tipo. As placas dizem o
      tipo de cada grupo.
    world: 2
    season: 3
    sound: ptbr_ep41_clr_07
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O conjunto dentro do outro conjunto tamb\xE9m \xE9 de animais, mas um tipo
      de animal espec\xEDfico."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_08
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: Eu vou ajudar a separar os animais antes que eles fujam!
    world: 2
    season: 3
    sound: ptbr_ep41_clr_09
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: Resolvido! Cada animal no seu devido lugar! Mas por que os Goblins soltaram
      estes animais?
    world: 2
    season: 3
    sound: ptbr_ep41_clr_10
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Segundo o P\xE9 Grande, o Ruto havia deixado uma coisa muito importante
      aos cuidados dele. Mas o P\xE9 Grande n\xE3o sabe se os goblins roubaram isto!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_13
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Aqui est\xE1 uma lista com os pertences do P\xE9 Grande. Vamos colocar
      tudo na ordem e ver o que sumiu."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_14
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Precisamos colocar tudo em ordem alfab\xE9tica, para facilitar na hora
      de procurar."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_15
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Quando a primeira letra de uma palavra \xE9 igual, acho que devemos comparar
      a segunda letra, n\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_16
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Muito bem, vamos ver... A\xED falta s\xF3 isso aqui e..."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_17
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Pronto! A lista est\xE1 organizada! O P\xE9 Grande disse que n\xE3o lembra
      o que era, mas roubaram mesmo a coisa que o Ruto deixou com ele!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_18
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 2
  - text: "\xC9 aqui que moram os goblins! Sabe, eles s\xE3o criaturinhas bem covardes.
      Aposto que podemos assust\xE1-los! Ent\xE3o certamente nos devolver\xE3o as
      coisas do P\xE9 Grande."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_21
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Aqui, vou escrever um bilhete para assust\xE1-los!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_22
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Mas... N\xE3o sei. Olhe aqui o que eu escrevi. Acho que podemos incluir
      mais alguma palavra, para ficar mais amea\xE7ador... O que voc\xEA sugere?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_23
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o sei n\xE3o... Isso n\xE3o me parece assustador!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_24
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "N\xE3o sei n\xE3o... Isso n\xE3o me parece assustador!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_24
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Vamos tentar \"terr\xEDvel\"! Me parece assustador o suficiente!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_25
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Pronto! L\xE1 foi o bilhete por baixo da porta e..."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_26
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Mas que bando de malcriados! Eles n\xE3o s\xF3 n\xE3o se assustaram, como
      exigem pagamento pelas coisas que roubaram do P\xE9 Grande!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_28
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Vamos juntar nossas coisas para dar a metade para cada goblin. Mas ser\xE1
      que se dividirmos cada coisa em partes iguais vai sobrar algo para n\xF3s?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_29
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Devemos dividir igualmente entre os 2, para n\xE3o haver briga. Ent\xE3o
      deve sobrar pelo menos 1 olho de caolho e 1 semente de ab\xF3bora, n\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_30
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Os dois goblins precisam ficar com a mesma quantidade de cada coisa. Ser\xE1
      que d\xE1 pra dividir 7 olhos de caolho para os 2 goblins sem sobrar nenhum?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_31
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Que bom! Dividindo cada coisa em partes iguais, sobra 1 olho de caolho
      e 1 semente de ab\xF3bora!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_32
    id: 4
    episode: 1
    emotion: happy
    slug: victory
    minigame: 4
  - text: "N\xE3o \xE9 isso... Vamos seguir pela lista. O objeto que procuramos precisa
      se encaixar na descri\xE7\xE3o."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_38
    id: 0
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "N\xE3o \xE9 isso tamb\xE9m. \xC9 azul, n\xE3o \xE9 redondo... Serve para
      guardar coisas dentro..."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_39
    id: 1
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Dif\xEDcil encontrar essa coisa, hein? Vamos procurar mais um pouco. Temos
      que ler com calma, item por item da lista..."
    world: 2
    season: 3
    sound: ptbr_ep41_clr_40
    id: 2
    episode: 1
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Agora basta encontrar a coisa que o Ruto deixou com o P\xE9 Grande... Mas...
      O que \xE9?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_36
    id: 3
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Aqui est\xE1 a lista com a descri\xE7\xE3o da tal coisa que precisamos
      encontrar. Qual ser\xE1?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_37
    id: 4
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Mas que quintal mais bagun\xE7ado e fedido! Acho que esses goblins largam
      todo o lixo por aqui!"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_35
    id: 5
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Aqui! \xC9 essa caixa azul aqui! U\xE9, mas... Ela est\xE1 vazia?"
    world: 2
    season: 3
    sound: ptbr_ep41_clr_41
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Segundo as leis dos goblins, tudo o que eles roubam deve ser levado at\xE9
      o Rei Goblin."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_01
    id: 0
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ele nem \xE9 um rei de verdade! \xC9 s\xF3 um goblin mais malvado do que
      os outros, ent\xE3o todos o chamam de rei!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_02
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Acho que \xE9 s\xF3 seguir mais um pouco e... N\xE3o... N\xE3o era esse
      o caminho?"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_03
    id: 2
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Guardi\xE3o, quem s\xE3o esses a\xED na frente?"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_04
    id: 3
    episode: 2
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "H\xE1 coisas que ficam mesmo horripilantes no escuro..."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_10
    id: 4
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Vamos usar as estrelas para nos guiar!
    world: 2
    season: 3
    sound: ptbr_ep42_clr_11
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Agora podemos nos guiar pelas estrelas, como faziam os antigos navegadores
      de sonhos!
    world: 2
    season: 3
    sound: ptbr_ep42_clr_16
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Vamos usar aquelas estrelas ali.
    world: 2
    season: 3
    sound: ptbr_ep42_clr_17
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Caramba, o que \xE9 aquilo ali?"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_24
    id: 8
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Com certeza estamos chegando perto do lar do Rei Goblin, ou n\xE3o encontrar\xEDamos
      esta confus\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_30
    id: 9
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Um beco sem sa\xEDda? Mas... Como assim? Deve haver uma passagem!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_31
    id: 10
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vamos r\xE1pido, Guardi\xE3o! Antes que a passagem se feche!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_37
    id: 11
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Acho que dever\xEDamos ter pensado em como vamos sair daqui de dentro,
      n\xE3o \xE9?"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_38
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Ali! Juro que vi alguma coisa! Ser\xE1 um fantasma? Prefiro fantasmas do
      que goblins!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_05
    id: 0
    episode: 2
    emotion: happy
    slug: intro
    minigame: 1
  - text: "Vamos pegar alguma coisa que nos ajude a enxergar no escuro. Pelo menos
      assim poderemos ver quem s\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "N\xE3o acho que isso sirva... Preciso de algo que ilumine a floresta!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_07
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Isso tamb\xE9m n\xE3o vai servir... Ent\xE3o s\xF3 resta usarmos esta lanterna..."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_08
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 1
  - text: "S\xE3o apenas troncos de \xE1rvores velhas que na sombra, tem forma de
      fantasmas horr\xEDveis."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_09
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Caramba, mas que c\xE9u polu\xEDdo! Nem d\xE1 para ver as estrelas com
      estas nuvens de polui\xE7\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_12
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Sabe o que \xE9 essa m\xE1quina? \xC9 um sugador de polui\xE7\xE3o instalado
      pelo P\xE9 Grande. Vamos empurrar essas nuvens fedidas at\xE9 eles."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_13
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Precisamos arrastar todas as nuvens de polui\xE7\xE3o para as m\xE1quinas!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_14
    id: 2
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Pronto! O c\xE9u est\xE1 limp\xEDssimo!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_15
    id: 3
    episode: 2
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Meu av\xF4 sempre contava que o bruxo Nostradamus sabia ler as estrelas."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_18
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Existe uma estrela grande, a Estrela Polar, que est\xE1 sempre no norte.
      Se voc\xEA conseguir encontr\xE1-la, n\xF3s conseguiremos saber para que lado
      \xE9 norte, sul, leste e oeste."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_19
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "A Estrela Polar \xE9 uma estrela grande e azul. Vamos ver se a encontramos."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_20
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o... Acho que n\xE3o \xE9 esta. A Estrela Polar \xE9 grande e azul."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_21
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ser\xE1 que n\xE3o \xE9 aquela ali?"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_22
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 3
  - text: "\xC9 ela mesma! Agora, se ela est\xE1 ali, ent\xE3o aquele \xE9 o norte.
      Isso significa que este \xE9 o caminho certo!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_23
    id: 5
    episode: 2
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Olha, Guardi\xE3o! Parece que os goblins andaram aprontando das suas por
      aqui! Embaralharam as sombras de tudo por aqui!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_25
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Vamos devolver as sombras de cada bicho e coisa antes que elas saiam pregando
      pe\xE7as por a\xED!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_26
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Cada coisa tem sua pr\xF3pria sombra. \xC9 como uma vers\xE3o escura e
      de ponta-cabe\xE7a do seu dono."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_27
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Alguma coisa ficou embolada. Precisamos corrigir para n\xE3o dar confus\xE3o."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_28
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Alguma coisa ficou embolada. Precisamos corrigir para n\xE3o dar confus\xE3o."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_28
    id: 4
    episode: 2
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Acho que \xE9 isso, n\xE3o \xE9? Cada coisa com sua pr\xF3pria sombra!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_29
    id: 5
    episode: 2
    emotion: happy
    slug: victory
    minigame: 4
  - text: "N\xE3o \xE9 poss\xEDvel que eu tenha errado o caminho de novo... Aposto
      que... Olha! Tem algo escrito na parede!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_32
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "\"A sombra \xE9 a passagem para seguir adiante.\" Claro! Os goblins adoram
      escuro, ent\xE3o esta \xE9 a chave!"
    world: 2
    season: 3
    sound: ptbr_ep42_clr_33
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Precisamos juntar essas cascas de \xE1rvore na forma de uma porta."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_34
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ficou faltando alguma coisa... N\xE3o est\xE1 parecendo o suficiente com
      uma porta..."
    world: 2
    season: 3
    sound: ptbr_ep42_clr_35
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 5
  - text: ERROR_2
    world: 2
    season: 3
    sound: 
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 5
  - text: ERROR_3
    world: 2
    season: 3
    sound: 
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 5
  - text: Funcionou! A sombra virou uma porta de parede!
    world: 2
    season: 3
    sound: ptbr_ep42_clr_36
    id: 6
    episode: 2
    emotion: happy
    slug: victory
    minigame: 5
  - text: Devemos estar chegando perto da toca do Rei Goblin!
    world: 2
    season: 3
    sound: ptbr_ep43_clr_01
    id: 0
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Sabe o que meu av\xF4 falava? Que vivia aqui perto um feiticeiro muito
      poderoso chamado Zuzu, que odiava o Rei Goblin."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_02
    id: 1
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ser\xE1 que n\xE3o \xE9 boa ideia procur\xE1-lo? Ele pode nos ajudar, caso
      o Rei Goblin n\xE3o seja, digamos, muito simp\xE1tico."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_03
    id: 2
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Olha ali. Parece um mapa... que sorte!
    world: 2
    season: 3
    sound: ptbr_ep43_clr_04
    id: 3
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Como um vampiro banguela consegue chupar sangue? Ser\xE1 que \xE9 de canudinho?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_10
    id: 4
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Sei l\xE1! Vamos, que a cabana do Feiticeiro Zuzu deve ser aquela logo
      ali na frente."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_11
    id: 5
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Obrigada, seu Feiticeiro! Agora podemos dar um jeito no Rei Goblin e encontrar
      seja l\xE1 o que for que o Ruto deixou com o P\xE9 Grande!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_17
    id: 6
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Est\xE1 preparado, Guardi\xE3o? Porque estamos prestes a entrar na toca
      do Rei Goblin!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_18
    id: 7
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Espero que este feiti\xE7o tenha mandado o Rei Goblin para bem longe! Agora:
      o tesouro!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_24
    id: 8
    episode: 3
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Caramba, dentro do ba\xFA \xE9 ainda mais fedido do que aqui fora!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_31
    id: 9
    episode: 3
    emotion: sad
    slug: minigame5
    minigame: 
  - text: "Olhe a\xED dentro, Guardi\xE3o. Veja o que era a tal coisa t\xE3o preciosa
      que o Ruto deixou."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_32
    id: 10
    episode: 3
    emotion: sad
    slug: minigame5
    minigame: 
  - text: "Acho que essa hist\xF3ria est\xE1 ficando cada vez mais misteriosa! O que
      \xE9 esse objeto poderoso e quem o roubou?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_41
    id: 11
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: "A \xFAnica forma de descobrir a resposta \xE9 ir at\xE9 a fronteira da
      Floresta Assombrada e perguntar ao Ruto n\xF3s mesmos!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_42
    id: 12
    episode: 3
    emotion: happy
    slug: final
    minigame: 
  - text: "Este \xE9 o mapa da Floresta Assombrada. Vamos us\xE1-lo para chegar at\xE9
      a toca do Rei Goblin."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_05
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Qual ser\xE1 o caminho mais curto at\xE9 a toca do Rei Goblin? S\xF3 que
      n\xE3o se esque\xE7a que precisamos passar pela Casa do Feiticeiro Zuzu, mas
      sem passar perto do Vampiro Banguela, viu?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_06
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ser\xE1 esse o menor caminho, passando pelo Lar do Feiticeiro Zuzu e evitando
      a casa do Vampiro? Ouvi dizer que ele gosta de Guardi\xF5es... Para o almo\xE7o!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_07
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 1
  - text: E se pegarmos este caminho?
    world: 2
    season: 3
    sound: ptbr_ep43_clr_08
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Esse \xE9 o melhor caminho mesmo."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_09
    id: 4
    episode: 3
    emotion: regular
    slug: victory
    minigame: 1
  - text: "O grande Feiticeiro Zuzu vai nos ajudar a recuperar o que o Rei Goblin
      roubou de n\xF3s!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_12
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Mas o feiti\xE7o que nos ajudar\xE1 est\xE1 aqui... O problema \xE9 que
      rasgou e seus peda\xE7os se misturaram com outros feiti\xE7os! Precisamos montar
      as frases que rimam para cada feiti\xE7o."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_13
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o acho que essas frases rimem... Precisamos de outra combina\xE7\xE3o.
      Quem sabe prestando aten\xE7\xE3o nos finais? Lago, mexe, sacudiu... Dormiu,
      por exemplo, rima com sacudiu, n\xE3o \xE9?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_14
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Acho que esse feiti\xE7o n\xE3o funciona... Vamos tentar deste jeito: um
      sapo na beira do lago faz tudo ficar congelado! Mexe, mexe, mexe \u2013 e uma
      bola de fogo acontece! Se o feiti\xE7o sacudiu, o Rei Goblin dormiu!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_15
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Parece que o Feiticeiro Zuzu est\xE1 contente! O feiti\xE7o est\xE1 pronto!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_16
    id: 4
    episode: 3
    emotion: happy
    slug: victory
    minigame: 2
  - text: "L\xE1 est\xE1 ele, Guardi\xE3o! Vamos usar o feiti\xE7o!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_19
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Espere a\xED... Mas tem alguma coisa faltando nesse feiti\xE7o! Ele n\xE3o
      vai funcionar!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_20
    id: 1
    episode: 3
    emotion: scared
    slug: intro
    minigame: 3
  - text: "\xC9 um som! O som de alguma coisa desaparecendo! Mas, que som \xE9 esse?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_21
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Esse som n\xE3o soa certo... Tem que ser um que lembre algo sumindo no
      ar!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_22
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: Ploft? Plaft? Pluf!
    world: 2
    season: 3
    sound: ptbr_ep43_clr_23a
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Esse som n\xE3o soa certo... Tem que ser um que lembre algo sumindo no
      ar!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_22
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Esse som \xE9 mesmo de sumi\xE7o! Tchau, tchau, Rei Goblin!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_23b
    id: 6
    episode: 3
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Com certeza a coisa que o P\xE9 Grande guardava est\xE1 a\xED dentro, mas
      o ba\xFA est\xE1 trancado!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_25
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Olhe o cadeado. Parece que funciona com uma senha. Qual \xE9 a resposta?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_26
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o abriu... Vamos somar um por um os n\xFAmeros para ter a resposta.
      100 mais 100 mais 100 j\xE1 d\xE1 300... O que falta somar?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_27
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Ainda n\xE3o abriu. Precisamos somar todos, mas com muita aten\xE7\xE3o,
      pois tem alguns que s\xE3o centena, outros dezena ou unidade. As centenas somam
      300... E as dezenas? 10 mais 10 d\xE1 quanto?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_28
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 4
  - text: "100 + 100 + 100 s\xE3o 300... Mais 10 + 10 que d\xE1 20... 320... Mais
      1..."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_29
    id: 4
    episode: 3
    emotion: regular
    slug: error3
    minigame: 4
  - text: "321! \xC9 esta a resposta! Olha, abriu!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_30
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Um bilhete? N\xE3o \xE9 poss\xEDvel! E foi escrito pelo pr\xF3prio Ruto!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_33
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ser\xE1 que ele veio at\xE9 aqui e levou o tal objeto sem que o Rei Goblin
      visse?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_34
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O bilhete est\xE1 incompleto... Qual ser\xE1 a parte certa que faz sentido
      aqui?"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_35
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Isso n\xE3o faz sentido... Acho que \xE9 outro peda\xE7o."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_36
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Nunca vi bilhete se machucando! Acho que n\xE3o \xE9 esse o trecho que
      completa a frase..."
    world: 2
    season: 3
    sound: ptbr_ep43_clr_37
    id: 4
    episode: 3
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Tamb\xE9m n\xE3o pode ser este peda\xE7o... Ent\xE3o, s\xF3 pode ser este
      aqui... Se ele cair em m\xE3os erradas, ser\xE1 o fim de todos n\xF3s!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_39
    id: 5
    episode: 3
    emotion: regular
    slug: error2
    minigame: 5
  - text: Bilhete dorminhoco? Novidade para mim!
    world: 2
    season: 3
    sound: ptbr_ep43_clr_38
    id: 6
    episode: 3
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Caramba, o Ruto partiu em busca do tal objeto poderoso! Ent\xE3o outra
      pessoa o roubou antes!"
    world: 2
    season: 3
    sound: ptbr_ep43_clr_40
    id: 7
    episode: 3
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Nesta dire\xE7\xE3o a Floresta Escura termina bem perto da Caverna dos
      Ecos Sem Fim. J\xE1 ouviu falar desse lugar?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_01
    id: 0
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "\xC9 onde um monte de monstros que n\xE3o sabem viver em sociedade se escondem,
      inclusive o Bicho-Pap\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_02
    id: 1
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Alguns anos atr\xE1s o Prefeito colocou um posto de vigia por aqui, para
      garantir que nenhum monstro escape. Certamente o vigia nos ajudar\xE1."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_03
    id: 2
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei, quem \xE9 esse a\xED? Ser\xE1 que \xE9 o vigia?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_04
    id: 3
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: O lagarto fugiu! Precisamos encontrar o vigia!
    world: 2
    season: 3
    sound: ptbr_ep44_clr_09
    id: 4
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ele saber\xE1 nos dizer o que aconteceu!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_10
    id: 5
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Se o vigia n\xE3o viu monstro algum sair da caverna, talvez aquele lagarto
      que vimos n\xE3o tenha vindo de dentro dela! Ent\xE3o quem mandou amarrar o
      vigia?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_17
    id: 6
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Um mist\xE9rio de cada vez! Precisamos saber se o vigia viu o Ruto por
      aqui!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_18
    id: 7
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Parece que o vigia quer dizer alguma coisa para voc\xEA, Guardi\xE3o."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_26
    id: 8
    episode: 4
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Olha, esse Ruto \xE9 corajoso mesmo, hein? S\xF3 tem monstro nessa caverna!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_33
    id: 9
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Gostei dele! Vamos l\xE1... Ei, o vigia quer dizer mais alguma coisa."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_34
    id: 10
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Acho melhor irmos logo, antes que os monstros todos se cansem de assustar
      o Ruto, n\xE3o \xE9? N\xE3o podemos perder essa oportunidade!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_42
    id: 11
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "Caverna dos Ecos Sem Fim, aqui vamos n\xF3s!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_43
    id: 12
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "Quem \xE9 voc\xEA? Certamente n\xE3o \xE9 o vigia! Ser\xE1 que esse lagarto
      escapou da caverna?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_05
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O qu\xEA? Quem? Guardi\xE3o, veja se voc\xEA entende o que ele diz. Quem
      \xE9 esperto e forte?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_06
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ser\xE1 que n\xE3o \xE9 o Ruto? Acho que faz mais sentido..."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_07
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Ent\xE3o o Ruto deve ter entrado na caverna! Estamos chegando perto!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_08
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Olha! Tem uma penumbra amarrada aqui! Vamos solt\xE1-la."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_11
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Muito bem, sua penumbra, tenho algumas perguntinhas para voc\xEA! Guardi\xE3o,
      me ajuda aqui. Me diga quais s\xE3o as perguntas que eu vou fazer."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_12
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "As respostas desse sujeito n\xE3o precisam ficar marcadas, mas todas as
      minhas perguntas precisam, sim."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_13
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Quais frases terminam com um ponto de interroga\xE7\xE3o? Essas s\xE3o
      as perguntas!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_14
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Ficou faltando alguma coisa a\xED."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_15
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Pronto! Ent\xE3o, voc\xEA \xE9 o vigia, n\xE3o \xE9? Mas quem poderia t\xEA-lo
      amarrado?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_16
    id: 5
    episode: 4
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Ent\xE3o o Ruto passou por aqui! E veio atr\xE1s de um monstro terr\xEDvel
      e malvado... Mas qual?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_19
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ruto deixou uma lista de caracter\xEDsticas do monstro que ele veio procurar."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_20
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "O vigia tem v\xE1rios cartazes de monstros procurados. Precisamos descobrir
      qual deles Ruto veio capturar. \xC9 s\xF3 dizer quais partes do corpo dos monstros
      s\xE3o semelhantes e quais s\xE3o diferentes."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_21
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Alguma coisa n\xE3o bate... Vamos rever as caracter\xEDsticas em cada um
      dos cartazes?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_22
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Isso n\xE3o est\xE1 me cheirando bem. Alguma caracter\xEDstica est\xE1
      fora do lugar."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_23
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 3
  - text: Precisamos mudar essas aqui de lugar, e pronto!
    world: 2
    season: 3
    sound: ptbr_ep44_clr_24
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Ser\xE1 que \xE9 esse o monstro? Mas por que o Ruto viria atr\xE1s dele?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_25
    id: 6
    episode: 4
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Ruto deixou um bilhete para voc\xEA? Provavelmente s\xF3 confiava em outro
      guardi\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_27
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Mas est\xE1 tudo em c\xF3digo! Voc\xEA vai precisar usar seu decodificador
      de c\xF3digos para revelar a mensagem... Sem letras mai\xFAsculas e min\xFAsculas
      n\xE3o d\xE1 certo, n\xE9?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_28
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Opa! Temos que ter s\xF3 letras, mai\xFAsculas e min\xFAsculas! Tem certeza
      de que usou o decodificador direito?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_29
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Tem alguma coisa esquisita a\xED. Ser\xE1 mesmo que voc\xEA escolheu s\xF3
      letras, e incluiu mai\xFAsculas e min\xFAsculas?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_30
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 4
  - text: Vamos tentar de um jeito diferente. Eu ajudo.
    world: 2
    season: 3
    sound: ptbr_ep44_clr_31
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: '"Parti para a Caverna dos Ecos Sem Fim!" Nossa! Ele entrou na caverna!
      Que doido!'
    world: 2
    season: 3
    sound: ptbr_ep44_clr_32
    id: 5
    episode: 4
    emotion: happy
    slug: victory
    minigame: 4
  - text: Flores? Para mim? Nossa, que inesperado!
    world: 2
    season: 3
    sound: ptbr_ep44_clr_35
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: Como assim eu posso precisar delas? Dentro da caverna?
    world: 2
    season: 3
    sound: ptbr_ep44_clr_36
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Bom, vamos levar 12 flores. Se o vigia tinha 34, quantas flores v\xE3o
      sobrar para ele, Guardi\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_37
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Bom, cada vaso tem 10 flores. Eu s\xF3 quero 12. Quantas flores devolvemos?"
    world: 2
    season: 3
    sound: ptbr_ep44_clr_38
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Vamos usar as flores para contar. S\xE3o 12 delas para mim e tudo que sobrar
      \xE9 do vigia."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_39
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Um vaso e mais duas flores para mim. V\xE3o sobrar dois vasos e mais duas
      flores..."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_40
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 5
  - text: "22 flores! Muito obrigada, vigia! O senhor \xE9 muito gentil."
    world: 2
    season: 3
    sound: ptbr_ep44_clr_41
    id: 6
    episode: 4
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Sabe de uma coisa, Guardi\xE3o? Essa tal de Caverna dos Ecos Sem Fim nem
      \xE9 t\xE3o assustadora assim."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_01
    id: 0
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eu esperava drag\xF5es, fantasmas e zumbis..."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_02
    id: 1
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei, olhe! Um monstro sem olhos! Que legal! Sempre quis ver um! Dizem que
      ele adora devorar penumbras e guardi\xF5es!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_03
    id: 2
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O que foi? N\xE3o acha uma boa ideia falar com o monstro? Bom, se voc\xEA
      prefere, podemos tentar prend\xEA-lo. Mas precisamos descobrir como atrair o
      monstro para cima desta armadilha."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_04
    id: 3
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Precisamos de alguma coisa com cheiro bem doce para atrair o monstro, mas
      o qu\xEA?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_11
    id: 4
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "As flores que o vigia me deu! Mas \xE9 claro! Vamos coloc\xE1-las na armadilha!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_12
    id: 5
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Essa foi boa, n\xE3o \xE9? Ele quase nos pegou! Que demais! Mas agora precisamos
      cruzar este rio."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_19
    id: 6
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Olha, um telefone! Vamos us\xE1-lo! Vai que ele chama um outro monstro!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_20
    id: 7
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Que figura sinistra! Ol\xE1, seu Barqueiro, tudo bom?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_28
    id: 8
    episode: 5
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Est\xE1 ouvindo esse barulho? Parece que h\xE1 algu\xE9m mais a frente!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_35
    id: 9
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Olha s\xF3 essas criaturas! Ser\xE1 que elas t\xEAm alguma pista do Ruto?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_36
    id: 10
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Guardi\xE3o, n\xF3s precisamos correr antes que o Ruto vire comida de aranha
      gigante!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_44
    id: 11
    episode: 5
    emotion: scared
    slug: final
    minigame: 
  - text: "R\xE1pido! Nesta dire\xE7\xE3o! Estamos indo, Ruto!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_45
    id: 12
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: Vamos pesquisar neste tablet. Com certeza vamos encontrar um site que nos
      ajude a atrair o Monstro sem Olhos.
    world: 2
    season: 3
    sound: ptbr_ep45_clr_05
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Voc\xEA pode navegar pelas p\xE1ginas para escolher um dos sites."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_06
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "\"Como atrair monstros sem olhos.\" \"Brincando com monstros sem olhos.\"
      \"Espaguete de olhos de monstro.\" \"Como construir uma armadilha.\" \"Aulas
      de dan\xE7a para monstros.\""
    world: 2
    season: 3
    sound: ptbr_ep45_clr_07
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Precisamos de um que nos ensine a levar esse monstro at\xE9 a armadilha."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_08
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: 'Vamos tentar esta aqui: "Como atrair monstros sem olhos." Deve funcionar!'
    world: 2
    season: 3
    sound: ptbr_ep45_clr_09
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Caramba, parece que, como eles n\xE3o enxergam, esses monstros desenvolveram
      muito bem o olfato!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_10
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Com certeza essas flores atrair\xE3o o monstro, mas precisamos separ\xE1-las
      direito."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_13
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: Vamos colocar apenas as flores dentro da armadilha, cada uma no seu devido
      lugar.
    world: 2
    season: 3
    sound: ptbr_ep45_clr_14
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Temos que tomar cuidado para n\xE3o misturar as coisas. Cada conjunto pede
      um tipo de flor."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_15
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 2
  - text: "As flores azuis t\xEAm um cheiro diferente, ent\xE3o, s\xE3o flores, mas
      ficam no seu pr\xF3prio conjunto."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_16
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 2
  - text: Eu ajudo a arrumar tudo antes que o monstro sem olhos chegue aqui.
    world: 2
    season: 3
    sound: ptbr_ep45_clr_17
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Funcionou! O monstro caiu e est\xE1 preso na armadilha!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_18
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Parece que \xE9 uma lista telef\xF4nica! E cada letra tem uma por\xE7\xE3o
      de contatos."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_21
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Precisamos de algu\xE9m para nos ajudar a cruzar este rio."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_22
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: Procure o nome do Barqueiro na lista e depois ligue para ele.
    world: 2
    season: 3
    sound: ptbr_ep45_clr_23
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "A lista est\xE1 em ordem alfab\xE9tica. Precisamos primeiro encontrar a
      p\xE1gina certa, com a letra B, depois escolher o nome Barqueiro."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_24
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Esta \xE9 a p\xE1gina correta, com os nomes come\xE7ados com a letra B.
      Onde est\xE1 o nome barqueiro?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_25
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 3
  - text: "\xC9 este aqui! Pode ligar pra ele Guardi\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_26
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "L\xE1 vem ele!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_27
    id: 6
    episode: 5
    emotion: happy
    slug: victory
    minigame: 3
  - text: Ele cobra um pote inteiro de olhos de caolho para nos levar ao outro lado!
      Que roubo!
    world: 2
    season: 3
    sound: ptbr_ep45_clr_29
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ainda temos 30 olhos e ele quer 10. Quantos v\xE3o sobrar, Guardi\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_30
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: Tem certeza? Cada pote tem 10 olhos.
    world: 2
    season: 3
    sound: ptbr_ep45_clr_31
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Bem, t\xEDnhamos 3 potes, vamos usar 1 e ficar com 2 potes... Ent\xE3o...Sobram
      quantos mesmo?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_32
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Se cada pote tem 10 olhos de caolho, ent\xE3o..."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_33
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 4
  - text: "S\xF3 nos restam 20 olhos de caolho! Caramba, esta miss\xE3o est\xE1 saindo
      cara, hein?"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_34
    id: 5
    episode: 5
    emotion: sad
    slug: victory
    minigame: 4
  - text: "S\xE3o os Broncos! Eles vivem escondidos nessas cavernas."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_37
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Dizem que desenham tudo o que veem, ent\xE3o certamente esses desenhos
      s\xE3o uma pista sobre aonde foi o Ruto."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_38
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Mas n\xE3o est\xE1 f\xE1cil de entender. O que querem dizer os desenhos?
      Vamos tentar descobrir o que cada personagem do desenho falou em cada um deles."
    world: 2
    season: 3
    sound: ptbr_ep45_clr_39
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Parece meio estranho... Um com certeza \xE9 o Ruto. O outro parece um tipo
      de aranha gigante!"
    world: 2
    season: 3
    sound: ptbr_ep45_clr_40
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: Precisamos colocar as falas de cada personagem no desenho certo para saber
      o que aconteceu.
    world: 2
    season: 3
    sound: ptbr_ep45_clr_41
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: Vamos colocar desse jeito aqui. Isso deve nos ajudar.
    world: 2
    season: 3
    sound: ptbr_ep45_clr_42
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 5
  - text: Caramba! O Ruto foi capturado por uma aranha gigante!
    world: 2
    season: 3
    sound: ptbr_ep45_clr_43
    id: 6
    episode: 5
    emotion: scared
    slug: victory
    minigame: 5
  - text: "Nunca imaginei que diria isso, mas este lugar me d\xE1 calafrios..."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_01
    id: 0
    episode: 6
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Est\xE1 tudo t\xE3o quieto que estou at\xE9 desconfiada."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_02
    id: 1
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Por que o Ruto se meteu num lugar destes, hein?
    world: 2
    season: 3
    sound: ptbr_ep46_clr_03
    id: 2
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Olhe! Uma porta! Com certeza o Ruto est\xE1 do outro lado!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_04
    id: 3
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O que \xE9 isso a\xED na frente? Parecem quadros."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_11
    id: 4
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Vamos investigar!
    world: 2
    season: 3
    sound: ptbr_ep46_clr_12
    id: 5
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Se aquilo \xE9 o que ela costuma fazer, quer dizer que logo logo vai almo\xE7ar
      o Ruto!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_19
    id: 6
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Ei, tem alguma coisa se mexendo naquela teia logo ali!
    world: 2
    season: 3
    sound: ptbr_ep46_clr_20
    id: 7
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Foge, Ruto! A aranha gigante est\xE1 vindo!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_26
    id: 8
    episode: 6
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "Que pena, n\xE3o \xE9, dona aranha? Seu almo\xE7o foi embora! E por que
      voc\xEA est\xE1 olhando desse jeito para n\xF3s?"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_34
    id: 9
    episode: 6
    emotion: scared
    slug: minigame5
    minigame: 
  - text: "Essa aranha parece meio faminta, n\xE3o? Acho melhor arranjarmos outra
      coisa para ela comer, antes que resolva provar outro guardi\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_35
    id: 10
    episode: 6
    emotion: scared
    slug: minigame5
    minigame: 
  - text: "Com a aranha gigante dormindo profundamente n\xF3s poderemos ir embora
      para casa, n\xE3o \xE9?"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_43
    id: 11
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Como assim n\xE3o, Ruto? Precisamos ir para a toca do Bicho Pap\xE3o? Se
      prepare Guardi\xE3o, agora vamos enfrentar um monstro de verdade!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_44
    id: 12
    episode: 6
    emotion: happy
    slug: final
    minigame: 
  - text: "A porta tem algum tipo de senha para abrir, alguma coisa a ver com a posi\xE7\xE3o
      dessas teias."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_05
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Precisamos colocar a pe\xE7a certa para abrir a porta."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_06
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Parece que \xE9 um tipo de sequ\xEAncia, cada pe\xE7a numa posi\xE7\xE3o
      diferente. Qual est\xE1 faltando?"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_07
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "\xC9 como se as pe\xE7as mostrassem a teia rodando, n\xE3o \xE9? Repare
      na posi\xE7\xE3o de cada olho."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_08
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Deve ser essa pe\xE7a aqui, com o olho apontado para baixo."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_09
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Pronto! As pe\xE7as juntas formam uma sequ\xEAncia, como se estivessem
      rodando! Agora vamos entrar."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_10
    id: 5
    episode: 6
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Quem diria... Uma aranha pintora! Parece que ela pintou uma hist\xF3ria."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_13
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "O que ser\xE1 que ela est\xE1 fazendo em cada um dos quadros? Me ajuda
      a completar cada um?"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_14
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Acho que alguma coisa est\xE1 estranha. Cada a\xE7\xE3o tem que ter a ver
      com o desenho."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_15
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Isso est\xE1 meio esquisito. Algum verbo est\xE1 fora do lugar!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_16
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Acho que a ordem certa \xE9 essa aqui."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_17
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Parece que ela est\xE1 imitando os Broncos, desenhando tudo que faz!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_18
    id: 5
    episode: 6
    emotion: happy
    slug: victory
    minigame: 2
  - text: "\xC9 o Guardi\xE3o Ruto! Calma, Ruto, n\xF3s vamos lhe soltar!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_21
    id: 0
    episode: 6
    emotion: scared
    slug: intro
    minigame: 3
  - text: "O Ruto n\xE3o parece muito feliz, n\xE9? Acho que eu tamb\xE9m n\xE3o estaria
      se fosse virar almo\xE7o de aranha."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_22
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: Precisamos derrubar essa teia. Deve haver alguma pista de como fazer isso
      por aqui.
    world: 2
    season: 3
    sound: ptbr_ep46_clr_23
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "A coluna da esquerda \xE9 fr\xE1gil! N\xE3o vai aguentar o peso de duas
      pedras."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_24
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Voc\xEA est\xE1 livre, Ruto! Oba!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_25
    id: 4
    episode: 6
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Oi, dona aranha, tudo bem? Ent\xE3o... Estava passando por aqui e tal..."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_27
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Acho que ela quer saber se vimos o Ruto por aqui! Precisamos descrever
      o contr\xE1rio do Ruto para engan\xE1-la."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_28
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\xC9 s\xF3 separar as descri\xE7\xF5es ao contr\xE1rio do Ruto nesta coluna
      da direita."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_29
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ent\xE3o, dona aranha, n\xE3o vimos esse cara a\xED, n\xE3o... Era bem
      diferente, n\xE3o \xE9, Guardi\xE3o? Ele era..."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_30
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 4
  - text: "\xC9 para falar ao contr\xE1rio da foto, Guardi\xE3o! Precisamos enganar
      a aranha gigante!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_31
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ent\xE3o, dona aranha, esquece essa foto a\xED, n\xE3o \xE9? Nem \xE9 ele
      que vimos!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_32
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Acho que funcionou! Ela acha que n\xE3o vimos o Ruto de verdade!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_33
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 4
  - text: "\xD3tima ideia, Guardi\xE3o! Podemos usar essas sementes de frutas do sono
      que sobraram de nossa outra aventura!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_36
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Pode deixar, dona aranha! Vamos preparar um almo\xE7o muito gostoso para
      voc\xEA!"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_37
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Temos 32 sementes. Se dermos 25 para a aranha, quantas sementes v\xE3o
      sobrar?"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_38
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: Precisamos diminuir 25 sementes da quantidade total que temos aqui.
    world: 2
    season: 3
    sound: ptbr_ep46_clr_39
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "N\xE3o acho que seja isso. Porque n\xE3o usa as sementes para ajudar a
      contar?"
    world: 2
    season: 3
    sound: ptbr_ep46_clr_40
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ser\xE1 que \xE9 isso? Deixe me ver... tiramos 25 de 32 e sobram..."
    world: 2
    season: 3
    sound: ptbr_ep46_clr_41
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: 7 sementes! Vamos guardar estas porque nunca se sabe quando vamos precisar
      novamente.
    world: 2
    season: 3
    sound: ptbr_ep46_clr_42
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Chegamos na toca do Bicho Pap\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_01
    id: 0
    episode: 7
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Viu isso, Guardi\xE3o? Ruto disse que o Bicho Pap\xE3o roubou um objeto
      muito poderoso que o P\xE9 Grande estava guardando."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_02
    id: 1
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas por que o Bicho Pap\xE3o faria isso? Ser\xE1 que ele est\xE1 tentando
      conquistar esse sonho?"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_03
    id: 2
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Caramba! O Bicho Pap\xE3o capturou v\xE1rias penumbras! Precisamos libert\xE1-las!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_04
    id: 3
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Opa! O Bicho Pap\xE3o nos viu aqui e est\xE1 bem brabo agora!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_11
    id: 4
    episode: 7
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "R\xE1pido, vamos derrub\xE1-lo com aquela corda!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_12
    id: 5
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "O Bicho Pap\xE3o est\xE1 desmaiado! E agora? O que faremos?"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_18
    id: 6
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: O Ruto disse que deve ter alguma pista sobre os planos do monstro aqui.
      Vamos investigar!
    world: 2
    season: 3
    sound: ptbr_ep47_clr_19
    id: 7
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Veja se voc\xEA encontra algum papel ou coisa assim que possa nos ajudar,
      Guardi\xE3o."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_27
    id: 8
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Ent\xE3o aquele Lagarto que prendeu o vigia n\xE3o fugiu da caverna. Ele
      trabalha para o Senhor Sombrio!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_34
    id: 9
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Se s\xE3o sustos que ele quer, sustos ele ter\xE1! Vamos quebrar esses
      jarros!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_35
    id: 10
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Caramba, o Bicho Pap\xE3o ficou desesperado e comeu todos os sustos de
      uma \xFAnica vez! Espero que tenha uma indigest\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_43
    id: 11
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Bom, acho que agora s\xF3 resta uma coisa a fazer: enfrentar o Senhor Sombrio!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_44
    id: 12
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Guardi\xE3o, enquanto eu distraio o Bicho Pap\xE3o, voc\xEA precisa quebrar
      o feiti\xE7o que controla essas pobres penumbras."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_05
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Essa \xE9 a Joia da Servid\xE3o. Para quebrar o feiti\xE7o, precisamos
      inverter a palavra m\xE1gica."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_06
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "N\xE3o funcionou. S\xF3 vai funcionar se escrevermos a palavra m\xE1gica
      \"servil\" de tr\xE1s para frente..."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_07
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 1
  - text: Nada ainda. Vamos escrever letra por letra, mas invertendo a ordem de "servil".
    world: 2
    season: 3
    sound: ptbr_ep47_clr_08
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Espera a\xED... \"servil\" ao contr\xE1rio \xE9 \"livres\"!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_09
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Funcionou! Fujam, amigas! Os guardi\xF5es e eu cuidaremos do Bicho Pap\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_10
    id: 5
    episode: 7
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Precisamos derrub\xE1-lo de surpresa."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_13
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ele precisa trope\xE7ar na corda enquanto estiver correndo. Pode me ajudar
      a montar esse plano?"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_14
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Mas assim n\xE3o vai funcionar! Eu preciso puxar a corda no momento exato
      em que ele estiver correndo!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_15
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Precisamos peg\xE1-lo de surpresa! Para isso, devemos puxar a corda ao
      mesmo tempo em que o Bicho Pap\xE3o correr..."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_16
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 2
  - text: "O Bicho Pap\xE3o caiu direitinho!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_17
    id: 4
    episode: 7
    emotion: happy
    slug: victory
    minigame: 2
  - text: "As coisas do Bicho Pap\xE3o sa\xEDram do lugar quando ele e as penumbras
      correram."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_20
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Assim n\xE3o d\xE1 para encontrar nada!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_21
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos precisar colocar tudo no lugar, do jeito que est\xE1 nessa foto,
      para podermos procurar direito."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_22
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos precisar usar a foto como refer\xEAncia, mas ela foi tirada de um
      lugar diferente."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_23
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: "A foto d\xE1 a pista, mas precisamos imaginar onde cada objeto deve ficar
      olhando deste outro \xE2ngulo."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_24
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Isso est\xE1 dando o maior trabalho! Deixa eu ajudar."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_25
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Agora sim! Est\xE1 tudo novamente no seu devido lugar! Mas nenhuma pista
      ainda. Vamos continuar procurando."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_26
    id: 6
    episode: 7
    emotion: happy
    slug: victory
    minigame: 3
  - text: "O que voc\xEA encontrou a\xED, Guardi\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_28
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Parece algum tipo de acordo ou contrato, mas est\xE1 meio comprido! Vamos
      trocar alguns desses nomes por pronomes, n\xE9? Fica mais f\xE1cil de ler."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_29
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Quando o texto se repete muito, fica chato! Acho que o neg\xF3cio \xE9
      trocar nomes repetidos por \"ele\", \"ela\" ou \"eles\"."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_30
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Voc\xEA est\xE1 me dando uma ideia! Que tal chamar o Senhor Sombrio de
      \"ele\"? Como podemos chamar a M\xE1quina Amplificadora?"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_31
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 4
  - text: Vou ajudar a mudar o texto para podermos ler tranquilamente.
    world: 2
    season: 3
    sound: ptbr_ep47_clr_32
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Eu n\xE3o acredito! O Senhor Sombrio est\xE1 por tr\xE1s de tudo desde
      o in\xEDcio! E quer dominar o Mundo dos Sonhos!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_33
    id: 5
    episode: 7
    emotion: scared
    slug: victory
    minigame: 4
  - text: "O Bicho Pap\xE3o come sustos para sobreviver. Por isso vive dando sustos
      em todo mundo."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_36
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Pelo jeito ele estava vendendo sustos para o Senhor Sombrio, o que \xE9
      uma coisa terr\xEDvel!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_37
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos empilhar esses jarros de susto na ordem. Isso far\xE1 com que caiam
      e se quebrem!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_38
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vejamos... 2, 5, 22, 25... Os jarros precisam ficar na ordem. Assim, todos
      se quebrar\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_39
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Temos que olhar todos os n\xFAmeros com calma para ver qual vem depois
      de qual..."
    world: 2
    season: 3
    sound: ptbr_ep47_clr_40
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Eu vou ajud\xE1-lo, Guardi\xE3o. Juntos conseguiremos colocar os n\xFAmeros
      em ordem crescente!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_41
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Os jarros v\xE3o cair! Vamos nos afastar!"
    world: 2
    season: 3
    sound: ptbr_ep47_clr_42
    id: 6
    episode: 7
    emotion: scared
    slug: victory
    minigame: 5
  - text: "Devia ter imaginado que o Senhor Sombrio estava por tr\xE1s disso. Ele
      est\xE1 sempre querendo conquistar o Mundo dos Sonhos!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_01
    id: 0
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ent\xE3o esse tal objeto misterioso era um disco de energia? Pelo jeito
      o Senhor Sombrio est\xE1 usando ele em sua nova m\xE1quina."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_02
    id: 1
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "\"M\xE1quina Amplificadora de Sustos...\" Que amador! Nem sabe dar um bom
      susto sozinho!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_03
    id: 2
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Bom, esse \xE9 o caminho para a Montanha Gelada? Precisamos atravessar
      esse precip\xEDcio."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_04
    id: 3
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "A Montanha Gelada \xE9 o ponto mais alto deste sonho. De l\xE1 o Senhor
      Sombrio poder\xE1 assustar a todos com sua m\xE1quina e dominar esse lugar."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_10
    id: 4
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Vamos em frente, guardi\xE3o! O Senhor Sombrio nos aguarda!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_11
    id: 5
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "L\xE1 est\xE1 o Senhor Sombrio, aquele malvad\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_18
    id: 6
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Precisamos fazer alguma coisa para impedi-lo!
    world: 2
    season: 3
    sound: ptbr_ep48_clr_19
    id: 7
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O Senhor Sombrio fugiu com o susto! E l\xE1 est\xE1 o Disco de Energia!
      Precisamos recuper\xE1-lo antes que o Senhor Sombrio retorne!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_27
    id: 8
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "O Senhor Sombrio voltou! Ele deve ter percebido que n\xE3o era nenhum monstro
      malvado que o assustou!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_34
    id: 9
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Sabe o que eu ia adorar? Que o Senhor Sombrio provasse do pr\xF3prio rem\xE9dio
      e levasse o maior susto da vida dele. Um susto de verdade!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_35
    id: 10
    episode: 8
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Viu s\xF3 o Senhor Sombrio fugindo de medo com aquela por\xE7\xE3o de monstros
      atr\xE1s dele?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_48
    id: 11
    episode: 8
    emotion: happy
    slug: final
    minigame: 
  - text: "Ele certamente aprendeu a li\xE7\xE3o! Gra\xE7as a sua ajuda Guardi\xE3o,
      o Senhor Sombrio nunca mais voltar\xE1 a atormentar o Sonho das Sombras Sussurrantes!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_49
    id: 12
    episode: 8
    emotion: happy
    slug: final
    minigame: 
  - text: "Voc\xEA \xE9 bem atento, Guardi\xE3o! Nem tinha visto essa placa!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_05
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Nossa, essa placa est\xE1 sem algumas v\xEDrgulas! Nem consigo ler direito.
      Voc\xEA pode me ajudar, Guardi\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_06
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "\xC9 mesmo dif\xEDcil isso... As v\xEDrgulas servem de pausa, ent\xE3o
      ficam entre certas palavras de um texto, por exemplo, quando listamos as coisas...."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_07
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Pelas minhas contas, h\xE1 4 v\xEDrgulas neste texto. Vamos ler com aten\xE7\xE3o
      para descobrir onde deveriam estar?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_08
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Pelas minhas contas, h\xE1 4 v\xEDrgulas neste texto. Vamos ler com aten\xE7\xE3o
      para descobrir onde deveriam estar?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_08
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Nossa! Pela quantidade de equipamentos que vamos precisar, \xE9 uma montanha
      perigosa mesmo... Mas n\xE3o temos tempo de voltar atr\xE1s agora!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_09
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Precisamos consertar essa m\xE1quina para subir a ponte."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_12
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Mas qual ser\xE1 a engrenagem que se encaixa aqui?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_13
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Parece que as engrenagens est\xE3o em sequ\xEAncia. Acho que \xE9 s\xF3
      completar a sequ\xEAncia com a pe\xE7a certa."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_14
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Precisamos olhar com mais aten\xE7\xE3o, n\xE3o \xE9? Voc\xEA n\xE3o acha
      que a pe\xE7a certa deve se parecer com as outras, mas como se o desenho estivesse
      rodando, mudando de posi\xE7\xE3o?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_15
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Posso tentar essa pe\xE7a aqui?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_16
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 2
  - text: Perfeito! O mecanismo funcionou e a ponte baixou!
    world: 2
    season: 3
    sound: ptbr_ep48_clr_17
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Voc\xEA tem um plano para tirar o disco de energia do Senhor Sombrio?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_20
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Deve ser algum tipo de c\xF3digo dos guardi\xF5es!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_21
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, me explique isso, por favor?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_22
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Essa frase n\xE3o fez sentido... Que tal tentar de outra forma."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_23
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "A gente tem que escolher um jeito de tentar juntar os dois peda\xE7os da
      frase, explicando a raz\xE3o de pegarmos o disco, n\xE3o \xE9?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_24
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Acho que entendi. Ent\xE3o agora eu vou assustar o Senhor Sombrio para
      ele largar o Disco de Energia!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_25
    id: 5
    episode: 8
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Se n\xE3o pegarmos o Disco de Energia, o Senhor Sombrio usar\xE1 ele em
      sua m\xE1quina!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_26
    id: 6
    episode: 8
    emotion: regular
    slug: victory
    minigame: 3
  - text: O Disco de Energia se danificou! E agora?
    world: 2
    season: 3
    sound: ptbr_ep48_clr_28
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Guardi\xE3o, s\xF3 voc\xEA pode reconstruir o disco!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_29
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ser\xE1 que os n\xFAmeros t\xEAm alguma rela\xE7\xE3o com o tamanho dos
      peda\xE7os?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_30
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Vendo voc\xEA fazer, estou tendo uma ideia... Que tal colocar o n\xFAmero
      menor, no peda\xE7o de tamanho menor, e assim por diante?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_31
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Agora j\xE1 sei como \xE9! Os n\xFAmeros devem corresponder ao tamanho:
      no maior peda\xE7o, colocamos o n\xFAmero maior..."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_32
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Pronto! Est\xE1 montado! Muito bem, Guardi\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_33
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 4
  - text: "A M\xE1quina Amplificadora de Sustos! Como eu n\xE3o tinha pensado nisso
      antes?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_36
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos l\xE1! Temos que ler as instru\xE7\xF5es e seguir os passos para
      colocarmos esse plano em pr\xE1tica!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_37
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: Em primeiro lugar, precisamos amarrar o Senhor Sombrio!
    world: 2
    season: 3
    sound: ptbr_ep48_clr_38
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O plano diz que a primeira coisa a fazer \xE9 amarrar o Senhor Sombrio,
      levando a corda at\xE9 ele. Mas e depois?"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_39
    id: 3
    episode: 8
    emotion: regular
    slug: error0_1
    minigame: 5
  - text: "Opa! Depois de amarrar, n\xE3o \xE9 para colocar o Senhor Sombrio em cima
      da M\xE1quina? Vamos Guardi\xE3o!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_40
    id: 4
    episode: 8
    emotion: regular
    slug: error0_2
    minigame: 5
  - text: "Agora \xE9 a vez de colocar o Senhor Sombrio sobre a m\xE1quina."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_42
    id: 5
    episode: 8
    emotion: regular
    slug: request1
    minigame: 5
  - text: "Agora \xE9 a vez de colocar o Senhor Sombrio sobre a m\xE1quina."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_42
    id: 6
    episode: 8
    emotion: regular
    slug: error1_1
    minigame: 5
  - text: "O Senhor Sombrio precisa estar em cima da m\xE1quina para o nosso plano
      funcionar!"
    world: 2
    season: 3
    sound: ptbr_ep48_clr_43
    id: 7
    episode: 8
    emotion: regular
    slug: error1_2
    minigame: 5
  - text: "Certo. Agora \xE9 s\xF3 colocar o Disco de Energia na m\xE1quina."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_44
    id: 8
    episode: 8
    emotion: regular
    slug: request2
    minigame: 5
  - text: "N\xE3o. Agora \xE9 o Disco de Energia dentro da m\xE1quina."
    world: 2
    season: 3
    sound: ptbr_ep48_clr_45
    id: 9
    episode: 8
    emotion: regular
    slug: error2_1
    minigame: 5
  - text: Eu posso lhe ajudar. Aqui.
    world: 2
    season: 3
    sound: ptbr_ep48_clr_46
    id: 10
    episode: 8
    emotion: regular
    slug: error2_2
    minigame: 5
  - text: Pronto! Tenha um bom susto, Senhor Sombrio!
    world: 2
    season: 3
    sound: ptbr_ep48_clr_47
    id: 11
    episode: 8
    emotion: happy
    slug: victory
    minigame: 5
