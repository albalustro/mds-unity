%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G2W1
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "Com mil bot\xF5es! O que \xE9 isso?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0a
    id: 0
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Guardi\xE3o! Guardi\xE3o! Que bom que voc\xEA ouviu nosso chamado! O Sonho
      das Coisas Perdidas est\xE1 em perigo! Olhe!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0b
    id: 1
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Esses rob\xF4s muito mal-encarados apareceram por toda a parte! Est\xE3o
      destruindo tudo por onde passam! Acredita que me expulsaram de casa?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0c
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Minha linda cole\xE7\xE3o de bot\xF5es... Ser\xE1 que jamais a verei novamente?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0d
    id: 3
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Conseguimos chegar at\xE9 a maleta! Olha que legal! Parece uma maleta de
      agente secreto!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0e
    id: 4
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "O que ser\xE1 que tem dentro? Com certeza \xE9 algo importante para esses
      rob\xF4s malucos!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0f
    id: 5
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Um controle remoto? Para que ser\xE1 que serve?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0g
    id: 6
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Acho que s\xF3 h\xE1 uma forma de descobrir, n\xE3o \xE9? Quer tentar?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0h
    id: 7
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos correr at\xE9 minha casa! Sabe-se l\xE1 quanto tempo temos at\xE9
      que esses rob\xF4s voltem..."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0i
    id: 8
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Lar, doce lar! Ei, eu n\xE3o esqueci a porta aberta! E por que meus m\xF3veis
      est\xE3o jogados do lado de fora?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0j
    id: 9
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ser\xE1 que os rob\xF4s do Senhor Sombrio pegaram minhas cole\xE7\xF5es?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0k
    id: 10
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Um desses rob\xF4s do mal deixou cair uma maleta daquelas em que guardam
      segredos. Tenho um plano infal\xEDvel para desviar a aten\xE7\xE3o do rob\xF4
      e peg\xE1-la sem ser visto!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O problema \xE9 que eu me embananei todo e n\xE3o lembro mais a ordem das
      coisas... Pode me ajudar?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Aqui, escrevi tudo neste quadro para ajudar. Pode colocar as coisas em
      ordem para sabermos qual \xE9 meu plano perfeito?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1c
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "N\xE3o, n\xE3o... Isso n\xE3o parece fazer sentido. Pense no que devemos
      fazer antes de..."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1d
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Isso est\xE1 meio confuso! Me lembro vagamente que a primeira coisa que
      ter\xEDamos de fazer era distrair os rob\xF4s com alguma coisa..."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1e
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Ent\xE3o eu devo... N\xE3o entendi! E se tentarmos de outra forma?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1f
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Sim! Era esse o plano! Atirar a pedra antes de correr, ou correr depois
      de atirar a pedra, tamb\xE9m daria no mesmo... \xC9 um excelente plano, n\xE3o
      \xE9?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1g
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 1
  - text: "N\xF3s formamos uma dupla e tanto! Vamos l\xE1?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1h
    id: 7
    episode: 1
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Nossa! Nem consigo ler o que est\xE1 escrito sem perder o f\xF4lego! Ser\xE1
      uma senha?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_2a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "S\xF3 pode estar escrito na l\xEDngua dos rob\xF4s! Eles n\xE3o precisam
      respirar para falar, sabia?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_2b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: Certo... Precisamos separar as palavras dessa frase. Isso deve abrir a maleta!
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_2c
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ainda n\xE3o consigo ler a senha. \"Abrir a...\""
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_2d
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Quase l\xE1! Acho que consigo ler uma parte."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_2e_2
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "E se colocarmos um espa\xE7o aqui? Pode apertar o bot\xE3o depois?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_2f
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: "\"Abrir a maleta\"? Mas que tipo de senha \xE9 essa! O importante \xE9
      que a maleta abriu!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_2g
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Parece que esse controle remoto comanda os rob\xF4s em volta da minha casa!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Se conseguirmos usar esse controle, eu posso ir at\xE9 a minha casa salvar
      meus bot\xF5es!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, me ajude a descobrir as sequ\xEAncias certas. Isso mandar\xE1
      esses rob\xF4s para bem longe!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3c
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 que s\xE3o pares de um lado e \xEDmpares do outro?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3d
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "N\xE3o parece que funcionou. Vamos tentar outra coisa: pares e \xEDmpares
      separados, mas em ordem?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3e
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: Talvez seja isso aqui...
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3f
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Acertamos! Era uma sequ\xEAncia crescente de n\xFAmeros \xEDmpares do lado
      esquerdo, e outra de n\xFAmeros pares do lado direito!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3g
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Veja! Os rob\xF4s est\xE3o voando para bem longe! Espero que nunca mais
      voltem!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_3h
    id: 7
    episode: 1
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Ei? O que \xE9 esse papel? Ser\xE1 que algu\xE9m esqueceu isso aqui?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Um bilhete! O que est\xE1 escrito a\xED?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o entendi. Por que o Senhor Panofino foi procurar um abrigo seguro?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4c
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Tem certeza de que \xE9 essa a resposta? Vamos rever o bilhete juntos?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4d
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "\"Prezado Bom Trapo, O Sonho das Coisas Perdidas est\xE1 em perigo! Os
      rob\xF4s do Senhor Sombrio est\xE3o por toda a parte. Est\xE3o revirando e quebrando
      tudo."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4d1
    id: 4
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Acho que procuram alguma coisa... Cuidado! Eles prenderam v\xE1rios Colecionadores
      que tentaram proteger suas cole\xE7\xF5es. Foram todos levados em seus discos
      voadores!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4d2
    id: 5
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Vou procurar abrigo em um lugar seguro. Sugiro que voc\xEA fa\xE7a o mesmo!
      Assinado: Senhor Panofino, seu vizinho.\""
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4d3
    id: 6
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Ora, mas, afinal... Por que meu vizinho Panofino foi procurar um abrigo
      seguro? Ser\xE1 que tem algo a ver com os rob\xF4s invasores?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4dc
    id: 7
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "N\xE3o entendi bem isso... Talvez seja outro motivo..."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4e
    id: 8
    episode: 1
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Porque os rob\xF4s est\xE3o prendendo Colecionadores! Ei, eu sou um Colecionador!
      Melhor me esconder tamb\xE9m!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_4f
    id: 9
    episode: 1
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Meus lindos bot\xF5es! Onde est\xE3o voc\xEAs?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_5a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "N\xE3o consigo encontrar minha cole\xE7\xE3o de bot\xF5es nessa bagun\xE7a!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_5b
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, voc\xEA precisa me ajudar! Coloque o nome de cada m\xF3vel
      em sua etiqueta, para ter certeza de que n\xE3o levaram nada, por favor!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_5c
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acho que tem alguma confus\xE3o aqui! Olhe de novo, com calma... Apenas
      4 m\xF3veis da lista est\xE3o aqui fora e todos estes 4 servem para sentar."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_5d
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Aqui, deixe-me marcar na lista os 4 m\xF3veis que vejo aqui fora."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_5e
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Nada dos meus bot\xF5es aqui! Deixe-me ajudar com as etiquetas."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_5f
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Pronto. Etiquetamos todos os m\xF3veis! Mas nada dos meus bot\xF5es..."
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_5g
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Ser\xE1 que meus bot\xF5es ainda est\xE3o dentro de casa? Guardi\xE3o!
      Precisamos salv\xE1-los!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0l
    id: 7
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Voc\xEA vai na frente. Eu... protejo a retaguarda!"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0m
    id: 8
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Bot\xF5ezinhos... cad\xEA voc\xEAs?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_0n
    id: 9
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Venha, Guardi\xE3o! Esta \xE9 minha casa!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0a
    id: 0
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas que horror! Esses rob\xF4s reviraram a minha casa toda! Olha s\xF3!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0b
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Arrumar tudo vai dar um trabalho...
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0c
    id: 2
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eles quebraram tantas coisas... E algumas eram t\xE3o... t\xE3o importantes..."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0d
    id: 3
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Tenho uma ideia! Olha aquela m\xE1quina ali."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0e
    id: 4
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Agora precisamos levar tudo para a M\xE1quina Faz-Tudo!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0f
    id: 5
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "E todas essas outras coisas espalhadas pelo ch\xE3o? Vou levar um temp\xE3o
      para arrumar tudo!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0g
    id: 6
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "A n\xE3o ser, \xE9 claro, que um certo Guardi\xE3o me ajude..."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0h
    id: 7
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Mais papel no ch\xE3o! Quem andou cortando papel na minha casa?"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0i
    id: 8
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Espere um pouco... A festa de anivers\xE1rio da Grande Bola de L\xE3 est\xE1
      para acontecer hoje!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0j
    id: 9
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Com certeza todos os Colecionadores estar\xE3o l\xE1! Eles podem estar
      em perigo!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0k
    id: 10
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Voc\xEA quer que eu v\xE1 junto para ajudar? Preciso mesmo? Est\xE1 bom...
      Vamos l\xE1!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_0l
    id: 11
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Voc\xEA vai me ajudar? Que bom! Muito obrigado!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_1a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Olhe as fotos da fam\xEDlia Bom Trapo... Todas rasgadas... Pode me ajudar
      a montar tudo como era antes?"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_1b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Deixe-me ajud\xE1-lo. Esse vai aqui..."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_1c
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 1
  - text: Pronto! Ligue a luz, por favor.
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_1d
    id: 3
    episode: 2
    emotion: regular
    slug: solved
    minigame: 1
  - text: "Est\xE1 pronto! As quatro gera\xE7\xF5es dos Bom Trapo completas novamente..."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_1e
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Meu bisav\xF4, meu av\xF4, meu pai... e aquele sou eu... quando ainda tinha
      cabelo. Est\xE1 vendo o que h\xE1 do lado de cada um? Sim, a Grande Bola de
      L\xE3, sendo constru\xEDda ao longo do tempo."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_1f
    id: 5
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: "A fam\xEDlia Bom Trapo esteve sempre presente nos momentos mais importantes
      da hist\xF3ria deste Sonho! Sim!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_1g
    id: 6
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Essa \xE9 uma Supercoletora 3.000! Eu mesmo a constru\xED com algumas tachinhas,
      p\xE9s-de-meia, filtro de caf\xE9 e um celular que deixaram por a\xED..."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_2a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Serve para pegar os objetos que n\xE3o usamos mais. Comece recolhendo estes:
      linha, clips, bola de gude e palito de sorvete."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_2b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Pegue a maior quantidade que puder destes objetos no meu jardim, mas cuidado
      para n\xE3o pegar nada da natureza! A natureza agradece!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_2c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Acho que isso \xE9 o suficiente. E de quebra limpamos meu jardim de toda
      essa sujeira! Muito bom!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_2f
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "A M\xE1quina Faz-Tudo! Comprei novinha de um vizinho que preferia pegar
      as coisas dos outros a faz\xEA-las ele mesmo!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_3a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: Os objetos que recolhemos entram aqui para reconstruir todas estas coisas
      legais.
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_3b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Agora basta colocar os objetos que forem pedidos nas instru\xE7\xF5es e
      pronto! Vamos reconstruir minhas coisas?"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_3c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: erro 1
    world: 1
    season: 2
    sound: 
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 3
  - text: erro 2
    world: 1
    season: 2
    sound: 
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 3
  - text: erro 3
    world: 1
    season: 2
    sound: 
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Tudo novinho, reconstru\xEDdo! Bengala, pente e muito mais...Voc\xEA \xE9
      muito bom nisso, Guardi\xE3o! Mas essa M\xE1quina Faz-Tudo \xE9 minha, nem vem!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_3d
    id: 6
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Acho que isso \xE9 tudo o que esses rob\xF4s de uma figa destru\xEDram!
      Agora, o que mais falta fazer?"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_3e
    id: 7
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Voc\xEA vai me ajudar? Oba!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_4a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "A minha cole\xE7\xE3o e a antiga cole\xE7\xE3o do meu av\xF4 est\xE3o todas
      bagun\xE7adas."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_4b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Eu pego um objeto e voc\xEA coloca na caixa certa, tudo bem? A cole\xE7\xE3o
      do meu av\xF4 s\xF3 tem coisas antigas, e a minha, s\xF3 coisas novas, que precisam
      de energia ou baterias para funcionar."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_4c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o, n\xE3o... Isso n\xE3o parece fazer sentido."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_4f
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Opa! Acho que n\xE3o \xE9 bem assim."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_4g
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ent\xE3o eu devo... n\xE3o entendi! E se tentarmos de outra forma?"
    world: 1
    season: 2
    sound: ptbr_ep9_bbt_1f
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Oba! Est\xE1 tudo arrumado!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_4d
    id: 6
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Mas... nenhum sinal da minha cole\xE7\xE3o de bot\xF5es!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_4e
    id: 7
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "\xC9 o jornal de hoje! Eu o encontrei perdido por a\xED, na porta de uma
      casa..."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: Mas quem o recortou todo? Ainda nem tive tempo de ler!
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: Vamos colocar na ordem certa? Talvez haja uma pista aqui!
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acho que essa foto n\xE3o fica aqui n\xE3o! O texto deve dar uma dica de
      onde cada uma fica."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5d
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Acho que essa foto n\xE3o fica aqui n\xE3o! O texto deve dar uma dica de
      onde cada uma fica."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5d
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Acho que essa foto n\xE3o fica aqui n\xE3o! O texto deve dar uma dica de
      onde cada uma fica."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5d
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Agora sim o jornal est\xE1 novinho em folha! Ou quase..."
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5e
    id: 6
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Vejamos... \"1 de janeiro de 1904: In\xEDcio da constru\xE7\xE3o da Grande
      Bola de L\xE3.\" Meu bisav\xF4 estava l\xE1!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5f
    id: 7
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "\"23 de mar\xE7o de 1914: A Grande Bola de L\xE3 fica pronta.\" Nossa,
      e pensar que h\xE1 tanto tempo nosso sonho depende dessa Bola de L\xE3 para
      nos dar energia!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5g
    id: 8
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "\"10 de fevereiro de 2004: Gato Boldo vira o protetor da Grande Bola de
      L\xE3.\" Lembro como se fosse ontem! Aquele gato enorme comeu todo meu bolo
      de anivers\xE1rio!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5h
    id: 9
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "\"23 de mar\xE7o de 2014: Comemora\xE7\xE3o do anivers\xE1rio de 100 anos
      da Grande Bola de L\xE3.\" 100 anos! Quanto tempo!"
    world: 1
    season: 2
    sound: ptbr_ep10_bbt_5i
    id: 10
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Eu sabia que tinha alguma coisa errada quando vi este foguete aterrissado
      no meio da festa! Tenho certeza de que os Colecionadores est\xE3o presos aqui
      dentro! \xC9 bem a cara do Senhor Sombrio!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0a
    id: 0
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Precisamos encontr\xE1-los logo, antes que os rob\xF4s voltem e decolem
      com o foguete!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0b
    id: 1
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos libert\xE1-los, Guardi\xE3o! E depois precisamos sair daqui antes
      que o Senhor Sombrio resolva voltar!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0c
    id: 2
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Pelos meus bigodes... Quantos de voc\xEAs havia a\xED dentro?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0d
    id: 3
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ser\xE1 que esses s\xE3o todos os Colecionadores sequestrados?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0e
    id: 4
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Certo! Est\xE3o todos aqui! Podemos ir embora agora?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0f
    id: 5
    episode: 3
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Ei, o que \xE9 aquele painel ali?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0g
    id: 6
    episode: 3
    emotion: regular
    slug: minigame4
    minigame: 
  - text: Podemos partir agora!
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0h
    id: 7
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "O que foi, Guardi\xE3o? Parece que voc\xEA est\xE1 tendo uma ideia!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_0i
    id: 8
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Aquele monitor ali em cima parece ser um mapa! Com certeza a bandeira mostra
      onde os Colecionadores est\xE3o presos!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Use o mapa para nos guiar at\xE9 a bandeira, passando pelas portas, mas
      cuidado para n\xE3o errar o caminho e dar de frente com aqueles perigos mostrados
      no mapa."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Temos duas sa\xEDdas agora... Qual \xE9 a porta certa que nos levar\xE1
      at\xE9 a sala da bandeira? Use o mapa como guia!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1c
    id: 2
    episode: 3
    emotion: regular
    slug: request1
    minigame: 1
  - text: "Tr\xEAs portas agora! Para onde devemos ir?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1e
    id: 3
    episode: 3
    emotion: regular
    slug: request2
    minigame: 1
  - text: "Estamos quase l\xE1! E agora? Qual \xE9 a porta que leva aos Colecionadores?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1h
    id: 4
    episode: 3
    emotion: regular
    slug: request3
    minigame: 1
  - text: "Acho que n\xE3o \xE9 por aqui! Melhor trancar essa porta!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1d
    id: 5
    episode: 3
    emotion: regular
    slug: error10
    minigame: 1
  - text: Ai, que perigo! Fecha isso!
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1f
    id: 6
    episode: 3
    emotion: regular
    slug: error20
    minigame: 1
  - text: "N\xE3o, n\xE3o! Desculpe o inc\xF4modo. Fecha isso!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1g
    id: 7
    episode: 3
    emotion: regular
    slug: error21
    minigame: 1
  - text: 
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1i
    id: 8
    episode: 3
    emotion: regular
    slug: error30
    minigame: 1
  - text: 
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1j
    id: 9
    episode: 3
    emotion: regular
    slug: error31
    minigame: 1
  - text: "Chegamos! Este \xE9 o lugar onde os colecionadores est\xE3o presos!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_1k
    id: 10
    episode: 3
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Calma, amigos! Logo vamos libert\xE1-los! Ou o meu nome n\xE3o \xE9 Bom
      Trapo!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_2a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Voc\xEA consegue libert\xE1-los, n\xE3o \xE9, Guardi\xE3o? Eu at\xE9 que
      gosto do meu nome..."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_2b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Quantos cadeados... Quantas chaves! Deve haver uma ordem certa para us\xE1-las!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_2c
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Acho que n\xE3o \xE9 essa a ordem... Ser\xE1 que os n\xFAmeros n\xE3o s\xE3o
      uma dica?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_2d
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Ainda n\xE3o foi! \xC9 uma sequ\xEAncia de n\xFAmeros, n\xE3o?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_2e
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 2
  - text: "N\xE3o funcionou? E se tentarmos desse jeito..."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_2f
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 2
  - text: Abriu! Era preciso colocar as chaves em ordem crescente!
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_2g
    id: 6
    episode: 3
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Acho melhor fazermos uma lista com os Colecionadores presentes, para termos
      certeza de que n\xE3o esquecemos ningu\xE9m!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_3a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Pode me ajudar, Guardi\xE3o? \xC9 s\xF3 colocar esses nomes em ordem para
      que eu veja se cada um deles est\xE1 aqui."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_3b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos fazer a chamada... Tem algo de errado com a ordem desses nomes, n\xE3o
      tem?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_3c
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Esses nomes est\xE3o embaralhados! \xC9 melhor colocar em ordem alfab\xE9tica."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_3d
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Fica um pouco dif\xEDcil fazer a chamada assim. Vamos mudar essa ordem."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_3e
    id: 4
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Sim! Agora os nomes est\xE3o em ordem alfab\xE9tica! Vamos fazer a chamada."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_3f
    id: 5
    episode: 3
    emotion: regular
    slug: victory
    minigame: 3
  - text: "\xC9 o motor no foguete! Podemos garantir que ele n\xE3o possa trazer mais
      rob\xF4s para c\xE1!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_4a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Acho que podemos fazer com que o foguete volte para o Senhor Sombrio, mas
      n\xE3o decole de novo. Voc\xEA me ajuda?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_4b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ali est\xE3o as instru\xE7\xF5es. Vamos tentar?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_4c
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ser\xE1 que faltou alguma coisa? Deixe-me ver... Primeiro voc\xEA precisar\xE1
      tirar o fio azul e o vermelho. Com cuidado! A\xED tire o garfo, a l\xE2mpada
      e a tesoura."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_4d
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 4
  - text: Ora, essa coisa treme como um Colecionador no ferro-velho! Posso dar uma
      olhada?
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_4e
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 4
  - text: "\xC9 isso! Esse foguete voar\xE1 de volta at\xE9 o Senhor Sombrio, e ent\xE3o
      ir\xE1 parar! Ele n\xE3o poder\xE1 mandar mais seus rob\xF4s atr\xE1s de n\xF3s!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_4f
    id: 5
    episode: 3
    emotion: regular
    slug: victory
    minigame: 4
  - text: Podemos usar esse papel para deixar um bilhete para o Senhor Sombrio!
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_5a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "\xD3tima ideia, Guardi\xE3o! Ele vai ficar uma fera! Com voc\xEA, espero..."
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_5b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Aqui: monte a mensagem que quer deixar para o Senhor Sombrio. Ele vai aprender
      a n\xE3o mexer mais com um Guardi\xE3o!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_5c
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Posso ler? N\xE3o entendi essa mensagem... Precisamos impressionar o Senhor
      Sombrio!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_5d
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Tem alguma coisa fora de ordem aqui, n\xE3o tem?"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_5e
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Isso \xE9 que \xE9 recado! O Senhor Sombrio vai tremer de medo!"
    world: 1
    season: 2
    sound: ptbr_ep11_bbt_5f
    id: 5
    episode: 3
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Chegamos! Mas onde est\xE3o todos? Isso n\xE3o deveria ser uma festa?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0a
    id: 0
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Olha, o Gato Boldo! Vamos falar com ele! Ele deve saber de alguma coisa.
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0b
    id: 1
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei! O que \xE9 isso aqui? Minha cole\xE7\xE3o de bot\xF5es! Ela estava
      aqui todo esse tempo!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0c
    id: 2
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Como assim eu pedi para voc\xEA guard\xE1-la para mim!? N\xE3o pedi nada!...
      Pedi?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0d
    id: 3
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Bem... De qualquer forma... Vou checar se est\xE1 tudo aqui mesmo!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0e
    id: 4
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Agora que eu sei que meus bot\xF5es est\xE3o a salvo, podemos..."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0f_1
    id: 5
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Que p\xE1ssaro \xE9 aquele? Ele parece que quer dizer algo!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0g_1
    id: 6
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Aten\xE7\xE3o, Colecionadores! Preparem-se! Os rob\xF4s do Senhor Sombrio
      est\xE3o vindo! Mas por que ser\xE1?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0f_2
    id: 7
    episode: 4
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Ei, voc\xEA deixou cair estes pap\xE9is! Pode peg\xE1-los?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0g
    id: 8
    episode: 4
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Precisamos fazer alguma coisa para proteger esse lugar! Mas o qu\xEA?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0h
    id: 9
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "\xC9 isso! Podemos fazer uma armadura para o Gato Boldo! Ele nos proteger\xE1!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0i
    id: 10
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ora, pare de reclamar, seu gato pregui\xE7oso! Vamos, Guardi\xE3o! Temos
      uma armadura para construir!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0j_1
    id: 11
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Boldo! Ora, mas voc\xEA estava dormindo! Voc\xEA devia estar protegendo
      a Grande Bola de L\xE3!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "N\xE3o adianta fazer essa cara, Boldo! Guardi\xE3o, me ajude aqui? Esse
      gato precisa ficar acordado!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "E se fizermos um calend\xE1rio para organizar tudo o que ele pode fazer?
      Guardi\xE3o, voc\xEA me ajuda?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Basta colocar cada atividade no lugar certo: todos os dias, uma vez na
      semana, uma vez ao m\xEAs e uma vez ao ano."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1d
    id: 3
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Concordo com o Boldo. Esse calend\xE1rio est\xE1 estranho. Vamos tentar
      de outra forma."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1e
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 1
  - text: Esquisito... Precisamos trocar algumas dessas atividades de lugar!
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1f
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Quase l\xE1... Mas, talvez, se mudarmos aqui? O que voc\xEA acha?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1g
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 1
  - text: Gostou, Boldo? Ele gostou! Muito bem!
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1h
    id: 7
    episode: 4
    emotion: regular
    slug: victory
    minigame: 1
  - text: Agora, levante-se! Temos que nos preparar para proteger o nosso Sonho!
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_1i
    id: 8
    episode: 4
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Mas... est\xE1 tudo misturado com bot\xF5es comuns! O que voc\xEA fez,
      Boldo?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Como assim \"nada\"? Minha cole\xE7\xE3o s\xF3 tem bot\xF5es valios\xEDssimos!
      Que ultraje!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Guardi\xE3o, por favor! Me ajuda a arrumar a bagun\xE7a que esse gato fez?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vejamos... Eu tinha 12 bot\xF5es da Copa, mais 6 bot\xF5es dos Supercolecionadores,
      11 bot\xF5es dos Unic\xF3rnios do Arco-\xCDris... Me perdi... Quantos bot\xF5es
      eu tinha no total, Guardi\xE3o?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2d
    id: 3
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vamos contar de novo! 12 bot\xF5es mais 6 mais 11... Vai dar...?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2e1
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Vamos usar os bot\xF5es para ajudar!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2g0
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: "12 mais 6 mais 11 bot\xF5es... Quanto d\xE1 tudo isso?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2f1
    id: 6
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: Tem certeza?
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2f0
    id: 7
    episode: 4
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Vamos usar os bot\xF5es para ajudar! 12 bot\xF5es da Copa..."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2g
    id: 8
    episode: 4
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Mais 6 bot\xF5es dos Supercolecionadores... J\xE1 somam 18!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2h
    id: 9
    episode: 4
    emotion: regular
    slug: victory
    minigame: 2
  - text: "E meus 11 bot\xF5es dos Unic\xF3rnios do Arco-\xCDris! Isso d\xE1 29! Pode
      fechar a tampa do pote depois?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2i
    id: 10
    episode: 4
    emotion: regular
    slug: victory
    minigame: 2
  - text: "A\xED est\xE1 minha cole\xE7\xE3o! S\xE3o 29 bot\xF5es rar\xEDssimos! Obrigado
      pela ajuda!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_2j
    id: 11
    episode: 4
    emotion: regular
    slug: victory
    minigame: 2
  - text: "\xC9 um corvo mensageiro! Ele deve ter uma mensagem importante para voc\xEA!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_3a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Mas como vamos saber qual delas \xE9 para voc\xEA? Ser\xE1 que o canto
      indica a palavra?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_3b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que n\xE3o... Ele cantou 2 tons, n\xE3o foi? Isso pode ser uma pista!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_3c
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: "2 tons para 2 s\xEDlabas!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_3e
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 3
  - text: "N\xE3o. N\xE3o acho que \xE9 isso..."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_3d
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 3
  - text: "\"Rob\xF4s\"? Rob\xF4s!!!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_3f
    id: 5
    episode: 4
    emotion: regular
    slug: victory
    minigame: 3
  - text: "N\xE3o! Era s\xF3 o que faltava!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_3g
    id: 6
    episode: 4
    emotion: regular
    slug: victory
    minigame: 3
  - text: "O que \xE9 isso? Um desenho rasgado? Ser\xE1 que conta uma hist\xF3ria?
      Eu gosto de hist\xF3rias!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Uma mensagem, voc\xEA diz? \xC9 por isso que voc\xEA \xE9 um Guardi\xE3o!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Eu n\xE3o consigo entender a mensagem sem as imagens! Pode colocar as imagens
      na ordem para mim? Eu estou confuso!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Acho que n\xE3o \xE9 essa a ordem... Vejamos o que diz aqui..."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4d
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "\"Sem perceber, o Senhor Sombrio deixou cair seu di\xE1rio. Um Colecionador
      que passava por l\xE1 o encontrou e resolveu peg\xE1-lo. Ele o levou para casa,
      para guardar em sua cole\xE7\xE3o particular.\""
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4d2
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Ser\xE1? Acho que as imagens ainda n\xE3o est\xE3o encaixando bem com o
      texto..."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4e
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ainda n\xE3o... E se colocarmos nessa ordem aqui..."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4f
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Agora entendi! N\xE3o! O Colecionador Farrapo encontrou o di\xE1rio do
      Senhor Sombrio! \xC9 isso que seus rob\xF4s est\xE3o procurando por todo o Sonho!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_4g
    id: 7
    episode: 4
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Esta \xE9 a M\xE1quina Faz-Tudo modelo especial, muito maior e melhor do
      que a que eu tenho em casa!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_5a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Basta colocarmos as instru\xE7\xF5es aqui desse lado e a m\xE1quina construir\xE1
      uma armadura brilhante para o Gato Boldo!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_5b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Agora, como eram as instru\xE7\xF5es mesmo? Pode me ajudar preenchendo
      as palavras que faltam?"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_5c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "A m\xE1quina travou! Deve ter algo errado nas instru\xE7\xF5es. Vamos tentar
      diferente."
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_5d
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: Nada ainda. Precisamos mudar alguma coisa aqui.
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_5e
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: Quase! Vamos tentar mudar isso aqui...
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_5f
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 5
  - text: Funciona! Olhe que maravilha!
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_5g
    id: 6
    episode: 4
    emotion: regular
    slug: victory
    minigame: 5
  - text: "A armadura ficou \xF3tima!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0j_2
    id: 7
    episode: 4
    emotion: regular
    slug: victory
    minigame: 5
  - text: "E agora? Tenho uma ideia! Vamos, Guardi\xE3o! Temos muito trabalho pela
      frente!"
    world: 1
    season: 2
    sound: ptbr_ep12_bbt_0k1
    id: 8
    episode: 4
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Guardi\xE3o, eu folheei o di\xE1rio do Senhor Sombrio. Est\xE1 cheio de
      m\xE1quinas terr\xEDveis que ele pode usar contra n\xF3s!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0a
    id: 0
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas eu tive uma ideia! Podemos fazer um falso di\xE1rio do Senhor Sombrio
      e esconder a vers\xE3o original!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0b
    id: 1
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "E nenhum lugar melhor para isso do que a F\xE1brica de Livros! Agora...
      Como fazer um di\xE1rio? Em algum lugar por aqui deve haver um manual..."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0c
    id: 2
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Deixe-me ver aqui... Nossa! Precisaremos de muitos materiais!
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0d
    id: 3
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Vamos olhar naquelas caixas ali.
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0e
    id: 4
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Farrapo! V\xE1 levar esse material para a m\xE1quina!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0f
    id: 5
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Enquanto isso, o Guardi\xE3o e eu vamos separar as folhas do di\xE1rio!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0g
    id: 6
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Farrapo! Farrapo! A m\xE1quina est\xE1 pronta?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0h
    id: 7
    episode: 5
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Como voc\xEA n\xE3o sabe como us\xE1-la? Acho que isso \xE9 um trabalho
      para o Guardi\xE3o!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0i
    id: 8
    episode: 5
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "O di\xE1rio falso est\xE1 pronto! Se o Senhor Sombrio tentar montar as
      m\xE1quinas usando esse di\xE1rio vai ter uma surpresa e tanto!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0j
    id: 9
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Guardi\xE3o! Acho que falta uma coisa s\xF3! Pode pegar o di\xE1rio para
      mim?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0k
    id: 10
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "\xD3timo trabalho, Guardi\xE3o! Agora \xE9 s\xF3 deixarmos o di\xE1rio
      em um lugar onde..."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0l
    id: 11
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "Ei! Onde est\xE1 o di\xE1rio? E o Farrapo? Para onde foi aquele Colecionador
      encrenqueiro?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0m
    id: 12
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "L\xE1 vamos n\xF3s de novo..."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_0n
    id: 13
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "Excelente, Guardi\xE3o! N\xE3o tinha visto esses manuais aqui!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_1a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Agora, qual deles nos ensina como fazer um di\xE1rio para enganar o Senhor
      Sombrio?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_1b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Esse livro parece muito bom! Mas n\xE3o \xE9 o que precisamos agora."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_1c
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Infelizmente esse n\xE3o serve para fabricar um di\xE1rio."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_1d
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: "N\xE3o \xE9 este. Voc\xEA sabe qual \xE9, Farrapo? Este?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_1e
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 1
  - text: "\"Aprenda a fabricar di\xE1rios\"! Tudo o que precisamos est\xE1 aqui!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_1f
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 1
  - text: Quantas caixas! Vamos precisar organizar tudo aqui embaixo.
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_2a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Guardi\xE3o, pode fazer isso para mim? Por favor, coloque as caixas em
      ordem crescente para procurarmos os materiais."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_2b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Alguma coisa est\xE1 fora de ordem. Use os n\xFAmeros das caixas para coloc\xE1-las
      do n\xFAmero menor para o maior."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_2c
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Estou meio confuso... Acho que estas aqui s\xE3o as primeiras. E o resto?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_2d
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Farrapo! N\xE3o fique parado a\xED! Ajude o Guardi\xE3o com essas caixas,
      ande!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_2e
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 2
  - text: "A\xED est\xE1! Agora podemos trabalhar no di\xE1rio!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_2f
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Precisamos cortar o papel bem no meio para fazer as folhas do di\xE1rio."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_3a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Use essa r\xE9gua para descobrir quantas r\xE9guas cabem em cada metade
      da folha."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_3b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que esse n\xE3o \xE9 o meio da p\xE1gina! Vamos ver quantas vezes
      precisamos usar a r\xE9gua para chegar ao meio da p\xE1gina."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_3c
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ai, nunca fui muito bom com a tesoura! Voc\xEA corta e eu me\xE7o. O que
      voc\xEA acha?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_3d
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Precisamos de 2 r\xE9guas para chegar ao meio da folha! Agora eu corto
      as outras folhas no tamanho certo!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_3e
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "A\xED est\xE1!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_2f0
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Essa m\xE1quina faz o trabalho todo sozinha! Bom... Quase todo o trabalho..."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_4a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Voc\xEA precisa colocar os materiais em ordem na lista e, ent\xE3o, \xE9
      s\xF3 esperar. Pronto?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_4b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "A m\xE1quina engasgou! Ela s\xF3 funciona se os materiais estiverem em
      ordem alfab\xE9tica!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_4c
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Veja se a primeira letra de cada material est\xE1 em ordem alfab\xE9tica."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_4d
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Caramba! Deixe-me ver se consigo ajudar aqui. Aperte o bot\xE3o depois
      para ver se funciona."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_4e
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Funcionou! Temos o di\xE1rio!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_4f
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 4
  - text: "O que voc\xEA acha de assinarmos o di\xE1rio na \xFAltima p\xE1gina? Quando
      o Senhor Sombrio chegar ao final dele... Vai ter uma grande surpresa!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_5a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "J\xE1 escrevi o meu. Sua vez!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_5b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Faltou uma coisa. Reparou que a primeira letra do meu nome \xE9 grande?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_5c
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Nossos nomes s\xE3o sempre especiais. Merecem ser escritos com a primeira
      letra mai\xFAscula, n\xE3o acha?"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_5d
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Agora sim! Adoraria ver a cara do Senhor Sombrio quando ver nossos nomes
      no fim do di\xE1rio!"
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_5f
    id: 4
    episode: 5
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Mas... Pode ser de longe, ou numa foto! Acho que \xE9 mais seguro assim."
    world: 1
    season: 2
    sound: ptbr_ep13_bbt_5g
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Essa \xE9 a casa do Farrapo. Ser\xE1 que ele pegou o di\xE1rio falso para
      fazer uma nova cole\xE7\xE3o de livros falsos?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0a
    id: 0
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Farrapo! Ol\xE1? Voc\xEA est\xE1 a\xED? Somos n\xF3s, o Bom Trapo e o Guardi\xE3o!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0b
    id: 1
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Nada dele... Ser\xE1 que ele deixou alguma pista de onde pode ter ido?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0c
    id: 2
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O di\xE1rio verdadeiro deve dizer o local do novo esconderijo do Senhor
      Sombrio."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0d
    id: 3
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Vamos procur\xE1-lo. J\xE1 olhou atr\xE1s daquela cortina?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0e
    id: 4
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Caramba! O que eu fiz! Derrubei a caixa com a cole\xE7\xE3o de insetos
      do Farrapo!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0f
    id: 5
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Me ajude, Guardi\xE3o! Eu morro de medo de insetos!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0g
    id: 6
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ainda bem que eu resolvi esse problema! Ou talvez tenha sido voc\xEA...
      Claro!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0h
    id: 7
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "O que \xE9 isso que caiu do di\xE1rio? Um ingresso para o Parque do Terror!
      Mas que dia ele ir\xE1 abrir? H\xE1 algum calend\xE1rio por aqui?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0i
    id: 8
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Eu odeio ter de dizer isso, mas precisamos ir at\xE9 o Parque do Terror
      salvar o Farrapo! De novo!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0j
    id: 9
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Mas antes precisamos alertar o Mestre dos Sonhos e todos os Colecionadores!
      Ali na mesa h\xE1 papel e l\xE1pis!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0k
    id: 10
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ent\xE3o... agora voc\xEA vai sozinho l\xE1 no Parque do Terror, certo?
      Enquanto eu... ajudo aqui a... fazer... alguma coisa..."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0l
    id: 11
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Por favor! Olha o nome desse lugar! \"Parque do Terror\"! Coisa boa n\xE3o
      pode ser!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0m
    id: 12
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Ora... se voc\xEA insiste tanto eu... eu vou..."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0n
    id: 13
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: Onde eu fui me meter!
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_0o
    id: 14
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Voc\xEA encontrou um bilhete do Farrapo! Que bom!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_1a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Mas... Faltam algumas letras aqui! Voc\xEA coloca as letras certas para
      que possamos ler a mensagem?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_1b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "N\xE3o estou entendendo a mensagem toda... Algumas letras ainda devem estar
      trocadas."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_1c
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: '"Fui encontrar o..." Vamos tentar desse jeito.'
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_1e
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Entendi uma parte, mas n\xE3o tudo. Lembre que M vem antes de P e B."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_1d
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 1
  - text: "\"Fui encontrar o Senhor Sombrio. Fiquei sabendo que ele comprou uma por\xE7\xE3o
      de bombas de fedor e precisa ser impedido enquanto ainda h\xE1 tempo. Voltarei
      quando cumprir esta miss\xE3o.\""
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_1f
    id: 5
    episode: 6
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Esse Farrapo \xE9 o Colecionador mais louco que eu j\xE1 conheci! Ir at\xE9
      l\xE1 sozinho, v\xEA se pode!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_1g
    id: 6
    episode: 6
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Que bonito! Ser\xE1 que \xE9 uma pista?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_2a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Pena que uma palavra est\xE1 faltando. Qual destas ser\xE1 a palavra certa?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_2b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Acho que n\xE3o. Ser\xE1 que o desenho d\xE1 uma dica?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_2c
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Ser\xE1 que \xE9 isso mesmo?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_2d0
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "No desenho ele est\xE1 colocando o di\xE1rio..."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_2e
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Embaixo da cama! \xC9 isso! Eu pego!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_2f
    id: 5
    episode: 6
    emotion: regular
    slug: victory
    minigame: 2
  - text: "A cole\xE7\xE3o de insetos se misturou com insetos comuns da casa! E agora?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_3a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Quantos insetos havia na cole\xE7\xE3o? Veja se na caixa h\xE1 uma pista!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_3b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Tem certeza? Voc\xEA pode colocar os insetos nas caixas para ajudar a contar.
      Eu \xE9 que n\xE3o ponho a m\xE3o neles!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_3c
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ali diz 13 mais 5 mais 8. Quanto d\xE1?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_3d
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 3
  - text: "13 mais 5 \xE9 igual a... 18. 18 mais 8..."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_3e
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 3
  - text: "S\xE3o 26 insetos na cole\xE7\xE3o! Pronto! \xC9 s\xF3 coloc\xE1-los dentro
      da caixa e fingir que nada aconteceu!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_3f
    id: 5
    episode: 6
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Aqui diz que o Parque do Terror s\xF3 abrir\xE1 no dia 20!"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_4a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Espere a\xED! Se hoje \xE9 dia 5, quantos dias faltam at\xE9 a abertura
      do Parque do Terror?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_4b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\xC9 isso mesmo? Hoje \xE9 dia 5. A inaugura\xE7\xE3o \xE9 dia 20. Que
      conta podemos fazer para descobrir quantos dias faltam?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_4c
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 4
  - text: "E se pensarmos assim: 20 menos 5... Quanto d\xE1?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_4d
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 4
  - text: Vejamos... O parque abre dia 20, menos o dia de hoje, 5...
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_4e
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Faltam 15 dias! Nossa, isso d\xE1 2 semanas e mais 1 dia para o Parque
      abrir! Tem alguma coisa estranha acontecendo por l\xE1..."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_4f
    id: 5
    episode: 6
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Pronto! Escrevi uma carta para o Mestre dos Sonhos e uma not\xEDcia para
      ir aos jornais."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Coloque cada uma em seu devido lugar enquanto eu procuro no di\xE1rio onde
      fica esse Parque do Terror."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vejamos... A not\xEDcia diz: \"Pesadelo das Coisas Sombrias! Na manh\xE3
      desta quarta-feira, o tem\xEDvel Senhor Sombrio foi avistado andando livre pelo
      Sonho das Coisas Perdidas."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5c
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Os Guardi\xF5es afirmam que est\xE3o fazendo o poss\xEDvel para deter a
      destrui\xE7\xE3o provocada pelos rob\xF4s do Senhor Sombrio."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5da
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "As autoridades pedem \xE0 popula\xE7\xE3o de Colecionadores que se escondam
      em um lugar seguro at\xE9 que a crise seja resolvida.\""
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5db
    id: 4
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "J\xE1 a carta diz: \"Caro Mestre dos Sonhos, o Senhor Sombrio est\xE1 \xE0
      solta no Sonho das Coisas Perdidas, usando seus rob\xF4s para destruir tudo,
      enquanto procura seu di\xE1rio perdido."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5ea
    id: 5
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Estamos fazendo todo o poss\xEDvel para det\xEA-lo. Assinado: Guardi\xE3o.\""
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5eb
    id: 6
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Bom... Ent\xE3o acho que \xE9 ao contr\xE1rio! A carta no envelope e a
      not\xEDcia no jornal, n\xE3o?"
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5f
    id: 7
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: Erro 2
    world: 1
    season: 2
    sound: 
    id: 8
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: Erro 3
    world: 1
    season: 2
    sound: 
    id: 9
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Feito? Pode deixar que eu coloco a carta nos Correios e a not\xEDcia no
      quadro de avisos."
    world: 1
    season: 2
    sound: ptbr_ep14_bbt_5g
    id: 10
    episode: 6
    emotion: regular
    slug: victory
    minigame: 5
  - text: Quem teve essa ideia maluca de abrir um lugar chamado Parque do Terror?
      Aposto que foi alguma penumbra do Sonho das Sombras Sussurrantes!
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0a
    id: 0
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: E o Senhor Sombrio tinha que se esconder logo aqui?
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0b
    id: 1
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Olha! Uma bilheteria. Talvez o Farrapo esteja escondido l\xE1 dentro e
      possamos ir embora sem entrar nesse lugar tenebroso!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0c
    id: 2
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Esse lugar vazio \xE9 ainda mais assustador! Para onde vamos?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0d
    id: 3
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Uma placa! Ela deve indicar para onde devemos ir!
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0e
    id: 4
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "E agora, Guardi\xE3o?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0m
    id: 5
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Est\xE1 vendo aquelas duas entradas? Acho que \xE9 naquela dire\xE7\xE3o."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0i
    id: 6
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Esse parque \xE9 t\xE3o grande! Farrapo pode estar em qualquer lugar!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0f
    id: 7
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos olhar aquele apresentador rob\xF4 e ver que tipo de show ele est\xE1
      apresentando."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0g
    id: 8
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ai, Farrapo! Onde voc\xEA foi se meter?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0h
    id: 9
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Olhe, Guardi\xE3o! \xC9 o Farrapo! E ele nem parece t\xE3o feroz assim!
      Eu acho..."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0j
    id: 10
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Precisamos libert\xE1-lo antes que o Senhor Sombrio volte!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0k_1
    id: 11
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Podemos ir embora agora? Por favor! Odeio parques de divers\xE3o sombrios!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0k_2
    id: 12
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "N\xE3o! O Senhor Sombrio voltou! Fuja, Farrapo!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_0l
    id: 13
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Ora, mas... E ainda precisamos pagar para entrar nesse lugar terr\xEDvel?
      O parque n\xE3o est\xE1 desativado?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_1a
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Eu tenho apenas uma nota de 1 dinheiro! Guardi\xE3o, voc\xEA pode troc\xE1-la
      por moedas para mim?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_1b
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "N\xE3o, espere. H\xE1 mais moedas aqui do que preciso. Lembre-se que 1
      dinheiro \xE9 igual a 100 centavos!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_1c
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Est\xE1 faltando pelo menos uma moeda aqui! Preciso de 100 centavos para
      trocar por uma nota de 1 dinheiro!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_1d
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: Deixe-me ver... aqui. Acho que agora vai estar certo.
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_1e
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Muito bem! 100 centavos de dinheiro! Agora vamos pagar para entrar nesse
      lugar terr\xEDvel!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_1f
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Ora, mais essa agora! Algu\xE9m pegou todas as letras R da placa! Esses
      Colecionadores!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_2a
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: Precisamos colocar todos no lugar para conseguirmos ler essa placa!
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_2b
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o acendeu! Deve ter alguma palavra errada!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_2c
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Ainda n\xE3o foi... Devemos ter colocado algumas letras R a mais... Ou
      talvez a menos!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_2d
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 2
  - text: "N\xE3o... Vamos tentar desse jeito aqui."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_2e
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 2
  - text: "O painel acendeu! Nossa, mas que nomes terr\xEDveis! Pelo menos agora sabemos
      onde fica cada coisa... E podemos ficar bem longe delas!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_2f
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 2
  - text: Para qual lado ir? Vamos olhar no ingresso que encontramos na casa do Farrapo!
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_3a
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 que h\xE1 uma pista aqui sobre em qual porta entrar?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_3b
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vejamos... \"Ele tomou a po\xE7\xE3o e se transformou em um lobisomem feroz!\"
      Pelos meus bot\xF5es! Precisamos mesmo ir nessa dire\xE7\xE3o?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_3c
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: Erro 2
    world: 1
    season: 2
    sound: 
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 3
  - text: Erro 3
    world: 1
    season: 2
    sound: 
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 3
  - text: "\xC9 essa a entrada, n\xE9? Voc\xEA tem certeza? Parece t\xE3o... assustador!
      J\xE1 que n\xE3o tem jeito, aperte o bot\xE3o para abrir a porta."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_3d
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Est\xE1 certo... Vamos por aqui. Pode seguir em frente... Eu vou logo atr\xE1s!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_3e
    id: 6
    episode: 7
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Ei, parece o Farrapo neste cartaz... Mas onde ele est\xE1?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_4a
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o! O cartaz caiu no ch\xE3o! Em cima de qual das duas passagens ele
      estava antes?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_4b
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\"Elas est\xE3o presas\"? Esta frase n\xE3o parece estar de acordo com
      a imagem do cartaz. Nele h\xE1 apenas o colecionador feroz... quer dizer, o
      Farrapo."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_4c
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 4
  - text: erro 2
    world: 1
    season: 2
    sound: 
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 4
  - text: erro 3
    world: 1
    season: 2
    sound: 
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "\"Ele est\xE1 preso.\" Sim, o Farrapo est\xE1 preso. \xC9 essa a porta!
      Espera... Ser\xE1 que o Farrapo virou... uma... uma... fera?"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_4d
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 4
  - text: "J\xE1 vi um desses mecanismos antes! Precisamos girar as duas chaves certas
      ao mesmo tempo!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_5a
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Eu giro a da esquerda e voc\xEA a da direita. Mas, primeiro, voc\xEA precisa
      escolher uma chave igual a minha para encaixar na fechadura."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_5b
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acho que essa chave n\xE3o funciona. As duas chaves devem ter o mesmo formato
      quando s\xE3o vistas de frente."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_5c
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Essa tamb\xE9m n\xE3o serve. Acho que n\xE3o tentamos esta aqui ainda..."
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_5d
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: erro 3
    world: 1
    season: 2
    sound: 
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Funcionou! Farrapo est\xE1 livre!"
    world: 1
    season: 2
    sound: ptbr_ep15_bbt_5e
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Guardi\xE3o! Fomos capturados pelo Senhor Sombrio!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0a
    id: 0
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Deve haver alguma coisa aqui para nos ajudar a escapar... Mas o qu\xEA?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0b
    id: 1
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas como ronca esse rob\xF4! Parece uma britadeira!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0c
    id: 2
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Veja se voc\xEA consegue enxergar a chave do outro lado da porta."
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0d
    id: 3
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Livres! Melhor falar baixo, n\xE3o?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0e
    id: 4
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "\xC9 o Senhor Sombrio! R\xE1pido, vamos nos esconder atr\xE1s daquela m\xE1quina!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0f
    id: 5
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Uma resposta do Mestre dos Sonhos!
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0g
    id: 6
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Pelos meus bot\xF5es! Aquilo \xE9 uma m\xE1quina de teletransporte! O Senhor
      Sombrio deve estar planejando roubar todo o Sonho das Coisas Perdidas de uma
      vez!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0h
    id: 7
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: Precisamos fazer alguma coisa para impedir o Senhor Sombrio!
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0i
    id: 8
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "O Senhor Sombrio foi at\xE9 a m\xE1quina de teletransporte para ver o que
      h\xE1 de errado!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0j
    id: 9
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vamos at\xE9 o painel de controle enquanto ele est\xE1 olhando para o outro
      lado!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0k_1
    id: 10
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: Conseguimos!
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0k_4
    id: 11
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "Estamos livres do Senhor Sombrio... ao menos por um bom tempo!Muito obrigado
      Guardi\xE3o!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0n
    id: 12
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "Muito obrigado Guardi\xE3o!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0o
    id: 13
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "O que voc\xEA encontrou a\xED? Um desenho do rob\xF4 que est\xE1 guardando
      a chave da nossa cela?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_1a
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Parece que conta uma hist\xF3ria... Mas est\xE1 incompleta... N\xE3o entendi!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_1b
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Isso n\xE3o faz sentido... faz? Por que n\xE3o tenta outra coisa?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_1c
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "N\xE3o sei n\xE3o... E se tentarmos esta?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_1d
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "\"O rob\xF4 pendurou a chave antes de dormir.\" \xC9 isso! Ent\xE3o temos
      como fugir daqui!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_1e
    id: 4
    episode: 8
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Voc\xEA consegue ver a chave? Ser\xE1 que consegue peg\xE1-la usando um
      desses gravetos?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_2a
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Mas n\xE3o sei qual tem o tamanho certo para alcan\xE7ar a chave... Qual
      desses instrumentos podemos usar para medir o comprimento do graveto?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_2b
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Uma balan\xE7a? Acho que n\xE3o. Ela serve para pesar os gravetos!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_2c
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Bonito rel\xF3gio, mas n\xE3o serve! O rel\xF3gio mostra que horas s\xE3o!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_2d
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Vejamos, para medir o comprimento dos gravetos podemos usar a fita m\xE9trica."
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_2e
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Perfeito! Vejamos... Este \xE9 o melhor graveto. Deixe-me tentar pegar
      a chave..."
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_2f
    id: 5
    episode: 8
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Consegui! Agora \xE9 s\xF3 abrir a porta!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_2g
    id: 6
    episode: 8
    emotion: regular
    slug: victory
    minigame: 2
  - text: "O que o Senhor Sombrio est\xE1 fazendo? Se o Mestre dos Sonhos estivesse
      aqui... Ei, isso aqui \xE9 um transmissor com c\xE2mera!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_3a
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Podemos tirar um foto com a descri\xE7\xE3o de onde est\xE1 o Senhor Sombrio
      e mandar para o Mestre dos Sonhos! Ele saber\xE1 o que fazer!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_3b
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Se n\xE3o explicarmos bem a cena, o Mestre dos Sonhos n\xE3o saber\xE1
      nos ajudar!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_3c
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "N\xE3o acho que seja desse jeito. Olhando a cena isso n\xE3o faz muito
      sentido."
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_3d
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: Talvez se mudarmos isto aqui...
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_3e
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Pronto! Agora \xE9 s\xF3 esperar!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_3f
    id: 5
    episode: 8
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Veja, Guardi\xE3o! O Senhor Sombrio deixou a lista de pe\xE7as da m\xE1quina
      aqui!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_4a
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Veja quantos brinquedos h\xE1 na lista. Tenho uma ideia que pode nos ajudar!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_4b
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Tudo isso? Voc\xEA somou s\xF3 a quantidade de brinquedos da lista?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_4c
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: "S\xF3 isso? Acho que se somar os brinquedos dessa lista d\xE1 um n\xFAmero
      maior, hein?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_4d
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 4
  - text: Posso ver? Acho que tem algo de estranho aqui.
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_4e
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 4
  - text: "S\xE3o 2 carrinhos de controle remoto mais 21 bonecas... 23 brinquedos!
      Ent\xE3o acho que sei o que posso fazer!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_4f_1
    id: 5
    episode: 8
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Vou puxar esse fio aqui, tirar essa cabe\xE7a de boneca, essa antena enroscada...
      Pronto! Agora vamos sair daqui correndo!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_4f_2
    id: 6
    episode: 8
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Se ligarmos a m\xE1quina agora, conseguiremos mandar o Senhor Sombrio para
      bem longe daqui!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_5a
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Que m\xE1quina simp\xE1tica! Mas as frases est\xE3o sem pontua\xE7\xE3o!
      Acho melhor corrigi-las antes de lig\xE1-la."
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_5b
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "N\xE3o funcionou... O que est\xE1 errado?"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_5c
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: Devemos ter colocado algum ponto errado aqui.
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_5d
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Vamos tentar desse jeito aqui. Aperte o bot\xE3o logo depois para ver se
      funciona."
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_5e
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 5
  - text: Funciona! Tchau, tchau, Senhor Sombrio!
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_5f
    id: 5
    episode: 8
    emotion: regular
    slug: victory
    minigame: 5
  - text: O Senhor Sombrio vai passar um bom tempo congelando no Polo Norte!
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0k_3
    id: 6
    episode: 8
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Opa, acho que mexi demais nessa m\xE1quina! Ela est\xE1 quase explodindo!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0l
    id: 7
    episode: 8
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Vamos fugir! Ligue a m\xE1quina!"
    world: 1
    season: 2
    sound: ptbr_ep16_bbt_0m
    id: 8
    episode: 8
    emotion: regular
    slug: victory
    minigame: 5
