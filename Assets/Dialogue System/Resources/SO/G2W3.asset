%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G2W3
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "Guardi\xE3o! Ainda bem que voc\xEA chegou! Estamos com s\xE9rios problemas!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_01
    id: 0
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Um enorme bando de piratas a\xE9reos est\xE1 atacando a cidade de Stratus
      e roubando todo o nosso tesouro!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_02
    id: 1
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eu disse \"fujam agora, pois Nimbus, a destemida, est\xE1 aqui!\", mas
      acho que n\xE3o me ouviram, porque n\xE3o funcionou!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_03
    id: 2
    episode: 1
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Acho melhor, ent\xE3o, subir a torre de alarme e pedir ajuda."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_04
    id: 3
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Os Filhos do Trov\xE3o nos ajudar\xE3o a enfrentar os piratas, mas precisamos
      de mais defesas."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_11
    id: 4
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Meu av\xF4 Z\xE9firo \xE9 o respons\xE1vel pela catapulta de nuvens. Vamos
      at\xE9 l\xE1 descobrir o que aconteceu com ele."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_12
    id: 5
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Pronto, vov\xF4. Agora v\xE1 at\xE9 a catapulta de nuvens e expulse esses
      piratas daqui!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_19
    id: 6
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Guardi\xE3o, leve meu av\xF4 at\xE9 a catapulta de nuvens."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_20
    id: 7
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Enquanto meu av\xF4 ataca os navios piratas, vamos tentar ligar o Moinho
      Anti-N\xE9voa. Ele deve ajudar a afastar os piratas que restam."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_28
    id: 8
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Vamos falar com o meu pai. Ele deve saber mais sobre o que est\xE1 acontecendo."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_35
    id: 9
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ei, olhe! Algu\xE9m deixou um bilhete na porta da minha casa!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_36
    id: 10
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Estranha esta mensagem... \xC9 como se essa Capit\xE3 Isabela estivesse
      nos desafiando a ir atr\xE1s dela!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_42
    id: 11
    episode: 1
    emotion: regular
    slug: final
    minigame: 
  - text: "Bom, se \xE9 isso que ela quer, \xE9 isso que ela ter\xE1! Vamos, Guardi\xE3o!
      Temos uma pirata para capturar!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_43
    id: 12
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "Usamos esta torre para pedir ajuda de outras cidades e, em especial, dos
      Filhos do Trov\xE3o, as verdadeiras nuvens guerreiras deste sonho."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_05
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Acho que o Cirrus, do lado de l\xE1, n\xE3o est\xE1 entendendo a mensagem...
      Ser\xE1 que voc\xEA pode deixar esta mensagem mais simples?"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Se n\xE3o entenderem o que precisamos, n\xE3o ter\xE3o como nos ajudar,
      como nos dar assist\xEAncia."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_07
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: Estou preocupada porque precisamos de ajuda imediatamente! Essa mensagem
      tem que ir agora!
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_08
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: "\xC9 isso! Basta escrever \"Pe\xE7o ajuda dos Filhos do Trov\xE3o agora\"
      e Cirrus vai entender!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_09
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Olhe, eles nos entenderam! As nuvens guerreiras j\xE1 est\xE3o a caminho!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_10
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Vov\xF4! Voc\xEA esqueceu o que precisa fazer pela manh\xE3 de novo!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_13
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Guardi\xE3o, me ajude a lembrar a ordem em que o vov\xF4 Z\xE9firo precisa
      fazer as coisas. Assim ele se lembra de como usar a catapulta de nuvens."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_14
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Espere a\xED, tem alguma coisa estranha na rotina do vov\xF4! Tudo bem
      ele tomar caf\xE9 da manh\xE3 antes ou depois do banho, mas o banho ele tem
      que tomar direito, certo?"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_15
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: Esse banho tem que incluir tirar o pijama, ir ao chuveiro, ensaboar-se,
      enxaguar-se, secar-se todo, colocar roupa nova...
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_16
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Aqui, vov\xF4, vamos rever a lista juntos."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_17
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Agora sim! Muito obrigada, Guardi\xE3o."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_18
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Como assim voc\xEA n\xE3o lembra como ligar a catapulta? Vov\xF4..."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_21
    id: 0
    episode: 1
    emotion: sad
    slug: intro
    minigame: 3
  - text: "E pensar que um dia o vov\xF4 Z\xE9firo foi um dos grandes her\xF3is de
      Stratus. Sempre tinha grandes hist\xF3rias para contar!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_22
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, o vov\xF4 escreveu as duas frases que ligam a catapulta neste
      papel, mas tem algo errado. Voc\xEA pode tirar os espa\xE7os a mais que ele
      colocou nas frases?"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_23
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ainda h\xE1 espa\xE7os extras sobrando. Leia as frases em voz alta para
      ver onde est\xE3o os espa\xE7os a mais."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_24
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Alguma palavra ainda est\xE1 dividida, com espa\xE7os sobrando. Vamos ler
      palavra por palavra: Nuv...em? Nuvem! Aqui tinha um espa\xE7o a mais, n\xE3o
      \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_25
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Se tirarmos estes espa\xE7os aqui est\xE1 tudo certo: nuvem, pulando, como,
      carneirinho, disparar."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_26
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 3
  - text: "As frases deram certo! A catapulta de nuvens j\xE1 est\xE1 funcionando!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_27
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 3
  - text: Normalmente usamos este moinho para afastar nuvens muito altas que nos impedem
      de enxergar, mas deve servir para afastar os piratas.
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_29
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Agora... como fazemos essa coisa funcionar? Acho que precisamos montar
      esta sequ\xEAncia num\xE9rica."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_30
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "A sequ\xEAncia faz o moinho funcionar. 0, 10, 20... O que mais?"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_31
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Veja que legal! Essa sequ\xEAncia segue de 10 em 10! Vamos completar?"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_32
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 4
  - text: "S\xE3o muitos n\xFAmeros. Deixe-me ajudar... 20, 30, 40, 50, 60..."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_33
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 4
  - text: "O Moinho Anti-N\xE9voa j\xE1 est\xE1 funcionando! Duvido que os piratas
      consigam continuar voando por aqui com este vento todo!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_34
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Vejamos... o que est\xE1 escrito no bilhete?"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_37
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: Mas o que esses piratas queriam aqui?
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_38
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Estranho... Vamos ler isso aqui: Cidad\xE3os de Stratus, desculpem-nos
      pelo transtorno, mas precisamos do seu ouro e joias. Nada pessoal, eu juro!"
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_39a
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Pe\xE7o que fiquem longe de Bermudas! A n\xE3o ser que queiram enfrentar
      a verdade. Assinado, Isabela Tempestade, Capit\xE3 do Escoc\xEAs Voador."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_39b
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Essa n\xE3o! Entendi o que a mensagem quer dizer, e ela n\xE3o \xE9 boa."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_40
    id: 4
    episode: 1
    emotion: scared
    slug: error2
    minigame: 5
  - text: "\xC9 o tesouro de Stratus, aquele que estamos juntando h\xE1 anos explorando
      os Sete Ventos."
    world: 3
    season: 2
    sound: ptbr_ep57_nbs_41
    id: 5
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "O bilhete fala sobre um lugar chamado Ilha das Bermudas. \xC9 uma cidade
      sem lei, longe daqui, onde piratas e bandidos vivem!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_01
    id: 0
    episode: 2
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Vamos precisar nos preparar para irmos at\xE9 Bermudas sem que os piratas
      percebam nossas inten\xE7\xF5es."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_02
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Por sorte conhe\xE7o um velho pirata aposentado que mora aqui em Stratus.
      Ele certamente nos ajudar\xE1 a nos fingirmos de piratas!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_03
    id: 2
    episode: 2
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Al\xF4, Capit\xE3o Barbada? Onde voc\xEA est\xE1?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_04
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Agora vamos aprender a duelar com espadas? Ia ser bem legal!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_11
    id: 4
    episode: 2
    emotion: happy
    slug: minigame2
    minigame: 
  - text: "Como assim penas? Vai entender, n\xE3o \xE9? Achei que piratas usassem
      espadas. Talvez eles n\xE3o gostem de coisas pontudas!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_12
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "E agora vamos treinar sobreviv\xEAncia na selva! Vai que nos jogam em alguma
      ilha deserta, n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_24
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Mas o que esta geladeira tem a ver com sobreviv\xEAncia na selva?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_25
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Agora \xE9 a hora de aprender a pilotar um navio como um verdadeiro pirata!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_33
    id: 8
    episode: 2
    emotion: happy
    slug: minigame4
    minigame: 
  - text: "Estamos prontos para fingirmos ser piratas agora? N\xE3o? O que falta?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_48
    id: 9
    episode: 2
    emotion: sad
    slug: minigame5
    minigame: 
  - text: Um teste, claro! Para provarmos que enganamos como piratas!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_49
    id: 10
    episode: 2
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Muito obrigado pelas li\xE7\xF5es, Capit\xE3o Barbada. Aposto que meu pai
      ficaria agradecido pela sua ajuda..."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_57
    id: 11
    episode: 2
    emotion: happy
    slug: final
    minigame: 
  - text: "N\xE3o podemos esperar meu pai voltar da armada de Stratus! Precisamos
      partir imediatamente."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_58
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Pronto para viver a vida de um pirata, Guardi\xE3o? Estou louca para colocar
      minha fantasia!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_59
    id: 13
    episode: 2
    emotion: happy
    slug: final
    minigame: 
  - text: "A primeira li\xE7\xE3o \xE9 entender como eram as coisas antes, na \xE9poca
      em que meu av\xF4 lutava com o Capit\xE3o Barbada, e como s\xE3o agora."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_05
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Estes quadros mostram passado e presente. Qual \xE9 qual?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Acho que os costumes de hoje em dia s\xE3o outros, e as coisas t\xEAm mais
      tecnologia, n\xE3o?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_07
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Antigamente a vida de um pirata era diferente, com menos m\xE1quinas!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_08
    id: 3
    episode: 2
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Entendi o que \xE9 o qu\xEA. Veja se n\xE3o \xE9 isso aqui."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_09
    id: 4
    episode: 2
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Obrigada pela li\xE7\xE3o de hist\xF3ria, Capit\xE3o Barbada!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_10
    id: 5
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Bom, n\xE3o \xE9 que dizem que a pena \xE9 mais poderosa que a espada?
      Deve ser porque faz c\xF3cegas!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_13
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Voc\xEA precisar\xE1 se esquivar do boneco de treinamento. \xC9 s\xF3 seguir
      minhas instru\xE7\xF5es que tudo estar\xE1 bem. Pronto? Vamos l\xE1!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_14
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: Direita!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_15
    id: 2
    episode: 2
    emotion: happy
    slug: command0
    minigame: 2
  - text: Esquerda!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_17
    id: 3
    episode: 2
    emotion: happy
    slug: command1
    minigame: 2
  - text: Dentro!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_19
    id: 4
    episode: 2
    emotion: happy
    slug: command2
    minigame: 2
  - text: Fora!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_21
    id: 5
    episode: 2
    emotion: happy
    slug: command3
    minigame: 2
  - text: Esquerda!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_17
    id: 6
    episode: 2
    emotion: happy
    slug: command4
    minigame: 2
  - text: Direita!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_15
    id: 7
    episode: 2
    emotion: happy
    slug: command5
    minigame: 2
  - text: Creio que estamos prontos para enfrentar um duelo de penas com qualquer
      pirata!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_23
    id: 8
    episode: 2
    emotion: happy
    slug: victory
    minigame: 2
  - text: Cuidado com o golpe! Esquive para a direita!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_16
    id: 9
    episode: 2
    emotion: scared
    slug: error0
    minigame: 2
  - text: "Aten\xE7\xE3o, Guardi\xE3o! O golpe est\xE1 vindo pela esquerda!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_18
    id: 10
    episode: 2
    emotion: scared
    slug: error1
    minigame: 2
  - text: "O boneco de treinamento est\xE1 vindo para a frente! Esquive para dentro."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_20
    id: 11
    episode: 2
    emotion: scared
    slug: error2
    minigame: 2
  - text: "Desvie para fora, Guardi\xE3o."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_22
    id: 12
    episode: 2
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Aten\xE7\xE3o, Guardi\xE3o! O golpe est\xE1 vindo pela esquerda!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_18
    id: 13
    episode: 2
    emotion: regular
    slug: error4
    minigame: 2
  - text: Cuidado com o golpe! Esquive para a direita!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_16
    id: 14
    episode: 2
    emotion: scared
    slug: error5
    minigame: 2
  - text: Entendi! Precisamos primeiro conhecer cada tipo de alimento, claro!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_26
    id: 0
    episode: 2
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Se soubermos quem s\xE3o os produtores, fica mais f\xE1cil encontrar os
      produtos, n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_27
    id: 1
    episode: 2
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Muito bem, Guardi\xE3o. Vamos separar produtores de produtos!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_28
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Alguma coisa est\xE1 estranha por aqui... O leite vem da vaca, correto?"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_29
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ficou algo esquisito a\xED. Vamos rever o que pode estar errado."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_30
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 3
  - text: "J\xE1 descobri!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_31
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 3
  - text: "\xD3timo! Est\xE1 tudo separadinho do jeito certo! Somos praticamente os
      Cirrus das selvas!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_32
    id: 6
    episode: 2
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Todo pirata aprende a pilotar navios voadores nas condi\xE7\xF5es mais
      complicadas. Eles adoram atacar saindo de nuvens de chuva!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_34
    id: 0
    episode: 2
    emotion: happy
    slug: intro
    minigame: 4
  - text: Primeiro siga em frente.
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_35
    id: 1
    episode: 2
    emotion: regular
    slug: request_0
    minigame: 4
  - text: "Agora vire \xE0 esquerda."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_37
    id: 2
    episode: 2
    emotion: regular
    slug: request_1
    minigame: 4
  - text: Esquerda novamente.
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_39
    id: 3
    episode: 2
    emotion: regular
    slug: request_2
    minigame: 4
  - text: "Agora vire \xE0 direita."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_41
    id: 4
    episode: 2
    emotion: regular
    slug: request_3
    minigame: 4
  - text: "Ande para tr\xE1s."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_43
    id: 5
    episode: 2
    emotion: regular
    slug: request_4
    minigame: 4
  - text: "E, por \xFAltimo, siga em frente."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_45
    id: 6
    episode: 2
    emotion: regular
    slug: request_5
    minigame: 4
  - text: "Calma l\xE1! Primeiro \xE9 para frente!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_36
    id: 7
    episode: 2
    emotion: regular
    slug: error0
    minigame: 4
  - text: "Ei, voc\xEA n\xE3o me ouviu? \xC9 \xE0 esquerda, agora."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_38
    id: 8
    episode: 2
    emotion: regular
    slug: error1
    minigame: 4
  - text: Cuidado! Era esquerda de novo!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_40
    id: 9
    episode: 2
    emotion: scared
    slug: error2
    minigame: 4
  - text: Opa! Eu disse direita...
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_42
    id: 10
    episode: 2
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Volte! \xC9 para tr\xE1s!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_44
    id: 11
    episode: 2
    emotion: scared
    slug: error4
    minigame: 4
  - text: "Que perigo, Guardi\xE3o. \xC9 para frente."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_46
    id: 12
    episode: 2
    emotion: scared
    slug: error5
    minigame: 4
  - text: "\xC9 isso! Boa, Guardi\xE3o! Voc\xEA chegou ao seu destino final!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_47
    id: 13
    episode: 2
    emotion: happy
    slug: victory
    minigame: 4
  - text: "O que h\xE1 nestes quadros? Parecem aqueles quadros sobre o passado e o
      presente dos piratas."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_50
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O Capit\xE3o Barbada quer que mostremos que entendemos sobre a hist\xF3ria
      dos piratas. Vai ser moleza!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_51
    id: 1
    episode: 2
    emotion: happy
    slug: intro
    minigame: 5
  - text: Ele quer que a gente complete os quadros colocando as coisas do passado
      e do presente em seus lugares.
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_52
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Os quadros do passado mostram \xE9pocas antigas, antes de termos toda essa
      tecnologia de hoje."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_53
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Antigamente n\xE3o t\xEDnhamos as roupas que temos hoje, nem motores, sabia?
      Isso deve ser uma dica."
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_54
    id: 4
    episode: 2
    emotion: regular
    slug: error2
    minigame: 5
  - text: Talvez o certo aqui seja deste jeito.
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_55
    id: 5
    episode: 2
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Voc\xEA sabia que os antigos piratas viviam em cavernas? Imagine tentar
      fazer navios voadores de pedra!"
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_56
    id: 6
    episode: 2
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Aqui estamos, Guardi\xE3o. A ilha de Bermudas, o mais terr\xEDvel covil
      de piratas em todo o Mundo dos Sonhos!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_01
    id: 0
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "\xC9 t\xE3o excitante estar aqui! Imagine quantas batalhas a\xE9reas e
      duelos de penas estes navios e piratas j\xE1 viram!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_02
    id: 1
    episode: 3
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Ali est\xE1 a taverna que o Capit\xE3o Barbada mencionou. Com certeza encontraremos
      alguma pista sobre a tal capit\xE3 pirata Isabela Tempestade l\xE1 dentro."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_03
    id: 2
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eles t\xEAm um seguran\xE7a na porta! Vamos precisar convenc\xEA-lo de
      que somos piratas para entrar."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_04
    id: 3
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Precisamos nos misturar. Conversar com alguns piratas. Isso deve nos dar
      algumas pistas.
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_11
    id: 4
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Veja se encontra algum velho lobo do mar que pare\xE7a interessado em conversar."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_12
    id: 5
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Bom, o lobo do mar disse que o Escoc\xEAs Voador est\xE1 no porto e procura
      marujos. Esse \xE9 o nome do navio da Capit\xE3 Isabela!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_25
    id: 6
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos falar com algu\xE9m que trabalhe aqui, algu\xE9m que esteja sempre
      de olho em tudo."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_26
    id: 7
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O cozinheiro mencionou que um dos marinheiros do Escoc\xEAs Voador \xE9
      aquele rapaz jogando Lesmas Velozes. Aposto que ele sabe sobre a capit\xE3!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_32
    id: 8
    episode: 3
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Acho que ele \xE9 um p\xE9ssimo perdedor... Agora n\xE3o quer falar onde
      est\xE1 a capit\xE3!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_37
    id: 9
    episode: 3
    emotion: sad
    slug: minigame5
    minigame: 
  - text: "Bom, s\xF3 restam duas pessoas nessa taverna: aqueles dois esquisitos ali.
      Vamos at\xE9 l\xE1."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_38
    id: 10
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Era a Capit\xE3 Isabela Tempestade! Foi ela quem atacou Stratus!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_46
    id: 11
    episode: 3
    emotion: scared
    slug: final
    minigame: 
  - text: "Mas... por que ela estaria pedindo nossa ajuda? Precisamos ir atr\xE1s
      deles! Vamos!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_47
    id: 12
    episode: 3
    emotion: happy
    slug: final
    minigame: 
  - text: "Somos os terr\xEDveis piratas Nimbus e Guar... Guerreir\xE3o! Com licen\xE7a."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_05
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Como assim piratas n\xE3o pedem licen\xE7a? Guerreir\xE3o, precisamos provar
      que somos piratas. Vamos mostrar que entendemos de piratarias... Tire da mesa
      o que piratas n\xE3o usam."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_06
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Opa! Temos que ler com aten\xE7\xE3o, para que n\xE3o desconfiem do nosso
      disfarce..."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_07
    id: 2
    episode: 3
    emotion: scared
    slug: error1
    minigame: 1
  - text: "L\xE1pis n\xE3o est\xE1 na lista... eu j\xE1 imaginava que piratas n\xE3o
      sabem escrever."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_08
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Claro que eles gostam de frango, mas coxinha de galinha n\xE3o est\xE1
      na lista de objetos de piratas - ent\xE3o deve ficar fora da mesa tamb\xE9m!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_09
    id: 4
    episode: 3
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Pronto! Isso \xE9 pirata o suficiente para voc\xEA?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_10
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Mas que velho lobo exc\xEAntrico! Disse que s\xF3 responde se formos capazes
      de descrever uma baleia voadora para ele, como prova de que somos experientes."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_13
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Bom... como \xE9 uma baleia voadora? Por acaso \xE9 um tipo de planta?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_14
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Acho que n\xE3o \xE9 planta, n\xE3o! \xC9 um animal!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_15
    id: 2
    episode: 3
    emotion: happy
    slug: error0_1
    minigame: 2
  - text: "Por acaso \xE9 um animal azul?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_16
    id: 3
    episode: 3
    emotion: regular
    slug: request1
    minigame: 2
  - text: "\xC9 um animal azul, sim! Veja se n\xE3o h\xE1 alguma pista por aqui que
      possa nos ajudar."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_17
    id: 4
    episode: 3
    emotion: happy
    slug: error1_1
    minigame: 2
  - text: "Ent\xE3o \xE9 um mam\xEDfero voador?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_18
    id: 5
    episode: 3
    emotion: regular
    slug: request2
    minigame: 2
  - text: "Baleias s\xE3o mam\xEDferos e, com esse nome, certamente que voa!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_19
    id: 6
    episode: 3
    emotion: regular
    slug: error2_1
    minigame: 2
  - text: "E qual \xE9 o tamanho de uma baleia voadora? Menor do que um cachorro?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_20
    id: 7
    episode: 3
    emotion: regular
    slug: request3
    minigame: 2
  - text: "N\xE3o, n\xE3o! Acho que \xE9 maior. Bem maior! Olhe aquele quadro ali
      atr\xE1s!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_21
    id: 8
    episode: 3
    emotion: regular
    slug: error3_1
    minigame: 2
  - text: "\xC9 maior que um cachorro e tamb\xE9m \xE9 maior que um navio?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_22
    id: 9
    episode: 3
    emotion: scared
    slug: request4
    minigame: 2
  - text: "Mas \xE9 sim! J\xE1 ouviu a hist\xF3ria sobre um sujeito que foi engolido
      por uma baleia, navio e tudo? Pois \xE9!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_23
    id: 10
    episode: 3
    emotion: regular
    slug: error4_1
    minigame: 2
  - text: "E ent\xE3o? Isso prova que somos piratas experientes, n\xE3o?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_24
    id: 11
    episode: 3
    emotion: happy
    slug: victory
    minigame: 2
  - text: "O cozinheiro! Boa ideia, Guardi\xE3o! Com certeza ele deve ter visto a
      tal capit\xE3 por aqui."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_27
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos ajud\xE1-lo a carregar a comida. Isso deve convenc\xEA-lo a nos ajudar."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_28
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: Vamos ver. Qual destas caixas tem mais batatas?
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_29
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 mesmo? Se somarmos todas essas soltas, s\xE3o 23 batatas, n\xE3o?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_30
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Esta caixa tem 3 sacos com 10 batatas cada, ent\xE3o tem 30 batatas no
      total. Deve ser esta aqui!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_31
    id: 4
    episode: 3
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Ora, ele diz que n\xE3o fala com perdedores! Pode isso? Vamos precisar
      convenc\xEA-lo de que somos ganhadores!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_33
    id: 0
    episode: 3
    emotion: sad
    slug: intro
    minigame: 4
  - text: "Vamos bater a pontua\xE7\xE3o dele em Lesmas Velozes! \xC9 s\xF3 fazer
      o caminho mais curto at\xE9 a sa\xEDda na parte de cima do labirinto!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_34
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Opa! \xC9 para o outro lado!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_35
    id: 2
    episode: 3
    emotion: scared
    slug: error0_1
    minigame: 4
  - text: Esquerda!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_17
    id: 3
    episode: 3
    emotion: regular
    slug: request1
    minigame: 4
  - text: "Opa! \xC9 para o outro lado!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_35
    id: 4
    episode: 3
    emotion: scared
    slug: error1_1
    minigame: 4
  - text: Esquerda!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_17
    id: 5
    episode: 3
    emotion: regular
    slug: request2
    minigame: 4
  - text: "Opa! \xC9 para o outro lado!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_35
    id: 6
    episode: 3
    emotion: scared
    slug: error2_1
    minigame: 4
  - text: Direita!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_15
    id: 7
    episode: 3
    emotion: regular
    slug: request3
    minigame: 4
  - text: "Opa! \xC9 para o outro lado!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_35
    id: 8
    episode: 3
    emotion: scared
    slug: error3_1
    minigame: 4
  - text: "Pronto! Ganhamos! E agora, amigo? Quem \xE9 o perdedor aqui?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_36
    id: 9
    episode: 3
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Estamos procurando o Escoc\xEAs Voador. Ouvimos dizer que est\xE3o contratando
      marujos e n\xF3s, experientes piratas, procuramos emprego!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_39
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "\xC9 impress\xE3o minha ou esses dois ficaram nervosos quando eu falei
      sobre o Escoc\xEAs Voador?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_40
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ei, aquela mulher deixou cair uns papeis no ch\xE3o enquanto levantava...
      Vamos colocar as palavras em ordem alfab\xE9tica e ver se formam alguma mensagem?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_41
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos ler parte por parte. Se est\xE1 em ordem alfab\xE9tica, com certeza
      a primeira palavra come\xE7a com a letra A! Continuando a falar o alfabeto,
      qual a outra palavra que come\xE7a com a letra mais pr\xF3xima do A?"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_42
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 5
  - text: "\"Ajude-me, Guardi\xE3o.\" Esse \xE9 o in\xEDcio, com certeza!"
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_43
    id: 4
    episode: 3
    emotion: happy
    slug: error2
    minigame: 5
  - text: Acho que entendi!
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_44
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 5
  - text: "\"Ajude-me, Guardi\xE3o. Preciso de socorro urgente.\" Ser\xE1 que..."
    world: 3
    season: 2
    sound: ptbr_ep59_nbs_45
    id: 6
    episode: 3
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Vamos segui-los, Guardi\xE3o! Antes que Capit\xE3 Isabela e aquele pirata
      esquisito desapare\xE7am!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_01
    id: 0
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei! Precisamos sair! Que confus\xE3o \xE9 essa na porta?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_02
    id: 1
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Se n\xE3o conseguirmos sair daqui vamos perder a capit\xE3!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_03
    id: 2
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Guardi\xE3o, veja se consegue descobrir com o seguran\xE7a o porqu\xEA
      desta confus\xE3o toda."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_04
    id: 3
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Droga! Eles escaparam!
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_11
    id: 4
    episode: 4
    emotion: sad
    slug: minigame2
    minigame: 
  - text: "Olha, um jornal pirata! Podemos pedir ajuda por l\xE1!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_12
    id: 5
    episode: 4
    emotion: happy
    slug: minigame2
    minigame: 
  - text: "Enquanto os jornaleiros espalham os jornais com a not\xEDcia de que estamos
      \xE0 procura da capit\xE3 do Escoc\xEAs Voador, vamos ver se algu\xE9m viu alguma
      coisa."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_17
    id: 6
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Um papagaio de pirata! Este bicho \xE9 t\xE3o tagarela que com certeza
      vai nos contar algo de \xFAtil!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_18
    id: 7
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "H\xE1 tantos navios aqui! Qual deles deve ser o Escoc\xEAs Voador? Vamos
      perguntar para aquele vendedor de sab\xE3o!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_26
    id: 8
    episode: 4
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Segundo o vendedor de sab\xE3o, o Escoc\xEAs Voador est\xE1 na lista de
      navios para serem lavados."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_33
    id: 9
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vamos checar aquela listagem. Ela deve dizer em qual doca est\xE1 o navio
      que procuramos."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_34
    id: 10
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Finalmente vamos encontrar o Escoc\xEAs Voador! Aposto que essa tal Capit\xE3
      Isabela tem uma hist\xF3ria e tanto para contar."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_43
    id: 11
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "Ser\xE1 que ela precisa mesmo de nossa ajuda? E, se precisa, contra quem?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_44
    id: 12
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: Roubaram as panelas do cozinheiro? Quem faria isso?
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_05
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ora, pelas imagens da c\xE2mera podemos saber o que aconteceu. Vamos explicar
      ao seguran\xE7a."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_06
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Espera a\xED, \xE9 isso mesmo? Se ele queria sair de fininho, tinha que
      esperar o cozinheiro se virar A FIM DE passar despercebido, ou PARA passar despercebido,
      n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_07
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 1
  - text: "N\xE3o sei, n\xE3o... Ainda est\xE1 meio estranho, n\xE3o acha? \xC9 fato
      que ele pega a panela E foge para o sal\xE3o..."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_08
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 1
  - text: Entendi! O danado pegou a panela e fugiu!
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_09
    id: 4
    episode: 4
    emotion: regular
    slug: error3
    minigame: 1
  - text: Agora sim! O bandido foi preso! Podemos ir? Estamos com um pouco de pressa!
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_10
    id: 5
    episode: 4
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Jornais piratas s\xE3o conhecidos por circular por toda a parte! E imprimem
      tudo na hora!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_13
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vamos colocar o t\xEDtulo da not\xEDcia e a legenda da foto, cada um no
      seu lugar certo."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_14
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Opa! Acho que a legenda explica bem direitinho a imagem da capit\xE3..."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_15
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Pronto! Agora \xE9 s\xF3 pedir para imprimirem e distribu\xEDrem por toda
      a cidade!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_16
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Ent\xE3o, papagaio: para onde foi a Capit\xE3 Isabela Tempestade?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_19
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: 
    world: 3
    season: 2
    sound: sfx_m3_t2_e4_d3_dica_papagaio
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ora, mas... este papagaio n\xE3o fala! S\xF3 faz barulho!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_20
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos ver na placa... para qual dire\xE7\xE3o o papagaio diz que foi a
      capit\xE3? Ser\xE1 que o som que ele faz \xE9 uma pista?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_21
    id: 3
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que o som diz o n\xFAmero de s\xEDlabas na palavra! Vamos ouvir de
      novo."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_22
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Parece que s\xE3o dois sons. Qual destas placas tem uma palavra com duas
      s\xEDlabas?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_23
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 3
  - text: "L\xC1 tem uma s\xEDlaba. AR-MA-Z\xC9M, tem 3 s\xEDlabas, DE-P\xD3-SI-TO
      tem 4 e DO-CAS tem duas s\xEDlabas. Deve ser esta aqui!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_24
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 3
  - text: Vamos para as docas antes que eles fujam!
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_25
    id: 7
    episode: 4
    emotion: happy
    slug: victory
    minigame: 3
  - text: "J\xE1 viu como todo pirata que faz besteira, ou anda na prancha, ou lava
      o conv\xE9s? Esse vendedor deve saber muita coisa!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_27
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Mas \xE9 claro que ele s\xF3 nos ajuda se o ajudarmos primeiro... Ele quer
      que digamos quantos sab\xF5es t\xEAm de cada fragr\xE2ncia."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_28
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Melhor conferir conta por conta. A primeira: 23+42. A gente tem que somar
      as unidades: 3 + 2 e sabemos que d\xE3o 5 unidades. E, em seguida, somamos as
      dezenas: 2 + 4 e sabemos que d\xE3o 6 dezenas."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_29a
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "6 dezenas e 5 unidades \xE9 o n\xFAmero 65, concorda?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_29b
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Isso \xE9 mesmo complicado... Na conta 12 + 25, somando as unidades primeiro
      e depois as dezenas, teremos 7 unidades e 3 dezenas, que s\xE3o 37, n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_30
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Quanto sab\xE3o! S\xF3 pra conferir a \xFAltima: desta vez temos 15 + 33
      e sabemos que s\xE3o 48, porque s\xE3o 8 unidades e 4 dezenas."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_31
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: "A\xED est\xE1! Fizemos as contas para voc\xEA. Agora nos conte onde est\xE1
      o navio!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_32
    id: 6
    episode: 4
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Quem diria que piratas gostam de manter seus navios t\xE3o limpinhos!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_35
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ao que parece, os navios s\xE3o separados pelo n\xFAmero de vezes por m\xEAs
      que s\xE3o lavados."
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_36
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Segundo o vendedor, o Escoc\xEAs Voador \xE9 lavado todas as segundas e
      quartas-feiras. Quantas vezes este m\xEAs o navio ser\xE1 lavado?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_37
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos usar o calend\xE1rio para ajudar. Somando as segundas-feiras e as
      quartas-feiras deste m\xEAs, quantas vezes o navio ser\xE1 lavado?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_38
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Ser\xE1? Vamos conferir: Este m\xEAs teremos 4 segundas-feiras e mais 5
      quartas-feiras. Quantas vezes o navio ser\xE1 lavado, ent\xE3o?"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_39
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Se s\xE3o 4 segundas-feiras e 5 quartas-feiras, ent\xE3o o total neste
      m\xEAs s\xE3o de... 9 lavagens!"
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_40
    id: 5
    episode: 4
    emotion: regular
    slug: error3
    minigame: 5
  - text: Doca 9! Vamos!
    world: 3
    season: 2
    sound: ptbr_ep60_nbs_42
    id: 6
    episode: 4
    emotion: happy
    slug: victory
    minigame: 5
  - text: "L\xE1 est\xE1 o Escoc\xEAs Voador! Mas... olha quantos rob\xF4s! E s\xF3
      h\xE1 uma pessoa que usa um ex\xE9rcito de rob\xF4s como esse..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_01
    id: 0
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ser\xE1 que a Capit\xE3 Isabela se aliou ao Senhor Sombrio? Ser\xE1 que
      ela o est\xE1 ajudando a dominar o Sonho das Nuvens Guerreiras?"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_02
    id: 1
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Acho que o \xFAnico jeito de descobrir \xE9 chegando at\xE9 ela. Mas como
      passar por todos esses rob\xF4s?"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_03
    id: 2
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Olha s\xF3 quantas engenhocas malucas! T\xEDpico do Senhor Sombrio! Vamos
      ver o que s\xE3o."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_04
    id: 3
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O Desligador Eletr\xF4nico 3.000 apagou boa parte dos rob\xF4s! Muito bom!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_11
    id: 4
    episode: 5
    emotion: happy
    slug: minigame2
    minigame: 
  - text: "Guardi\xE3o, outro rob\xF4! A bateria do Desligador acabou! Vamos precisar
      enfrent\xE1-lo de outra forma."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_12
    id: 5
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Duvido que haja mais rob\xF4s por aqui! Acho que s\xF3 nos resta..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_19
    id: 6
    episode: 5
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "O que \xE9 aquilo? Um rob\xF4 muda-formas! Ah n\xE3o!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_20
    id: 7
    episode: 5
    emotion: sad
    slug: minigame3
    minigame: 
  - text: Um pesinho a mais o joga para fora do navio! Tchau!
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_28
    id: 8
    episode: 5
    emotion: happy
    slug: minigame4
    minigame: 
  - text: "Isso foi engra\xE7ado! Mas vamos l\xE1! S\xF3 falta um rob\xF4 e a capit\xE3
      para descobrirmos a verdade!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_29
    id: 9
    episode: 5
    emotion: happy
    slug: minigame4
    minigame: 
  - text: "Preparem-se para enfrentar a destemida Nimbus e o Guardi\xE3o dos Sonhos!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_36
    id: 10
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ei! \xC9 o rob\xF4-tenente do Senhor Sombrio! E ele est\xE1 desmaiado!
      Acho que bati forte demais na porta..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_37
    id: 11
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Certamente o Senhor Sombrio est\xE1 escondido l\xE1. Podemos ir ao Escoc\xEAs
      Voador."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_45
    id: 12
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "E, enquanto isso, Capit\xE3 Isabela Tempestade, a senhora explica porque
      estava ajudando o Senhor Sombrio. E isso antes que eu resolva te mostrar qu\xE3o
      h\xE1bil eu sou com a pena!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_46
    id: 13
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: "Os rob\xF4s do Senhor Sombrio devem ter trazido isso tudo para c\xE1 para
      usar contra Stratus!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_05
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ser\xE1 que n\xE3o h\xE1 algo a\xED que possamos usar para desligar esses
      rob\xF4s? Veja se encontra algo no cat\xE1logo de engenhocas."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_06
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Isso \xE9 interessante... mas n\xE3o acho que v\xE1 ajudar. Ser\xE1 que
      alguma das engenhocas serve para desligar rob\xF4s? Temos que ler uma a uma
      para saber."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_07
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Eu nem sabia que existia uma m\xE1quina para fazer isso! Quem sabe tenha
      serventia no futuro, mas n\xE3o \xE9 o que precisamos neste momento. Estamos
      atr\xE1s de um \"desligador\"."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_08
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: "O que precisamos mesmo \xE9 uma coisa que desligue os rob\xF4s... como
      isso aqui! Desligador Eletr\xF4nico 3.000! Com essa pot\xEAncia, deve desligar
      tudo, mesmo!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_09
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 1
  - text: Espero que isso funcione!
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_10
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Nossa, \xE9 um rob\xF4 multiplicador! Ele consegue construir in\xFAmeros
      rob\xF4s! Deve ter sido assim que surgiram tantos rob\xF4s no navio!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_13
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "O problema \xE9 saber qual deles \xE9 o original... Se voc\xEA deslig\xE1-lo,
      todos os outros tamb\xE9m desligar\xE3o! Aqui: esta \xE9 a descri\xE7\xE3o do
      rob\xF4 original. Veja se consegue encontr\xE1-lo."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_14
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "\xC9 s\xF3 seguir a descri\xE7\xE3o no papel para descobrir qual \xE9 o
      original... Primeiro, aqui est\xE1 escrito que ele tem dois olhos vermelhos...
      E o que mais?"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_15
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 2
  - text: "O rob\xF4 original tem olhos vermelhos, boca quadrada... e o que mais?"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_16
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Acho que o rob\xF4 que procuramos \xE9 aquele ali. Veja bem: dois olhos
      vermelhos, boca quadrada, uma antena e quatro bra\xE7os. Vamos peg\xE1-lo!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_17
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Boa, Guardi\xE3o! Pegamos ele!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_18
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 2
  - text: "N\xE3o conseguiremos venc\xEA-lo em uma luta, porque ele poderia virar
      um navio inteiro! Precisamos usar a nossa intelig\xEAncia."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_21
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Voc\xEA, rob\xF4! Aposto que n\xE3o consegue virar um robozinho pequenininho
      que n\xE3o pesa nada."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_22
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Voc\xEA virou um robozinho, mas pesa pouco? Guardi\xE3o, vamos descobrir
      qual \xE9 o peso deste rob\xF4."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_23
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que \xE9 menos do que isso. Veja o ponteiro da balan\xE7a! Est\xE1
      apontando para o lado dos pesos. Coloque menos pesos para ver exatamente quanto
      ele pesa..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_25
    id: 3
    episode: 5
    emotion: regular
    slug: more
    minigame: 3
  - text: "Acho que ele pesa mais, hein? O ponteiro da balan\xE7a est\xE1 apontando
      para o lado dele. Coloque mais pesos para ver exatamente quanto ele pesa."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_24
    id: 4
    episode: 5
    emotion: regular
    slug: less
    minigame: 3
  - text: "Acho que j\xE1 sei qual \xE9 o peso dele! Basta o ponteiro da balan\xE7a
      estar bem no meio. Dessa forma, sabemos que as duas bandejas est\xE3o exatamente
      com o mesmo peso!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_26
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 3
  - text: "\xC9, 60 gramas... Realmente voc\xEA conseguiu, muda-formas. Ficou t\xE3o
      leve, mas t\xE3o leve que..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_27
    id: 6
    episode: 5
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Ei! Algu\xE9m trancou a porta da cabine da capit\xE3! Devem estar morrendo
      de medo de n\xF3s!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_30
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Vamos precisar descobrir qual \xE9 a senha. Ser\xE1 que deixaram alguma
      pista para tr\xE1s?"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_31
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "E aquele bilhete no ch\xE3o? Pode ser uma pista! Nossa! O maior n\xFAmero
      poss\xEDvel com 3 algarismos? Essa \xE9 complicada..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_32
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Se a senha \xE9 o maior n\xFAmero de tr\xEAs algarismos, ele vai ter unidade,
      dezena e centena... Que tal a gente come\xE7ar colocando o maior algarismo nas
      centenas? Acho que \xE9 o 9..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_33
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Guardi\xE3o! J\xE1 sei! Se o 9 \xE9 o maior dos algarismos, ele deve entrar
      tamb\xE9m na dezena e na unidade..."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_34
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 4
  - text: 999! Mas que senha mais boba! Deviam estar com muita pressa mesmo!
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_35
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Capit\xE3 Isabela, voc\xEA ter\xE1 muitas explica\xE7\xF5es para dar. Mas,
      primeiro, precisamos descobrir de onde vieram esses rob\xF4s."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_38
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Podemos usar o c\xE9rebro-rob\xF4 para descobrirmos por onde eles andaram.
      Isso deve nos dar uma boa pista do paradeiro do Senhor Sombrio."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_39
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Um monte de imagens e palavras... Mas o que \xE9 o qu\xEA? Vamos tentar
      por ordem nisso tudo?"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_40
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos ler um por um... Nimbus sou eu! Ele deve ter me visto chegando perto
      da porta. E tem uma caverna a\xED."
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_41
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Estamos indo bem! Estou vendo a palavra margarida duas vezes. Por que uma
      delas come\xE7a com letra mai\xFAscula e a outra, min\xFAscula?"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_42
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Entendi o que voc\xEA est\xE1 fazendo! Colocamos tamb\xE9m a margarida,
      que \xE9 esta flor, e a Margarida, que \xE9 o nome desta garota. Por isso est\xE1
      com letra mai\xFAscula! Boa, Guardi\xE3o!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_43
    id: 5
    episode: 5
    emotion: happy
    slug: error3
    minigame: 5
  - text: "Esses rob\xF4s vieram da ilha dos homens-p\xE1ssaro! Eu sei onde eles vivem!"
    world: 3
    season: 2
    sound: ptbr_ep61_nbs_44
    id: 6
    episode: 5
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Ent\xE3o o Senhor Sombrio sequestrou sua filha Serena? Isso explica porque
      voc\xEA o estava ajudando."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_01
    id: 0
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Viu isso, Guardi\xE3o? Precisamos ajudar a Capit\xE3 Isabela a salvar sua
      filha! Se n\xE3o, ela ser\xE1 obrigada a atacar Stratus mais uma vez!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_02
    id: 1
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Bom, essa \xE9 a ilha dos famigerados homens-p\xE1ssaro. Vamos seguir disfar\xE7ados
      de rob\xF4s. Isso deve nos ajudar a entrar no esconderijo do Senhor Sombrio."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_03
    id: 2
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "E l\xE1 est\xE1 nosso primeiro desafio! Comporte-se como um rob\xF4, Guardi\xE3o!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_04
    id: 3
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos logo antes que outro rob\xF4 nos pare pelo caminho!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_11
    id: 4
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Droga... mais um! Vamos falar com ele...
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_12
    id: 5
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Olha, mas que vontade de parar de fingir e dar uma bela bronca nesses rob\xF4s!
      Estou me segurando aqui!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_20
    id: 6
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Claro... mais um rob\xF4? Ser\xE1 que eu posso brigar com esse? Deixa?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_21
    id: 7
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Olha, com um ex\xE9rcito desses n\xE3o me surpreende que o Senhor Sombrio
      viva falhando em conquistar o Mundo dos Sonhos!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_27
    id: 8
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Mais um! Aposto que vai pedir nossa ajuda tamb\xE9m!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_28
    id: 9
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Vai l\xE1 entregar a carta que n\xF3s fazemos sua pr\xF3xima tarefa! Boa
      sorte!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_34
    id: 10
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Isso nos dar\xE1 uma desculpa para entrar na caverna. Ei, aquele ali n\xE3o
      \xE9 Rocha, o l\xEDder dos homens-p\xE1ssaro? \xC9 sim, \xE9 ele mesmo."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_35
    id: 11
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Estamos sozinhos dentro da caverna! Aposto que a Serena Tempestade est\xE1
      logo em frente!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_43
    id: 12
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Vamos l\xE1, Guardi\xE3o. Est\xE1 na hora de libertar a princesa! Ou pirata,
      sei l\xE1... Bom, voc\xEA entendeu!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_44
    id: 13
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "N\xF3s somos os rob\xF4s do Escoc\xEAs Voador voltando para checar a prisioneira
      Serena Tempestade!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_05
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Guardi\xE3o, ele quer que preenchamos o calend\xE1rio com nosso pr\xF3ximo
      saque a Stratus! Em que dia da semana cair\xE1 o dia 6?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_06
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Acho que se usarmos os n\xFAmeros para preencher o calend\xE1rio com os
      dias, as coisas podem ficar mais f\xE1ceis..."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_07
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Parece que o dia 1 \xE9 quinta-feira. Ent\xE3o dia 2 \xE9 sexta-feira,
      dia 3 \xE9 s\xE1bado... E o dia 6?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_08
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "J\xE1 sei!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_09
    id: 4
    episode: 6
    emotion: happy
    slug: error3
    minigame: 1
  - text: "Pronto, ter\xE7a-feira! Podemos passar agora?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_10
    id: 5
    episode: 6
    emotion: regular
    slug: victory
    minigame: 1
  - text: 
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_15
    id: 0
    episode: 6
    emotion: regular
    slug: radio
    minigame: 2
  - text: Bip de novo! Precisamos passar. Temos uma mensagem urgente para o Senhor
      Sombrio.
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_13
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ai, caramba... Ele quer que ajudemos a preencher sua planilha de saques!
      T\xE1 bom..."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_14
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ele j\xE1 tinha preenchido as 24 nuvens de ontem e as 32 de hoje. Voc\xEA
      ouviu o resto? A primeira coisa que eu disse foi que ontem tinham 12 cartas...
      E o que mais? Vou repetir."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_16
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Precisamos preencher toda a tabela. Al\xE9m das 12 cartas, ontem tamb\xE9m
      tinham 14 malas, n\xE3o \xE9? E hoje? Vou repetir para voc\xEA."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_17
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Eu completo o resto. Uma coluna se refere ao dia de ontem, a outra, ao
      dia de hoje! E cada linha \xE9 um tipo de coisa: nuvem, carta e mala. Quantos
      saques!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_18
    id: 5
    episode: 6
    emotion: happy
    slug: error3
    minigame: 2
  - text: "Tchau, rob\xF4. E um bom bip para voc\xEA!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_19
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 2
  - text: "T\xE1 bom... voc\xEA est\xE1 certo, Guardi\xE3o... \xC9 muito melhor conversarmos
      para resolver os problemas..."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_22
    id: 0
    episode: 6
    emotion: sad
    slug: intro
    minigame: 3
  - text: "Esse rob\xF4 est\xE1 perguntando se sabemos a ordem do dia. Acho que ele
      leu o quadro e n\xE3o entendeu, mas est\xE1 com vergonha de contar, isso sim!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_23
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos ver o que diz o quadro. Qual \xE9 a ordem que foi dada aos rob\xF4s?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_24
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que todos eles iam adorar ir para casa jogar bola, mas n\xE3o deve
      ser essa a ordem certa!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_25
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Isso mesmo, rob\xF4! V\xE1 consertar o navio! Tchau!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_26
    id: 4
    episode: 6
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Como um rob\xF4 pode ser t\xE3o desastrado? Culpa do Senhor Sombrio que
      n\xE3o os constr\xF3i direito!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_29
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "T\xE1 bom, vamos ajud\xE1-lo. Ele diz que perdeu a carta que precisava
      entregar quando trope\xE7ou. Qual destes pap\xE9is \xE9 uma carta?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_30
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Bonito, mas isso n\xE3o \xE9 uma carta. Carta sempre diz no in\xEDcio para
      quem ela foi escrita, e no final o nome de quem a escreveu."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_31
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 4
  - text: "A carta deve ser essa aqui. A Sociedade dos Vil\xF5es An\xF4nimos a escreveu
      para o Senhor Sombrio."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_32
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 4
  - text: "A carta deve ser essa aqui. A Sociedade dos Vil\xF5es An\xF4nimos a escreveu
      para o Senhor Sombrio."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_32
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Parece que o Senhor Sombrio gastou mais do que podia. N\xE3o est\xE1 f\xE1cil
      para ningu\xE9m!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_33
    id: 5
    episode: 6
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Rocha! Viemos fazer a tarefa daquele rob\xF4 atrapalhado das cartas. Estamos
      dando uma m\xE3o... ou parafuso amigo, n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_36
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ent\xE3o, vamos passando viu, Rocha? Ok?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_37
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Bom, estamos na caverna! S\xF3 precisamos organizar esses selos que o Senhor
      Sombrio roubou e podemos seguir em frente! Voc\xEA sabe como fazer isso?"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_38
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Algumas palavras come\xE7am com C e outras com QU. Ler as palavras em voz
      alta deve ajudar. Adoro dan\xE7ar quadrilha e sei que \xE9 com QU. E nunca me
      esque\xE7o das caveiras dos navios piratas. E caveira \xE9 com \"C\"."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_39
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Coelho \xE9 com \"C\". Quarto \xE9 com \"QU\". O que mais? Ler as palavras
      em voz alta deve ajudar."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_40
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Vamos organizar estes \xFAltimos aqui para podermos seguir em frente."
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_41
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: "Pronto! Cole\xE7\xE3o completa e organizada! Ufa!"
    world: 3
    season: 2
    sound: ptbr_ep62_nbs_42
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Esse Senhor Sombrio \xE9 um vil\xE3o terr\xEDvel. Prender a filha da capit\xE3
      para obrig\xE1-la a atacar Stratus! Ele \xE9 um covarde mesmo!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_01
    id: 0
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Parece que n\xE3o h\xE1 tantos rob\xF4s aqui dentro. Ainda bem!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_02
    id: 1
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Este lugar se assemelha a um labirinto! Precisamos encontrar algum mapa
      que nos guie at\xE9 a pris\xE3o."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_03
    id: 2
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Uma mesa cheia de pap\xE9is! Deve haver algo de \xFAtil l\xE1!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_04
    id: 3
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Temos esta prova, mas ainda precisamos encontrar a Serena.
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_11
    id: 4
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ser\xE1 que aquele cartaz na parede n\xE3o \xE9 um mapa? De repente ele
      nos mostra o caminho."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_12
    id: 5
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Estranho que n\xE3o tem um rob\xF4 sequer por aqui! Nem precis\xE1vamos
      deste disfarce todo!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_19
    id: 6
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Esta deve ser a mesa de seguran\xE7a deles. Vamos ver se h\xE1 algo nos
      monitores!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_20
    id: 7
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Droga... estava tudo indo t\xE3o bem! Um rob\xF4 sentinela! Vamos precisar
      passar por ele."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_27
    id: 8
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Certo, vamos logo soltar a Serena antes que o sentinela perceba que h\xE1
      algo de errado."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_34
    id: 9
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Quer apostar quanto que o cadeado da cela tem algum c\xF3digo esquisito?"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_35
    id: 10
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Opa! Opa! Calma, Serena! N\xF3s somos amigos! Sua m\xE3e nos mandou para
      salv\xE1-la!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_43
    id: 11
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Agora venha conosco e r\xE1pido. N\xE3o temos tempo a perder!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_44
    id: 12
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: Uma carta! Com certeza deve haver algo interessante aqui.
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_05
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Leia a carta e veja quem s\xE3o as pessoas mencionadas."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_06
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Acho que n\xE3o... H\xE1 dois personagens nesta carta, n\xE3o?"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_07
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O Escoc\xEAs Voador \xE9 s\xF3 um navio. E eu, com certeza, n\xE3o apare\xE7o
      nessa hist\xF3ria!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_08
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: "A carta parece ser sobre as Tempestades, m\xE3e e filha."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_09
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 1
  - text: "A\xED est\xE1 a prova de que a Capit\xE3 Isabela s\xF3 atacou Stratus porque
      o Senhor Sombrio a obrigou!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_10
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Ora, mas quem escreveu este mural todo incompleto? Deve ter sido um desses
      rob\xF4s de meia-tigela!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_13
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: Precisamos completar as palavras para entender para onde precisamos ir.
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_14
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Nem sempre o jeito que falamos \xE9 o jeito que escrevemos."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_15
    id: 2
    episode: 7
    emotion: regular
    slug: error1
    minigame: 2
  - text: "\"Sigam em frente...\" e depois vem o qu\xEA?"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_16
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 2
  - text: Agora ficou faltando isso aqui.
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_17
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 2
  - text: "\xC9 assim que o Senhor Sombrio protege o esconderijo secreto dele? N\xE3o
      me surpreende que seus rob\xF4s sejam t\xE3o tapados..."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_18
    id: 5
    episode: 7
    emotion: sad
    slug: victory
    minigame: 2
  - text: "Cada monitor mostra a imagem de uma c\xE2mera diferente espalhada pelos
      t\xFAneis."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_21
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Essa \xE9 a imagem da entrada que nos leva at\xE9 Serena Tempestade!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_22
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Mas... qual das entradas \xE9 a entrada certa?"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_23
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o parece ser esta... A imagem da c\xE2mera mostra algum detalhe da
      passagem certa."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_24
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Aquilo ali n\xE3o \xE9 um morcego e uma tocha?"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_25
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 3
  - text: "N\xE3o parece ser esta... A imagem da c\xE2mera mostra algum detalhe da
      passagem certa."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_24
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 3
  - text: "\xC9 essa a passagem! Vamos embora!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_26
    id: 6
    episode: 7
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Ent\xE3o... Precisamos levar a prisioneira at\xE9 o Senhor Sombrio."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_28
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Quer uma ajuda? Podemos ajudar a contar quanto voc\xEA ganhou no \xFAltimo
      saque. Pode ser? \xD3timo! Digo, bip!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_29
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: Opa! Acho que ele tem menos do que isso.
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_31
    id: 2
    episode: 7
    emotion: regular
    slug: error_more
    minigame: 4
  - text: "Voc\xEA somou as quatro moedas? Me parece que d\xE1 mais do que isso."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_30
    id: 3
    episode: 7
    emotion: regular
    slug: error_less
    minigame: 4
  - text: "25 mais 10, d\xE1 35. Mais 5, d\xE1 40... mais 1..."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_32
    id: 4
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "41 dinheiros! Uma fortuna! Voc\xEA est\xE1 bip-rico!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_33
    id: 5
    episode: 7
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Vamos  testar uma op\xE7\xE3o de cada vez: se \xE9 s\xF3 o Senhor Sombrio,
      n\xE3o pode ser TROUXEMOS, por que a\xED o certo seria TROUXE, n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_39
    id: 0
    episode: 7
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Mas \xE9 claro! Ele prendeu Serena aqui!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_41
    id: 1
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Acho que esta aqui tamb\xE9m n\xE3o serve: BUSCARAM... Se \xE9 s\xF3 o
      Senhor Sombrio, na placa estaria escrito BUSCOU..."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_40
    id: 2
    episode: 7
    emotion: regular
    slug: error3
    minigame: 5
  - text: "N\xE3o disse? Acho que esse Senhor Sombrio passa o tempo dele inventando
      este tipo de cadeado maluco!"
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_36
    id: 3
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Voc\xEA sabe como resolver esta charada, n\xE3o \xE9, Guardi\xE3o? Porque
      eu estou meio perdida..."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_38
    id: 4
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Logo, logo voc\xEA estar\xE1 livre, Serena. \xC9 s\xF3 esperar um pouco."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_37
    id: 5
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Aleluia! A porta est\xE1 aberta! Pode sair, Serena Tempestade."
    world: 3
    season: 2
    sound: ptbr_ep63_nbs_42
    id: 6
    episode: 7
    emotion: happy
    slug: victory
    minigame: 5
  - text: Nossa, nunca pensei que existissem tantos piratas assim no Sonho das Nuvens
      Guerreiras!
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_01
    id: 0
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Agora que salvamos a filha da Capit\xE3 Isabela ela quer mais \xE9 ir \xE0
      forra! O Senhor Sombrio que se cuide!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_02
    id: 1
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos ajudar pilotando o Escoc\xEAs Voador. Com certeza agora expulsaremos
      o Senhor Sombrio do nosso sonho!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_03
    id: 2
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O que \xE9 aquilo? Um bando de baleias voadoras? Parece que querem dizer
      algo!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_04
    id: 3
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Apesar da ajuda das baleias, h\xE1 muitos rob\xF4s. Vamos ter que enfrent\xE1-los
      diretamente!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_11
    id: 4
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "L\xE1 est\xE1 uma esquadrilha de rob\xF4s voadores! Atacar!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_12
    id: 5
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Precisamos organizar todos os navios piratas para atacar o navio voador
      do Senhor Sombrio.
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_19
    id: 6
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Capit\xE3 Isabela? Quais s\xE3o as suas ordens?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_20
    id: 7
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "L\xE1 est\xE1 o Gale\xE3o Sombrio, o navio do Senhor Sombrio! Vamos ensinar
      uma li\xE7\xE3o a ele!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_27
    id: 8
    episode: 8
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Cessar fogo! Acho que estou vendo alguma coisa no Gale\xE3o Sombrio!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_32
    id: 9
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Guardi\xE3o, use a luneta da Capit\xE3 Isabela e veja se consegue ver o
      que est\xE1 acontecendo no navio inimigo."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_33
    id: 10
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ei! O Senhor Sombrio est\xE1 fugindo! Ah, droga!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_39
    id: 11
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "Bom, pelo menos n\xF3s o derrotamos mais uma vez! E agora Stratus e os
      piratas das Bermudas est\xE3o juntos. E gra\xE7as ao Senhor Sombrio!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_40
    id: 12
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "O navio da Capit\xE3 Isabela tem um tradutor \xF3timo. Bom... quase \xF3timo."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_05
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "O tradutor est\xE1 meio confuso. Tem alguma coisa errada na pontua\xE7\xE3o
      desta frase, n\xE3o?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_06
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Parece que tem um ponto faltando e um sobrando... Vamos come\xE7ar pelo
      que est\xE1 faltando... \"As baleias responderam.\" Ponto final! Acabou a frase.
      Agora, qual ponto est\xE1 sobrando?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_07
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Lendo com calma essas duas frases de baixo, d\xE1 para a gente ver que
      o ponto ali no meio est\xE1 sobrando..."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_08
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "\"Elas v\xE3o nos ajudar.\" Esta \xE9 a frase!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_09
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Com a ajuda das baleias voadoras poderemos derrotar o ex\xE9rcito de rob\xF4s
      do Senhor Sombrio!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_10
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Precisamos preparar os canh\xF5es de sopro para derrubar esses rob\xF4s!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_13
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Olhe na cartilha de defesa aeronaval. Quantas cargas de nuvens precisamos
      para enfrentar rob\xF4s voadores aqui no Sonho das Nuvens Guerreiras?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_14
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Olhe a coluna \"rob\xF4s voadores\" e veja na linha deste sonho quantas
      cargas precisamos."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_15
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Se precis\xE1ssemos nos defender de moscas, seria f\xE1cil! Era s\xF3 olhar
      na primeira linha, a das Nuvens Guerreiras, e ver na primeira coluna, a das
      moscas: seria 1 carga! Mas nosso ataque \xE9 de rob\xF4s voadores..."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_16
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Vamos juntos: primeira linha \xE9 aqui das Nuvens Guerreiras... E a terceira
      coluna diz dos Rob\xF4s Voadores... Ent\xE3o, a resposta \xE9 3! S\xF3 isso?
      Achei que precisar\xEDamos de mais..."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_17
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 2
  - text: "O que voc\xEAs acham disso, seus cabe\xE7as de vento?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_18
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 2
  - text: "A Capit\xE3 Isabela passou essas ordens. Precisamos transmiti-las para
      os outros navios."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_21
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: Esta ordem parece grande demais... vamos precisar resumir isso de algum
      jeito...
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_22
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Veja qual destas placas tem a mensagem que resume a ordem da capit\xE3."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_23
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ei! Ser\xE1 isso? Vamos ler uma por uma... \"Cada um por si\"? A Capit\xE3
      acha que juntos somos mais poderosos... Esta placa n\xE3o serve."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_24
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ela quer que avancemos, n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_25
    id: 4
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Ela quer que avancemos, n\xE3o \xE9?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_25
    id: 5
    episode: 8
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Est\xE1 na hora de avan\xE7ar e atacar!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_26
    id: 6
    episode: 8
    emotion: happy
    slug: victory
    minigame: 3
  - text: Esperei tanto tempo por este dia!
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_28
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Est\xE1 na hora de usarmos todos os nossos canh\xF5es de \xE1gua! Guardi\xE3o,
      temos \xE1gua o suficiente para todos os canh\xF5es?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_29
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Tem certeza? Ora, temos sim! Se somarmos quanto cada canh\xE3o precisa
      d\xE1 exatamente 1 litro, ou 1000 mililitros!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_30
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: ERROR2
    world: 3
    season: 2
    sound: 
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Isso \xE9 pelo que voc\xEA fez em Stratus, Senhor Sombrio!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_31
    id: 4
    episode: 8
    emotion: happy
    slug: victory
    minigame: 4
  - text: "\xC9 um tipo de mensagem? N\xE3o consigo ver direito daqui!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_34
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Ele est\xE1 dizendo que desistiu por qu\xEA?"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_35
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "N\xE3o me parece que \xE9 isso."
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_36
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Ora, deve ser pelos tiros de canh\xE3o!"
    world: 3
    season: 2
    sound: ptbr_ep64_nbs_37
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ganhamos! Agora \xE9 s\xF3 capturar o Senhor Sombrio e entreg\xE1-lo \xE0s
      autoridades!"
    world: 3
