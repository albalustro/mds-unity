    episode: 2
    emotion: happy
    slug: command4
    minigame: 2
  - text: Direita!
    world: 3
    season: 2
    sound: ptbr_ep58_nbs_15
    id: 7
    episode: 2
    emotion: happy
    slug: command5
    minigame: 2
  - text: Creio que estamos prontos para enfrentar um duelo de penas com qualquer
