    season: 1
    sound: ptbr_ep27_clr_23
    id: 9
    episode: 3
    emotion: regular
    slug: ask3
    minigame: 2
  - text: "Sei que 12 \xE9 muito, mas voc\xEA pegou peda\xE7os de papel\xE3o demais!"
