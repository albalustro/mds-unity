    world: 2
    season: 1
    sound: ptbr_ep28_clr_13
    id: 6
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Pronto! Agora \xE9 s\xF3 ligar os postes de luz! E se n\xF3s atrairmos
