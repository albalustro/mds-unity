    sound: ptbr_ep26_clr_25
    id: 4
    episode: 2
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Toda planta precisa de sol, mas algumas precisam de sombra tamb\xE9m, sen\xE3o
