%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G1W2
  m_EditorClassIdentifier: 
  dialogueList:
  - text: Deve ser esse o sequestrador!
    world: 2
    season: 1
    sound: ptbr_ep25_clr_01
    id: 0
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O qu\xEA? Voc\xEA \xE9 um Guardi\xE3o dos Sonhos? Duvido! Pode provar?
      Hein?"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_02
    id: 1
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Certo. Voc\xEA parece mesmo um guardi\xE3o... Eu vou confiar... Mas s\xF3
      dessa vez!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_03
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Voc\xEA veio aqui para encontrar o filho do Prefeito do Sonho das Sombras
      Sussurrantes, certo? Meu nome \xE9 Clara! O Prefeito me pediu para ajudar a
      desvendar esse mist\xE9rio."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_04
    id: 3
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eu n\xE3o me preocuparia com essas 15 penumbras desaparecidas. N\xF3s penumbras
      adoramos nos esconder e assustar os outros!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_11
    id: 4
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Falando nisso, vamos at\xE9 o Prefeito? Ele deve saber mais sobre o desaparecimento
      do filho dele."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_12
    id: 5
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: Grama e terra? Dentro de casa? Como isso teria vindo parar aqui?
    world: 2
    season: 1
    sound: ptbr_ep25_clr_19
    id: 6
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "A mans\xE3o do Prefeito tem um quintal grande. Talvez o Espoleta tenha
      ido parar l\xE1!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_20
    id: 7
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O que \xE9 aquilo no ch\xE3o? Vamos olhar mais de perto!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_29
    id: 8
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Voc\xEA j\xE1 veio antes para o Sonho das Sombras Sussurrantes, n\xE9?
      N\xE3o? Ent\xE3o voc\xEA n\xE3o sabe o que mora aqui? Isso vai ser muito engra\xE7ado..."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_36
    id: 9
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Sabe quando voc\xEA tem um sonho ruim? Um pesadelo? Ent\xE3o... Geralmente
      ele vem daqui. Vamos para dentro que eu explico melhor."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_37
    id: 10
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Vamos, Guardi\xE3o! A Floresta Assombrada nos aguarda! Monstros, sustos,
      escuro! Isso vai ser t\xE3o demais..."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_45
    id: 11
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "V\xE1rias de n\xF3s, penumbras, j\xE1 sa\xEDmos em busca do Espoleta, este
      \xE9 o nome do filho do Prefeito. Mas, voc\xEA n\xE3o vai acreditar, todas as
      outras desapareceram tamb\xE9m!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_05
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Precisamos distribuir os cartazes de \"procura-se\", um para cada uma das
      15 penumbras desaparecidas. Voc\xEA pode me ajudar?"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Acho que h\xE1 cartazes demais ai! Foram s\xF3 15 penumbras que desapareceram."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_07
    id: 2
    episode: 1
    emotion: regular
    slug: errorMoreThan
    minigame: 1
  - text: "Ser\xE1 que n\xE3o est\xE3o faltando cartazes? 15 penumbras desapareceram."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_08
    id: 3
    episode: 1
    emotion: regular
    slug: errorLessThan
    minigame: 1
  - text: "Est\xE1 pronto? Deixe-me ajudar."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_09
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: 15 cartazes para 15 penumbras desaparecidas. Espero que ajude!
    world: 2
    season: 1
    sound: ptbr_ep25_clr_10
    id: 5
    episode: 1
    emotion: regular
    slug: victory
    minigame: 1
  - text: Segundo o Prefeito, era aqui que o Espoleta estava logo antes de desaparecer.
    world: 2
    season: 1
    sound: ptbr_ep25_clr_13
    id: 0
    episode: 1
    emotion: sad
    slug: intro
    minigame: 2
  - text: "D\xE1 para ver que ele era bem bagunceiro, hein? Pode me ajudar a arrumar
      tudo nas caixas certas? Deve haver uma pista por aqui."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_14
    id: 1
    episode: 1
    emotion: happy
    slug: intro
    minigame: 2
  - text: "Acho que colocamos alguma coisa fora do lugar... Melhor organizar tudo
      em suas caixas, para ter certeza de que n\xE3o perdemos nenhuma pista!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_15
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Misturamos alguma coisa. Vamos ver se est\xE1 tudo no lugar: bonecos, carros
      e artes."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_16
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Esse garoto tem tanta coisa que at\xE9 eu fico confusa! Vamos dar um jeito
      aqui."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_17
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Pronto! Agora est\xE1 tudo no seu devido lugar? Ei, o que \xE9 essa coisa
      aqui?"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_18
    id: 5
    episode: 1
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Nossa, mas quanta neblina! Eu n\xE3o enxergo nada. Se Espoleta estiver
      se escondendo, ent\xE3o..."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_21
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "O que voc\xEA acha de tirarmos essa neblina daqui com uns ventiladores?"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_22
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vamos coloc\xE1-los lado a lado e ligar nessa tomada. Mas precisamos ligar
      da pot\xEAncia menor para a maior, para n\xE3o queimar fus\xEDveis!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_24
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Os n\xFAmeros no ventilador dizem sua pot\xEAncia. \xC9 s\xF3 seguir a
      sequ\xEAncia, come\xE7ando pelo menor."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_25
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Est\xE1 sentindo um cheiro de queimado? Ai, calma! Vamos olhar de novo.
      Os ventiladores devem ficar em ordem crescente. Assim: 0, 1, 2, 3, 4..."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_26
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: Caramba! Assim quem se assusta sou eu! Vamos tentar mudar a ordem das coisas.
    world: 2
    season: 1
    sound: ptbr_ep25_clr_27
    id: 5
    episode: 1
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Funcionou? Parece que sim! Os ventiladores afastaram toda a neblina e agora
      podemos ver o que h\xE1 no quintal!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_28
    id: 6
    episode: 1
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Pegadas! Pegadas... Enormes! Nossa, que legal! Ser\xE1 que \xE9 um monstro?
      Um drag\xE3o! Eu acho que vi um drag\xE3o por aqui, uma vez..."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_30
    id: 0
    episode: 1
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Calma, calma... Vamos devagar. Primeiro precisamos saber para onde essas
      pegadas levam. Ser\xE1 que podemos continuar o resto das pegadas?"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_31
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o... Acho que as pegadas seguem um padr\xE3o. Desse jeito... Viu?
      Vamos fazer o resto."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_32
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Interessante... Acho que estamos quase l\xE1. S\xF3 precisamos corrigir
      isso aqui."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_33
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Olha s\xF3! Realmente \xE9 uma sequ\xEAncia!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_34
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Conseguimos! As pegadas levam para... Ai, que legal! Eu vou adorar. Bom,
      eu n\xE3o sei se voc\xEA vai adorar..."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_35
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 4
  - text: "As pegadas levam at\xE9 a Floresta Assombrada. \xC9 uma floresta enorme
      de \xE1rvores retorcidas, barulhos estranhos, monstros ferozes... \xC9 t\xE3o
      legal!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_38
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: O Prefeito tem um mapa deste sonho guardado aqui, em algum lugar.
    world: 2
    season: 1
    sound: ptbr_ep25_clr_39
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O mapa est\xE1 em uma caixa dentro de um dos dois arm\xE1rios, \xE0 direita
      da estante."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_40
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acho que n\xE3o \xE9 esta caixa. Procure no arm\xE1rio de cima, \xE0 direita
      da estante. Mas cuidado com a planta carn\xEDvora que est\xE1 ao lado..."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_41
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Voc\xEA leu o que est\xE1 escrito na caixa? Veja se tem \"MAPA\" escrito
      nela."
    world: 2
    season: 1
    sound: ptbr_ep25_clr_42
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Achamos! \xC9 essa aqui... \"MAPA\"!"
    world: 2
    season: 1
    sound: ptbr_ep25_clr_43
    id: 5
    episode: 1
    emotion: happy
    slug: error3
    minigame: 5
  - text: Agora, com o mapa, podemos partir!
    world: 2
    season: 1
    sound: ptbr_ep25_clr_44
    id: 6
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Estamos chegando na Floresta Assombrada! Guardi\xE3o, voc\xEA vai adorar
      esse lugar!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_01
    id: 0
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Voc\xEA n\xE3o vai acreditar em quem mora aqui! Tem drag\xE3o, bicho-pap\xE3o,
      cobra gigante... N\xE3o acredito!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_02
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O P\xE9 Grande! O P\xE9 Grande deve morar aqui! Voc\xEA viu o tamanho daquela
      pegada? S\xF3 pode ter sido ele que levou o Espoleta!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_03
    id: 2
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Mas, e agora... Em que dire\xE7\xE3o devemos seguir?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_04
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Nossa, quanto tempo tem que n\xE3o venho aqui! Adorava vir brincar aqui
      quando eu era pequena..."
    world: 2
    season: 1
    sound: ptbr_ep26_clr_09
    id: 4
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ei... Mas veja se n\xE3o \xE9 o pr\xF3prio P\xE9 Grande em pessoa! Vamos
      falar com ele, Guardi\xE3o!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_10
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Voc\xEA sabia que n\xE3o se pode cortar \xE1rvores de uma \xE1rea de preserva\xE7\xE3o?
      E mesmo assim esses lenhadores malvados vieram aqui!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_19
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Vamos ver o estrago que fizeram ali!
    world: 2
    season: 1
    sound: ptbr_ep26_clr_20
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: O que mais podemos fazer por essa floresta? Vamos olhar ali!
    world: 2
    season: 1
    sound: ptbr_ep26_clr_26
    id: 8
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: E agora? Falta alguma coisa?
    world: 2
    season: 1
    sound: ptbr_ep26_clr_32
    id: 9
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "O P\xE9 Grande est\xE1 chamando! Vamos l\xE1!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_33
    id: 10
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: Pronto! Terminado. Ei! E o filho do Prefeito? Quase me esqueci dele!
    world: 2
    season: 1
    sound: ptbr_ep26_clr_40
    id: 11
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Voc\xEA viu rob\xF4s estranhos na floresta? Ser\xE1 que eles sabem de alguma
      coisa?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_41
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Precisamos ir at\xE9 l\xE1, Guardi\xE3o! O Espoleta pode estar em perigo!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_42
    id: 13
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "No mapa n\xE3o fala nada sobre essa encruzilhada na estrada..."
    world: 2
    season: 1
    sound: ptbr_ep26_clr_05
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Guardi\xE3o, olhe as placas. Veja se h\xE1 alguma dica de qual lado leva
      \xE0 Floresta Assombrada."
    world: 2
    season: 1
    sound: ptbr_ep26_clr_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Diz aqui: \"Usina desativada. \xC1rea em recupera\xE7\xE3o.\" Nossa, ainda
      bem que o Prefeito mandou fechar essa usina para recuperar o local. Ela devia
      estar estragando a Floresta Assombrada!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_07
    id: 2
    episode: 2
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Aqui diz: \"Floresta Assombrada. \xC1rea de preserva\xE7\xE3o.\" Legal!
      \xC9 proibido cortar \xE1rvores aqui, para proteger a floresta e os monstros
      que vivem l\xE1! Vamos?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_08
    id: 3
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Oi, senhor P\xE9 Grande! Por acaso o senhor andou devorando um penumbra
      chamado Espoleta? Ele \xE9 o filho do Prefeito desse sonho, sabe?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_11
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o? Quer dizer que voc\xEA est\xE1 mais ocupado em cuidar da sua floresta
      e afastar os lenhadores malvados que est\xE3o derrubando as mudas de \xE1rvores?
      Podemos ajudar a assust\xE1-los? Podemos? Podemos?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_12
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Claro que ajudamos! Guardi\xE3o, sempre que um desses malvados aparecer,
      assuste-os."
    world: 2
    season: 1
    sound: ptbr_ep26_clr_13
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Se algum deles conseguir cortar uma muda, me ajude a plantar uma nova.
      Pronto para come\xE7ar, Guardi\xE3o?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_14
    id: 3
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Isso foi t\xE3o divertido! Viu como eles fugiram de medo?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_15
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Ent\xE3o voc\xEA protege a floresta, P\xE9 Grande? Veja como no fundo ele
      \xE9 um guardi\xE3o como voc\xEA, Guardi\xE3o!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_16
    id: 5
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Quer dizer que voc\xEA n\xE3o viu o Espoleta? E eu achando que voc\xEA
      tivesse comido ele. Mas essa fama de mal deve ajudar a afastar esses lenhadores
      e ca\xE7adores, n\xE9?"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_17
    id: 6
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Ei, podemos ajudar com mais alguma coisa? A\xED voc\xEA pode contar mais
      sobre como s\xE3o as coisas por aqui!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_18
    id: 7
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Quando cortam muito as \xE1rvores de um lugar, a terra estraga e, com o
      tempo, nada mais cresce ali!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_21
    id: 0
    episode: 2
    emotion: sad
    slug: intro
    minigame: 3
  - text: "\xC9 por isso que o P\xE9 Grande est\xE1 afastando esses lenhadores! \xC9
      ainda mais legal assustar gente malvada!"
    world: 2
    season: 1
    sound: ptbr_ep26_clr_22
    id: 1
    episode: 2
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Vamos ajudar a plantar algumas mudas novas? \xC9 s\xF3 colocar cada uma
      em um dos buracos no ch\xE3o."
    world: 2
    season: 1
    sound: ptbr_ep26_clr_23
