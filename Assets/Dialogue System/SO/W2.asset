    world: 2
    season: 1
    sound: ptbr_ep27_clr_20
    id: 8
    episode: 3
    emotion: regular
    slug: solve2
    minigame: 2
  - text: "Agora o \xFAltimo material para a fantasia... 12 peda\xE7os de papel\xE3o!
