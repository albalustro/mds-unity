%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G1W1
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "O qu\xEA!? Quem \xE9 voc\xEA?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0a_1
    id: 0
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Um Guardi\xE3o! Que bom! Finalmente algu\xE9m que pode resolver essa confus\xE3o!
      Com a minha ajuda, \xE9 claro..."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0a_2
    id: 1
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Roubaram a Grande Bola de L\xE3! Viu? E agora?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0b_1
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O qu\xEA? O que \xE9 a Grande Bola de L\xE3? Ora, \xE9 uma bola... de l\xE3...
      S\xF3 que grande! Enorme! Ela \xE9 a bateria que faz tudo nesse sonho se mover
      e, sem ela... nada funciona!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0b_2
    id: 3
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei! Onde est\xE1 o maquinista? Isso \xE9 hora de procurar tampas de caneta
      perdidas? E agora?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0c
    id: 4
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Precisamos abrir a cancela em frente ao trem, ou n\xE3o conseguiremos seguir
      viagem!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0d
    id: 5
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "S\xF3 precisamos ligar o trem e... Onde est\xE3o os trilhos!?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0e
    id: 6
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ai, n\xE3o... Algu\xE9m deve ter aproveitado que o trem estava desligado
      para pegar os palitos que formam o trilho! Olha s\xF3!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0f
    id: 7
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Sabe aquelas baterias de fiapos que fizemos? Ent\xE3o, precisamos coloc\xE1-las
      no trem."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0g_1
    id: 8
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Assim, sempre que o trem passar por uma esta\xE7\xE3o, os fiapos bater\xE3o
      no gerador da vila e pronto! Teremos energia em todo o sonho!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0g_2
    id: 9
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "O trem j\xE1 est\xE1 funcionando, vamos em frente?!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_0h
    id: 10
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "N\xF3s Colecionadores adoramos... colecionar coisas! P\xE9s de meia, bot\xF5es,
      carteiras, \xF3culos, telefones... Qual \xE9 o problema? Se os outros deixam
      uma bagun\xE7a, o m\xEDnimo que podemos fazer \xE9 guardar tudo conosco, n\xE3o?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1a_1
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Pedi para todos os Colecionadores do Sonho das Coisas Perdidas trazerem
      suas pr\xF3prias bolas de l\xE3 para c\xE1. Se juntarmos tudo, podemos fazer
      baterias novas. Mas... est\xE1 uma bagun\xE7a! Olha s\xF3!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1a_2
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Voc\xEA pode me ajudar? Separe e organize os novelos de l\xE3 nessas caixas.
      Depois que voc\xEA fizer isso, \xE9 s\xF3 ligar a m\xE1quina!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1a_3
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Funcionou! Cada caixa ficou com um tipo diferente de novelo. \xC9 por isso
      que voc\xEA \xE9 um Guardi\xE3o dos sonhos!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1b_1
    id: 3
    episode: 1
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Vamos levar essas baterias at\xE9 o maquinista do trem. \xC9 esse trem
      que leva energia para todo o sonho."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1b_2
    id: 4
    episode: 1
    emotion: regular
    slug: victory
    minigame: 1
  - text: "De que maneira voc\xEA tentou separar os novelos entre as caixas?"
    world: 1
    season: 1
    sound: ptbr_ep7_bbt_2Z
    id: 5
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Que estranho... Ser\xE1 que separar uma cor em cada caixa funciona?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1d
    id: 6
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Espere um momento... Voc\xEA me deu uma ideia."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1f
    id: 7
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Pode ligar a m\xE1quina? N\xE3o que eu seja medroso, claro..."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_1g
    id: 8
    episode: 1
    emotion: regular
    slug: hint
    minigame: 1
  - text: "Agora... como abrimos essa coisa? Quantos n\xFAmeros e luzes... O que dever\xEDamos
      fazer aqui? Voc\xEA pode me ajudar?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Conseguimos! Muito bom, Guardi\xE3o! A senha era uma sequ\xEAncia de n\xFAmeros
      crescente! Agora \xE9 s\xF3 colocar o trem para funcionar e distribuir energia
      para todo o sonho!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2b
    id: 1
    episode: 1
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Nossa, que loucura! Acho que n\xE3o era bem isso."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2c
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Acho que isso \xE9 uma senha. E agora j\xE1 sabemos alguns dos n\xFAmeros!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2d
    id: 3
    episode: 1
    emotion: regular
    slug: hint1
    minigame: 2
  - text: "Ainda n\xE3o era isso n\xE3o..."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2e
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Olhe os n\xFAmeros que apareceram! Zero, um, dois, tr\xEAs, quatro, cinco...
      Ser\xE1 que \xE9 algum tipo de sequ\xEAncia?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2f
    id: 5
    episode: 1
    emotion: regular
    slug: hint2
    minigame: 2
  - text: "Tamb\xE9m n\xE3o era aquele... E se n\xF3s mud\xE1ssemos esses aqui assim..."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2g
    id: 6
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Pode apertar o bot\xE3o para mim? Para dar boa sorte!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_2h
    id: 7
    episode: 1
    emotion: regular
    slug: hint3
    minigame: 2
  - text: "Eu espero que nenhum Colecionador tenha pego palito algum, ou n\xE3o teremos
      o suficiente! Bom, acho que isso \xE9 um trabalho para um Guardi\xE3o dos Sonhos."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_3a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 que... Funcionou! O trilho est\xE1 completo novamente... e ainda
      sobraram palitos, veja s\xF3!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_3b_1
    id: 1
    episode: 1
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Agora sim, vamos colocar as baterias no Gerador de Fiapos El\xE9tricos
      e seguir em frente!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_3b_2
    id: 2
    episode: 1
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Ser\xE1 que.. opa.. Acho que esquecemos de alguma coisa..."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_3c
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ser\xE1 que se colocar estes palitos aqui e ali..."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_3d
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Pode me ajudar puxando esta alavanca, Guardi\xE3o? Eu espero aqui atr\xE1s,
      onde \xE9 seguro."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_3e
    id: 5
    episode: 1
    emotion: regular
    slug: hint
    minigame: 3
  - text: "Agora, como ser\xE1 que devemos colocar essas baterias?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4a
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Funcionou? Funcionou! Tenho certeza que meu apoio ajudou a resolver o problema!
      ... N\xE3o \xE9?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4b
    id: 1
    episode: 1
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Nossa! Acho que n\xE3o \xE9 desse jeito... E se voc\xEA trocar uma bateria
      azul por uma vermelha? Ou o contr\xE1rio? Ou os dois!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4c
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Acho que essas duas est\xE3o certas. Ser\xE1 que ajuda?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4e
    id: 3
    episode: 1
    emotion: regular
    slug: hint1
    minigame: 4
  - text: "N\xE3o funcionou... Posso tentar?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4d
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Acho que essas duas est\xE3o certas. Ser\xE1 que ajuda?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4e
    id: 5
    episode: 1
    emotion: regular
    slug: hint2
    minigame: 4
  - text: Que estranho. Talvez se trocar essas aqui de lugar...
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4f
    id: 6
    episode: 1
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Vamos ver agora. Pode girar a chave para mim? Prefiro n\xE3o sujar as m\xE3os..."
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_4g
    id: 7
    episode: 1
    emotion: regular
    slug: hint3
    minigame: 4
  - text: "H\xE1 quanto tempo n\xE3o pego esse trem... Guardi\xE3o? Cad\xEA voc\xEA?"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_5a
    id: 0
    episode: 1
    emotion: regular
    slug: intro1
    minigame: 5
  - text: "De onde voc\xEA saiu?! N\xE3o... voc\xEA n\xE3o me assustou. Eu sou um
      bar\xE3o, um soldado destemido! Jamais seria assustado t\xE3o facilmente, l\xF3gico!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_5b_1
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Voc\xEA pode vir comigo? O trem nos levar\xE1 por todo o sonho das Coisas
      Perdidas, ent\xE3o poderemos ter certeza de que o roubo da Grande Bola de L\xE3
      n\xE3o causou outros problemas!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_5b_2
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos nos sentar do lado direito do trem? De l\xE1 vamos ter uma \xF3tima
      vista! E n\xE3o se esque\xE7a de tocar o sino assim que estiver pronto!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_5b_3_var2
    id: 3
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "\xD3tima escolha! Agora aperte o cinto! Algo me diz que essa aventura est\xE1
      apenas come\xE7ando!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_5b1
    id: 4
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Voc\xEA prefere sentar na esquerda do trem? Tudo bem! Mas eu prefiro a
      direita! Gosto da vista!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_5c_1
    id: 5
    episode: 1
    emotion: regular
    slug: error
    minigame: 5
  - text: "Agora aperte o cinto! Algo me diz que essa aventura est\xE1 apenas come\xE7ando!"
    world: 1
    season: 1
    sound: ptbr_ep01_bbt_5c_2
    id: 6
    episode: 1
    emotion: regular
    slug: error
    minigame: 5
  - text: "Chegamos! \xC9 aqui que a Grande Bola de L\xE3 ficava."
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0a
    id: 0
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Talvez consigamos encontrar pistas sobre quem a roubou daqui! Vamos l\xE1?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0b
    id: 1
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Pelos meus bot\xF5es! Olha quanto desperd\xEDcio de energia!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0c
    id: 2
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Se os Colecionadores continuarem a gastar energia desse jeito, nem dez
      Grandes Bolas de L\xE3 conseguir\xE3o manter o Sonho funcionando!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0d
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos at\xE9 o Gerador de Energia, onde ficava a Grande Bola de L\xE3.
      Tenho certeza que encontraremos pistas \xFAteis por l\xE1."
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0e
    id: 4
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "S\xF3 espero que o Boldo esteja de bom humor... Da \xFAltima vez ele me
      arranhou todinho!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0f
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Talvez Boldo tenha visto algo! Ele sempre fica aqui, protegendo a Grande
      Bola de L\xE3. Obviamente n\xE3o fez um trabalho muito bom, n\xE3o \xE9?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0f_a
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Voc\xEA... pode ir at\xE9 l\xE1 falar com ele? Sabe como \xE9, gatos gostam
      de brincar com trapos e fiapos... Prefiro continuar inteiro, por enquanto!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0g
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Como assim?! Gato pregui\xE7oso! O que voc\xEA quer agora?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0h
    id: 8
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Muito bem! Agora n\xE3o tem mais nada que esse gato possa... Ele est\xE1
      dormindo de novo!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0i
    id: 9
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "O que \xE9 isso? Uma carta? Mas o que vamos fazer com isso?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0j
    id: 10
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Todos a bordo! O trem nos levar\xE1 at\xE9 a entrada do templo onde vive
      Aquele Que Tudo Coleciona! Ser\xE1 uma viagem bem tranquila!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0l
    id: 11
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Ent\xE3o, por que ser\xE1 que eu n\xE3o consigo parar de tremer?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_0m
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Est\xE1 vendo o que eles est\xE3o fazendo? Entram numa casa aqui, acendem
      a luz e v\xE3o embora! Absurdo!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_1a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ser\xE1 que voc\xEA pode ficar de olho e apagar as luzes sempre que um
      Colecionador sair e as deixar acesas? Eles precisam aprender a economizar energia!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_1b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Vamos come\xE7ar?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_1c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: Mas que coisa!
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_1d
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Espero que eles aprendam a economizar energia! Se n\xE3o fizerem isso,
      como acham que o Mundo vai continuar funcionando?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_1e
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Mas que bagun\xE7a! Pode me dar uma m\xE3o organizando cada coisa em seu
      lugar? Afinal, \xE9 importante manter sempre tudo organizado!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_2a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Coloque cada uma destas coisas junto com aquelas que j\xE1 est\xE3o em
      seu lugar. Pronto para me ajudar com isso?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_2b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Quem fez essa bagun\xE7a toda? N\xE3o sabe que manter tudo limpo e arrumado
      \xE9 bom para a sa\xFAde e para o funcionamento do Mundo?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_2c
    id: 2
    episode: 2
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Ora, mas esse bichano pregui\xE7oso nem abre o olho!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_3a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que devemos ajudar a recolher esse lixo... Voc\xEA ajuda? Ajuda! Mas,
      cuidado, porque nem tudo aqui \xE9 lixo!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_3b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "O bal\xE3o-coletor-de-lixo passa apenas 3 vezes por aqui. Por isso, leve
      somente o lixo at\xE9 ele e... m\xE3os \xE0 obra, Guardi\xE3o!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_3c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Recolher sempre o lixo do Mundo \xE9 muito importante! Ainda bem que voc\xEA
      foi cuidadoso e n\xE3o deixou que levassem os animais de estima\xE7\xE3o!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_3d
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Claro... juntar o lixo n\xE3o \xE9 suficiente! Precisamos separar o lixo!
      Tenho certeza de que ainda h\xE1 algumas coisas \xFAteis nesse lixo..."
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_4a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Sim, sim! A miss\xE3o, claro! Voc\xEA pode separar esse lixo por cor? Enquanto
      isso eu vou ver se encontro algum bot\xE3o bonito para a minha cole\xE7\xE3o...
      Eu espero que voc\xEA n\xE3o se importe..."
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_4b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Pronto para come\xE7ar a separar?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_4c
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Nenhum bot\xE3o. Mas tudo bem... O importante \xE9 sempre separar o lixo.
      Muitas coisas podem ser reutilizadas ou recicladas depois que algu\xE9m as joga
      fora e a separa\xE7\xE3o facilita este trabalho."
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_4d
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Sim! \xC9 uma carta de recomenda\xE7\xE3o para Aquele Que Tudo Coleciona,
      o mais s\xE1bio dos s\xE1bios!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_5a
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Certamente ele poder\xE1 nos ajudar. Mas, primeiro, precisamos enviar essa
      carta. Voc\xEA pode fazer isso?"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_5b
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Voc\xEA precisa ir ao banco sacar dinheiro? N\xE3o se preocupe! Eu pago
      o envio da carta."
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_5c
    id: 2
    episode: 2
    emotion: regular
    slug: banco
    minigame: 5
  - text: "Isso s\xE3o horas de fazer compras? Deixe que eu levo a carta at\xE9 a
      ag\xEAncia dos Correios."
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_5d
    id: 3
    episode: 2
    emotion: regular
    slug: supermercado
    minigame: 5
  - text: "Pronto! Carta enviada! Agora Aquele Que Tudo Coleciona j\xE1 sabe que estamos
      a caminho!"
    world: 1
    season: 1
    sound: ptbr_ep2_bbt_5e
    id: 4
    episode: 2
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Aqui \xE9 o mais perto que o trem pode nos levar. O resto do caminho pode
      ser perigoso!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0a
    id: 0
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos? Voc\xEA primeiro!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0b
    id: 1
    episode: 3
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Aquele Que Tudo Coleciona \xE9 um Colecionador estranho. Ele diz que coleciona
      a mais valiosa das coisas: conhecimento! Sou mais meus bot\xF5es!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0c
    id: 2
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Vamos l\xE1. Tenho certeza de que \xE9 nessa dire\xE7\xE3o!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0d
    id: 3
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Esse rio parece meio... perigoso... Bom, mas eu... digo, n\xF3s fizemos
      4 pontes! Ent\xE3o isso n\xE3o ser\xE1 um problema, certo?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0e
    id: 4
    episode: 3
    emotion: scared
    slug: minigame2
    minigame: 
  - text: Vamos resolver isso e seguir em frente?
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0f
    id: 5
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Estamos quase l\xE1... Eu acho... Ora, mas claro que eu n\xE3o estou perdido!
      Tenho certeza de que..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0g
    id: 6
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: Talvez eu esteja um pouquinho perdido... Para onde temos de ir agora?
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0h
    id: 7
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Devemos estar quase l\xE1, que bom! Vamos em frente?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0i
    id: 8
    episode: 3
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Pode ficar na minha frente? Por via das d\xFAvidas, claro! N\xE3o que eu
      tenha medo..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0j
    id: 9
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ora, mas de onde saiu esse rio? Acho que vamos precisar atravess\xE1-lo..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "J\xE1 contei que constru\xED a poderosa Primeira Ponte Pendente do Prata?
      Como assim nunca ouviu falar? Ora... vamos l\xE1, me ajude aqui."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Muito bem, primeiro preciso de 3 l\xE1pis. Pode coloc\xE1-los ali para
      mim? Quando tiver terminado, balance a ferramenta!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1c
    id: 2
    episode: 3
    emotion: regular
    slug: request_lapis
    minigame: 1
  - text: "Mas... isso n\xE3o s\xE3o l\xE1pis! Est\xE1 querendo me confundir, \xE9?
      Preciso de 3 l\xE1pis, ora essa!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1b_2
    id: 3
    episode: 3
    emotion: regular
    slug: lapis_mismatch
    minigame: 1
  - text: "N\xE3o acho que isso seja o suficiente! Precisarei de 3 l\xE1pis para fazer
      essa ponte!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1c_2
    id: 4
    episode: 3
    emotion: regular
    slug: lapis_less
    minigame: 1
  - text: "1, 2, 3... Calma l\xE1! Voc\xEA me deu l\xE1pis demais! S\xF3 preciso de
      3!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1d
    id: 5
    episode: 3
    emotion: regular
    slug: lapis_over
    minigame: 1
  - text: "Muito bem! 3 l\xE1pis. Isso me lembra a Grande Batalha do Rio Tibum. Bons
      tempos aqueles..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1e
    id: 6
    episode: 3
    emotion: regular
    slug: lapis_success
    minigame: 1
  - text: "Certo, agora preciso de 4 chicletes mastigados. S\xE3o melhor do que cola!
      Quando os tiver separado, me avise."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1f
    id: 7
    episode: 3
    emotion: regular
    slug: request_chiclete
    minigame: 1
  - text: "Eu pedi isso?! Devo estar ficando louco! Preciso \xE9 de 4 chicletes mastigados!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1g
    id: 8
    episode: 3
    emotion: happy
    slug: chiclete_mismatch
    minigame: 1
  - text: "Voc\xEA andou mascando o meu chiclete mastigado? Eu preciso de 4!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1h
    id: 9
    episode: 3
    emotion: regular
    slug: chiclete_less
    minigame: 1
  - text: "Espere a\xED! Voc\xEA me deu chicletes a mais! Tudo bem! Quem sabe depois
      eu n\xE3o pego para mim..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1i
    id: 10
    episode: 3
    emotion: regular
    slug: chiclete_over
    minigame: 1
  - text: "Certo, 4 chicletes mastigados! J\xE1 contei da vez em que eu derrotei sozinho
      o Rei Gigante da Floresta s\xF3 com um chiclete? Foi sim!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1j
    id: 11
    episode: 3
    emotion: regular
    slug: chiclete_success
    minigame: 1
  - text: "Vejamos agora... Sim! 5 pregadores de roupas! Pode coloc\xE1-los ali para
      mim? Quando estiver tudo certo, me avise!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1l
    id: 12
    episode: 3
    emotion: regular
    slug: request_pregadores
    minigame: 1
  - text: "Voc\xEA gosta de brincadeiras, hein? Deixe que eu pego os 5 pregadores
      de roupas."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1m
    id: 13
    episode: 3
    emotion: regular
    slug: pregadores_mismatch
    minigame: 1
  - text: "N\xE3o acho que isso seja o suficiente. Por isso pedi 5 pregadores de roupas.
      Tudo bem, eu pego o que faltou!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1n
    id: 14
    episode: 3
    emotion: regular
    slug: pregadores_less
    minigame: 1
  - text: "Voc\xEA me deu 6 pregadores, e n\xE3o 5! Bom, talvez eu possa guardar esse
      aqui, caso um de n\xF3s caia no rio, n\xE3o \xE9?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1p
    id: 15
    episode: 3
    emotion: regular
    slug: pregadores_over
    minigame: 1
  - text: "Eu consegui? Eu consegui! Bem. Bem, n\xF3s! N\xF3s conseguimos, n\xE3o
      \xE9 mesmo? Afinal formamos uma dupla e tanto!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1o
    id: 16
    episode: 3
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Perfeito! Agora temos algumas pontes e podemos escolher qual \xE9 a melhor
      para atravessarmos o rio!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1q
    id: 17
    episode: 3
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Qual dessas pontes \xE9 do tamanho certo para atravessar o rio? Voc\xEA
      parece forte!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Por que n\xE3o vai at\xE9 l\xE1 e coloca a ponte do tamanho certo no lugar?
      Eu fico aqui atr\xE1s, onde \xE9 seguro, dando apoio moral."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2b
    id: 1
    episode: 3
    emotion: happy
    slug: intro
    minigame: 2
  - text: "Quanto estiver pronto, puxe aquele sino do outro lado do rio. \xC9 que
      talvez eu aproveite para tirar um cochilo... Que bom!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2c
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Qu\xEA? O que foi isso!? L\xE1 vai a ponte... Acho que ela era pequena
      demais..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2d
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 2
  - text: Que pena... Era uma boa ponte...
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2e
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Pense no lado positivo! Agora n\xF3s temos certeza de qual ponte \xE9 a
      certa! Pode tocar o sino para mim?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2f
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 2
  - text: Agora podemos seguir caminho. Posso sentir o cheiro d'Aquele Que Tudo Coleciona
      daqui!
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2h
    id: 6
    episode: 3
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Ou talvez seja aquele sandu\xEDche de atum que encontrei ali atr\xE1s..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_2i
    id: 7
    episode: 3
    emotion: regular
    slug: victory
    minigame: 2
  - text: De onde saiu essa placa?
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Bem, quero dizer, claro que ela estava a\xED! Eu s\xF3 fingi que n\xE3o
      a vi para que... voc\xEA pudesse encontr\xE1-la. Voc\xEA \xE9 o her\xF3i por
      aqui, n\xE3o \xE9?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Mas... misturaram letras e n\xFAmeros! Assim n\xE3o consigo entender nada!
      Pode riscar esses n\xFAmeros para mim?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3c
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Eu n\xE3o estou entendendo nada! Ser\xE1 que \xE9 uma mensagem secreta?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3d
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Tem alguma coisa esquisita nessa frase, n\xE3o? E se tirarmos os n\xFAmeros,
      como este?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3e
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Ora, agora eu tenho certeza! Basta tirar todos os n\xFAmeros e deixar apenas
      as letras!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3f
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: Agora podemos ler a mensagem! Que legal!
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3g
    id: 6
    episode: 3
    emotion: regular
    slug: victory
    minigame: 3
  - text: '"Templo do Conhecimento"! Estamos no caminho certo!'
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_3h
    id: 7
    episode: 3
    emotion: regular
    slug: finish
    minigame: 3
  - text: "Eu conhe\xE7o este colecionador. \xC9 o aventureiro Banana Jones! Mas que
      parafern\xE1lia \xE9 essa? \xC9 um tipo de porta?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Seja o que for, parece trancada... E, segundo o nosso amigo, estas pe\xE7as
      coloridas t\xEAm algo a ver com a tranca."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4b
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ele diz que devemos seguir o manual dessa coisa, que est\xE1 preso na parede.
      Se eu ler as instru\xE7\xF5es, voc\xEA tenta abri-la?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4c
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Vamos l\xE1! Come\xE7amos com um tri\xE2ngulo verde. Coloque-o na porta
      e puxe a alavanca para testar."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4d
    id: 3
    episode: 3
    emotion: regular
    slug: hint_0
    minigame: 4
  - text: "Acho que essa n\xE3o era um tri\xE2ngulo verde... Tente outra pe\xE7a."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4e
    id: 4
    episode: 3
    emotion: regular
    slug: hint_0_error_0
    minigame: 4
  - text: "N\xE3o deu... Precisa ser um tri\xE2ngulo verde. Posso tentar?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4f
    id: 5
    episode: 3
    emotion: regular
    slug: hint_0_error_1
    minigame: 4
  - text: "Muito bem! Agora \xE9 um ret\xE2ngulo rosa. Tem algum por a\xED?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4g
    id: 6
    episode: 3
    emotion: regular
    slug: hint_1
    minigame: 4
  - text: "Melhor olhar de novo! N\xE3o tem nenhum ret\xE2ngulo rosa por a\xED?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4h
    id: 7
    episode: 3
    emotion: regular
    slug: hint_1_error_0
    minigame: 4
  - text: Caramba! Deixe-me ver...
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4i
    id: 8
    episode: 3
    emotion: regular
    slug: hint_1_error_1
    minigame: 4
  - text: "\xD3timo! A pr\xF3xima pe\xE7a parece um tri\xE2ngulo violeta."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4j
    id: 9
    episode: 3
    emotion: regular
    slug: hint_2
    minigame: 4
  - text: "\xC9... Essa pe\xE7a n\xE3o serve... Encontrou um tri\xE2ngulo violeta?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4l
    id: 10
    episode: 3
    emotion: regular
    slug: hint_2_error_0
    minigame: 4
  - text: "Mas, o qu\xEA? Ora, essa..."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4m
    id: 11
    episode: 3
    emotion: regular
    slug: hint_2_error_1
    minigame: 4
  - text: "Certo! Agora precisamos de um c\xEDrculo verde. O que me diz?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4n
    id: 12
    episode: 3
    emotion: regular
    slug: hint_3
    minigame: 4
  - text: "Ser\xE1 que eu vi errado? N\xE3o, aqui est\xE1. Um c\xEDrculo verde."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_40
    id: 13
    episode: 3
    emotion: regular
    slug: hint_3_error_0
    minigame: 4
  - text: Que coisa! Vamos tentar esta aqui...
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4p
    id: 14
    episode: 3
    emotion: regular
    slug: hint_3_error_1
    minigame: 4
  - text: "S\xF3 falta uma agora. Um quadrado laranja!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4q
    id: 15
    episode: 3
    emotion: regular
    slug: hint_4
    minigame: 4
  - text: "Mas era s\xF3 o que me faltava essa pe\xE7a n\xE3o encaixar... Tente um
      quadrado laranja!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4r
    id: 16
    episode: 3
    emotion: regular
    slug: hint_4_error_0
    minigame: 4
  - text: "Deixe-me tentar. Voc\xEA puxa a alavanca!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4s
    id: 17
    episode: 3
    emotion: regular
    slug: hint_4_error_1
    minigame: 4
  - text: "Funciona! Olha, essa coisa est\xE1 se abrindo!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_4t
    id: 18
    episode: 3
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Que barulho \xE9 esse?! Parecem monstros voadores gigantes!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5a
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "S\xE3o p\xE1ssaros! O que ser\xE1 que est\xE3o carregando? Ser\xE1 que
      voc\xEA consegue peg\xE1-los?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5b
    id: 1
    episode: 3
    emotion: regular
    slug: showDuck
    minigame: 5
  - text: "Olhe! 5 chaves! Ser\xE1 que h\xE1 mais delas com esses p\xE1ssaros?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5c
    id: 2
    episode: 3
    emotion: regular
    slug: key1
    minigame: 5
  - text: "Oba! Mais 5 chaves! Vamos guard\xE1-las na caixa."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5d
    id: 3
    episode: 3
    emotion: regular
    slug: key2
    minigame: 5
  - text: "Mas que barulhos estranhos! N\xE3o gosto de barulhos estranhos!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5e
    id: 4
    episode: 3
    emotion: regular
    slug: fade_grass
    minigame: 5
  - text: "Olha s\xF3! Tr\xEAs portas, cada uma com um n\xFAmero! Ser\xE1 que o n\xFAmero
      tem algo a ver com as chaves que voc\xEA juntou?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5f
    id: 5
    episode: 3
    emotion: regular
    slug: fade_grass
    minigame: 5
  - text: "Agora, qual porta abrir? O n\xFAmero na porta deve indicar quantas chaves
      conseguimos pegar."
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5i
    id: 6
    episode: 3
    emotion: regular
    slug: fade_grass
    minigame: 5
  - text: "Fecha, r\xE1pido!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5j
    id: 7
    episode: 3
    emotion: scared
    slug: monster1
    minigame: 5
  - text: "Esquece essa porta, t\xE1 bom? Voc\xEA s\xF3 usou 8 chaves nela!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5l
    id: 8
    episode: 3
    emotion: regular
    slug: monster2
    minigame: 5
  - text: Desculpe! Foi engano!
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5m
    id: 9
    episode: 3
    emotion: scared
    slug: shower1
    minigame: 5
  - text: "Voc\xEA usou 12 chaves nessa porta... Tinha 2 a mais sobrando, \xE9?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_5n
    id: 10
    episode: 3
    emotion: regular
    slug: shower2
    minigame: 5
  - text: "Esta \xE9 a porta certa! Ela se abriu com as 10 chaves que voc\xEA pegou
      dos p\xE1ssaros!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_1c2
    id: 11
    episode: 3
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Essa \xE9 a entrada do templo! Voc\xEA primeiro, porque eu sou muito educado!"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0a2
    id: 12
    episode: 3
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Nossa, mas como \xE9 escuro nesse lugar! Posso segurar sua m\xE3o, se voc\xEA
      quiser... Para voc\xEA n\xE3o sentir medo... Por favor?"
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0b2
    id: 0
    episode: 4
    emotion: sad
    slug: minigame1
    minigame: 
  - text: Essa deve ser a caverna onde Aquele Que Tudo Coleciona mora. Imagine que
      coisas maravilhosas ele deve guardar aqui!
    world: 1
    season: 1
    sound: ptbr_ep3_bbt_0c3
    id: 1
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Aquele Que Tudo Coleciona fala apenas com os mais destemidos e inteligentes
      que superam seus 4 desafios da sabedoria! Ainda bem que eu estou aqui para ajudar!
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_0d
    id: 2
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Preparado para a Caverna dos Desafios? Eu n\xE3o..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1a
    id: 3
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eu sabia! Al\xE7ap\xF5es sempre levam para lugares escuros..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_0e
    id: 4
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: O segundo desafio deve estar bem ali embaixo, nessa caverna sombria...
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_0f
    id: 5
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Espero que n\xE3o precisemos passar por mais nenhum lugar escuro."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_0g
    id: 6
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "S\xF3 h\xE1 uma coisa que eu odeio mais do que escuro: espinhos!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_0h
    id: 7
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Lugares escuros, espinhos. S\xF3 tem uma coisa pior! Doces!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_0i
    id: 8
    episode: 4
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Esse lugar parece t\xE3o... vazio. Esperava mais do lugar onde mora Aquele
      Que Tudo Coleciona..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_0j
    id: 9
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Um al\xE7ap\xE3o! Eu odeio al\xE7ap\xF5es... Sempre levam a lugares escuros..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1b
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Deve ser o primeiro desafio, claro! M\xE3os \xE0 obra!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1c
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Essas bolas s\xE3o a senha que abre o al\xE7ap\xE3o. Tente descobrir a
      senha e, ent\xE3o, puxe a alavanca para ver o que acontece!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1d
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Que curioso! Parece que \xE9 uma sequ\xEAncia de algum tipo, n\xE3o? Deixe-me
      ajudar..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1e
    id: 3
    episode: 4
    emotion: regular
    slug: error_1
    minigame: 1
  - text: "Ainda n\xE3o foi... Mas essas aqui parecem certas: 15, 14, 13, 12... Vamos
      continuar?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1f
    id: 4
    episode: 4
    emotion: regular
    slug: error_2
    minigame: 1
  - text: "Acho que voc\xEA me deu uma ideia... Vejamos. Pode puxar a alavanca agora?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1g
    id: 5
    episode: 4
    emotion: regular
    slug: hint
    minigame: 1
  - text: "Abriu! Voc\xEA \xE9 um g\xEAnio! \xC9 por isso que \xE9 um Guardi\xE3o!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_1h
    id: 6
    episode: 4
    emotion: regular
    slug: victory
    minigame: 1
  - text: "O que \xE9 isso?! S\xE3o... S\xE3o monstros! Monstros enormes com olhos
      que brilham e..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_2a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ora, mas... n\xE3o s\xE3o olhos! S\xE3o... s\xE3o vaga-lumes!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_2b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Mas \xE9 claro que eu sabia que eram vaga-lumes! Estava apenas testando
      se voc\xEA estava alerta!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_2c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "O segundo desafio! Est\xE1 vendo aquele jarro ali? Precisamos ench\xEA-lo
      de vaga-lumes. Certamente 10 vaga-lumes ser\xE3o suficientes!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_2d
    id: 3
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o sei... Estes vaga-lumes n\xE3o s\xE3o suficientes! Precisamos de
      10 deles para iluminar a caverna!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_2e
    id: 4
    episode: 4
    emotion: regular
    slug: error_1
    minigame: 2
  - text: "Nossa! H\xE1 tantos vaga-lumes aqui!"
    world: 1
    season: 1
    sound: ptbr_ep04_bbt_2f_fixed
    id: 5
    episode: 4
    emotion: regular
    slug: error_2
    minigame: 2
  - text: "Ora, olha s\xF3! 1, agora mais 3, s\xE3o 4. Agora mais 3, s\xE3o 7... e
      os \xFAltimos 3! Fechamos com 10! Exatamente a quantidade de que precisamos!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_2g
    id: 6
    episode: 4
    emotion: regular
    slug: hint
    minigame: 2
  - text: Agora que temos os 10 vaga-lumes, vamos embora daqui? Eu odeio lugares escuros!
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_2h
    id: 7
    episode: 4
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Voc\xEA s\xF3 pode estar brincando comigo!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_3a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Deve ser o terceiro desafio. Qual ser\xE1 a charada aqui?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_3b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que voc\xEA precisa fazer alguma coisa com essas flores. Vamos tentar
      separ\xE1-las pelas folhas?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_3c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Mais espinhos! Deve haver uma pista aqui. Acho que cada folha merece uma
      cole\xE7\xE3o de flores, n\xE3o?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_3d
    id: 3
    episode: 4
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Ainda n\xE3o... Acho que a solu\xE7\xE3o \xE9 distribuir flores de forma
      igual entre as folhas. Vamos tentar?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_3e
    id: 4
    episode: 4
    emotion: regular
    slug: error2
    minigame: 3
  - text: "\xC9 isso! Vamos antes que esses espinhos resolvam voltar!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_3f
    id: 5
    episode: 4
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Pera\xED! N\xE3o, eu gosto de doces! S\xE3o t\xE3o coloridos e deliciosos..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ser\xE1 que o desafio \xE9 comer doces? Se for, posso fazer sozinho? N\xE3o?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Aposto que esses doces flutuam sobre o buraco para formar uma ponte! Mas
      ser\xE1 que eles aguentam o nosso peso?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: Cada doce tem uma letra... Vamos tentar um de cada vez... Primeiro o "D".
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4d
    id: 3
    episode: 4
    emotion: regular
    slug: step_1
    minigame: 4
  - text: "Muito bem! Agora \xE9 o doce com a letra \"O\"."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4g
    id: 4
    episode: 4
    emotion: regular
    slug: step_2
    minigame: 4
  - text: "Isso! Agora com calma... \xE9 o doce com a letra \"C\"."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4j
    id: 5
    episode: 4
    emotion: regular
    slug: step_3
    minigame: 4
  - text: "Agora \xE9 o \xFAltimo doce! \xC9 aquele com a letra \"E\"."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4m
    id: 6
    episode: 4
    emotion: regular
    slug: step_4
    minigame: 4
  - text: "Essa foi por pouco! E se voc\xEA tentar esse doce aqui... Pode tocar o
      sino?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4f
    id: 7
    episode: 4
    emotion: regular
    slug: hint
    minigame: 4
  - text: "Conseguimos! Agora \xE9 s\xF3 atravessar! Estou ansioso para encontrar
      Aquele Que Tudo Coleciona!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4j2
    id: 8
    episode: 4
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Opa! N\xE3o \xE9 esse. Precisamos primeiro do 'D' de doce."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4e
    id: 9
    episode: 4
    emotion: regular
    slug: error_1_1
    minigame: 4
  - text: "Essa foi por pouco! E se voc\xEA tentar esse doce aqui? Pode tocar o sino?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4f
    id: 10
    episode: 4
    emotion: regular
    slug: error_1_2
    minigame: 4
  - text: "N\xE3o, \xE9 a letra que a gente usa para escrever as palavras ovo, \xF3culos..."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4h
    id: 11
    episode: 4
    emotion: regular
    slug: error_2_1
    minigame: 4
  - text: Esse aqui. Quando estiver pronto, toque o sino!
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4i
    id: 12
    episode: 4
    emotion: regular
    slug: error_2_2
    minigame: 4
  - text: "Acho que n\xE3o \xE9 esse. \xC9 aquele letra que a gente usa na palavra
      cebola... Falando em cebola j\xE1 fico com \xE1gua na boca... E nos olhos tamb\xE9m!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4k
    id: 13
    episode: 4
    emotion: regular
    slug: error_3_1
    minigame: 4
  - text: Esta aqui!
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4l
    id: 14
    episode: 4
    emotion: regular
    slug: error_3_2
    minigame: 4
  - text: "N\xE3o \xE9 este. \xC9 a letra que a gente usa para escrever \xE9gua ou
      elefante."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4n
    id: 15
    episode: 4
    emotion: regular
    slug: error_4_1
    minigame: 4
  - text: Esta letra aqui!
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_4o
    id: 16
    episode: 4
    emotion: regular
    slug: error_4_2
    minigame: 4
  - text: "Olhe! \xC9 Aquele Que Tudo Coleciona! Que honra! Onde est\xE1 sua maravilhosa
      cole\xE7\xE3o?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5a
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Como assim \"na sua cabe\xE7a\"? Que hist\xF3ria \xE9 essa de que conhecimento
      \xE9 a mais valiosa cole\xE7\xE3o de todas?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5b
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Eu ainda sou mais meus bot\xF5es... O que \xE9 isso? Uma carta?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5c
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Nossa, mas que confuso! S\xF3 pode ser o \xFAltimo dos 4 desafios!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5d
    id: 3
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acho que as palavras est\xE3o fora de ordem. Como podemos ajeit\xE1-las?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5e
    id: 4
    episode: 4
    emotion: regular
    slug: error_1
    minigame: 5
  - text: "Essa palavra parece que fica aqui. Ser\xE1 que ajuda?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5f
    id: 5
    episode: 4
    emotion: regular
    slug: error_2
    minigame: 5
  - text: "Entendi o que voc\xEA est\xE1 fazendo! Posso tentar?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5g
    id: 6
    episode: 4
    emotion: regular
    slug: hint
    minigame: 5
  - text: "\"Hoje \xE9 Domingo, pede cachimbo. O cachimbo \xE9 de barro, bate no jarro.
      O jarro \xE9 fino, bate no sino. O sino \xE9 de ouro, bate no touro."
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5h_a
    id: 7
    episode: 4
    emotion: regular
    slug: victory
    minigame: 5
  - text: "O touro \xE9 valente, bate na gente. A gente \xE9 fraco, cai no buraco.
      O buraco \xE9 fundo, acabou-se o mundo!\""
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5h_b
    id: 8
    episode: 4
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Olha! Um buraco se abriu, que nem na charada! Para onde ser\xE1 que ele
      leva?"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5i
    id: 9
    episode: 4
    emotion: regular
    slug: victory
    minigame: 5
  - text: "S\xF3 espero que n\xE3o seja para o fim do mundo... Guardi\xF5es primeiro!"
    world: 1
    season: 1
    sound: ptbr_ep4_bbt_5j
    id: 10
    episode: 4
    emotion: regular
    slug: victory
    minigame: 5
  - text: Buraco
    world: 1
    season: 1
    sound: 
    id: 11
    episode: 4
    emotion: regular
    slug: word2
    minigame: 5
  - text: Touro
    world: 1
    season: 1
    sound: 
    id: 12
    episode: 4
    emotion: regular
    slug: word1
    minigame: 5
  - text: Jarro
    world: 1
    season: 1
    sound: 
    id: 13
    episode: 4
    emotion: regular
    slug: word0
    minigame: 5
  - text: "Hoje \xE9 domingo, Pede cachimbo. O cachimbo \xE9 de barro, Bate no ___.
      O jarro \xE9 fino, Bate no sino. O sino \xE9 de ouro, Bate no ___. O touro \xE9
      valente, Bate na gente. A gente \xE9 fraco, Cai no ___. O buraco \xE9 fundo,
      Acabou-se o mundo."
    world: 1
    season: 1
    sound: 
    id: 14
    episode: 4
    emotion: regular
    slug: letter
    minigame: 5
  - text: "E eu aqui pensando que esse buraco nos levaria para o lado de fora! N\xE3o
      tenho tanta sorte..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0a
    id: 0
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Se Aquele Que Tudo Coleciona disse que esse \xE9 o caminho, ent\xE3o deve
      ser o caminho!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0b
    id: 1
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Eu s\xF3 espero que os perigos tenham acabado..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0c
    id: 2
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Estamos do lado de fora! Agora \xE9 s\xF3..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0d
    id: 3
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "O que \xE9 essa coisa?!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0e
    id: 4
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Vamos passar bem r\xE1pido e bem quietos para n\xE3o acord\xE1-lo!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0f
    id: 5
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "O que \xE9 isso agora?! Um... um... um... disco voador!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0g
    id: 6
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ser\xE1 que... Ser\xE1 que devemos ver o que h\xE1 dentro do disco voador?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0h
    id: 7
    episode: 5
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Mas, Guardi\xE3o... E se houver alien\xEDgenas dentro do disco voador?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_0i
    id: 8
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Um labirinto! Mas, veja, h\xE1 um mapa aqui, desenhado na parede."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Eu posso ler as instru\xE7\xF5es do mapa enquanto voc\xEA procura a sa\xEDda.
      Que tal?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: 'Muito bem: siga para cima e, depois, balance a lanterna!'
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1c
    id: 2
    episode: 5
    emotion: regular
    slug: request0
    minigame: 1
  - text: Agora, siga para a direita.
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1e
    id: 3
    episode: 5
    emotion: regular
    slug: request1
    minigame: 1
  - text: Certo... Agora siga para baixo.
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1g
    id: 4
    episode: 5
    emotion: regular
    slug: request2
    minigame: 1
  - text: Agora siga para a direita.
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1i
    id: 5
    episode: 5
    emotion: regular
    slug: request3
    minigame: 1
  - text: Agora siga para baixo.
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1l
    id: 6
    episode: 5
    emotion: regular
    slug: request4
    minigame: 1
  - text: "Agora, o \xFAltimo: siga para a esquerda."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1n
    id: 7
    episode: 5
    emotion: regular
    slug: request5
    minigame: 1
  - text: Cuidado! Nossa, que perigo! Vamos que eu lhe ajudo!
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1f
    id: 8
    episode: 5
    emotion: regular
    slug: error0
    minigame: 1
  - text: Volta, volta! Eu lhe ajudo a chegar ao lugar certo.
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1h
    id: 9
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "N\xE3o, n\xE3o! Por a\xED n\xE3o! Venha por aqui."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1m
    id: 10
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Para onde voc\xEA vai? \xC9 por ali!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1ja
    id: 11
    episode: 5
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Sei que voc\xEA gosta de mim, Guardi\xE3o, mas n\xE3o \xE9 para o meu lado
      que voc\xEA deve ir!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1ma
    id: 12
    episode: 5
    emotion: regular
    slug: hit_trapo
    minigame: 1
  - text: "A sa\xEDda! Muito bem! Vamos finalmente sair desse lugar!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1p
    id: 13
    episode: 5
    emotion: regular
    slug: victory
    minigame: 1
  - text: Nossa! Vamos, vou lhe mostrar o lugar certo.
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_1d
    id: 14
    episode: 5
    emotion: regular
    slug: push_guardian
    minigame: 1
  - text: "Acho que sem querer acordamos esse Verme P\xE9-de-Meia!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vermes P\xE9-de-Meia adoram dormir, e odeiam acordar! Olha como est\xE1
      irritado..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Olhe ali: uma caixa de m\xFAsica! Vamos ver se ela funciona!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2c
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Acho que a m\xFAsica precisa ser mais longa. Como voc\xEA vai resolver
      isso, Guardi\xE3o?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2d
    id: 3
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o, n\xE3o. H\xE1 algo de estranho nessa sequ\xEAncia."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2e
    id: 4
    episode: 5
    emotion: regular
    slug: error_1
    minigame: 2
  - text: "Ele est\xE1 nervoso. E se tentarmos repetir a ordem?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2f
    id: 5
    episode: 5
    emotion: regular
    slug: error_2
    minigame: 2
  - text: Caramba! Acho que nos confundimos aqui. Vejamos...
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2g
    id: 6
    episode: 5
    emotion: regular
    slug: hint
    minigame: 2
  - text: "Olha, olha! Est\xE1 funcionando! Quando repetimos a sequ\xEAncia o Verme
      P\xE9-de-Meia cai no sono!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_2h
    id: 7
    episode: 5
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Um disco voador! Agora j\xE1 \xE9 demais!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_3a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "E, veja s\xF3, ele derrubou todos esses cubos do nosso caminho, misturando
      letras e n\xFAmeros..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_3b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: Vamos precisar organizar tudo para poder passar. Pode me ajudar a reorganizar
      as duas colunas?
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_3c
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Ser\xE1 que n\xE3o precisamos separar letras e n\xFAmeros?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_3d
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: Opa! Vamos ver se eu posso ajudar.
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_3e
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Acho que basta organizar uma por letras e outra por n\xFAmeros, assim..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_3g
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Veja s\xF3 que maravilha! Os n\xFAmeros e as letras ficaram em ordem! Agora
      podemos seguir em frente."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_3g2
    id: 6
    episode: 5
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Mas que cadeado estranho! Como ser\xE1 que abre?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_4a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Acho que vamos precisar da intelig\xEAncia de um Guardi\xE3o aqui..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_4b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\"Ato.\" Acho que falta alguma coisa nessas palavras! Voc\xEA pode desvendar
      esse mist\xE9rio?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_4c
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o... Olhe os desenhos! Devem dar uma boa dica!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_4d
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Nossa, mas que dif\xEDcil! Ser\xE1 que \xE9 o nome desses animais?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_4e
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Entendi! Usamos a letra \"G\" para escrever GATO, \"P\" para escrever PATO
      e \"R\" para escrever RATO! \xD3timo, Guardi\xE3o!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_4f
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Uau! A porta se abriu! S\xF3 n\xE3o sei se eu quero mesmo entrar num disco
      voador..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_4g
    id: 6
    episode: 5
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Ainda bem que algu\xE9m aqui tem coragem! N\xE3o que eu n\xE3o tenha, \xE9
      claro..."
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_5a
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O que \xE9 isso? Um tipo de computador? Para que serve?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_5b
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acho que \xE9 para escrevermos um nome para o disco voador! O que voc\xEA
      acha?"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_5c
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Bom, voc\xEA descobriu o disco! Escreva no computador um nome para o disco
      voador. Escreva do seu jeito!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_5d
    id: 3
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Meus bot\xF5es! O disco voador est\xE1 se mexendo! Ele est\xE1 voando!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_5d_2
    id: 4
    episode: 5
    emotion: regular
    slug: victory
    minigame: 5
  - text: "Socorro! Os alien\xEDgenas est\xE3o me levando!"
    world: 1
    season: 1
    sound: ptbr_ep5_bbt_5e
    id: 5
    episode: 5
    emotion: scared
    slug: victory
    minigame: 5
  - text: "Voc\xEA sabe pilotar essa coisa? Como assim \"mais ou menos\"?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0a
    id: 0
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Sabe o que encontrei no disco? Uma foto autografada do Senhor Sombrio!
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0b
    id: 1
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Era o que eu mais temia: o terr\xEDvel Senhor Sombrio est\xE1 por tr\xE1s
      do roubo da Grande Bola de L\xE3!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0c
    id: 2
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Bom, acho que precisamos ir at\xE9 ele, n\xE3o \xE9? Diga que n\xE3o..."
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0d
    id: 3
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Que cheiro \xE9 esse? Voc\xEA soltou um pum?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0e
    id: 4
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "N\xE3o... \xC9 cheiro de meleca! Um monte dela! E vem de dentro do disco
      voador!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0f
    id: 5
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "N\xE3o acredito... Que tipo de vil\xE3o constr\xF3i um disco voador movido
      \xE0 meleca?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0g
    id: 6
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Sabe quem \xE9 o Senhor Sombrio? Ningu\xE9m sabe ao certo..."
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0h
    id: 7
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Tudo que sei \xE9 que ele quer conquistar todos os Sonhos! Ou talvez destru\xED-los!
      Sabe como s\xE3o esses vil\xF5es, n\xE9?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0i
    id: 8
    episode: 6
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Por que eu estou t\xE3o animado em chegar ao castelo de um vil\xE3o como
      o Senhor Sombrio?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0h2
    id: 9
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Estamos quase dentro do castelo... Voc\xEA segura a minha m\xE3o?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0i2
    id: 10
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Agora \xE9 s\xF3 entrar no castelo do Senhor Sombrio!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0j
    id: 11
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Voc\xEA pode ir na frente... Eu vou logo atr\xE1s..."
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_0k
    id: 12
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Olha ali! Placas! Agora ficou f\xE1cil!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_1a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Ou n\xE3o? Me diga, Guardi\xE3o: em que dire\xE7\xE3o devemos ir?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_1b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Opa, espere! Acho que n\xE3o \xE9 esse o caminho... H\xE1 poucas palavras
      nesta placa, n\xE3o acha?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_1c
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Acho que tamb\xE9m n\xE3o \xE9 por aqui. Ser\xE1 que n\xE3o \xE9 esse o
      caminho?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_1d
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: '"Castelo do Senhor Sombrio"! Estamos no caminho certo!'
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_1e
    id: 4
    episode: 6
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Olha, eu n\xE3o sei se temos meleca o suficiente para ir at\xE9 o Castelo
      do Senhor Sombrio."
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_2a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vamos aproveitar para encher o tanque nesse posto de combust\xEDvel rob\xF4!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_2b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Vejamos. T\xEDnhamos 10 litros de meleca. Perdemos 2 quando decolamos e
      gastamos 3. Quantos ainda temos?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_2c
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ser\xE1 que \xE9 isso mesmo? 10 litros, perdemos 2 e usamos 3. Quantos
      litros ainda temos?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_2d
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "N\xE3o sei, n\xE3o. 10, perdi 2, fiquei com... 8. A\xED usei 3... Quanto
      ser\xE1 que ficou?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_2e
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Posso ajudar? Acho que agora j\xE1 sei! 10 menos 2 d\xE1 8. 8 menos 3 d\xE1
      5! Descobrimos!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_2f
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 2
  - text: "Temos 5 litros de meleca! Agora \xE9 s\xF3 encher o tanque e partir!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_2g
    id: 6
    episode: 6
    emotion: regular
    slug: victory
    minigame: 2
  - text: "Como assim voc\xEA nunca pousou um disco voador?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: Certo, calma! Eu lembro de ter aprendido uma coisa ou outra sobre pousar
      discos voadores quando lutei na Guerra dos Felpudos.
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Vejamos o que me lembro... Primeiro precisamos de um n\xFAmero... Qual
      era mesmo? Sei que era maior que 10 e menor que 15. Qual ser\xE1?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3c
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Alguma coisa deu errada! O n\xFAmero \xE9 maior que 10 e menor que 15."
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3d
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Nossa! Ser\xE1 que eu fiz algo errado... Vejamos... Maior que 10 pode ser
      o 12 ou o 18....Mas menor que 15... Sobra apenas o 12. Ser\xE1 isso?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3e
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 3
  - text: 'Como chacoalha essa coisa! Vamos tentar de novo: menor que 9 e maior que
      5.'
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3g
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Ser\xE1 que eu me confundi? Menor do que 9 s\xF3 pode ser o 8 ou o 5...
      Mas tamb\xE9m deve ser maior que 5... Ent\xE3o com certeza \xE9.... o 8!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3h
    id: 6
    episode: 6
    emotion: regular
    slug: error4
    minigame: 3
  - text: "Conseguimos o primeiro n\xFAmero! Agora o segundo: \xE9 menor que 9 e maior
      que 5."
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3f
    id: 7
    episode: 6
    emotion: regular
    slug: victory1
    minigame: 3
  - text: Conseguimos! Estamos pousando!
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_3i
    id: 8
    episode: 6
    emotion: regular
    slug: victory2
    minigame: 3
  - text: "Esse Senhor Sombrio \xE9 engenhoso! Colocou um port\xE3o no caminho!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_4a
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: Aposto que precisamos descobrir a palavra secreta para abri-lo!
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_4b
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\"Sapato.\" N\xE3o entendi... Ser\xE1 que \xE9 uma dica? \"Sapato\"?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_4c
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "N\xE3o \xE9... Ser\xE1 que tem alguma coisa a ver com essa imagem na tela
      da direita?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_4d
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Ainda n\xE3o... Sapato... Sa... Pato... Ser\xE1 que \xE9 parte da palavra?"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_4e
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Voc\xEA me deu uma grande ideia, Guardi\xE3o! Veja s\xF3! P - A - T - O.
      Pato!"
    world: 1
    season: 1
    sound: ptbr_ep6_bbt_4f
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Funcionou! O port\xE3o se abriu! Estamos quase l\xE1!"
