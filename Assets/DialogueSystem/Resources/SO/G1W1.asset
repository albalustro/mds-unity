    season: 1
    sound: ptbr_ep8_bbt_3b
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Essa m\xE1quina est\xE1 roubando os pensamentos dele! Precisamos organizar
