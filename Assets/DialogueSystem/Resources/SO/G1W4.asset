%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e88c3eff8220fb4295ab4195f856ae7, type: 3}
  m_Name: G1W4
  m_EditorClassIdentifier: 
  dialogueList:
  - text: "N\xE3o sei como posso te agradecer por ter nos ajudado, nobre Guardi\xE3o.
      Sem tua ajuda jamais conseguiria salvar a vila!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_43
    id: 0
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "Mas olhe a destrui\xE7\xE3o provocada pela m\xE1quina-drag\xE3o!  Vejo
      muito trabalho pela frente!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_44
    id: 1
    episode: 1
    emotion: happy
    slug: final
    minigame: 
  - text: "Alto l\xE1, estranho! Quem \xE9s tu para adentrar a vila secreta das fadas!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_01
    id: 2
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Pelas l\xE1grimas da Rainha, \xE9s um Guardi\xE3o dos Sonhos! Ent\xE3o
      h\xE1 esperan\xE7a!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_02
    id: 3
    episode: 1
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Sou Florin, o bravo cavaleiro deste reino e encarregado de defender esta
      vila do terr\xEDvel perigo que a assola!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_03
    id: 4
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Uma fera gigantesca est\xE1 destruindo tudo pelo caminho. Venha! Vejamos
      o que podemos fazer pelos nobres cidad\xE3os deste sonho."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_04
    id: 5
    episode: 1
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Por que me olhas deste jeito, Guardi\xE3o? Alguma coisa errada comigo?
      Mostarda no bigode? N\xE3o... Eu n\xE3o tenho bigode!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_11
    id: 6
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Ou\xE7a! \xC9 o som de duendes preparando-se para a batalha! AVANTE!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_12
    id: 7
    episode: 1
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "O que h\xE1 de errado com a forma que falo? Todos os cavaleiros falam desse
      jeito! ... N\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_19
    id: 8
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Ora, n\xE3o importa! Temos um monstro a derrotar e uma vila a salvar! Soldados!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_20
    id: 9
    episode: 1
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Como assim aquilo n\xE3o \xE9 um drag\xE3o? Ora, n\xE3o importa! Ainda
      temos trabalho a fazer!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_27
    id: 10
    episode: 1
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "O drag\xE3o... certo, a m\xE1quina foi derrotada! Vencemos!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_34
    id: 11
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: Mas os perigos que podem surgir! Precisamos fazer algo para proteger a vila!
    world: 4
    season: 1
    sound: ptbr_ep73_frn_35
    id: 12
    episode: 1
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Parece que o terr\xEDvel drag\xE3o passou por aqui e espalhou os pertences
      deste pobre alde\xE3o."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_05
    id: 0
    episode: 1
    emotion: sad
    slug: intro
    minigame: 1
  - text: "Podes ajudar-me na \xE1rdua tarefa de organizar tudo nestas cestas?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_06
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Creio que h\xE1 algo fora do lugar, nobre Guardi\xE3o. Talvez devamos organiz\xE1-los
      por cor? Ou tipo de coisa?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_07
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Compreendo tua inten\xE7\xE3o, mas creio que possamos organizar a primeira
      caixa utilizando apenas objetos vermelhos."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_08
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Poder\xEDamos, talvez, colocar os pertences vermelhos em uma caixa e os
      verdes em outra?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_09
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 1
  - text: "N\xE3o precisa agradecer, gentil alde\xE3o. \xC9 nosso dever como protetores
      deste sonho ajud\xE1-lo!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_10
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Sim. Guerreiros destemidos aguardando o comando! Mas, onde est\xE1 o capit\xE3o
      de voc\xEAs?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_13
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ora, se o capit\xE3o desapareceu, faremos n\xF3s o trabalho dele! Guardi\xE3o,
      vamos mostrar a estes soldados como cavalgar como verdadeiros cavaleiros!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_14
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o creio que seja bem assim..."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_15
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 2
  - text: "N\xE3o seria ao contr\xE1rio?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_16
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Talvez eu deva demonstrar com minha vasta experi\xEAncia na montaria de
      insetos de todos os tipos e tamanhos."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_17
    id: 4
    episode: 1
    emotion: regular
    slug: error3
    minigame: 2
  - text: Excelente trabalho! Pela Rainha das Fadas!
    world: 4
    season: 1
    sound: ptbr_ep73_frn_18
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 2
  - text: "O que s\xE3o aqueles potes? Ah, melado! Tive uma ideia!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_21
    id: 0
    episode: 1
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, ajude-me a distribuir os potes de melado. Nenhum soldado deve
      ter mais do que os demais!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_22
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Creio que sobrar\xE3o potes de melado, mas n\xE3o h\xE1 problema!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_23
    id: 2
    episode: 1
    emotion: regular
    slug: error1
    minigame: 3
  - text: Cada soldado deve ter apenas um pote de melado!
    world: 4
    season: 1
    sound: ptbr_ep73_frn_24
    id: 3
    episode: 1
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Aten\xE7\xE3o, soldados! Apresentar armas! Atacar!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_25
    id: 4
    episode: 1
    emotion: scared
    slug: error3
    minigame: 3
  - text: "O drag\xE3o est\xE1 aprisionado no melado!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_26
    id: 5
    episode: 1
    emotion: happy
    slug: victory
    minigame: 3
  - text: "J\xE1 ouvistes falar de Cascudos? S\xE3o terr\xEDveis abelhas imposs\xEDveis
      de se domesticar!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_28
    id: 0
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Temos v\xE1rios cascudos aqui, para caso de ataque de drag\xF5es. Ajude-me
      a liber\xE1-los. Est\xE3o na porta do meio da parte de cima e na porta da esquerda
      da parte de baixo."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_29
    id: 1
    episode: 1
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Creio que me entendeste mal. Em cima \xE9 a porta do meio, e embaixo \xE9
      a porta da esquerda."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_30
    id: 2
    episode: 1
    emotion: regular
    slug: error0
    minigame: 4
  - text: "Precisamos de todos os cascudos ao mesmo tempo! Abra a porta do meio que
      fica da parte de cima tamb\xE9m."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_31
    id: 3
    episode: 1
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Isso n\xE3o ser\xE1 o suficiente. Tu tamb\xE9m precisas abrir a porta de
      baixo, do lado esquerdo."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_32
    id: 4
    episode: 1
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Agora, afasta-te, pois os cascudos atacar\xE3o o que estiver entre eles
      e o melado!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_33
    id: 5
    episode: 1
    emotion: scared
    slug: victory
    minigame: 4
  - text: "O que planejas fazer, Guardi\xE3o? Posso ajudar-te?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_36
    id: 0
    episode: 1
    emotion: scared
    slug: intro
    minigame: 5
  - text: "Uma barreira m\xE1gica! \xC9s muito s\xE1bio!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_37
    id: 1
    episode: 1
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Vejo que come\xE7aste a colocar as pilastras. Podes completar a sequ\xEAncia,
      por favor?"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_38
    id: 2
    episode: 1
    emotion: regular
    slug: intro
    minigame: 5
  - text: "A magia far\xE1 com que o fogo e a \xE1gua se tornem vapor, criando uma
      ilus\xE3o de que a vila n\xE3o est\xE1 aqui."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_42
    id: 3
    episode: 1
    emotion: regular
    slug: victory
    minigame: 5
  - text: "H\xE1 algo de errado, n\xE3o? Precisamos seguir a sequ\xEAncia de pilastras
      m\xE1gicas."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_39
    id: 4
    episode: 1
    emotion: regular
    slug: error1
    minigame: 5
  - text: "S\xE3o duas pilastras de cada tipo, ou a magia n\xE3o funcionar\xE1."
    world: 4
    season: 1
    sound: ptbr_ep73_frn_40
    id: 5
    episode: 1
    emotion: regular
    slug: error2
    minigame: 5
  - text: "A fada completar\xE1 o encantamento!"
    world: 4
    season: 1
    sound: ptbr_ep73_frn_41
    id: 6
    episode: 1
    emotion: happy
    slug: error3
    minigame: 5
  - text: "Muito obrigado por tua oferta em nos ajudar a reconstruir a vila, nobre
      Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_01
    id: 0
    episode: 2
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "A m\xE1quina-drag\xE3o destruiu muitas casas e derrubou diversas \xE1rvores!
      Precisaremos reorganizar tudo!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_02
    id: 1
    episode: 2
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Por que aquela m\xE1quina faria tamanho estrago? E em uma floresta t\xE3o
      pac\xEDfica!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_03
    id: 2
    episode: 2
    emotion: sad
    slug: minigame1
    minigame: 
  - text: Bom, perguntas ficam para depois. Temos muito trabalho pela frente. Avante!
    world: 4
    season: 1
    sound: ptbr_ep74_frn_04
    id: 3
    episode: 2
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Muitos alde\xF5es est\xE3o reclamando de que suas planta\xE7\xF5es est\xE3o
      sendo devoradas por uma praga."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_08
    id: 4
    episode: 2
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Ajuda-me a descobrir o que est\xE1 acontecendo?"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_09
    id: 5
    episode: 2
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "As coisas n\xE3o eram assim t\xE3o perigosas quando nossa majestade, a
      Rainha das Fadas, protegia-nos. Se n\xE3o fossem pelos gigantes..."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_13
    id: 6
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos, Guardi\xE3o. Est\xE3o a nos chamar no Lago Arco \xCDris."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_14
    id: 7
    episode: 2
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Olhai! \xC9 meu tio, Darin! Talvez ele precise de ajuda!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_19
    id: 8
    episode: 2
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "A vila est\xE1 como nova! Em pouco tempo ningu\xE9m mais se lembrar\xE1
      do perigo que passamos."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_23
    id: 9
    episode: 2
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Se houvesse uma forma de lembrar duendes e fadas sobre a import\xE2ncia
      de proteger nossa floresta!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_24
    id: 10
    episode: 2
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Que h\xE1 de errado, Guardi\xE3o? Tu pareces preocupado? Deixo-te ser cavaleiro
      tamb\xE9m!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_30
    id: 11
    episode: 2
    emotion: scared
    slug: final
    minigame: 
  - text: "Este cartaz do vilanesco Senhor Sombrio? Cr\xEA que ele seja o respons\xE1vel
      pela m\xE1quina-drag\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_31
    id: 12
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Ent\xE3o est\xE1 decidido: partiremos imediatamente. Se algu\xE9m neste
      sonho sabe a verdade certamente que \xE9 a \xC1rvore Mais Velha! Avante!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_32
    id: 13
    episode: 2
    emotion: regular
    slug: final
    minigame: 
  - text: "Drag\xE3o infernal! Cuspiu fogo por toda a parte!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_05
    id: 0
    episode: 2
    emotion: sad
    slug: intro
    minigame: 1
  - text: "Guardi\xE3o, ajude-me a apagar o inc\xEAndio com a \xE1gua deste tonel!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_06
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 1
  - text: "\xC9s mesmo muito destemido, Guardi\xE3o! Enfrentaste o fogo sem medo!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_07
    id: 2
    episode: 2
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Pelo ronco do gigante! S\xE3o pulgas-rob\xF4s, de certo soltas pela m\xE1quina-drag\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_10
    id: 0
    episode: 2
    emotion: scared
    slug: intro
    minigame: 2
  - text: "Vamos captur\xE1-las, Guardi\xE3o, antes que devorem tudo!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_11
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Creio que capturamos todas essas odiosas m\xE1quinas!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_12
    id: 2
    episode: 2
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Que estrago terr\xEDvel! Pobres sapulhas, cobertos de \xF3leo at\xE9 debaixo
      das unhas!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_15
    id: 0
    episode: 2
    emotion: sad
    slug: intro
    minigame: 3
  - text: "A terr\xEDvel m\xE1quina-drag\xE3o espalhou \xF3leo por todo o lago. Precisamos
      fazer algo a respeito!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_16
    id: 1
    episode: 2
    emotion: scared
    slug: intro
    minigame: 3
  - text: "As fadas nos deram um p\xF3 m\xE1gico que limpar\xE1 os sapulhas, mas s\xF3
      se todos eles ficarem do lado de fora ao mesmo tempo! Ajuda-me, Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_17
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Bom trabalho, caro amigo! Agora deixemos o p\xF3 m\xE1gico fazer seu trabalho!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_18
    id: 3
    episode: 2
    emotion: regular
    slug: victory
    minigame: 3
  - text: "Guardi\xE3o, meu tio Darin est\xE1 juntando madeira usada para consertar
      o que foi destru\xEDdo."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_20
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Podes ajudar-me a juntar madeira? Mas sem retir\xE1-la da natureza! A floresta
      j\xE1 sofreu muito com o ataque."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_21
    id: 1
    episode: 2
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Devemos sempre que poss\xEDvel reutilizar materiais que j\xE1 temos. Se
      n\xE3o um dia n\xE3o restar\xE3o mais \xE1rvores na Floresta Encantada!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_22
    id: 2
    episode: 2
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Tu \xE9s mesmo s\xE1bio, Guardi\xE3o! Podemos colocar cartazes explicando
      o que deve ser feito!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_25
    id: 0
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Assim os habitantes da vila sempre se lembrar\xE3o de cuidar do meio ambiente."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_26
    id: 1
    episode: 2
    emotion: happy
    slug: intro
    minigame: 5
  - text: Encontrei alguns cartazes que podemos usar. Quais seriam os melhores cartazes
      para usarmos nesta campanha?
    world: 4
    season: 1
    sound: ptbr_ep74_frn_27
    id: 2
    episode: 2
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Tens certeza, Guardi\xE3o? Creio que estes cartazes aqui seriam de melhor
      valia."
    world: 4
    season: 1
    sound: ptbr_ep74_frn_28
    id: 3
    episode: 2
    emotion: regular
    slug: error1
    minigame: 5
  - text: "\xD3tima escolha! Fazemos uma \xF3tima dupla! Eu, o cavaleiro. Tu, meu
      escudeiro!"
    world: 4
    season: 1
    sound: ptbr_ep74_frn_29
    id: 4
    episode: 2
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Devemos seguir em frente. O mapa que tu nos deste nos ajudar\xE1 deveras
      em nosso caminho. Obrigado, amigo Gronco!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_46
    id: 0
    episode: 3
    emotion: happy
    slug: final
    minigame: 
  - text: "E quanto a n\xF3s, Guardi\xE3o, vamos em frente! A sabedoria da \xC1rvore
      Mais Velha nos aguarda!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_47
    id: 1
    episode: 3
    emotion: regular
    slug: final
    minigame: 
  - text: "N\xE3o temas, Guardi\xE3o. Conhe\xE7o esta floresta como a palma da minha
      m\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_01
    id: 2
    episode: 3
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Que \xE1rvore \xE9 esta? Ela n\xE3o deveria estar aqui? Que esp\xE9cie
      de bruxaria \xE9 essa?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_02
    id: 3
    episode: 3
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Talvez a \xC1rvore Mais Velha tenha mudado a floresta para se proteger...
      ou talvez eu..."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_03
    id: 4
    episode: 3
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Bom, deve haver uma pista de como reencontrar nosso caminho... creio.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_04
    id: 5
    episode: 3
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Gronco, tu dizes ser este o teu nome? Mmmm... Sou Florin e este \xE9 um
      Guardi\xE3o dos sonhos. Buscamos o caminho at\xE9 a \xC1rvore Mais Velha."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_11
    id: 6
    episode: 3
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Podes nos ajudar? Ora, que oportuno! Vamos segui-lo at\xE9 a casa dele,
      Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_12
    id: 7
    episode: 3
    emotion: happy
    slug: minigame2
    minigame: 
  - text: "Ent\xE3o tens ouvido o som de m\xE1quinas na floresta? Tu cr\xEAs que foram
      eles que roubaram teu urso e mexeram em teu tapete?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_19
    id: 8
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Estou a pensar se a m\xE1quina-drag\xE3o n\xE3o foi apenas o come\xE7o
      de algo... o que \xE9 isso adiante?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_20
    id: 9
    episode: 3
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Que lugar \xE9 este? N\xE3o parece algo do Sonho das \xC1rvores Encantadas.
      E de onde vem todo esse barulho?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_28
    id: 10
    episode: 3
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "Gronco poder\xE1 agora... onde est\xE1 o Gronco?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_35
    id: 11
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Pelas ra\xEDzes da \xC1rvore Mais Velha! Quando foi que Gronco derrotou
      todos aqueles cavaleiros rob\xF3ticos?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_36
    id: 12
    episode: 3
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Cuidado, Guardi\xE3o! \xC9 um terr\xEDvel ogro da floresta! Deixes que
      eu enfrentarei essa fera!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_05
    id: 0
    episode: 3
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Tu achas que ele s\xF3 est\xE1 procurando algum objeto? Quem sabe este
      bilhete possa nos ajudar... vamos ler: N\xE3o \xE9 de comer, n\xE3o \xE9 de
      metal, \xE9 marrom e \xE9 macio."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_06
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Um urso de pel\xFAcia? Que tipo de monstro tem um urso de pel\xFAcia?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_10
    id: 2
    episode: 3
    emotion: happy
    slug: victory
    minigame: 1
  - text: "N\xE3o creio que isso se encaixe em todas as caracter\xEDsticas escritas
      no bilhete. Primeira caracter\xEDstica: n\xE3o \xE9 de comer."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_07_A
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Ent\xE3o, j\xE1 sabemos que ele n\xE3o procura esta ma\xE7\xE3, nem a coxinha
      de galinha e nem o coco... Falta ver as outras caracter\xEDsticas: n\xE3o \xE9
      de metal, \xE9 marron e \xE9 macio."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_07_B
    id: 4
    episode: 3
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O objeto \xE9 marrom e macio. Tira o que n\xE3o for desta forma para facilitar
      encontr\xE1-lo."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_08_A
    id: 5
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "A segunda caracter\xEDstica, nobre Guardi\xE3o, \xE9 que n\xE3o \xE9 de
      metal. Assim, chave inglesa, porca, engrenagem e parafuso s\xE3o tamb\xE9m eliminados
      daqui. Falta-nos eleger aquilo que seja marrom e macio!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_08_B
    id: 6
    episode: 3
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Creio que o objeto \xE9 este."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_09
    id: 7
    episode: 3
    emotion: regular
    slug: error3
    minigame: 1
  - text: O que foi, Gronco? Qual o motivo de tanto pranto?
    world: 4
    season: 1
    sound: ptbr_ep75_frn_13
    id: 0
    episode: 3
    emotion: sad
    slug: intro
    minigame: 2
  - text: "Algu\xE9m colocou n\xFAmeros entre as letras do seu tapete! Ora, quem pregaria
      tal pe\xE7a? Devemos ajud\xE1-lo, Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_14
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Devemos tirar todos os n\xFAmeros e deixar apenas as letras no tapete."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_15
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 2
  - text: Deixes o que for letra. Tira o resto.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_16
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Usarei minha coragem para eliminar apenas os n\xFAmeros intrusos!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_17
    id: 4
    episode: 3
    emotion: happy
    slug: error3
    minigame: 2
  - text: "Teu tapete est\xE1 salvo, Gronco! Pode levar-nos at\xE9 nosso objetivo
      agora?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_18
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Dizes que tal muro n\xE3o existia aqui antes, Gronco? \xC9 certo que algu\xE9m
      tenta nos impedir de alcan\xE7ar nosso objetivo!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_21
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Devemos atravessar este muro e descobrir que mist\xE9rio \xE9 esse que
      cerca nosso sonho!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_22
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Gronco, tu \xE9s forte! Segures o port\xE3o. Guardi\xE3o, vamos procurar
      um tronco grande o suficiente para prender e manter o port\xE3o aberto."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_23
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o creio que este tronco se encaixe no espa\xE7o da porta."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_24
    id: 3
    episode: 3
    emotion: regular
    slug: error1
    minigame: 3
  - text: "S\xF3 de olhar j\xE1 percebemos que os de tamanho mais curto n\xE3o nos
      servem! Qual deles deve se encaixar perfeitamente, nobre Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_25
    id: 4
    episode: 3
    emotion: regular
    slug: error2
    minigame: 3
  - text: Acredito que este tronco tem o tamanho apropriado.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_26
    id: 5
    episode: 3
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Vamos passar r\xE1pido antes que o tronco se parta!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_27
    id: 6
    episode: 3
    emotion: scared
    slug: victory
    minigame: 3
  - text: "Mais uma vil m\xE1quina-monstro! Vou destru\xED-la sem demora! Prepare-se
      monstro!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_29
    id: 0
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O que queres dizer com senha? Ent\xE3o tu cr\xEAs que pode vencer a m\xE1quina
      colocando os n\xFAmeros certos no painel? Mas quais s\xE3o esses n\xFAmeros?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_30
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 4
  - text: "H\xE1 duas ferramentas no desenho. Seria o primeiro n\xFAmero 2?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_32
    id: 2
    episode: 3
    emotion: regular
    slug: error1
    minigame: 4
  - text: "N\xE3o seriam esses desenhos uma pista desta tal senha?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_31
    id: 3
    episode: 3
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ent\xE3o, seguindo teu pensamento, os n\xFAmeros seriam estes..."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_33
    id: 4
    episode: 3
    emotion: regular
    slug: error3
    minigame: 4
  - text: "A m\xE1quina-monstro dorme! Essa m\xE1gica \xE9 realmente poderosa, Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_34
    id: 5
    episode: 3
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Gronco, tu \xE9s um grande guerreiro! Em todos os sentidos!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_37
    id: 0
    episode: 3
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Se houvesse me chamado emprestaria minhas armas para derrotar estes rob\xF4s
      maldosos!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_38
    id: 1
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Quantos rob\xF4s tu derrotaste sozinho? Guardi\xE3o, ajuda-me a contar."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_39
    id: 2
    episode: 3
    emotion: regular
    slug: intro
    minigame: 5
  - text: "10 rob\xF4s, e sozinho! Gronco, tu \xE9s realmente impressionante!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_45
    id: 3
    episode: 3
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Gronco \xE9 bravo, mas o ex\xE9rcito do Senhor Sombrio n\xE3o \xE9 t\xE3o
      grande assim."
    world: 4
    season: 1
    sound: ptbr_ep75_frn_42
    id: 4
    episode: 3
    emotion: regular
    slug: error_more
    minigame: 5
  - text: "D\xEA uma olhada no alto da \xE1rvore, Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_41
    id: 5
    episode: 3
    emotion: happy
    slug: hint1
    minigame: 5
  - text: Acho que foram mais inimigos derrubados por Gronco.
    world: 4
    season: 1
    sound: ptbr_ep75_frn_40
    id: 6
    episode: 3
    emotion: regular
    slug: error_less
    minigame: 5
  - text: "H\xE1 7 rob\xF4s aqui e mais 3 sobre a empilhadeira. Quantos o Gronco derrotou?"
    world: 4
    season: 1
    sound: ptbr_ep75_frn_43
    id: 7
    episode: 3
    emotion: regular
    slug: hint2
    minigame: 5
  - text: Se foram 7 mais 3...
    world: 4
    season: 1
    sound: ptbr_ep75_frn_44
    id: 8
    episode: 3
    emotion: regular
    slug: lasterror
    minigame: 5
  - text: "Guardi\xE3o... s\xF3 h\xE1 um lugar onde descobriremos a localiza\xE7\xE3o
      da Rainha das Fadas... No Castelo dos Gigantes!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_49
    id: 0
    episode: 4
    emotion: regular
    slug: final
    minigame: 
  - text: "O fruto do conhecimento! Se o comermos saberemos o que precisamos sobre
      o que est\xE1 acontecendo!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_47
    id: 1
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "\xC9 um fruto delicioso...  N\xE3o! O Senhor Sombrio est\xE1 atr\xE1s da
      Rainha das Fadas! Mas... onde ela est\xE1?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_48
    id: 2
    episode: 4
    emotion: scared
    slug: final
    minigame: 
  - text: "\xC1rvore Mais Velha, pode nos ajudar a compreender o perigo que amea\xE7a
      o Sonho das \xC1rvores Encantadas?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_46
    id: 3
    episode: 4
    emotion: happy
    slug: final
    minigame: 
  - text: "A \xC1rvore Mais Velha fica logo adiante, Guardi\xE3o."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_01
    id: 4
    episode: 4
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Ela \xE9 muito s\xE1bia! Foi ela quem ensinou a Rainha das Fadas como colocar
      todos os gigantes para dormir, salvando, assim, o Sonho."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_02
    id: 5
    episode: 4
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "\xC9 uma pena que a Rainha tenha desaparecido na mesma \xE9poca... Ela
      jamais deixaria invadirem o Sonho das \xC1rvores Encantadas!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_03
    id: 6
    episode: 4
    emotion: sad
    slug: minigame1
    minigame: 
  - text: "Tu cr\xEAs mesmo que o Senhor Sombrio est\xE1 por tr\xE1s desta invas\xE3o?
      A \xC1rvore certamente saber\xE1 nos dizer a verdade!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_04
    id: 7
    episode: 4
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Se foi mesmo o Senhor Sombrio o respons\xE1vel por tudo isso, ele devia
      estar tentando ferir a \xC1rvore Mais Velha."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_11
    id: 8
    episode: 4
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Olhe, mais uma m\xE1quina-monstro! Creio que tu precisar\xE1s usar tua
      magia novamente!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_12
    id: 9
    episode: 4
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Os duendes da Vila Secreta constru\xEDram um sistema de irriga\xE7\xE3o
      para ajudar a floresta a crescer."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_19
    id: 10
    episode: 4
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Se colocarmos o orvalho m\xE1gico da \xE1rvore no tanque, poderemos salvar
      este bosque."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_20
    id: 11
    episode: 4
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Tu consegues ouvir esta m\xFAsica tristonha? De onde vem?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_28
    id: 12
    episode: 4
    emotion: sad
    slug: minigame4
    minigame: 
  - text: "Est\xE1 tudo resolvido! Podemos agora retornar \xE0 \xC1rvore Mais Velha
      para descobrirmos sobre..."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_37
    id: 13
    episode: 4
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Que algazarra \xE9 esta? N\xE3o consigo nem ouvir minha pr\xF3pria voz!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_38
    id: 14
    episode: 4
    emotion: scared
    slug: minigame5
    minigame: 
  - text: "S\xE1bia \xC1rvore Mais Velha... que cheiro \xE9 esse? Algu\xE9m andou
      despejando lixo por aqui?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_05
    id: 0
    episode: 4
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Isso \xE9 terr\xEDvel! Polu\xEDram tudo a tua volta! D\xEA-nos teu orvalho
      m\xE1gico e n\xF3s limparemos tudo! Meu cantil tem espa\xE7o para 10 unidades
      de orvalho. Ajuda-me, Guardi\xE3o."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_06
    id: 1
    episode: 4
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Cada gota \xE9 uma unidade de orvalho. Precisamos de exatamente 10 gotas."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_07
    id: 2
    episode: 4
    emotion: regular
    slug: error_1
    minigame: 1
  - text: "Acho que se contarmos as gotas que guardamos no cantil at\xE9 chegar a
      10 ser\xE1 o suficiente."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_08
    id: 3
    episode: 4
    emotion: regular
    slug: error_2
    minigame: 1
  - text: Se colhermos estas gotas aqui teremos o suficiente.
    world: 4
    season: 1
    sound: ptbr_ep76_frn_09
    id: 4
    episode: 4
    emotion: regular
    slug: error_3
    minigame: 1
  - text: "Obrigado, \xC1rvore Mais Velha! Limparemos o bosque antes de pedirmos tua
      ajuda!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_10
    id: 5
    episode: 4
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Faz teu truque e coloque a m\xE1quina-monstro para dormir. Eu a distrairei
      enquanto tu a domina!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_13
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Que \xE9 este aparelho? Ser\xE1 que ele tem uma pista de como derrotar
      a m\xE1quina-monstro?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_14
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 2
  - text: "N\xE3o funcionou! Tente o gravador novamente! Ele parece dizer uma senha!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_15
    id: 2
    episode: 4
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Pelo menos as duas letras j\xE1 identifiquei como sendo \"B\" e \"A\"...
      E os \xFAltimos n\xFAmeros entendi 3 e 5... N\xE3o achas melhor ouvirmos de
      novo?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_16
    id: 3
    episode: 4
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Muito bem, Guardi\xE3o. Tu \xE9s um verdadeiro her\xF3i!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_18
    id: 4
    episode: 4
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Malditos sejam esses rob\xF4s! Destru\xEDram os canos!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_21
    id: 0
    episode: 4
    emotion: sad
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, precisamos consertar tudo, ou o bosque n\xE3o se recuperar\xE1!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_22
    id: 1
    episode: 4
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Tu deves colocar os canos faltando em suas posi\xE7\xF5es corretas. Ajuda-me
      com isso?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_23
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Os canos devem ficar na sequ\xEAncia correta. Veja os n\xFAmeros que faltam."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_24
    id: 3
    episode: 4
    emotion: regular
    slug: error_1
    minigame: 3
  - text: "\xC9 uma sequ\xEAncia decrescente! \xC9 s\xF3 seguir os n\xFAmeros e colocar
      aqueles que faltam."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_25
    id: 4
    episode: 4
    emotion: regular
    slug: error_2
    minigame: 3
  - text: "Coloquei o orvalho no tanque. Permita-me ajud\xE1-lo a terminar com os
      canos."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_26
    id: 5
    episode: 4
    emotion: regular
    slug: error_3
    minigame: 3
  - text: "Isso parece ser o suficiente. A \xE1gua misturada ao orvalho m\xE1gico
      limpar\xE1 o solo."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_27
    id: 6
    episode: 4
    emotion: happy
    slug: victory
    minigame: 3
  - text: "S\xE3o as flores cantantes! Parece que querem cantar alguma coisa para
      um de n\xF3s!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_29
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "\"Uni, duni, t\xEA. Salam\xEA mingu\xEA. O sorvete color\xEA. O escolhido
      foi voc\xEA!\""
    world: 4
    season: 1
    sound: ptbr_ep76_frn_30
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 4
  - text: "O qu\xEA? O escolhido fui eu? Puxa, que bacana!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_32
    id: 2
    episode: 4
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Elas me escolheram! Que legal! Mas precisam saber qual desses nomes \xE9
      o meu..."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_31
    id: 3
    episode: 4
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Tens certeza? Desta lista, quase todos os nomes s\xE3o enormes... E meu
      nome \xE9 curtinho, n\xE3o \xE9?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_33
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Proponho que a gente elimine os nomes bem compridos: Bar\xE3o Bom Trapo...
      Ele nem \xE9 deste Sonho! Senhor Sombrio... Nunca as flores iriam querer cantar
      para ele, n\xE3o achas? O que mais temos a\xED na lista?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_34
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 4
  - text: "Ser\xE1 que n\xE3o \xE9 este? FLO-RIN... Eu mesmo!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_35
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 4
  - text: "\xC9 uma honra ter sido escolhido por elas! Obrigado, belas damas!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_36
    id: 7
    episode: 4
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Quem diria! O ataque das m\xE1quinas-monstro desorganizou as nozes dos
      nossos companheiros esquilos!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_39
    id: 0
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Acalmem-se, pequenos amigos! Decerto o Guardi\xE3o dos Sonhos poder\xE1
      ajud\xE1-los!"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_40
    id: 1
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O que me dizes, Guardi\xE3o? Podes arrumar as nozes, em cada bandeja, de
      10 em 10?"
    world: 4
    season: 1
    sound: ptbr_ep76_frn_41
    id: 2
    episode: 4
    emotion: regular
    slug: intro
    minigame: 5
  - text: Todos parecem satisfeitos! Bom! Podemos seguir adiante agora!
    world: 4
    season: 1
    sound: ptbr_ep76_frn_45
    id: 3
    episode: 4
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Temos que somar com muito cuidado, pois cada bandeja deve ter 10 nozes
      \u2013 nem mais, nem menos, ou estes esquilos continuar\xE3o a brigar."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_42
    id: 4
    episode: 4
    emotion: regular
    slug: error1
    minigame: 5
  - text: "S\xE3o 30 nozes, n\xE3o \xE9? Para te ajudar, uma das bandejas j\xE1 est\xE1
      com 10. As outras 20 nozes, arrumas 10 em cada uma das duas outras bandejas."
    world: 4
    season: 1
    sound: ptbr_ep76_frn_43
    id: 5
    episode: 4
    emotion: regular
    slug: error2
    minigame: 5
  - text: 'Acho que assim fica bom: 10 na primeira bandeja, 10 na segunda e 10 na
      terceira. Somando 30 nozes!'
    world: 4
    season: 1
    sound: ptbr_ep76_frn_44
    id: 6
    episode: 4
    emotion: regular
    slug: error3
    minigame: 5
  - text: "A Rainha das Fadas est\xE1... no Cora\xE7\xE3o do Sonho, em uma caverna
      no fundo da Terra!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_52
    id: 0
    episode: 5
    emotion: scared
    slug: final
    minigame: 
  - text: "Se a rainha est\xE1 assim t\xE3o fundo s\xF3 h\xE1 uma forma de chegarmos
      at\xE9 ela: com a ajuda dos an\xF5es ferr\xF5es!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_53
    id: 1
    episode: 5
    emotion: regular
    slug: final
    minigame: 
  - text: Estamos quase chegando ao Castelo dos Gigantes!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_01
    id: 2
    episode: 5
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "H\xE1 muitos e muitos anos os Gigantes tentaram conquistar todo o Sonho,
      mas a Rainha das Fadas usou um feiti\xE7o para coloc\xE1-los para dormir."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_02
    id: 3
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ningu\xE9m sabe o que aconteceu com a Rainha, mas parece que o Senhor Sombrio
      descobriu!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_03
    id: 4
    episode: 5
    emotion: regular
    slug: minigame1
    minigame: 
  - text: Espere. Estou ouvindo um zumbido estranho vindo de algum lugar. Pode ser
      um monstro!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_04
    id: 5
    episode: 5
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Trafa diz que soube de um mapa escondido no castelo. O mapa revela o esconderijo
      da Rainha das Fadas!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_11
    id: 6
    episode: 5
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Precisamos chegar at\xE9 o ba\xFA que guarda o mapa... Mas precisaremos
      passar primeiro pelos gigantes!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_12
    id: 7
    episode: 5
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Estamos a salvo! \xC9 aquele o ba\xFA, Trafa?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_27
    id: 8
    episode: 5
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Agora s\xF3 nos resta abrir o ba\xFA e pegar o mapa!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_28
    id: 9
    episode: 5
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Um enxame de tra\xE7as gigantes! Precisamos salvar o mapa!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_36
    id: 10
    episode: 5
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "A m\xFAsica p\xF4s as tra\xE7as gigantes para dormir! Conseguimos!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_43
    id: 11
    episode: 5
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Agora \xE9 seguro pegar o mapa."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_44
    id: 12
    episode: 5
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "\xC9 a joaninha viajadeira Trafa! E est\xE1 presa em papel pega-mosca!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_05
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Guardi\xE3o, podes ajudar-me a fazer um solvente para libertar Trafa? Precisamos
      juntar os ingredientes, mas s\xF3 aqueles que t\xEAm o nome dentro do outro
      ingrediente."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_06
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 1
  - text: "A palavra \"lago\" est\xE1 em \"lagoa\", ent\xE3o esses dois ficam juntos.
      O que mais?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_07
    id: 2
    episode: 5
    emotion: regular
    slug: error1
    minigame: 1
  - text: "N\xE3o vamos usar todos os ingredientes. S\xF3 4."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_08
    id: 3
    episode: 5
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Creio que isso \xE9 tudo. Agora \xE9 s\xF3 misturar e colocar no papel
      pega-mosca."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_09
    id: 4
    episode: 5
    emotion: regular
    slug: error3
    minigame: 1
  - text: "Est\xE1s a salva, Trafa! Agora, diga-nos: o que fazes aqui?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_10
    id: 5
    episode: 5
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Estes gigantes se mexem muito dormindo! Trafa n\xE3o conseguir\xE1 voar
      por cima deles carregando n\xF3s dois."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_13
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: Eu montarei em Trafa e guio-te do ar. Primeiro, para frente!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_14
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Agora vire \xE0 esquerda."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_16
    id: 2
    episode: 5
    emotion: regular
    slug: request_1
    minigame: 2
  - text: Novamente para frente. Avante!
    world: 4
    season: 1
    sound: ptbr_ep77_frn_18
    id: 3
    episode: 5
    emotion: regular
    slug: request_2
    minigame: 2
  - text: "Vire \xE0 direita."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_20
    id: 4
    episode: 5
    emotion: regular
    slug: request_3
    minigame: 2
  - text: "Volte para tr\xE1s!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_22
    id: 5
    episode: 5
    emotion: regular
    slug: request_4
    minigame: 2
  - text: "Para terminar, v\xE1 para a direita."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_24
    id: 6
    episode: 5
    emotion: regular
    slug: request_5
    minigame: 2
  - text: "Cuidado! \xC9 para frente!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_15
    id: 7
    episode: 5
    emotion: scared
    slug: error0
    minigame: 2
  - text: "Por a\xED, n\xE3o! Esquerda!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_17
    id: 8
    episode: 5
    emotion: scared
    slug: error1
    minigame: 2
  - text: "Guardi\xE3o! Quase! \xC9 para frente!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_19
    id: 9
    episode: 5
    emotion: scared
    slug: error2
    minigame: 2
  - text: "Nossa! Que perigo... Eu disse \xE0 direita!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_21
    id: 10
    episode: 5
    emotion: scared
    slug: error3
    minigame: 2
  - text: "Olha o bra\xE7o do gigante! Volte para tr\xE1s!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_23
    id: 11
    episode: 5
    emotion: scared
    slug: error4
    minigame: 2
  - text: "Cuidado! Estamos quase l\xE1! Direita!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_25
    id: 12
    episode: 5
    emotion: scared
    slug: error5
    minigame: 2
  - text: "Tu conseguiste, Guardi\xE3o! Somos uma \xF3tima equipe!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_26
    id: 13
    episode: 5
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Esses gigantes terr\xEDveis! Protegeram o ba\xFA com um cadeado m\xE1gico!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_29
    id: 0
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Que tipo de bruxaria \xE9 essa que n\xE3o usa chave? O que s\xE3o essas
      palavras?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_30
    id: 1
    episode: 5
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Tu, Guardi\xE3o, t\xE3o s\xE1bio nas palavras: como abriremos este ba\xFA?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_31
    id: 2
    episode: 5
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Creio que conhecemos estas palavras... Se colocarmos um I em FLOR N, temos
      FLORIN! Esse \xE9 mesmo o meu nome!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_32
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Vamos ver... esta aqui parece ser Ogro e aquela ali uva... quais ser\xE3o
      as outras?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_33
    id: 4
    episode: 5
    emotion: happy
    slug: error2
    minigame: 3
  - text: Posso tentar? Eu sei algumas palavras... deixe-me tentar, por favor.
    world: 4
    season: 1
    sound: ptbr_ep77_frn_34
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 3
  - text: "O ba\xFA est\xE1 aberto! Mas... que barulho \xE9 este?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_35
    id: 6
    episode: 5
    emotion: regular
    slug: victory
    minigame: 3
  - text: "S\xE3o muitas tra\xE7as gigantes! \xC9 imposs\xEDvel venc\xEA-las sozinho!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_37
    id: 0
    episode: 5
    emotion: scared
    slug: intro
    minigame: 4
  - text: "No ba\xFA! A harpa m\xE1gica! Guardi\xE3o, ajude-me a descobrir a sequ\xEAncia
      certa para nos proteger das tra\xE7as gigantes!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_38
    id: 1
    episode: 5
    emotion: scared
    slug: intro
    minigame: 4
  - text: "N\xE3o creio que seja assim. Devemos repetir a sequ\xEAncia."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_39
    id: 2
    episode: 5
    emotion: regular
    slug: error_1
    minigame: 4
  - text: "S\xE3o as vogais em ordem alfab\xE9tica, n\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_40
    id: 3
    episode: 5
    emotion: regular
    slug: error_2
    minigame: 4
  - text: "Dai-me a honra de completar esta sequ\xEAncia, ao menos desta vez!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_41
    id: 4
    episode: 5
    emotion: happy
    slug: error_3
    minigame: 4
  - text: "Adoro o som da harpa... Extraordin\xE1rio!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_42
    id: 5
    episode: 5
    emotion: regular
    slug: victory
    minigame: 4
  - text: "Oh, n\xE3o! As tra\xE7as destru\xEDram o mapa! Como descobriremos onde
      est\xE1 a Rainha?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_45
    id: 0
    episode: 5
    emotion: sad
    slug: intro
    minigame: 5
  - text: "Tu achas que \xE9 poss\xEDvel reconstruir o mapa, Guardi\xE3o? Mas como?"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_46
    id: 1
    episode: 5
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Claro, tu podes ler as palavras faltantes e ver onde se encaixam! Boa ideia,
      Guardi\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_47
    id: 2
    episode: 5
    emotion: happy
    slug: intro
    minigame: 5
  - text: "Cada palavra corresponde a um desenho do mapa, como a Lagoa Arco-\xCDris."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_48
    id: 3
    episode: 5
    emotion: regular
    slug: error1
    minigame: 5
  - text: Que outras palavras se encaixam com os desenhos do mapa?
    world: 4
    season: 1
    sound: ptbr_ep77_frn_49
    id: 4
    episode: 5
    emotion: regular
    slug: error2
    minigame: 5
  - text: "N\xE3o estariam estes aqui trocados? Vejamos..."
    world: 4
    season: 1
    sound: ptbr_ep77_frn_50
    id: 5
    episode: 5
    emotion: regular
    slug: error3
    minigame: 5
  - text: "O mapa est\xE1 completo!"
    world: 4
    season: 1
    sound: ptbr_ep77_frn_51
    id: 6
    episode: 5
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Hidra, poderia nos mostrar o caminho da mina dos an\xF5es ferr\xF5es?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_46_cut
    id: 0
    episode: 6
    emotion: regular
    slug: final
    minigame: 
  - text: "Vamos, Guardi\xE3o. Antes que este monstro decida mudar de ideia sobre
      nossa amizade!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_47
    id: 1
    episode: 6
    emotion: scared
    slug: final
    minigame: 
  - text: "O caminho at\xE9 a mina dos an\xF5es ferr\xF5es passa pelo terr\xEDvel
      Vale das Hidras!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_01
    id: 2
    episode: 6
    emotion: scared
    slug: minigame1
    minigame: 
  - text: "Como assim o que h\xE1 de t\xE3o terr\xEDvel em uma hidra? Elas s\xE3o
      cobras gigantes! Com v\xE1rias cabe\xE7as!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_02
    id: 3
    episode: 6
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Acho eu... Nunca... nunca vi uma hidra!
    world: 4
    season: 1
    sound: ptbr_ep78_frn_03
    id: 4
    episode: 6
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ei! Tem uma cabe\xE7a que parece concentrada... aquela, com um l\xE1pis
      na boca!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_05
    id: 5
    episode: 6
    emotion: scared
    slug: minigame1
    minigame: 
  - text: Tu ouves este silvo? O que poderia...
    world: 4
    season: 1
    sound: ptbr_ep78_frn_11
    id: 6
    episode: 6
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "\xC9 a outra cabe\xE7a da hidra! O que ser\xE1 que ela quer?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_12
    id: 7
    episode: 6
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Sinto cheiro de cozido... Espero que n\xE3o seja uma das cabe\xE7as se
      preparando para nos cozinhar!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_19
    id: 8
    episode: 6
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "L\xE1 est\xE1 ela, a terceira cabe\xE7a! Ela parece faminta!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_20
    id: 9
    episode: 6
    emotion: scared
    slug: minigame3
    minigame: 
  - text: "A quarta cabe\xE7a est\xE1 adiante. Parece estar ouvindo r\xE1dio."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_28
    id: 10
    episode: 6
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Isso \xE9 tudo, certo? N\xE3o precisamos mais ajudar nenhuma cabe\xE7a
      de hidra, n\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_37
    id: 11
    episode: 6
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Espere... aquela quinta cabe\xE7a quer alguma coisa..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_38
    id: 12
    episode: 6
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Ela est\xE1 fazendo palavras cruzadas! Se dermos uma ajuda, ela pode nos
      indicar o caminho da mina. Qual palavra est\xE1 faltando?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_06
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Nobre Guardi\xE3o, achas que as outras palavras aqui presentes nos auxiliam
      a escrever esta que est\xE1 faltando? Vamos observ\xE1-las letra por letra?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_07
    id: 1
    episode: 6
    emotion: regular
    slug: error1
    minigame: 1
  - text: "Penso j\xE1 termos descoberto ao menos duas letras: \"B\" e \"O\", que
      est\xE3o na palavra LOBO... Bom come\xE7o, n\xE3o achas, meu amigo?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_08
    id: 2
    episode: 6
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Falta-nos bem pouco neste desafio! A palavra VELA parece tamb\xE9m conter
      uma parte importante do que precisamos: as letras \"L\" e \"A\" completam nossa
      palavra BOLA!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_09
    id: 3
    episode: 6
    emotion: happy
    slug: error3
    minigame: 1
  - text: "Ainda bem que ficou tudo resolvido. N\xE3o queria ter que enfrentar essa
      hidra..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_10
    id: 4
    episode: 6
    emotion: regular
    slug: victory
    minigame: 1
  - text: "Ela... ela tamb\xE9m quer nossa ajuda! Ela viu que auxiliamos a outra cabe\xE7a
      e... Quem diria!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_13
    id: 0
    episode: 6
    emotion: happy
    slug: intro
    minigame: 2
  - text: "Ela quer que a ajudemos a descobrir qual destes objetos \xE9 o mais leve
      entre eles."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_14
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Talvez seja boa ideia pesar os objetos. O mais pesado ficar\xE1 mais baixo
      na balan\xE7a."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_15
    id: 2
    episode: 6
    emotion: regular
    slug: error1
    minigame: 2
  - text: "Com certeza n\xE3o \xE9 nem a bigorna, nem o vaso de planta! Estes dois
      s\xE3o os mais pesados!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_16
    id: 3
    episode: 6
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Ainda n\xE3o me parece ser este, Guardi\xE3o. Quem sabe tentas este aqui?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_17
    id: 4
    episode: 6
    emotion: regular
    slug: error3
    minigame: 2
  - text: "\xC9 certo! \xC9 o urso de pel\xFAcia. Podes contar a teus amigos... irm\xE3os...
      cabe\xE7as... n\xE3o sei!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_18
    id: 5
    episode: 6
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Fique longe de n\xF3s, monstro terr\xEDvel! Olha como ela saliva de fome!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_21
    id: 0
    episode: 6
    emotion: scared
    slug: intro
    minigame: 3
  - text: "Espere... ela... ela s\xF3 quer ajuda para fazer uma torta de frutas? Que
      tipo de cobra gigante \xE9 esta?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_22
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Guardi\xE3o, podes ajud\xE1-la? Creio que \xE9 s\xF3 colocarmos cada um
      dos ingredientes nas quantidades corretas."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_23
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Acho que a ordem \xE9 outra. Vamos contar cada coisa e ver qual destes
      \xE9 o n\xFAmero correto... Podes tentar de novo?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_24
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 3
  - text: "O n\xFAmero deve representar a quantidade de cada ingrediente. Como, por
      exemplo, este 8 deve ser das 8 flores! Quais ser\xE3o os outros?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_25
    id: 4
    episode: 6
    emotion: regular
    slug: error2
    minigame: 3
  - text: "Creio que \xE9 s\xF3 trocarmos estes aqui de lugar e est\xE1 terminado:
      3 ma\xE7\xE3s, 8 flores, 12 uvas e 15 sementes! Que torta estranha!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_26
    id: 5
    episode: 6
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Devo concordar que o cheiro est\xE1 \xF3timo. Melhor ainda que n\xE3o somos
      o prato principal!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_27
    id: 6
    episode: 6
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Se alguma cabe\xE7a n\xE3o estiver usando gravata na festa, vai ficar triste..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_33
    id: 0
    episode: 6
    emotion: regular
    slug: hint1
    minigame: 4
  - text: "N\xE3o sei, mas diria que esta cabe\xE7a da hidra est\xE1 confusa. Parece
      que n\xE3o sabe se decidir sobre algo."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_29
    id: 1
    episode: 6
    emotion: sad
    slug: intro
    minigame: 4
  - text: "Pobre hidra! Guardi\xE3o, ela precisa saber quantas gravatas ainda lhe
      sobrar\xE3o se ela usar uma em cada cabe\xE7a."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_31
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Sobrar\xE3o 5 gravatas, ent\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_36
    id: 3
    episode: 6
    emotion: happy
    slug: victory
    minigame: 4
  - text: "O que foi dito no r\xE1dio sobre o n\xFAmero de gravatas por cabe\xE7a?
      Uma por cabe\xE7a! \xD3timo! Assim sabemos quantas gravatas ela usou e depois
      fica mais f\xE1cil descobrirmos quantas v\xE3o sobrar, concordas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_32
    id: 4
    episode: 6
    emotion: regular
    slug: error_more
    minigame: 4
  - text: "O que foi dito no r\xE1dio sobre o n\xFAmero de gravatas por cabe\xE7a?
      Uma por cabe\xE7a! \xD3timo! Assim sabemos quantas gravatas ela usou e depois
      fica mais f\xE1cil descobrirmos quantas v\xE3o sobrar, concordas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_32
    id: 5
    episode: 6
    emotion: regular
    slug: error_less
    minigame: 4
  - text: "Se n\xE3o estou enganado, era exatamente uma gravata por cabe\xE7a... Como
      ela tem 5 cabe\xE7as usar\xE1 5 gravatas. E das 10 do arm\xE1rio, quantas v\xE3o
      sobrar, ent\xE3o, s\xE1bio amigo?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_34
    id: 6
    episode: 6
    emotion: regular
    slug: hint2
    minigame: 4
  - text: "Se alguma cabe\xE7a n\xE3o estiver usando gravata na festa, vai ficar triste..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_33
    id: 7
    episode: 6
    emotion: regular
    slug: hint3
    minigame: 4
  - text: "Bom, se s\xE3o 10 gravatas no arm\xE1rio... E ela usar\xE1 5 no Baile..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_35
    id: 8
    episode: 6
    emotion: regular
    slug: lasterror
    minigame: 4
  - text: "Pois bem... o que tu precisas, quinta cabe\xE7a da hidra?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_39
    id: 0
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "O que \xE9 isto? Um \xE1lbum de figurinhas? Hidras de gravata eu j\xE1
      vi, mas colecionando figurinhas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_40
    id: 1
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Bom, podemos ajud\xE1-la a colar as figuras que faltam no \xE1lbum, n\xE3o
      \xE9, Guardi\xE3o? A flor j\xE1 est\xE1 colada e as outras?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_41_fix
    id: 2
    episode: 6
    emotion: regular
    slug: intro
    minigame: 5
  - text: "J\xE1 achei duas palavras que n\xE3o s\xE3o deste \xE1lbum, pois n\xE3o
      temos a palavra COELHO, nem a palavra \xC1RVORE escritas aqui. Estas figurinhas
      devem ser de outro \xE1lbum..."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_42_A
    id: 3
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "O que achas de ler os demais nomes em voz alta para saber quais s\xE3o
      as figurinhas certas?"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_42_B
    id: 4
    episode: 6
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Lobo mau? Esse se encaixa, n\xE3o \xE9, Guardi\xE3o? Parece com as hist\xF3rias
      que meu tio me contava!"
    world: 4
    season: 1
    sound: ptbr_ep78_frn_43
    id: 5
    episode: 6
    emotion: regular
    slug: error2
    minigame: 5
  - text: "E tamb\xE9m se descobrimos a FADA... Tudo se completa com o DUENDE!."
    world: 4
    season: 1
    sound: ptbr_ep78_frn_44
    id: 6
    episode: 6
    emotion: regular
    slug: error3
    minigame: 5
  - text: Terminamos? Terminamos!
    world: 4
    season: 1
    sound: ptbr_ep78_frn_45
    id: 7
    episode: 6
    emotion: happy
    slug: victory
    minigame: 5
  - text: "Guardi\xE3o, segundo os an\xF5es, o Senhor Sombrio veio at\xE9 aqui roubar
      seus mapas do subterr\xE2neo, pois os an\xF5es sabem onde est\xE1 a Rainha das
      Fadas!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_44
    id: 0
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "E lembra o rubi especial que eles procuravam? \xC9 este o mist\xE9rio!
      A Rainha das Fadas est\xE1 aprisionada dentro do Rubi de Fogo!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_45
    id: 1
    episode: 7
    emotion: scared
    slug: final
    minigame: 
  - text: "N\xE3o podemos perder tempo: precisamos regat\xE1-la antes que seja tarde
      demais!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_46
    id: 2
    episode: 7
    emotion: regular
    slug: final
    minigame: 
  - text: "Chegamos! Esta \xE9 a mina dos an\xF5es ferr\xF5es! N\xE3o h\xE1 melhor
      minerador em todo o Mundo dos Sonhos!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_01
    id: 3
    episode: 7
    emotion: happy
    slug: minigame1
    minigame: 
  - text: "Eles nos ajudar\xE3o a chegar at\xE9 onde a Rainha das Fadas est\xE1 escondida.
      N\xE3o duvidaria que soubessem de tudo desde o princ\xEDpio."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_02
    id: 4
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Estranho... Este lugar parece t\xE3o vazio e silencioso. Geralmente pode-se
      ouvir os an\xF5es cantando e resmungando de longe."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_03
    id: 5
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "O que \xE9 aquele objeto piscando ali sobre a mesa?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_04
    id: 6
    episode: 7
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Ser\xE1 que chegamos tarde demais? Poderia o Senhor Sombrio e seus rob\xF4s
      j\xE1 terem passado por aqui?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_11
    id: 7
    episode: 7
    emotion: sad
    slug: minigame2
    minigame: 
  - text: "Vamos ver se encontramos alguma pista \xE0 frente."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_12
    id: 8
    episode: 7
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Os an\xF5es costumam ser muito cuidadosos com suas coisas... N\xE3o deixariam
      as etiquetas soltas de prop\xF3sito."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_18
    id: 9
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Aquele quadro parece ter o relat\xF3rio do dia. Deve haver uma pista ali."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_19
    id: 10
    episode: 7
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "Vamos avan\xE7ar. Pressinto que estamos prestes a descobrir este mist\xE9rio."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_28
    id: 11
    episode: 7
    emotion: regular
    slug: minigame4
    minigame: 
  - text: "Espere! Est\xE1s ouvindo este som? H\xE1 algu\xE9m adiante."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_35
    id: 12
    episode: 7
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "Prepare-se para o combate! Podem ser rob\xF4s do mal!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_36
    id: 13
    episode: 7
    emotion: scared
    slug: minigame5
    minigame: 
  - text: O que queres dizer com "uma bomba"? Uma bomba de fedor ainda por cima? O
      que faz uma bomba aqui?
    world: 4
    season: 1
    sound: ptbr_ep79_frn_05
    id: 0
    episode: 7
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Precisamos deslig\xE1-la antes que exploda! Guardi\xE3o, fazes tua m\xE1gica!
      Parece uma frase, mas toda fora de ordem! Desvendas o segredo da bomba!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_06
    id: 1
    episode: 7
    emotion: scared
    slug: intro
    minigame: 1
  - text: "O segredo come\xE7a com essa figura de SOLDADO! Ah, nobre Guardi\xE3o...
      Qual \xE9 aquela m\xFAsica na qual o soldado vai preso para o quartel?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_07
    id: 2
    episode: 7
    emotion: scared
    slug: error1
    minigame: 1
  - text: "Acho que \xE9 MARCHA SOLDADO... O que vem depois?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_08
    id: 3
    episode: 7
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Claro! Ouvia esta m\xFAsica quando treinava para ser cavaleiro!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_09
    id: 4
    episode: 7
    emotion: happy
    slug: error3
    minigame: 1
  - text: "\"Marcha soldado, cabe\xE7a de papel.\" Veja, o rel\xF3gio parou! Estamos
      salvo! E cheirosos!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_10
    id: 5
    episode: 7
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Isto parece uma cole\xE7\xE3o de algum tipo. Mas n\xE3o vejo etiquetas
      em lugar algum."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_13
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Ah, algu\xE9m as jogou no ch\xE3o! Vamos recolocar a etiqueta correta no
      vaso."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_14
    id: 1
    episode: 7
    emotion: happy
    slug: intro
    minigame: 2
  - text: Pronto, colado novamente.
    world: 4
    season: 1
    sound: ptbr_ep79_frn_17
    id: 2
    episode: 7
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Acabei por descobrir o segredo! Basta acharmos a etiqueta que tem a mesma
      palavra VASO, mas escrita em letra min\xFAscula. Podes tentar, Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_15
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 2
  - text: "\xC9 esta aqui!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_16
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Algu\xE9m bagun\xE7ou tudo, como se estivesse procurando algo."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_20
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "N\xE3o h\xE1 d\xFAvida de que os rob\xF4s do Senhor Sombrio passaram por
      aqui!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_21
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Veja, os an\xF5es fizeram uma grava\xE7\xE3o do relat\xF3rio. Eu toco a
      grava\xE7\xE3o e tu completas o quadro."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_22
    id: 3
    episode: 7
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Terminado? estranho. H\xE1 algo aqui sobre um rubi especial, mas n\xE3o
      consigo ler o resto do que est\xE1 escrito."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_27
    id: 5
    episode: 7
    emotion: regular
    slug: victory
    minigame: 3
  - text: Tenho certeza que ouvi 3 pedras quadradas. Mas e as outras? Vamos ouvir
      novamente, para termos certeza?
    world: 4
    season: 1
    sound: ptbr_ep79_frn_24
    id: 6
    episode: 7
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Com certeza s\xE3o 2 pedras circulares. E as demais?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_25_fix
    id: 7
    episode: 7
    emotion: regular
    slug: error2
    minigame: 3
  - text: "3 quadradas, 2 c\xEDrculares e zero tri\xE2ngulares!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_26
    id: 8
    episode: 7
    emotion: happy
    slug: error3
    minigame: 3
  - text: "Isto parece ser o quarto dos an\xF5es, mas, novamente, tudo est\xE1 fora
      de ordem."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_29
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: "J\xE1 que estamos aqui, vamos recolocar os nomes nos seus devidos lugares,
      em ordem alfab\xE9tica."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_30
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 4
  - text: A pessoa precisa ser muito vil para trocar os nomes das camas de lugar!
    world: 4
    season: 1
    sound: ptbr_ep79_frn_34
    id: 2
    episode: 7
    emotion: sad
    slug: victory
    minigame: 4
  - text: "Precisamos organizar de acordo com a primeira letra de cada nome. J\xE1
      tem um que come\xE7a com a letra \"A\". Abeto! Este \xE9 o primeiro!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_31
    id: 3
    episode: 7
    emotion: regular
    slug: error1
    minigame: 4
  - text: "Lembra-se da ordem do alfabeto? Come\xE7a com A, B, C, D... Achamos o segundo!
      Donfo! Quais ainda faltam?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_32
    id: 4
    episode: 7
    emotion: regular
    slug: error2
    minigame: 4
  - text: Abeto, Donfo, Fufos e... Tupli?
    world: 4
    season: 1
    sound: ptbr_ep79_frn_33
    id: 5
    episode: 7
    emotion: regular
    slug: error3
    minigame: 4
  - text: "Os an\xF5es ferr\xF5es! Tem\xEDamos que o Senhor Sombrio houvesse feito
      algo com voc\xEAs!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_37
    id: 0
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Vamos ajud\xE1-los a organizar tudo e, depois, expliquem-nos o que o Senhor
      Sombrio fazia aqui."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_38
    id: 1
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Guardi\xE3o, vamos ajud\xE1-los a colocar tudo nos seus devidos ba\xFAs?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_39
    id: 2
    episode: 7
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Tudo terminado! Pois bem, an\xF5es. O que houve aqui?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_43
    id: 3
    episode: 7
    emotion: regular
    slug: victory
    minigame: 5
  - text: "O desenho no ba\xFA indica o tipo de objeto a ser ali guardado. Devemos
      ter muita aten\xE7\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_40
    id: 4
    episode: 7
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Alguma coisa est\xE1 no lugar errado. Vamos tentar novamente."
    world: 4
    season: 1
    sound: ptbr_ep79_frn_41_A
    id: 5
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Acho que neste primeiro ba\xFA v\xE3o os dois ret\xE2ngulos verdes, pois
      o desenho do ba\xFA \xE9 igual aos ret\xE2ngulos! O que mais fica faltando?"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_41_B
    id: 6
    episode: 7
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ah, sim. Estes aqui est\xE3o trocados de lugar!"
    world: 4
    season: 1
    sound: ptbr_ep79_frn_42
    id: 7
    episode: 7
    emotion: happy
    slug: error3
    minigame: 5
  - text: "Bom, majestade, creio que ser\xE1 minha \xFAnica oportunidade de v\xEA-la.
      Espero poder servi-la novamente no futuro."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_42
    id: 0
    episode: 8
    emotion: sad
    slug: final
    minigame: 
  - text: "Guardi\xE3o, assim que tu estiveres pronto, podemos ir."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_43
    id: 1
    episode: 8
    emotion: regular
    slug: final
    minigame: 
  - text: "Segundo as lendas, o Rubi de Fogo \xE9 uma joia muito poderosa."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_01
    id: 2
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Quando a Rainha das Fadas p\xF4s os gigantes para dormir, ela se escondeu
      dentro da joia, pois se ela fosse derrotada, os gigantes despertariam!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_02
    id: 3
    episode: 8
    emotion: sad
    slug: minigame1
    minigame: 
  - text: Deve ser por isso que o Senhor Sombrio quer o rubi. Ele quer despertar os
      gigantes!
    world: 4
    season: 1
    sound: ptbr_ep80_frn_03
    id: 4
    episode: 8
    emotion: regular
    slug: minigame1
    minigame: 
  - text: "Veja! Outra m\xE1quina-drag\xE3o. E ela est\xE1 comendo a terra atr\xE1s
      do Rubi de Fogo! Precisamos det\xEA-la."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_04
    id: 5
    episode: 8
    emotion: scared
    slug: minigame1
    minigame: 
  - text: O Senhor Sombrio parece furioso. Precisamos agir antes que ele nos veja.
    world: 4
    season: 1
    sound: ptbr_ep80_frn_11
    id: 6
    episode: 8
    emotion: scared
    slug: minigame2
    minigame: 
  - text: "Olhe! Caixas de rubis m\xE1gicos! Vamos us\xE1-los contra o vil\xE3o!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_12
    id: 7
    episode: 8
    emotion: regular
    slug: minigame2
    minigame: 
  - text: "Funcionou! O Senhor Sombrio n\xE3o p\xF4de resistir \xE0 luz dos rubis
      e fugiu!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_19
    id: 8
    episode: 8
    emotion: happy
    slug: minigame3
    minigame: 
  - text: "Ser\xE1 que o Rubi de Fogo ainda est\xE1 l\xE1 dentro?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_20
    id: 9
    episode: 8
    emotion: regular
    slug: minigame3
    minigame: 
  - text: "N\xE3o \xE9 que eu esteja com medo, mas tu \xE9s mais experiente na arte
      da magia. Ent\xE3o..."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_28
    id: 10
    episode: 8
    emotion: scared
    slug: minigame4
    minigame: 
  - text: "Estamos no interior do Rubi de Fogo! Isso \xE9... Pelas costeletas do Gronco!
      \xC9 a Rainha das Fadas!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_33
    id: 11
    episode: 8
    emotion: happy
    slug: minigame5
    minigame: 
  - text: "Vossa alteza fe\xE9rica! Viemos proteg\xEA-la do maldoso Senhor Sombrio!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_34
    id: 12
    episode: 8
    emotion: regular
    slug: minigame5
    minigame: 
  - text: "O Senhor Sombrio est\xE1 com a m\xE1quina-drag\xE3o! Tu sabes como derrot\xE1-lo,
      Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_05
    id: 0
    episode: 8
    emotion: scared
    slug: intro
    minigame: 1
  - text: "Isso parece um encantamento! Ou uma senha! Quais letras faltam nestas palavras?
      S\xF3 assim conseguiremos ler a frase toda!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_06
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 1
  - text: "Vamos ler tudo em voz alta para tentar entender: Pela ... O que ser\xE1?
      Parece TELA... Isso mesmo! Basta completar... Pela tela do radar, a Rainha...
      Como continua?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_07
    id: 2
    episode: 8
    emotion: regular
    slug: error1
    minigame: 1
  - text: "O nome dela \xE9 Rainha Fada! Pronto, Guardi\xE3o! Colocamos as letras
      \"D\" e \"A\" que faltavam nesta palavra. Continuemos: Pela tela do radar, a
      Rainha Fada est\xE1 escondida dentro da joia..."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_08
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 1
  - text: "Tela... fada... joia... e m\xE1gica!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_09
    id: 4
    episode: 8
    emotion: happy
    slug: error3
    minigame: 1
  - text: "Muito bem, Guardi\xE3o! A m\xE1quina-drag\xE3o parou!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_10
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 1
  - text: "Todos os rubis deste lugar s\xE3o m\xE1gicos. Podemos usar essa magia para
      derrotar o Senhor Sombrio!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_13
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Guardi\xE3o, pegue a caixa com o maior n\xFAmero poss\xEDvel de rubis!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_14
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 2
  - text: "Isso n\xE3o \xE9 o suficiente. Precisamos de mais rubis!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_15
    id: 2
    episode: 8
    emotion: scared
    slug: error1
    minigame: 2
  - text: "Para derrotar o Senhor Sombrio, o importante \xE9 a quantidade. Esta caixa,
      por exemplo, embora bem cheia, s\xF3 tem 2 rubis... N\xE3o nos serve."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_16
    id: 3
    episode: 8
    emotion: regular
    slug: error2
    minigame: 2
  - text: "Aquela ali me parece que tem a maior quantidade de rubis. Nem d\xE1 para
      a gente contar direito! S\xE3o pequenos, mas s\xE3o muitos."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_17
    id: 4
    episode: 8
    emotion: regular
    slug: error3
    minigame: 2
  - text: "N\xF3s o expulsamos do Sonho das \xC1rvores Encantadas com o poder dos
      rubis!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_18
    id: 5
    episode: 8
    emotion: happy
    slug: victory
    minigame: 2
  - text: "Quantos rubis m\xE1gicos! Como vamos descobrir qual deles \xE9 o Rubi de
      Fogo?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_21
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "Claro! Os an\xF5es ferr\xF5es me deram essas fotos do rubi que guarda nossa
      rainha!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_22
    id: 1
    episode: 8
    emotion: happy
    slug: intro
    minigame: 3
  - text: "Usando estas fotos tu podes descobrir qual dos rubis \xE9 aquele que procuramos?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_23
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 3
  - text: "\xC9 ele! Veja as fotos! Ele parece t\xE3o quente quanto o fogo!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_27
    id: 3
    episode: 8
    emotion: happy
    slug: victory
    minigame: 3
  - text: "Olhando a primeira foto, conseguimos eliminar os rubis que t\xEAm mais
      do que 3 faces viradas para n\xF3s! Mas qual deles \xE9 o certo?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_24
    id: 4
    episode: 8
    emotion: regular
    slug: error1
    minigame: 3
  - text: "Vamos observar a segunda foto, com certeza os rubis de ponta achatada est\xE3o
      fora! Mas qual ser\xE1 o Rubi de Fogo, nobre Guardi\xE3o?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_25
    id: 5
    episode: 8
    emotion: regular
    slug: error2
    minigame: 3
  - text: Aquele ali parece ser o que procuramos.
    world: 4
    season: 1
    sound: ptbr_ep80_frn_26
    id: 6
    episode: 8
    emotion: regular
    slug: error3
    minigame: 3
  - text: "Claro! A p\xE1 m\xE1gica dos an\xF5es! Ela nos permitir\xE1 entrar no rubi
      e falar com a Rainha. Ela saber\xE1 como proteger a joia!"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_29
    id: 0
    episode: 8
    emotion: happy
    slug: intro
    minigame: 4
  - text: "Veja aqui as instru\xE7\xF5es. A p\xE1 m\xE1gica possui 9 cargas m\xE1gicas.
      Para entrarmos no Rubi, temos que gastar 5 cargas, e para sairmos, vamos gastar
      2 cargas."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_30_A
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Ser\xE1 que a p\xE1 m\xE1gica tem carga de magia o suficiente para entrarmos
      e sairmos do Rubi de Fogo?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_30_B
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 4
  - text: "Estamos com sorte! Tem carga suficiente, e ainda restar\xE3o duas cargas.
      Vamos entrar! Preparado?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_32
    id: 3
    episode: 8
    emotion: happy
    slug: victory
    minigame: 4
  - text: "Deixe-me ver com calma... S\xE3o 9 cargas no total e para entrarmos vamos
      remover 5 destas cargas! Desse total vamos ter que remover mais 2 cargas para
      sairmos de l\xE1! Ser\xE1 que isso poss\xEDvel?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_31
    id: 4
    episode: 8
    emotion: regular
    slug: error1
    minigame: 4
  - text: "A Rainha est\xE1 muito contente com nosso sucesso, Guardi\xE3o, mas teme
      que precisemos fazer alguma coisa a mais."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_35
    id: 0
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Estas s\xE3o instru\xE7\xF5es de um feiti\xE7o que tornar\xE1 o rubi invis\xEDvel
      a todos, menos para um Guardi\xE3o dos Sonhos. Isso proteger\xE1 nosso Sonho."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_36
    id: 1
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "S\xF3 precisamos descobrir qual destes pap\xE9is tem o poema m\xE1gico."
    world: 4
    season: 1
    sound: ptbr_ep80_frn_37
    id: 2
    episode: 8
    emotion: regular
    slug: intro
    minigame: 5
  - text: "Melhor \xE9 examinarmos um a um. Este aqui, por exemplo, \xE9 uma lista
      de compras, veja s\xF3:"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_38_A
    id: 3
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: "2 caixas de folha de parreira, 6 cascas de nozes, 1 d\xFAzia de caixas
      de orvalho... Muitos itens a serem adquiridos, n\xE3o te parece? Qual ser\xE1
      o poema m\xE1gico?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_38_B
    id: 4
    episode: 8
    emotion: regular
    slug: error1
    minigame: 5
  - text: "Veja bem, Guardi\xE3o! Temos aqui tamb\xE9m 2 receitas:"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_39_A
    id: 5
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Uma bem deliciosa, com mam\xE3o, leite e pozinhos m\xE1gicos. E outra que
      vai ao forno por 30 minutos, depois de misturar 6 cascas de figueira, 1 ovo
      de avestruz e 3 litros de orvalho. Mas qual ser\xE1 o poema m\xE1gico?"
    world: 4
    season: 1
    sound: ptbr_ep80_frn_39_B
    id: 6
    episode: 8
    emotion: regular
    slug: error2
    minigame: 5
  - text: "Ser\xE1 que n\xE3o \xE9 este outro aqui? \"Pozinho m\xE1gico, fa\xE7a sumir.
      O rubi de fogo que tenho aqui\". Isso mesmo! Os demais textos s\xE3o importantes,
      mas s\xE3o not\xEDcias e n\xE3o poemas, concordas, nobre Guardi\xE3o?\""
    world: 4
    season: 1
    sound: ptbr_ep80_frn_40
    id: 7
    episode: 8
    emotion: regular
    slug: error3
    minigame: 5
  - text: Encontramos!
    world: 4
    season: 1
    sound: ptbr_ep80_frn_41
    id: 8
    episode: 8
    emotion: happy
    slug: victory
    minigame: 5
